local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local IMG_CONFIGS = require(RPS.Modules.Configs.ImageConfigs)

local Chicken: CFG_TYPES.DecisionConfig = {
	Recurring = false,
	Weight = 0,
	Queue = {
		Min = 1,
		Max = 3
	},
	
	Rarity = 'Common',
	DecisionPlaintiff = 2,

	Plaintiffs = {
		{ -- plaintiff 1
			Category = 'Noble',
			Rarity = 'Common',
			Animation = {'Character','Hopeful'},
			Gender = 'Female',
			
			Dialogue = {
				{
					Order = 1,
					Subject = RPS.Assets.Models.Animals.Chicken,
					CFrame = CFrame.new(0, -0.4, -1.6) * CFrame.Angles(0, math.rad(35), 0),
					Animation = {'Chicken', 'Idle'}
