local PathfindingUtils = {}

type WaypointGraph = {
	[Vector3Value]: {Vector3Value}
}

-- create a graph of waypoints from a folder of waypoints
function PathfindingUtils.GenerateWaypointGraph(WaypointsFolder: Folder): WaypointGraph
	local graph: WaypointGraph = {}
	local grid: {
		[number]: {
			[number]: Vector3Value
		}
	} = {}

	-- Build X/Z lookup table once.
	for _, xFolder in WaypointsFolder:GetChildren() do
		if not xFolder:IsA("Folder") then
			continue
		end

		local x = tonumber(xFolder.Name:match("^X(%-?%d+)$"))

		if not x then
			continue
		end

		grid[x] = {}

		for _, point in xFolder:GetChildren() do
			if not point:IsA("Vector3Value") then
				continue
			end

			local z = tonumber(point.Name:match("^Spawn(%-?%d+)$"))

			if not z then
				continue
			end

			grid[x][z] = point
			graph[point] = {}
		end
	end


	local function getWaypoint(
		x: number,
		z: number
	): Vector3Value?

		local column = grid[x]

		if not column then
			return nil
		end

		return column[z]
	end


	local function addConnection(
		a: Vector3Value,
		b: Vector3Value?
	)
		if not b then
			return
		end

		table.insert(graph[a], b)
	end


	-- Compile connections once.
	for x, column in grid do
		for z, point in column do

			-- Horizontal roads.
			addConnection(point, getWaypoint(x - 1, z))
			addConnection(point, getWaypoint(x + 1, z))

			-- Vertical roads.
			--
			-- A missing Z means there is a gap in the road,
			-- so we DO NOT skip over it.
			addConnection(point, getWaypoint(x, z - 1))
			addConnection(point, getWaypoint(x, z + 1))
		end
	end
	
	return graph
end

-- get the path from a to b using a graph of waypoints
function PathfindingUtils.GetPath(
	Origin: Vector3Value,
	Destination: Vector3Value,
	Waypoints: WaypointGraph
): {Vector3Value}

	if Origin == Destination then
		return {}
	end

	-- Array queue + head index is substantially better than
	-- repeatedly calling table.remove(queue, 1).
	local queue: {Vector3Value} = {Origin}
	local head = 1

	local visited: {[Vector3Value]: boolean} = {
		[Origin] = true
	}

	local previous: {[Vector3Value]: Vector3Value} = {}

	while head <= #queue do
		local current = queue[head]
		head += 1

		local neighbors = Waypoints[current]

		if not neighbors then
			continue
		end

		for _, neighbor in neighbors do
			if visited[neighbor] then
				continue
			end

			visited[neighbor] = true
			previous[neighbor] = current

			-- Target found.
			if neighbor == Destination then
				local reversePath: {Vector3Value} = {}

				local node = Destination

				while node ~= Origin do
					table.insert(reversePath, node)

					local previousNode = previous[node]

					if not previousNode then
						warn("Failed to reconstruct NPC path")
						return {}
					end

					node = previousNode
				end

				-- Reverse without table.insert(path, 1, ...)
				-- because inserting at index 1 repeatedly shifts
				-- the entire array.
				local path: {Vector3Value} = {}

				for i = #reversePath, 1, -1 do
					table.insert(path, reversePath[i])
				end

				return path
			end

			table.insert(queue, neighbor)
		end
	end

	warn(
		`No NPC path from {Origin:GetFullName()} to {Destination:GetFullName()}`
	)

	return {}
end

-- get a random position for a positions folder
function PathfindingUtils.GetRandomPos(Positions: Folder): (Vector3, Vector3Value)
	local folders = Positions:GetChildren() :: {Folder}
	local xFolder = folders[math.random(1, #folders)]:GetChildren() :: {Vector3Value}
	local posV = xFolder[math.random(1, #xFolder)]
	return posV.Value, posV
end

return PathfindingUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1372"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">EffectsUtils</string><string name="ScriptGuid">{5a0417b7-bbcb-4bde-85c8-a9837235d2f3}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local EffectsUtils = {}

local WKS = game:GetService('Workspace')
local TWS = game:GetService('TweenService')
local RPS = game:GetService('ReplicatedStorage')

local random = Random.new()

local MAX_DROPLETS = 15
local MAX_POOLS = 4

-- play sound at position
function EffectsUtils.PlaySound(Sound: Sound, Position: Vector3): (Sound, Attachment)
	local att = Instance.new('Attachment')
	att.Name = Sound.Name
	att.WorldPosition = Position
	att.Parent = WKS.Temp
	
	local clone = Sound:Clone()
	clone.Parent = att
	clone:Play()
	clone.Ended:Once(function()
		att:Destroy()
	end)
	
	return clone, att
end

-- play sound at position
function EffectsUtils.PlaySoundAtRandom(SoundsFolder: Folder, Position: Vector3): (Sound, Attachment)
	local attachment: Attachment
	local sound = SoundsFolder:GetChildren()[math.random(1, #SoundsFolder:GetChildren())] :: Sound
	sound, attachment = EffectsUtils.PlaySound(sound, Position)

	return sound, attachment
end

-- add trail to part
function EffectsUtils.AddTrail(TargetPart: BasePart, TrailPart: BasePart, Duration: number?): Trail?
	if not TargetPart or not TrailPart then
		return nil
	end
	
	local trail: Trail
	local att0: Attachment 
	local att1: Attachment
	
	for _, child in TrailPart:GetChildren() do
		if child:IsA('Trail') then
			trail = child:Clone()
			trail.Parent = TargetPart
		elseif child:IsA('Attachment') then
			if att0 then
				att1 = child:Clone()
				att1.Parent = TargetPart
			else
				att0 = child:Clone()
				att0.Parent = TargetPart
			end
		end
	end
	
	trail.Attachment0 = att0
	trail.Attachment1 = att1
	
	if Duration then
		task.delay(Duration, function()
			trail:Destroy()
			att0:Destroy()
			att1:Destroy()
		end)
	end
	
	return trail
end

-- add particles
function EffectsUtils.AddParticles(ParentOrPosition: Instance | Vector3, ParticlesPart: BasePart, Duration: number?, Emits: {[string]: number}?): (Attachment?, {ParticleEmitter})
	local att: Attachment?
	local particles: {ParticleEmitter} = {}
	
	if typeof(ParentOrPosition) == 'Vector3' then
		local clone = ParticlesPart:Clone()
		clone.Parent = WKS.Temp
		clone.Position = ParentOrPosition
		
		for _, child in clone:GetDescendants() do
			if child:IsA('ParticleEmitter') then
				if Emits and Emits[child.Name] then
					child:Emit(Emits[child.Name])
				else
					child.Enabled = true
				end
			end
		end
		
		if Duration then
			task.delay(Duration, function()
				clone:Destroy()
			end)
		end
	else
		for _, child in ParticlesPart:GetChildren() do
			if child:IsA('Attachment') then
				att = child:Clone()
				att.Parent = ParentOrPosition
			elseif child:IsA('ParticleEmitter') then
				local particle = child:Clone()
				particle.Parent = ParentOrPosition
				table.insert(particles, particle)
			end
		end

		if att then
			for _, desc in att:GetDescendants() do
				if desc:IsA('ParticleEmitter') then
					table.insert(particles, desc)
				end
			end
		end

		for _, emitter in particles do
			if Emits and Emits[emitter.Name] then
				emitter:Emit(Emits[emitter.Name])
			else
				emitter.Enabled = true
			end
		end

		local lifetime = 0
		for _, emitter in particles do
			lifetime = math.max(lifetime, emitter.Lifetime.Max)
		end
		
		if Duration then
			task.delay(Duration, function()
				for _, emitter in particles do
					emitter.Enabled = false
				end
			end)
			
			task.delay(Duration + lifetime + 1, function()
				if att then
					att:Destroy()
				end
				
				for _, emitter in particles do
					emitter:Destroy()
				end
			end)
		else
			task.delay(lifetime, function()
				if att then
					att:Destroy()
				end
				
				for _, emitter in particles do
					emitter:Destroy()
				end
			end)
		end
	end
	
	return att, particles
end

-- highlight instance
function EffectsUtils.HighlightInstance(Parent: Instance, FillColor: Color3, Duration: number): Highlight
	local highlight = Instance.new('Highlight')
	highlight.FillColor = FillColor
	highlight.FillTransparency = 1
	highlight.OutlineTransparency = 1
	highlight.OutlineColor = Color3.new(1,1,1)
	highlight.Parent = Parent
	
	local tween = TWS:Create(highlight, TweenInfo.new(Duration/2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 0, true), {FillTransparency = 0.7, OutlineTransparency = 0})
	tween:Play()
	
	tween.Completed:Once(function()
		highlight:Destroy()
	end)
	
	return highlight
end

-- splurt blood particles
--[[function EffectsUtils.SplurtBlood(Target: Model, Damage: number, Emits: {[string]: number}?, Debug: boolean?)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = {WKS}

	local human = Target:FindFirstChildOfClass('Humanoid') :: Humanoid
	local root = Target:FindFirstChild("HumanoidRootPart") :: BasePart
	if not root then
		return
	end

	local race = Target:GetAttribute("Race") or "Human"
	local p0 = root.Position

	local particlesPart = RPS.Assets.Particles.Combat.Blood:FindFirstChild(race) :: BasePart
	local folder = RPS.Assets.Trails.Combat.Blood:FindFirstChild(race) :: Folder

	-- chance scaling
	local chance = 0--math.clamp(Damage / 25, 0.15, 1)
	if human.Health < 50 or Damage >= 25 then
		chance = 1
	end
	
	if random:NextNumber() > chance then
		return
	end

	-- droplet scaling
	local dropletCount = math.clamp(math.floor(Damage / 6), 2, MAX_DROPLETS)

	-- pool scaling
	local poolsSpawned = 0

	EffectsUtils.PlaySoundAtRandom(RPS.Assets.Sounds.Combat.Blood, p0)
	EffectsUtils.AddParticles(root, particlesPart, nil, Emits)

	for i = 1, dropletCount do

		local xDir = random:NextNumber(-15,15)
		local zDir = random:NextNumber(-15,15)
		local rayDir = Vector3.new(xDir, -15, zDir).Unit

		local result = WKS:Raycast(p0, rayDir * 100, params)
		if not result then
			continue
		end

		local t = Instance.new("NumberValue")
		t.Name = "Tweener"
		t.Parent = script

		local drop = (folder:FindFirstChild("Drop") :: BasePart):Clone()
		drop.Position = p0
		drop.Parent = WKS.Temp

		local p2 = result.Position
		local height = random:NextNumber(0, 3 + Damage * 0.05)
		local p1 = ((p0 + p2) / 2) + Vector3.new(0, height, 0)

		t.Changed:Connect(function()
			drop.Position = FXC_UTILS.BezierCurve(t.Value, p0, p1, p2)
		end)

		local tween = TWS:Create(t, TweenInfo.new(random:NextNumber(.05,.35)), {Value = 1})
		tween:Play()

		tween.Completed:Once(function()

			t:Destroy()
			drop:Destroy()

			if poolsSpawned >= MAX_POOLS then
				return
			end

			poolsSpawned += 1

			local pool = (folder:FindFirstChild("Pool") :: BasePart):Clone()
			pool.CFrame =
				CFrame.new(result.Position + (result.Normal * 0.05), result.Position + result.Normal)
				* CFrame.Angles(math.rad(-90), math.rad(-90), 0)

			pool.Anchored = true
			pool.CanCollide = false
			pool.Transparency = 0
			pool.Parent = WKS.Temp

			-- pool size scaling
			local sizeFactor = math.clamp(Damage * 0.2, 0.8, 10)

			local poolTween = TWS:Create(
				pool,
				TweenInfo.new(random:NextNumber(0.6,2), Enum.EasingStyle.Cubic),
				{Size = pool.Size * sizeFactor}
			)

			poolTween:Play()

			poolTween.Completed:Once(function()

				task.wait(5)

				local destTween = TWS:Create(pool, TweenInfo.new(.6), {Transparency = 1})

				destTween.Completed:Once(function()
					pool:Destroy()
				end)

				destTween:Play()
			end)

		end)
	end
end]]

-- finds position in curve
function EffectsUtils.BezierCurve(T: number, P0: Vector3, P1: Vector3, P2: Vector3): Vector3
	return (1 - T)^2 * P0 + 2 * (1 - T) * T * P1 + T^2 * P2
end

return EffectsUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1373"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">SnapshotUtils</string><string name="ScriptGuid">{b0419eca-b843-4cdd-97b9-4e2cf85a3e08}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
