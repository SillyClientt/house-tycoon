local CharacterUtils = {}

local WKS = game:GetService('Workspace')
local RPS = game:GetService('ReplicatedStorage')

local DRS_UTILS = require(RPS.Modules.Utils.DressUtils)
local CLN_UTILS = require(RPS.Modules.Utils.CollisionUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)

-- create a character from a category
function CharacterUtils.Create(Category: CFG_TYPES.NPCCategory| Model, Gender: string?, WithoutHair: boolean?, Scale: number?): (Model, Animator)
	if typeof(Category) == 'Instance' and Category:IsA('Model') then
		local char = Category:Clone()
		local animator = Category:FindFirstChildWhichIsA('Animator', true) :: Animator
		
		CLN_UTILS.SetCollisionGroup(char, 'NPC')

		return char, animator
	end
	
	local rigs = RPS.Assets.Models.NPCs.Rigs:GetChildren()
	local char = Gender and RPS.Assets.Models.NPCs.Rigs:FindFirstChild(Gender) :: Model? or rigs[math.random(1, #rigs)] :: Model
	
	char = char:Clone()
	char:SetAttribute('Type', Category)
	char:SetAttribute('Gender', Gender or char.Name)
	char:ScaleTo(Scale or 1)
	
	local colors = RPS.Assets.Accessories.BodyColors:GetChildren()
	local color = colors[math.random(1, #colors)]:Clone()
	color.Parent = char

	local genderOutfits = RPS.Assets.Accessories.Clothes:FindFirstChild(char.Name) :: Folder
	local outfits = (genderOutfits:FindFirstChild(Category) :: Folder):GetChildren()
	local outfit = outfits[math.random(1, #outfits)]:GetChildren() :: {Accessory | Pants | Shirt}
	
	for _, accessory in outfit do
		if accessory:FindFirstChild('HatAttachment', true) then
			WithoutHair = true
		end
	end

	local hairs = (RPS.Assets.Accessories.Hair:FindFirstChild(char.Name) :: Folder):GetChildren()
	local hair = hairs[math.random(1, #hairs)]:Clone()
	hair:SetAttribute('Hair', true)
	hair.Parent = char
	
	DRS_UTILS.DressUp(char, outfit, 'Outfit', WithoutHair)
	
	CLN_UTILS.SetCollisionGroup(char, 'NPC')
	
	return char, char:FindFirstChildWhichIsA('Animator', true) :: Animator
end

-- change npc type and outfit
function CharacterUtils.ChangeNPCType(Character: Model, NewCategory: CFG_TYPES.NPCCategory, WithoutHair: boolean?)
	local genderOutfits = RPS.Assets.Accessories.Clothes:FindFirstChild(Character:GetAttribute('Gender')) :: Folder
	local outfits = (genderOutfits:FindFirstChild(NewCategory) :: Folder):GetChildren()
	local outfit = outfits[math.random(1, #outfits)]:GetChildren() :: {Accessory | Pants | Shirt}
	
	for _, accessory in outfit do
		if accessory:FindFirstChild('HatAttachment', true) then
			WithoutHair = true
		end
	end

	DRS_UTILS.DressUp(Character, outfit, 'Outfit', WithoutHair)
	Character:SetAttribute('Type', NewCategory)
end

-- convert npc to data
function CharacterUtils.ToData(NPC: Model): DAT_TYPES.NPCData
	local hair: string?
	for _, child in NPC:GetChildren() do
		if child:IsA('Accessory') and child.Name:match('Hair') then
			hair = child.Name
			break
		end
	end
	
	local data: DAT_TYPES.NPCData = {
		Name = NPC.Name,
		Gender = NPC:GetAttribute('Gender'),
		Type = NPC:GetAttribute('Type'),
		BodyColor = (NPC:FindFirstChildOfClass('BodyColors') :: BodyColors).Name,
		Hair = hair
	}
	
	return data
end

-- convert data to npc
function CharacterUtils.ToNPC(Data: DAT_TYPES.NPCData): Model
	local rigs = RPS.Assets.Models.NPCs.Rigs:GetChildren()
	local char = RPS.Assets.Models.NPCs.Rigs:FindFirstChild(Data.Gender) :: Model

	char.Name = Data.Name or Data.Gender
	char = char:Clone()
	char:SetAttribute('Type', Data.Type)
	char:SetAttribute('Gender', Data.Gender)

	local color = (RPS.Assets.Accessories.BodyColors:FindFirstChild(Data.BodyColor) :: BodyColors):Clone()
	color.Parent = char

	if Data.Hair then
		local hair = ((RPS.Assets.Accessories.Hair:FindFirstChild(Data.Gender) :: Folder):FindFirstChild(Data.Hair) :: Accessory):Clone()
		hair.Parent = char
	end

	local genderOutfits = RPS.Assets.Accessories.Clothes:FindFirstChild(char.Name) :: Folder
	local outfits = (genderOutfits:FindFirstChild(Data.Type) :: Folder):GetChildren()
	local outfit = outfits[math.random(1, #outfits)]:GetChildren() :: {Accessory | Pants | Shirt}

	CLN_UTILS.SetCollisionGroup(char, 'NPC')

	DRS_UTILS.DressUp(char, outfit)
	
	return char
end

return CharacterUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1367"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">CollisionUtils</string><string name="ScriptGuid">{31361bf4-0ab9-4985-8527-3815ddff8b2e}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local CollisionUtils = {}

-- open collision group for instance
function CollisionUtils.SetCollisionGroup(Object: Instance, Group: string)
	if Object:IsA('BasePart') then
		Object.CollisionGroup = Group
	end
	
	for _, desc in Object:GetDescendants() do
		if not desc:IsA('BasePart') then
			continue
		end

		desc.CollisionGroup = Group
	end
end

return CollisionUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1368"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">InteractUtils</string><string name="ScriptGuid">{1d6ad156-31f3-4157-96ea-e08d614f2402}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local InteractUtils = {}

-- add a prompt to parent
function InteractUtils.AddPrompt(Parent: Instance, Action: string, Distance: number?): ProximityPrompt
	local prompt = Parent:FindFirstChild('Prompt', true) :: ProximityPrompt?
	
	if prompt then
		prompt.ActionText = Action
		prompt.MaxActivationDistance = Distance or prompt.MaxActivationDistance
		return prompt
	end

	local newAtt = script.PromptAttachment:Clone()
	local newPrompt = newAtt.Prompt
	
	newPrompt.ActionText = Action
	newPrompt.MaxActivationDistance = Distance or newPrompt.MaxActivationDistance
	newAtt.Parent = Parent

	return newPrompt
end

return InteractUtils
