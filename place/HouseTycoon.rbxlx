="SelectionOrder">0</int><string name="SerializedOverrides"></string><token name="Sink">0</token><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>6</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">-1</int64><token name="Style">0</token><bool name="Visible">true</bool><int name="ZIndex">1</int></Properties></Item><Item class="NumberValue" referent="RBX1287"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name">NumValue</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64><double name="Value">0</double></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBX1289"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Invasion</string><string name="ScriptGuid">{5ee91b0e-7ed0-491a-ace9-28cb11de68a7}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Invasion = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local SDS = game:GetService('SoundService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)
local IMG_CONFIGS = require(RPS.Modules.Configs.ImageConfigs)

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui

local gui = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local invasion = gui:WaitForChild('Invasion')

-- update invasion status
local function updateStatus(Timer: number?)
	local timer = Timer or DAT_Client:get({'Invasion', 'Timer'})
	local active = DAT_Client:get({'Invasion', 'StoredInvasion', 'Active'})
	
	if timer <= 0 or active then
		invasion.Title.Text = 'INVASION!'
		invasion.Icon.Image = IMG_CONFIGS.Invasion.Active
	elseif timer <= 30 then
		invasion.Title.Text = 'Invasion imminent: '..math.ceil(timer)..'s'
		invasion.Icon.Image = IMG_CONFIGS.Invasion.Warning
	else
		invasion.Title.Text = 'Kingdom peaceful'
		invasion.Icon.Image = IMG_CONFIGS.Invasion.Peace
	end
end

-- initialize invasion interface
function Invasion:Init()
	local gold = DAT_Client:get('Gold')
	updateStatus()
	
	RPS.Remotes.InvasionService.UpdateTimer.OnClientEvent:Connect(updateStatus)
end

return Invasion
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1290"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Upgrade</string><string name="ScriptGuid">{f7b1ac6d-7a8b-4fea-a6ec-4b4ed462f36b}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
