-- Types.
export type Signal<Parameters...> = {
	Connect: typeof(
		-- Connects a function.
		function(signal: Signal<Parameters...>, callback: (Parameters...) -> ()): Connection end
	),
	Once: typeof(
		-- Connects a function, then auto-disconnects after the first call.
		function(signal: Signal<Parameters...>, callback: (Parameters...) -> ()): Connection end
	),
	Wait: typeof(
		-- Yields the calling thread until the next fire.
		function(signal: Signal<Parameters...>): Parameters... end
	),
	
	Fire: typeof(
		-- Runs all connected functions and resumes all waiting threads.
		function(signal: Signal<Parameters...>, ...: Parameters...) end
	),
	
	DisconnectAll: typeof(
		-- Erases all connections.
		-- <strong>Much faster than calling <code>Disconnect</code> on each.</strong>
		function(signal: Signal<Parameters...>) end
	),
	Destroy: typeof(
		-- Erases all connections and methods.
		-- <strong>To fully erase, also remove all references to the signal.</strong>
		function(signal: Signal<Parameters...>) end
	)
}
export type Connection = {
	Signal: Signal,
	Connected: boolean,
	Disconnect: typeof(
		-- Removes the connection from the signal.
		-- <strong>The connection’s data remains.</strong>
		function(connection: Connection) end
	)
}
type CreateSignal = typeof(
	-- Creates a new signal.
	function(): Signal end
)

-- Spawn function.
local spawnThread = if script:GetAttribute("Deferred") then task.defer else task.spawn

-- Setup reusable callback threads.
local threads = {}

local function reusableThreadCall(callback, thread, ...)
	callback(...)
	table.insert(threads, thread)
end
local function reusableThread()
	while true do
		reusableThreadCall(coroutine.yield())
	end
end

-- Connection methods.
local function disconnect(connection)
	-- Verify connection.
	if not connection.Connected then return end
	
	-- Remove connection.
	connection.Connected = nil
	
	local signal = connection.Signal
	local previous = connection.Previous
	local next = connection.Next
	if previous then
		previous.Next = next
	else
		signal.Tail = next
	end
	if next then
		next.Previous = previous
	else
		signal.Head = previous
	end
end

-- Signal methods.
local Signal = {}
Signal.__index = Signal

Signal.Connect = function(signal, callback)
	-- Linked list head.
	local head = signal.Head
	
	-- Create connection.
	local connection = {
		Signal = signal,
		Previous = head,
		
		Callback = callback,
		
		Connected = true,
		Disconnect = disconnect
	}
	
	-- Add connection.
	if head then
		head.Next = connection
	else
		signal.Tail = connection
	end
	signal.Head = connection
	
	-- Return connection.
	return connection
end
Signal.Once = function(signal, callback)
	-- Linked list head.
	local head = signal.Head
	
	-- Create connection.
	local connection
	connection = {
		Signal = signal,
		Previous = head,
		
		Callback = function(...)
			-- Verify connection.
			if not connection.Connected then return end
			
			-- Remove connection.
			connection.Connected = false
			
			local previous = connection.Previous
			local next = connection.Next
			if previous then
				previous.Next = next
			else
				signal.Tail = next
			end
			if next then
				next.Previous = previous
			else
				signal.Head = previous
			end
			
			-- Fire callback.
			callback(...)
		end,
		
		Connected = true,
		Disconnect = disconnect
	}
	
	-- Add connection.
	if head then
		head.Next = connection
	else
		signal.Tail = connection
	end
	signal.Head = connection
	
	-- Return connection.
	return connection
end
Signal.Wait = function(signal)
	-- Save this thread to resume later.
	local thread = coroutine.running()
	
	-- Linked list head.
	local head = signal.Head
	
	-- Create connection.
	local connection
	connection = {
		Previous = head,
		
		Callback = function(...)
			-- Remove connection.
			connection.Connected = false
			
			local previous = connection.Previous
			local next = connection.Next
			if previous then
				previous.Next = next
			else
				signal.Tail = next
			end
			if next then
				next.Previous = previous
			else
				signal.Head = previous
			end
			
			-- Resume the thread.
			if coroutine.status(thread) == "suspended" then -- To avoid creating new threads.
				task.spawn(thread, ...)
			end
		end
	}
	
	-- Add connection.
	if head then
		head.Next = connection
	else
		signal.Tail = connection
	end
	signal.Head = connection
	
	-- Yield until the next fire, then return the arguments on resume.
	return coroutine.yield()
end

Signal.Fire = function(signal, ...)
	local connection = signal.Tail -- Start from the tail (back) of the list.
	while connection do
		-- Find or create a thread, then run the callback in it.
		local length = #threads
		if length == 0 then
			local thread = coroutine.create(reusableThread)
			coroutine.resume(thread) -- Initialize.
			spawnThread(thread, connection.Callback, thread, ...)
		else
			local thread = threads[length]
			threads[length] = nil -- Remove from free threads list.
			spawnThread(thread, connection.Callback, thread, ...)
		end
		-- Traverse.
		connection = connection.Next
	end
end

Signal.DisconnectAll = function(signal)
	-- Remove all connections.
	local connection = signal.Tail
	while connection do
		-- Save next connection.
		local nextConnection = connection.Next
		-- Remove data and pointers.
		connection.Connected = nil
		connection.Next = nil
		connection.Previous = nil
		-- Traverse.
		connection = nextConnection
	end
	-- Remove signal’s references.
	signal.Tail = nil
	signal.Head = nil
end
Signal.Destroy = function(signal)
	-- Remove all connections.
	local connection = signal.Tail
	while connection do
		-- Save next connection.
		local nextConnection = connection.Next
		-- Remove data and pointers.
		connection.Connected = nil
		connection.Next = nil
		connection.Previous = nil
		-- Traverse.
		connection = nextConnection
	end
	-- Remove signal’s references.
	signal.Tail = nil
	signal.Head = nil
	
	-- Unlink signal methods.
	setmetatable(signal, nil)
end

-- Signal creation function.
return function()
	return setmetatable({}, Signal) -- New blank table linked to the signal methods.
end :: CreateSignal]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW54"><Properties><string name="Name">Services</string></Properties><Item class="Folder" referent="NEW26"><Properties><string name="Name">BuildService</string></Properties><Item class="ModuleScript" referent="NEW22"><Properties><string name="Name">BuildCameraClient</string><ProtectedString name="Source"><![CDATA[--!strict
-- top-down camera while building: WASD / arrows pan, scroll zooms, Q / E or right-drag rotates
local BuildCameraClient = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')
local UIS = game:GetService('UserInputService')
local RNS = game:GetService('RunService')

local BLD_CSignals = require(script.Parent.BuildClientSignals)
local PLT_Client = require(RPS.Modules.Services.PlotService.PlotServiceClient)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)

local plr = PLS.LocalPlayer

local MIN_DISTANCE, MAX_DISTANCE = 25, 260
local MIN_PITCH, MAX_PITCH = math.rad(30), math.rad(85)
local PAN_SPEED = 1.1 -- studs per frame per 50 studs of zoom
local ROTATE_SPEED = math.rad(1.6)
local MOUSE_ROTATE = 0.005

local active = false
local level = 1
local focus = Vector3.zero
local yaw = 0
local pitch = math.rad(55)
local distance = 90
local rotating = false

-- the default character controls (walking is turned off while building)
local function getControls(): any?
	local playerScripts = plr:FindFirstChild('PlayerScripts')
	local module = playerScripts and playerScripts:FindFirstChild('PlayerModule')

	if not module or not module:IsA('ModuleScript') then
		return nil
	end

	local success, controls = pcall(function()
		return (require(module) :: any):GetControls()
	end)

	return if success then controls else nil
end

-- keep the focus point on the land
local function clampFocus()
	local origin = PLT_Client:GetOrigin()

	if not origin then
		return
	end

	local size = GRD_UTILS.LandStuds

	focus = Vector3.new(
		math.clamp(focus.X, origin.X - 20, origin.X + size + 20),
		origin.Y + GRD_UTILS.LevelHeight(level),
		math.clamp(focus.Z, origin.Z - 20, origin.Z + size + 20)
	)
end

-- start the build camera above the player
local function enter()
	local camera = WKS.CurrentCamera
	local character = plr.Character
	local root = character and character:FindFirstChild('HumanoidRootPart')

	focus = if root and root:IsA('BasePart') then root.Position else camera.Focus.Position

	-- face the same way the normal camera was facing
	local look = camera.CFrame.LookVector
	yaw = math.atan2(-look.X, -look.Z)

	clampFocus()

	camera.CameraType = Enum.CameraType.Scriptable

	local controls = getControls()

	if controls then
		controls:Disable()
	end
end

-- give the camera and walking back
local function exit()
	local camera = WKS.CurrentCamera
	camera.CameraType = Enum.CameraType.Custom

	UIS.MouseBehavior = Enum.MouseBehavior.Default
	rotating = false

	local controls = getControls()

	if controls then
		controls:Enable()
	end
end

-- move the camera every frame
local function update(DT: number)
	if not active then
		return
	end

	local scale = DT * 60
	local move = Vector3.zero

	if not UIS:GetFocusedTextBox() then
		if UIS:IsKeyDown(Enum.KeyCode.W) or UIS:IsKeyDown(Enum.KeyCode.Up) then move += Vector3.new(0, 0, -1) end
		if UIS:IsKeyDown(Enum.KeyCode.S) or UIS:IsKeyDown(Enum.KeyCode.Down) then move += Vector3.new(0, 0, 1) end
		if UIS:IsKeyDown(Enum.KeyCode.A) or UIS:IsKeyDown(Enum.KeyCode.Left) then move += Vector3.new(-1, 0, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.D) or UIS:IsKeyDown(Enum.KeyCode.Right) then move += Vector3.new(1, 0, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.Q) then yaw += ROTATE_SPEED * scale end
		if UIS:IsKeyDown(Enum.KeyCode.E) then yaw -= ROTATE_SPEED * scale end
	end

	if move.Magnitude > 0 then
		local direction = CFrame.Angles(0, yaw, 0):VectorToWorldSpace(move.Unit)
		focus += direction * PAN_SPEED * (distance / 50) * scale
	end

	clampFocus()

	local offset = CFrame.Angles(0, yaw, 0) * CFrame.Angles(-pitch, 0, 0) * Vector3.new(0, 0, distance)

	WKS.CurrentCamera.CFrame = CFrame.lookAt(focus + offset, focus)
end

-- jump the camera to a world position (e.g. a house from the Houses panel)
function BuildCameraClient:FocusOn(Position: Vector3)
	focus = Position
	clampFocus()
end

-- initialize build camera client-side
function BuildCameraClient:Init()
	BLD_CSignals.ModeChanged:Connect(function(Mode)
		local wasActive = active
		active = Mode ~= 'None'

		if active and not wasActive then
			enter()
		elseif wasActive and not active then
			exit()
		end
	end)

	BLD_CSignals.LevelChanged:Connect(function(Level)
		level = Level
		clampFocus()
	end)

	UIS.InputBegan:Connect(function(Input, Processed)
		if active and not Processed and Input.UserInputType == Enum.UserInputType.MouseButton2 then
			rotating = true
			UIS.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		end
	end)

	UIS.InputEnded:Connect(function(Input)
		if Input.UserInputType == Enum.UserInputType.MouseButton2 and rotating then
			rotating = false
			UIS.MouseBehavior = Enum.MouseBehavior.Default
		end
	end)

	UIS.InputChanged:Connect(function(Input, Processed)
		if not active then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseWheel and not Processed then
			distance = math.clamp(distance * (1 - Input.Position.Z * 0.12), MIN_DISTANCE, MAX_DISTANCE)
		elseif Input.UserInputType == Enum.UserInputType.MouseMovement and rotating then
			yaw -= Input.Delta.X * MOUSE_ROTATE
			pitch = math.clamp(pitch + Input.Delta.Y * MOUSE_ROTATE, MIN_PITCH, MAX_PITCH)
		end
	end)

	RNS:BindToRenderStep('BuildCamera', Enum.RenderPriority.Camera.Value + 1, update)
end

return BuildCameraClient
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW23"><Properties><string name="Name">BuildClientSignals</string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)

export type BuildMode = 'None' | 'Room' | 'Wall' | 'Door' | 'Window' | 'Floor' | 'Paint' | 'Furniture' | 'Edit' | 'Erase'

local BuildClientSignals = {
	-- UI asks for a tool: (mode, option, option)
	-- Room: (wall style, floor style)  Wall: (wall style)  Floor: (floor style)
	-- Paint: ('Wall' or 'Floor', style)  Furniture: (item name)
	ModeRequested = Signal() :: Signal.Signal<BuildMode, string?, string?>,

	-- the tool that is now active
	ModeChanged = Signal() :: Signal.Signal<BuildMode, string?, string?>,

	-- the floor being built on
	LevelChanged = Signal() :: Signal.Signal<number>,

	-- cost of what is being previewed (nil hides it)
	CostChanged = Signal() :: Signal.Signal<number?>,
}

return BuildClientSignals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW24"><Properties><string name="Name">BuildServiceClient</string><ProtectedString name="Source"><![CDATA[--!strict
local BuildServiceClient = {}

local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')
local UIS = game:GetService('UserInputService')
local RNS = game:GetService('RunService')

local BLD_CSignals = require(script.Parent.BuildClientSignals)
local DAT_Client = require(RPS.Modules.Packages.DataService).client
local PLT_Client = require(RPS.Modules.Services.PlotService.PlotServiceClient)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local BLD_UTILS = require(RPS.Modules.Utils.BuildUtils)
local HSE_UTILS = require(RPS.Modules.Utils.HouseUtils)
local LND_UTILS = require(RPS.Modules.Utils.LandUtils)
local INP_UTILS = require(RPS.Modules.Utils.InputUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local remotes = RPS.Remotes.BuildService
local furnitureRemotes = RPS.Remotes.FurnitureService

local GHOST_COLOR = Color3.fromRGB(120, 200, 255)
local GOOD_COLOR = Color3.fromRGB(90, 210, 120)
local BAD_COLOR = Color3.fromRGB(235, 80, 80)
local PAINT_INTERVAL = 0.12

type BuildMode = BLD_CSignals.BuildMode

-- tools that drag out a shape on the grid
local DRAG_TOOLS: {[string]: boolean} = {Room = true, Wall = true, Floor = true}

-- tools that click on existing pieces
local CLICK_TOOLS: {[string]: boolean} = {Door = true, Window = true, Paint = true, Erase = true}

local mode: BuildMode = 'None'
local level = 1
local wallStyle = 'Plaster'
local floorStyle = 'Wood'
local paintTarget = 'Wall'
local paintStyle = 'Plaster'

local dragging = false
local dragStartX, dragStartZ = 0, 0
local dragEndX, dragEndZ = 0, 0
local previewKey = ''

local ghosts: Folder
local marker: Part
local hover: Highlight
local hoverTarget: Instance?
local lastActed: Instance?
local lastActTime = 0

-- check the active tool belongs to this service
local function isBuildTool(): boolean
	return DRAG_TOOLS[mode] == true or CLICK_TOOLS[mode] == true
end

-- remove every preview piece
local function clearPreview()
	ghosts:ClearAllChildren()
	previewKey = ''
	marker.Parent = nil
	hover.Adornee = nil
	hoverTarget = nil
end

-- the land / level data the player is editing
local function getLevelData(): DAT_TYPES.LevelData
	return HSE_UTILS.GetLevel(DAT_Client:get('Land'), level)
end

-- initialize build service client-side
function BuildServiceClient:Init()
	local previewFolder = Instance.new('Folder')
	previewFolder.Name = 'BuildPreview'
	previewFolder.Parent = WKS

	ghosts = Instance.new('Folder')
	ghosts.Name = 'Ghosts'
	ghosts.Parent = previewFolder

	marker = Instance.new('Part')
	marker.Name = 'Marker'
	marker.Anchored = true
	marker.CanCollide = false
	marker.CanQuery = false
	marker.CanTouch = false
	marker.CastShadow = false
	marker.Material = Enum.Material.Neon
	marker.Color = GHOST_COLOR
	marker.Transparency = 0.35

	hover = Instance.new('Highlight')
	hover.FillTransparency = 0.45
	hover.DepthMode = Enum.HighlightDepthMode.Occluded
	hover.Parent = previewFolder

	BLD_CSignals.ModeRequested:Connect(function(Mode, OptionA, OptionB)
		BuildServiceClient:SetMode(Mode, OptionA, OptionB)
	end)

	RNS.RenderStepped:Connect(function()
		BuildServiceClient:Update()
	end)

	UIS.InputBegan:Connect(function(Input, Processed)
		if Processed then
			return
		end

		local ctrl = UIS:IsKeyDown(Enum.KeyCode.LeftControl) or UIS:IsKeyDown(Enum.KeyCode.RightControl)

		if INP_UTILS.IsPress(Input) then
			BuildServiceClient:Press()
		elseif mode == 'None' then
			return
		elseif Input.KeyCode == Enum.KeyCode.Z and ctrl then
			BuildServiceClient:Undo()
		elseif Input.KeyCode == Enum.KeyCode.PageUp then
			BuildServiceClient:SetLevel(level + 1)
		elseif Input.KeyCode == Enum.KeyCode.PageDown then
			BuildServiceClient:SetLevel(level - 1)
		elseif Input.KeyCode == Enum.KeyCode.Escape and isBuildTool() then
			BuildServiceClient:SetMode('None')
		end
	end)

	UIS.InputEnded:Connect(function(Input)
		if INP_UTILS.IsPress(Input) then
			BuildServiceClient:Release()
		end
	end)
end

-- get the active tool
function BuildServiceClient:GetMode(): BuildMode
	return mode
end

-- switch tool (every service listens to ModeChanged)
function BuildServiceClient:SetMode(Mode: BuildMode, OptionA: string?, OptionB: string?)
	dragging = false
	clearPreview()

	if Mode == 'Room' then
		wallStyle = if OptionA and BLD_CONFIGS.WallStyles[OptionA] then OptionA else wallStyle
		floorStyle = if OptionB and BLD_CONFIGS.FloorStyles[OptionB] then OptionB else floorStyle
	elseif Mode == 'Wall' then
		wallStyle = if OptionA and BLD_CONFIGS.WallStyles[OptionA] then OptionA else wallStyle
	elseif Mode == 'Floor' then
		floorStyle = if OptionA and BLD_CONFIGS.FloorStyles[OptionA] then OptionA else floorStyle
	elseif Mode == 'Paint' then
		paintTarget = if OptionA == 'Floor' then 'Floor' else 'Wall'

		local styles: {[string]: any} = if paintTarget == 'Floor' then BLD_CONFIGS.FloorStyles else BLD_CONFIGS.WallStyles

		if OptionB and styles[OptionB] then
			paintStyle = OptionB
		elseif not styles[paintStyle] then
			paintStyle = if paintTarget == 'Floor' then floorStyle else wallStyle
		end
	end

	mode = Mode

	BLD_CSignals.CostChanged:Fire(nil)
	BLD_CSignals.ModeChanged:Fire(Mode, OptionA, OptionB)
end

-- current picks (for the UI)
function BuildServiceClient:GetStyles(): (string, string, string, string)
	return wallStyle, floorStyle, paintTarget, paintStyle
end

-- get the floor being built on
function BuildServiceClient:GetLevel(): number
	return level
end

-- change the floor being built on (only unlocked floors)
function BuildServiceClient:SetLevel(Level: number)
	local newLevel = math.clamp(Level, 1, DAT_Client:get('Levels'))

	if newLevel == level then
		return
	end

	dragging = false
	clearPreview()

	level = newLevel
	BLD_CSignals.LevelChanged:Fire(level)
end

-- undo the last build action
function BuildServiceClient:Undo()
	remotes.Undo:FireServer()
end

-- grid point / cell under the pointer on the current floor
local function pointerHit(): (Vector3?, Vector3?)
	local origin = PLT_Client:GetOrigin()

	if not origin then
		return nil, nil
	end

	return origin, INP_UTILS.HitPlane(origin.Y + GRD_UTILS.LevelHeight(level))
end

-- follow the pointer every frame
function BuildServiceClient:Update()
	if not isBuildTool() or not PLT_Client:IsReady() then
		return
	end

	if CLICK_TOOLS[mode] then
		BuildServiceClient:UpdateHover()
		return
	end

	local origin, hit = pointerHit()

	if not origin or not hit then
		marker.Parent = nil
		return
	end

	local size = GRD_UTILS.LandCells
	local maxCells = BLD_CONFIGS.MaxDragCells
	local cellSize = BLD_CONFIGS.CellSize

	if mode == 'Wall' then
		local px, pz = GRD_UTILS.WorldToPoint(origin, hit)
		px, pz = math.clamp(px, 0, size), math.clamp(pz, 0, size)

		if dragging then
			-- walls only go in straight lines, along the axis moved most
			local dx, dz = px - dragStartX, pz - dragStartZ

			if math.abs(dx) >= math.abs(dz) then
				px, pz = dragStartX + math.clamp(dx, -maxCells, maxCells), dragStartZ
			else
				px, pz = dragStartX, dragStartZ + math.clamp(dz, -maxCells, maxCells)
			end

			dragEndX, dragEndZ = px, pz
			BuildServiceClient:DrawWallPreview(origin)
		end

		marker.Size = Vector3.new(1.2, 1.2, 1.2)
		marker.Shape = Enum.PartType.Ball
		marker.CFrame = CFrame.new(GRD_UTILS.PointToWorld(origin, px, pz, level) + Vector3.new(0, 0.8, 0))
	else
		local cx, cz = GRD_UTILS.WorldToCell(origin, hit)
		cx, cz = math.clamp(cx, 0, size - 1), math.clamp(cz, 0, size - 1)

		if dragging then
			cx = math.clamp(cx, dragStartX - maxCells + 1, dragStartX + maxCells - 1)
			cz = math.clamp(cz, dragStartZ - maxCells + 1, dragStartZ + maxCells - 1)

			dragEndX, dragEndZ = cx, cz

			if mode == 'Room' then
				BuildServiceClient:DrawRoomPreview(origin)
			else
				BuildServiceClient:DrawFloorPreview(origin)
			end
		end

		marker.Size = Vector3.new(cellSize - 0.4, 0.15, cellSize - 0.4)
		marker.Shape = Enum.PartType.Block
		marker.CFrame = CFrame.new(GRD_UTILS.CellToWorld(origin, cx, cz, level) + Vector3.new(0, BLD_CONFIGS.FloorThickness + 0.1, 0))
	end

	marker.Parent = ghosts.Parent
end

-- add see-through walls on edges, returns what they cost
local function ghostWalls(Origin: Vector3, Edges: {string}, Wall: DAT_TYPES.WallData, KeepExisting: boolean): number
	local levelData = getLevelData()
	local parcels = DAT_Client:get('Parcels')
	local cost = 0

	for _, edge in Edges do
		local old = levelData.Walls[edge]

		if KeepExisting and old then
			continue
		end

		local owned = LND_UTILS.IsEdgeOwned(parcels, edge)
		local model = BLD_UTILS.CreateWall(Origin, level, edge, Wall)
		BLD_UTILS.MakeGhost(model, if owned then GHOST_COLOR else BAD_COLOR)
		model.Parent = ghosts

		if not old or old.Kind ~= Wall.Kind or old.Style ~= Wall.Style then
			cost += BLD_UTILS.GetWallCost(Wall)
		end
	end

	return cost
end

-- add see-through floor tiles, returns what they cost
local function ghostFloors(Origin: Vector3, Cells: {string}, Style: string): number
	local levelData = getLevelData()
	local parcels = DAT_Client:get('Parcels')
	local config = BLD_CONFIGS.FloorStyles[Style]
	local cost = 0

	for _, cell in Cells do
		local floor = BLD_UTILS.CreateFloor(Origin, level, cell, Style)
		floor.Transparency = 0.35
		floor.CanCollide = false
		floor.CanQuery = false
		floor.CanTouch = false

		if not LND_UTILS.IsCellOwned(parcels, cell) then
			floor.Color = BAD_COLOR
		end

		floor.Parent = ghosts

		if levelData.Floors[cell] ~= Style then
			cost += config.Cost
		end
	end

	return cost
end

-- draw see-through walls along the drag line and show the cost
function BuildServiceClient:DrawWallPreview(Origin: Vector3)
	local key = `W{level}_{dragStartX}_{dragStartZ}_{dragEndX}_{dragEndZ}_{wallStyle}`

	if key == previewKey then
		return
	end

	previewKey = key
	ghosts:ClearAllChildren()

	local edges = GRD_UTILS.EdgesBetween(dragStartX, dragStartZ, dragEndX, dragEndZ)
	local cost = ghostWalls(Origin, edges, {Kind = 'Wall', Style = wallStyle}, false)

	BLD_CSignals.CostChanged:Fire(if cost > 0 then cost else nil)
end

-- draw see-through floor over the drag rectangle and show the cost
function BuildServiceClient:DrawFloorPreview(Origin: Vector3)
	local key = `F{level}_{dragStartX}_{dragStartZ}_{dragEndX}_{dragEndZ}_{floorStyle}`

	if key == previewKey then
		return
	end

	previewKey = key
	ghosts:ClearAllChildren()

	local cost = ghostFloors(Origin, GRD_UTILS.CellsBetween(dragStartX, dragStartZ, dragEndX, dragEndZ), floorStyle)

	BLD_CSignals.CostChanged:Fire(if cost > 0 then cost else nil)
end

-- draw a whole room (floor, walls around it and the front door)
function BuildServiceClient:DrawRoomPreview(Origin: Vector3)
	local key = `R{level}_{dragStartX}_{dragStartZ}_{dragEndX}_{dragEndZ}_{wallStyle}_{floorStyle}`

	if key == previewKey then
		return
	end

	previewKey = key
	ghosts:ClearAllChildren()

	local minX, maxX = math.min(dragStartX, dragEndX), math.max(dragStartX, dragEndX)
	local minZ, maxZ = math.min(dragStartZ, dragEndZ), math.max(dragStartZ, dragEndZ)

	local cost = ghostFloors(Origin, GRD_UTILS.CellsBetween(minX, minZ, maxX, maxZ), floorStyle)

	local doorEdge = GRD_UTILS.EdgeKey('X', math.floor((minX + maxX) / 2), maxZ + 1)
	local walls: {string} = {}

	for _, edge in GRD_UTILS.EdgesBetween(minX, minZ, maxX + 1, minZ) do
		table.insert(walls, edge)
	end

	for _, edge in GRD_UTILS.EdgesBetween(minX, maxZ + 1, maxX + 1, maxZ + 1) do
		if edge ~= doorEdge then
			table.insert(walls, edge)
		end
	end

	for _, edge in GRD_UTILS.EdgesBetween(minX, minZ, minX, maxZ + 1) do
		table.insert(walls, edge)
	end

	for _, edge in GRD_UTILS.EdgesBetween(maxX + 1, minZ, maxX + 1, maxZ + 1) do
		table.insert(walls, edge)
	end

	cost += ghostWalls(Origin, walls, {Kind = 'Wall', Style = wallStyle}, true)

	if not getLevelData().Walls[doorEdge] then
		cost += ghostWalls(Origin, {doorEdge}, {Kind = 'Door', Style = wallStyle}, true)
	end

	BLD_CSignals.CostChanged:Fire(if cost > 0 then cost else nil)
end

-- find the piece (wall model, floor part or furniture model) a part belongs to
local function getPiece(Hit: Instance): Instance?
	local current: Instance? = Hit

	while current and current:GetAttribute('Piece') == nil do
		current = current.Parent
	end

	return current
end

-- which piece folders the click tools can hit
local function getClickFolders(): {Instance}
	local names = if mode == 'Erase' then {'Walls', 'Floors', 'Furniture'}
		elseif mode == 'Paint' and paintTarget == 'Floor' then {'Floors'}
		else {'Walls'}

	local folders: {Instance} = {}

	for _, name in names do
		local folder = PLT_Client:GetPieceFolder(level, name)

		if folder then
			table.insert(folders, folder)
		end
	end

	return folders
end

-- highlight what the click tool is pointing at (and keep acting while held)
function BuildServiceClient:UpdateHover()
	local result = INP_UTILS.RaycastInclude(getClickFolders())
	local target = result and getPiece(result.Instance)

	hoverTarget = target
	hover.Adornee = target

	local color = if mode == 'Erase' then BAD_COLOR else GOOD_COLOR
	hover.FillColor = color
	hover.OutlineColor = color

	-- show what clicking would cost
	if target and mode ~= 'Erase' then
		BLD_CSignals.CostChanged:Fire(BuildServiceClient:GetClickCost(target))
	else
		BLD_CSignals.CostChanged:Fire(nil)
	end

	if dragging and target and target ~= lastActed then
		BuildServiceClient:ActOnTarget()
	end
end

-- cost of using the click tool on a piece
function BuildServiceClient:GetClickCost(Target: Instance): number?
	local levelData = getLevelData()

	if Target:GetAttribute('Piece') == 'Wall' then
		local old = levelData.Walls[Target.Name]

		if not old then
			return nil
		end

		local kind = if mode == 'Door' then 'Door' elseif mode == 'Window' then 'Window' else old.Kind
		local style = if mode == 'Paint' then paintStyle else old.Style

		return BLD_UTILS.GetWallCost({Kind = kind :: any, Style = style})
	elseif Target:GetAttribute('Piece') == 'Floor' then
		local config = BLD_CONFIGS.FloorStyles[paintStyle]

		return if config then config.Cost else nil
	end

	return nil
end

-- use the click tool on the piece under the pointer
function BuildServiceClient:ActOnTarget()
	local target = hoverTarget
	local now = os.clock()

	if not target or now - lastActTime < PAINT_INTERVAL then
		return
	end

	lastActed = target
	lastActTime = now

	local piece = target:GetAttribute('Piece')
	local key = target.Name

	if mode == 'Erase' then
		if piece == 'Wall' or piece == 'Floor' then
			remotes.RemovePiece:FireServer(level, piece, key)
		elseif piece == 'Furniture' then
			furnitureRemotes.RemoveFurniture:FireServer(key)
		end

		return
	end

	if piece == 'Wall' then
		local old = getLevelData().Walls[key]

		if not old then
			return
		end

		local kind = if mode == 'Door' then 'Door' elseif mode == 'Window' then 'Window' else old.Kind
		local style = if mode == 'Paint' then paintStyle else old.Style

		-- clicking a door with the door tool turns it back into a wall
		if (mode == 'Door' or mode == 'Window') and old.Kind == kind then
			kind = 'Wall'
		end

		local ax, az, bx, bz = GRD_UTILS.EdgePoints(key)
		remotes.PlaceWalls:FireServer(level, kind, style, ax, az, bx, bz)

	elseif piece == 'Floor' and mode == 'Paint' then
		local x, z = GRD_UTILS.ParseCellKey(key)
		remotes.PlaceFloors:FireServer(level, paintStyle, x, z, x, z)
	end
end

-- pointer pressed: start a drag
function BuildServiceClient:Press()
	if not isBuildTool() or not PLT_Client:IsReady() then
		return
	end

	if CLICK_TOOLS[mode] then
		dragging = true
		lastActed = nil
		BuildServiceClient:ActOnTarget()
		return
	end

	local origin, hit = pointerHit()

	if not origin or not hit then
		return
	end

	local size = GRD_UTILS.LandCells

	if mode == 'Wall' then
		local px, pz = GRD_UTILS.WorldToPoint(origin, hit)

		dragStartX, dragStartZ = math.clamp(px, 0, size), math.clamp(pz, 0, size)
	else
		local cx, cz = GRD_UTILS.WorldToCell(origin, hit)

		dragStartX, dragStartZ = math.clamp(cx, 0, size - 1), math.clamp(cz, 0, size - 1)
	end

	dragEndX, dragEndZ = dragStartX, dragStartZ
	previewKey = ''
	dragging = true
end

-- pointer released: send what was dragged out to the server
function BuildServiceClient:Release()
	if not dragging then
		return
	end

	dragging = false

	if mode == 'Wall' then
		if dragStartX ~= dragEndX or dragStartZ ~= dragEndZ then
			remotes.PlaceWalls:FireServer(level, 'Wall', wallStyle, dragStartX, dragStartZ, dragEndX, dragEndZ)
		end
	elseif mode == 'Floor' then
		remotes.PlaceFloors:FireServer(level, floorStyle, dragStartX, dragStartZ, dragEndX, dragEndZ)
	elseif mode == 'Room' then
		remotes.PlaceRoom:FireServer(level, wallStyle, floorStyle, dragStartX, dragStartZ, dragEndX, dragEndZ)
	end

	ghosts:ClearAllChildren()
	previewKey = ''

	if DRAG_TOOLS[mode] then
		BLD_CSignals.CostChanged:Fire(nil)
	end
end

return BuildServiceClient
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW25"><Properties><string name="Name">BuildViewClient</string><ProtectedString name="Source"><![CDATA[--!strict
-- while building: hides the floors above the one being edited and shows which tiles are lit
local BuildViewClient = {}

local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')

local BLD_CSignals = require(script.Parent.BuildClientSignals)
local HSE_CSignals = require(RPS.Modules.Services.HouseService.HouseClientSignals)
local HSE_Client = require(RPS.Modules.Services.HouseService.HouseServiceClient)
local PLT_Client = require(RPS.Modules.Services.PlotService.PlotServiceClient)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local DAT_Client = require(RPS.Modules.Packages.DataService).client
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)

local LIT_COLOR = Color3.fromRGB(255, 220, 90)
local DARK_COLOR = Color3.fromRGB(30, 40, 90)

local active = false
local level = 1
local lightView = true

local overlay: Folder
local grid: Folder
local hiddenParts: {[BasePart]: boolean} = {}
local landConnection: RBXScriptConnection?

-- the floor number a part is on (from its Lx folder)
local function getPartLevel(Part: Instance, Land: Folder): number?
	local current: Instance? = Part

	while current and current.Parent ~= Land do
		current = current.Parent
	end

	if not current then
		return nil
	end

	return tonumber(string.match(current.Name, '^L(%d+)$'))
end

-- folders whose parts go see-through on the floor being edited (so you can see inside rooms)
local SEE_THROUGH: {[string]: boolean} = {Walls = true, Posts = true}
local WALL_FADE = 0.65

-- hide a part above the floor being edited, fade the walls on it
local function checkPart(Part: Instance, Land: Folder)
	if not Part:IsA('BasePart') or not active then
		return
	end

	local partLevel = getPartLevel(Part, Land)

	if not partLevel then
		return
	end

	if partLevel > level then
		Part.LocalTransparencyModifier = 1
		hiddenParts[Part] = true
	elseif partLevel == level then
		local kind = Part:FindFirstAncestorWhichIsA('Folder')

		-- the piece folder (Walls / Posts) sits right under the level folder
		while kind and kind.Parent and kind.Parent.Parent ~= Land do
			kind = kind.Parent:FindFirstAncestorWhichIsA('Folder')
		end

		if kind and SEE_THROUGH[kind.Name] then
			Part.LocalTransparencyModifier = WALL_FADE
			hiddenParts[Part] = true
		end
	end
end

-- show everything again, then hide the floors above
local function refreshHidden()
	for part in hiddenParts do
		part.LocalTransparencyModifier = 0
	end

	hiddenParts = {}

	local land = PLT_Client:GetLandFolder()

	if not land or not active then
		return
	end

	for current = level, LND_CONFIGS.MaxLevels do
		local levelFolder = land:FindFirstChild(`L{current}`)

		if levelFolder then
			for _, descendant in levelFolder:GetDescendants() do
				checkPart(descendant, land)
			end
		end
	end
end

-- draw lit / dark tiles for the rooms on the floor being edited
local function refreshOverlay()
	overlay:ClearAllChildren()

	local origin = PLT_Client:GetOrigin()

	if not active or not lightView or not origin then
		return
	end

	local size = BLD_CONFIGS.CellSize
	local height = BLD_CONFIGS.FloorThickness + 0.06

	for _, house in HSE_Client:GetHouses() do
		for _, room in house.Rooms do
			if room.Level ~= level then
				continue
			end

			for _, cell in room.Cells do
				local x, z = GRD_UTILS.ParseCellKey(cell)
				local lit = room.LitCells[cell] == true

				local tile = Instance.new('Part')
				tile.Name = cell
				tile.Anchored = true
				tile.CanCollide = false
				tile.CanQuery = false
				tile.CanTouch = false
				tile.CastShadow = false
				tile.Material = Enum.Material.SmoothPlastic
				tile.Color = if lit then LIT_COLOR else DARK_COLOR
				tile.Transparency = if lit then 0.75 else 0.45
				tile.Size = Vector3.new(size - 0.3, 0.05, size - 0.3)
				tile.CFrame = CFrame.new(GRD_UTILS.CellToWorld(origin, x, z, level) + Vector3.new(0, height, 0))
				tile.Parent = overlay
			end
		end
	end
end

-- draw grid lines over every owned parcel on the floor being edited
local function refreshGrid()
	grid:ClearAllChildren()

	local origin = PLT_Client:GetOrigin()

	if not active or not origin then
		return
	end

	local cell = BLD_CONFIGS.CellSize
	local parcelCells = LND_CONFIGS.ParcelCells
	local parcelStuds = parcelCells * cell
	local height = GRD_UTILS.LevelHeight(level) + (if level == 1 then 0.08 else BLD_CONFIGS.FloorThickness + 0.04)

	-- add one thin line
	local function line(Center: Vector3, Size: Vector3, Edge: boolean)
		local part = Instance.new('Part')
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.CastShadow = false
		part.Material = Enum.Material.Neon
		part.Color = if Edge then Color3.fromRGB(120, 200, 255) else Color3.new(1, 1, 1)
		part.Transparency = if Edge then 0.2 else 0.65
		part.Size = Size
		part.CFrame = CFrame.new(Center)
		part.Parent = grid
	end

	for key, owned in DAT_Client:get('Parcels') do
		if not owned then
			continue
		end

		local px, pz = GRD_UTILS.ParseCellKey(key)
		local corner = origin + Vector3.new(px * parcelStuds, height, pz * parcelStuds)

		for index = 0, parcelCells do
			local edge = index == 0 or index == parcelCells
			local width = if edge then 0.25 else 0.1

			line(corner + Vector3.new(index * cell, 0, parcelStuds / 2), Vector3.new(width, 0.05, parcelStuds), edge)
			line(corner + Vector3.new(parcelStuds / 2, 0, index * cell), Vector3.new(parcelStuds, 0.05, width), edge)
		end
	end
end

-- refresh every view
local function refresh()
	refreshHidden()
	refreshOverlay()
	refreshGrid()
end

-- watch the land for new pieces on hidden floors
local function watchLand()
	if landConnection then
		return
	end

	local land = PLT_Client:GetLandFolder()

	if land then
		landConnection = land.DescendantAdded:Connect(function(Descendant)
			checkPart(Descendant, land)
		end)
	end
end

-- turn the lighting heatmap on / off
function BuildViewClient:SetLightView(Enabled: boolean)
	lightView = Enabled
	refreshOverlay()
end

function BuildViewClient:IsLightView(): boolean
	return lightView
end

-- initialize build view client-side
function BuildViewClient:Init()
	overlay = Instance.new('Folder')
	overlay.Name = 'LightOverlay'
	overlay.Parent = WKS

	grid = Instance.new('Folder')
	grid.Name = 'BuildGrid'
	grid.Parent = WKS

	BLD_CSignals.ModeChanged:Connect(function(Mode)
		active = Mode ~= 'None'
		watchLand()
		refresh()
	end)

	BLD_CSignals.LevelChanged:Connect(function(Level)
		level = Level
		refresh()
	end)

	HSE_CSignals.HousesChanged:Connect(function()
		refreshOverlay()
	end)

	task.spawn(function()
		DAT_Client:waitForData()
		DAT_Client:getChangedSignal('Parcels'):Connect(refreshGrid)
	end)
end

return BuildViewClient
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW28"><Properties><string name="Name">CleaningService</string></Properties><Item class="ModuleScript" referent="NEW27"><Properties><string name="Name">CleaningServiceClient</string><ProtectedString name="Source"><![CDATA[--!strict
-- every player's dirt has a Clean prompt; only show the ones on your own land
local CleaningServiceClient = {}

local PLS = game:GetService('Players')
local WKS = game:GetService('Workspace')

local plr = PLS.LocalPlayer

-- hide a Clean prompt that isn't on the local player's land
local function checkPrompt(Prompt: Instance)
	if not Prompt:IsA('ProximityPrompt') or Prompt.Name ~= 'CleanPrompt' then
		return
	end

	-- walk up to the land folder (it has an Owner attribute)
	local current: Instance? = Prompt.Parent

	while current and current:GetAttribute('Owner') == nil do
		current = current.Parent
	end

	Prompt.Enabled = current ~= nil and current:GetAttribute('Owner') == plr.UserId
end

-- initialize cleaning service client-side
function CleaningServiceClient:Init()
	task.spawn(function()
		local houses = WKS:WaitForChild('Houses')

		houses.DescendantAdded:Connect(checkPrompt)

		for _, descendant in houses:GetDescendants() do
			checkPrompt(descendant)
		end
	end)
end

return CleaningServiceClient
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW31"><Properties><string name="Name">FurnitureService</string></Properties><Item class="ModuleScript" referent="NEW29"><Properties><string name="Name">FurnitureClientSignals</string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)

local FurnitureClientSignals = {
	-- id and item name of the selected furniture (nil when nothing is selected)
	SelectionChanged = Signal() :: Signal.Signal<string?, string?>,
}

return FurnitureClientSignals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW30"><Properties><string name="Name">FurnitureServiceClient</string><ProtectedString name="Source"><![CDATA[--!strict
local FurnitureServiceClient = {}

local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')
local UIS = game:GetService('UserInputService')
local RNS = game:GetService('RunService')

local FUR_CSignals = require(script.Parent.FurnitureClientSignals)
local BLD_CSignals = require(RPS.Modules.Services.BuildService.BuildClientSignals)
local DAT_Client = require(RPS.Modules.Packages.DataService).client
local PLT_Client = require(RPS.Modules.Services.PlotService.PlotServiceClient)
local FUR_CONFIGS = require(RPS.Modules.Configs.FurnitureConfigs)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local FUR_UTILS = require(RPS.Modules.Utils.FurnitureUtils)
local BLD_UTILS = require(RPS.Modules.Utils.BuildUtils)
local INP_UTILS = require(RPS.Modules.Utils.InputUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local remotes = RPS.Remotes.FurnitureService

local VALID_COLOR = Color3.fromRGB(90, 210, 120)
local INVALID_COLOR = Color3.fromRGB(235, 80, 80)
local SELECT_COLOR = Color3.fromRGB(255, 220, 90)
local SNAP = 0.5 -- studs

local editing = false
local level = 1

local placingName: string?
local movingId: string?
local preview: Model?
local previewHighlight: Highlight?
local rotation = 0
local placeX, placeZ = 0, 0
local canPlace = false

local selectedId: string?
local selectedModel: Instance?
local selection: Highlight

-- snap a plot-local position to the furniture grid
local function snap(Value: number): number
	return math.floor(Value / SNAP + 0.5) * SNAP
end

-- snap so the footprint's corner sits on a tile corner (stairs)
local function snapToCells(Value: number, Length: number): number
	local size = BLD_CONFIGS.CellSize

	return math.floor((Value - Length / 2) / size + 0.5) * size + Length / 2
end

-- stop showing the placement preview
function FurnitureServiceClient:StopPlacement()
	if preview then
		preview:Destroy()
	end

	preview = nil
	previewHighlight = nil
	placingName = nil
	movingId = nil
	canPlace = false

	BLD_CSignals.CostChanged:Fire(nil)
end

-- clear selection
function FurnitureServiceClient:ClearSelection()
	if not selectedId then
		return
	end

	selectedId = nil
	selectedModel = nil
	selection.Adornee = nil

	FUR_CSignals.SelectionChanged:Fire(nil, nil)
end

-- start placing an item (or moving one when MovingId is given)
function FurnitureServiceClient:StartPlacement(Name: string, MovingId: string?, Rotation: number?)
	FurnitureServiceClient:StopPlacement()

	local config = FUR_CONFIGS.Items[Name]
	local model = FUR_UTILS.CreateModel(Name)

	if not config or not model then
		warn(`[FurnitureServiceClient]: Unknown furniture {Name}`)
		return
	end

	BLD_UTILS.MakeGhost(model)

	local highlight = Instance.new('Highlight')
	highlight.FillTransparency = 0.6
	highlight.OutlineTransparency = 0
	highlight.DepthMode = Enum.HighlightDepthMode.Occluded
	highlight.Parent = model

	model.Name = 'FurniturePreview'
	model.Parent = WKS

	preview = model
	previewHighlight = highlight
	placingName = Name
	movingId = MovingId
	rotation = Rotation or rotation

	if not MovingId then
		BLD_CSignals.CostChanged:Fire(config.Price)
	end

	FurnitureServiceClient:UpdatePreview()
end

-- move the preview to the pointer and colour it by whether it fits
function FurnitureServiceClient:UpdatePreview()
	local model = preview
	local name = placingName

	if not model or not name or not PLT_Client:IsReady() then
		return
	end

	local origin = PLT_Client:GetOrigin()
	local floorHeight = BLD_CONFIGS.FloorThickness + GRD_UTILS.LevelHeight(level)
	local hit = origin and INP_UTILS.HitPlane(origin.Y + floorHeight)

	if not origin or not hit then
		canPlace = false
		return
	end

	local x, z = GRD_UTILS.WorldToLocal(origin, hit)
	local config = FUR_CONFIGS.Items[name]

	if config and config.CellAligned then
		local minX, minZ, maxX, maxZ = FUR_UTILS.GetBounds(name, 0, 0, rotation)
		x, z = snapToCells(x, maxX - minX), snapToCells(z, maxZ - minZ)
	else
		x, z = snap(x), snap(z)
	end

	local land: DAT_TYPES.LandData = DAT_Client:get('Land')

	placeX, placeZ = x, z
	canPlace = FUR_UTILS.CanPlace(land, PLT_Client:GetContext(), name, level, x, z, rotation, movingId)

	FUR_UTILS.PlaceFurniture(
		model,
		GRD_UTILS.LocalToWorld(origin, x, z, level) + Vector3.new(0, BLD_CONFIGS.FloorThickness, 0),
		rotation
	)

	if previewHighlight then
		local color = if canPlace then VALID_COLOR else INVALID_COLOR

		previewHighlight.FillColor = color
		previewHighlight.OutlineColor = color
	end
end

-- place / move the previewed item
function FurnitureServiceClient:Confirm()
	FurnitureServiceClient:UpdatePreview()

	local name = placingName

	if not preview or not name or not canPlace then
		return
	end

	if movingId then
		remotes.MoveFurniture:FireServer(movingId, level, placeX, placeZ, rotation)
		FurnitureServiceClient:StopPlacement()
	else
		-- keep the preview so the player can place more
		remotes.PlaceFurniture:FireServer(name, level, placeX, placeZ, rotation)
	end
end

-- rotate the preview, or the selected item
function FurnitureServiceClient:Rotate()
	if preview then
		rotation = (rotation + 90) % 360
		FurnitureServiceClient:UpdatePreview()
	elseif selectedId then
		remotes.RotateFurniture:FireServer(selectedId)
	end
end

-- select the furniture under the pointer
function FurnitureServiceClient:Select()
	local furnitureFolder = PLT_Client:GetPieceFolder(level, 'Furniture')

	if not furnitureFolder then
		return
	end

	local result = INP_UTILS.RaycastInclude({furnitureFolder})
	local current: Instance? = result and result.Instance

	-- walk up to the furniture model
	while current and current.Parent ~= furnitureFolder do
		current = current.Parent
	end

	if not current then
		FurnitureServiceClient:ClearSelection()
		return
	end

	selectedId = current.Name
	selectedModel = current
	selection.Adornee = current

	local itemName = current:GetAttribute('Item')

	FUR_CSignals.SelectionChanged:Fire(current.Name, if typeof(itemName) == 'string' then itemName else nil)
end

-- pick up the selected item to move it
function FurnitureServiceClient:MoveSelected()
	local id = selectedId

	if not id then
		return
	end

	local land: DAT_TYPES.LandData = DAT_Client:get('Land')
	local item = land.Furniture[id]

	FurnitureServiceClient:ClearSelection()

	if item then
		FurnitureServiceClient:StartPlacement(item.Name, id, item.Rotation)
	end
end

-- sell the selected item
function FurnitureServiceClient:RemoveSelected()
	local id = selectedId

	if id then
		remotes.RemoveFurniture:FireServer(id)
		FurnitureServiceClient:ClearSelection()
	end
end

-- rotate the selected item
function FurnitureServiceClient:RotateSelected()
	if selectedId then
		remotes.RotateFurniture:FireServer(selectedId)
	end
end

-- initialize furniture service client-side
function FurnitureServiceClient:Init()
	selection = Instance.new('Highlight')
	selection.FillTransparency = 0.8
	selection.FillColor = SELECT_COLOR
	selection.OutlineColor = SELECT_COLOR
	selection.Parent = WKS

	BLD_CSignals.LevelChanged:Connect(function(Level)
		level = Level
		FurnitureServiceClient:ClearSelection()
	end)

	BLD_CSignals.ModeChanged:Connect(function(Mode, OptionA)
		FurnitureServiceClient:StopPlacement()
		FurnitureServiceClient:ClearSelection()

		editing = Mode == 'Edit'

		if Mode == 'Furniture' and OptionA then
			FurnitureServiceClient:StartPlacement(OptionA)
		end
	end)

	RNS.RenderStepped:Connect(function()
		if preview then
			FurnitureServiceClient:UpdatePreview()
		end

		-- the selected item was sold or the house was cleared
		if selectedModel and not selectedModel.Parent then
			FurnitureServiceClient:ClearSelection()
		end
	end)

	UIS.InputBegan:Connect(function(Input, Processed)
		if Processed then
			return
		end

		local active = preview ~= nil or editing

		if INP_UTILS.IsPress(Input) then
			if preview then
				FurnitureServiceClient:Confirm()
			elseif editing then
				FurnitureServiceClient:Select()
			end

		elseif not active then
			return

		elseif Input.KeyCode == Enum.KeyCode.R then
			FurnitureServiceClient:Rotate()

		elseif Input.KeyCode == Enum.KeyCode.M then
			FurnitureServiceClient:MoveSelected()

		elseif Input.KeyCode == Enum.KeyCode.X or Input.KeyCode == Enum.KeyCode.Delete then
			FurnitureServiceClient:RemoveSelected()

		elseif Input.KeyCode == Enum.KeyCode.Escape then
			if movingId then
				FurnitureServiceClient:StopPlacement()
			else
				BLD_CSignals.ModeRequested:Fire('None')
			end
		end
	end)
end

return FurnitureServiceClient
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW34"><Properties><string name="Name">HouseService</string></Properties><Item class="ModuleScript" referent="NEW32"><Properties><string name="Name">HouseClientSignals</string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local HouseClientSignals = {
	-- the houses on the local player's land were worked out again
	HousesChanged = Signal() :: Signal.Signal<{DAT_TYPES.HouseInfo}>,
}

return HouseClientSignals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW33"><Properties><string name="Name">HouseServiceClient</string><ProtectedString name="Source"><![CDATA[--!strict
-- works out the local player's houses whenever their land changes (shared by the UI)
local HouseServiceClient = {}

local RPS = game:GetService('ReplicatedStorage')

local HSE_CSignals = require(script.Parent.HouseClientSignals)
local DAT_Client = require(RPS.Modules.Packages.DataService).client
local MKT_Client = require(RPS.Modules.Services.MarketService.MarketServiceClient)
local HSE_UTILS = require(RPS.Modules.Utils.HouseUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

export type HouseStatus = 'Building' | 'For Sale' | 'For Rent' | 'Rented'

local REFRESH_DELAY = 0.2

local houses: {DAT_TYPES.HouseInfo} = {}
local refreshQueued = false

-- work the houses out again (batched so a big drag only refreshes once)
local function queueRefresh()
	if refreshQueued then
		return
	end

	refreshQueued = true

	task.delay(REFRESH_DELAY, function()
		refreshQueued = false
		houses = HSE_UTILS.GetHouses(DAT_Client:get('Land'))

		HSE_CSignals.HousesChanged:Fire(houses)
	end)
end

-- initialize house service client-side
function HouseServiceClient:Init()
	task.spawn(function()
		DAT_Client:waitForData()

		DAT_Client:getChangedSignal('Land'):Connect(queueRefresh)
		queueRefresh()
	end)
end

-- latest houses
function HouseServiceClient:GetHouses(): {DAT_TYPES.HouseInfo}
	return houses
end

-- what is happening with a house
function HouseServiceClient:GetStatus(HouseId: string): HouseStatus
	local rentals = DAT_Client:get('Rentals')

	if rentals[HouseId] then
		return 'Rented'
	end

	local listing = MKT_Client:GetListings()[HouseId]

	if listing then
		return if listing.Mode == 'Sale' then 'For Sale' else 'For Rent'
	end

	return 'Building'
end

return HouseServiceClient
]]></ProtectedString></Properties></Item></Item><Item class="ModuleScript" referent="NEW44"><Properties><string name="Name">Interface</string><ProtectedString name="Source"><![CDATA[--!strict
local Interface = {}

-- initialize interface
function Interface:Init()
	for _, child in script:GetChildren() do
		if child:IsA('ModuleScript') then
			task.spawn(function()
				(require(child) :: {Init: (self: any) -> ()}):Init()
			end)
		end
	end
end

return Interface
]]></ProtectedString></Properties><Item class="ModuleScript" referent="NEW35"><Properties><string name="Name">Build</string><ProtectedString name="Source"><![CDATA[--!strict
local Build = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')

local BLD_CSignals = require(RPS.Modules.Services.BuildService.BuildClientSignals)
local BLD_Client = require(RPS.Modules.Services.BuildService.BuildServiceClient)
local BLD_View = require(RPS.Modules.Services.BuildService.BuildViewClient)
local MON_Client = require(RPS.Modules.Services.MonetizationService.MonetizationServiceClient)
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local FUR_CONFIGS = require(RPS.Modules.Configs.FurnitureConfigs)
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)

type BuildMode = BLD_CSignals.BuildMode

local plr = PLS.LocalPlayer :: Player
local hud = plr:WaitForChild('PlayerGui'):WaitForChild('HUD')
local actions = INT_UTILS.Get(hud, 'Actions', 'Frame')
local buildBtn = INT_UTILS.Get(actions, 'Build', 'TextButton') :: TextButton

local bar = INT_UTILS.Get(hud, 'BuildBar', 'Frame') :: Frame
local tabs = INT_UTILS.Get(bar, 'Tabs', 'Frame')
local options = INT_UTILS.Get(bar, 'Options', 'Frame')
local items = INT_UTILS.Get(bar, 'Items', 'ScrollingFrame') :: ScrollingFrame
local hintLabel = INT_UTILS.Get(bar, 'Hint', 'TextLabel') :: TextLabel
local costLabel = INT_UTILS.Get(bar, 'Cost', 'TextLabel') :: TextLabel
local levelBox = INT_UTILS.Get(bar, 'LevelBox', 'Frame')
local levelDown = INT_UTILS.Get(levelBox, 'LevelDown', 'TextButton') :: TextButton
local levelUp = INT_UTILS.Get(levelBox, 'LevelUp', 'TextButton') :: TextButton
local levelLabel = INT_UTILS.Get(levelBox, 'LevelLabel', 'TextLabel') :: TextLabel
local lightsBtn = INT_UTILS.Get(levelBox, 'Lights', 'TextButton') :: TextButton

local optionTemplate = INT_UTILS.Get(options, 'OptionTemplate', 'TextButton') :: TextButton
local itemTemplate = INT_UTILS.Get(items, 'ItemTemplate', 'TextButton') :: TextButton

local GREY = Color3.fromRGB(200, 200, 200)
local CAMERA_HINT = 'WASD move  |  scroll zoom  |  Q/E or right-drag turn  |  Ctrl+Z undo'

local HINTS: {[BuildMode]: string} = {
	None = '',
	Room = 'Drag a box to build a whole room (walls, floor and a front door)',
	Wall = 'Drag from corner to corner to build walls',
	Door = 'Click a wall to put a door in it (click again to remove)',
	Window = 'Click a wall to put a window in it (click again to remove)',
	Floor = 'Drag a box to lay floor',
	Paint = 'Click or drag over walls / floors to repaint them',
	Furniture = 'Pick an item below. Lamps light up rooms and raise the value',
	Edit = 'Click your furniture to rotate, move or sell it',
	Erase = 'Click or drag over pieces to remove them (75% back)',
}

-- tab button name -> tool
local TAB_MODES: {[string]: BuildMode} = {
	Room = 'Room',
	Walls = 'Wall',
	Door = 'Door',
	Window = 'Window',
	Floors = 'Floor',
	Paint = 'Paint',
	Furniture = 'Furniture',
	Edit = 'Edit',
	Erase = 'Erase',
}

local mode: BuildMode = 'None'
local category: CFG_TYPES.FurnitureCategory = 'Bedroom'
local furnitureItem: string? = nil

-- sort config names by their Order
local function sortedKeys<T>(Configs: {[string]: T}, GetOrder: (T) -> number): {string}
	local keys = {}

	for key in Configs do
		table.insert(keys, key)
	end

	table.sort(keys, function(A, B)
		return GetOrder(Configs[A]) < GetOrder(Configs[B])
	end)

	return keys
end

-- add an option button (top row)
local function addOption(Text: string, Order: number, Picked: boolean, OnClick: () -> ())
	local button = INT_UTILS.CloneTemplate(optionTemplate) :: TextButton
	button.Text = Text
	button.LayoutOrder = Order
	button.BackgroundColor3 = if Picked then INT_UTILS.Colors.Active else INT_UTILS.Colors.Button
	button.Activated:Connect(OnClick)
end

-- add an item button (bottom row), Badge shows R$ / VIP / Light
local function addItem(Title: string, Price: number, Color: Color3, Order: number, Picked: boolean, OnClick: () -> (), Badge: string?)
	local button = INT_UTILS.CloneTemplate(itemTemplate) :: TextButton
	button.LayoutOrder = Order

	local swatch = button:FindFirstChild('Swatch') :: Frame?
	local title = button:FindFirstChild('Title') :: TextLabel?
	local price = button:FindFirstChild('Price') :: TextLabel?
	local badge = button:FindFirstChild('Badge') :: TextLabel?

	if swatch then
		swatch.BackgroundColor3 = Color
	end

	if title then
		title.Text = Title
	end

	if price then
		price.Text = STR_UTILS.FormatCash(Price)
	end

	if badge then
		badge.Visible = Badge ~= nil
		badge.Text = Badge or ''
	end

	INT_UTILS.SetPicked(button, Picked)
	button.Activated:Connect(OnClick)
end

-- list wall styles as items
local function addWallStyles(Picked: string, OnPick: (string) -> ())
	for _, name in sortedKeys(BLD_CONFIGS.WallStyles, function(C) return C.Order end) do
		local config = BLD_CONFIGS.WallStyles[name]

		addItem(config.DisplayName, config.Cost, config.Color, config.Order, name == Picked, function()
			OnPick(name)
		end)
	end
end

-- list floor styles as items
local function addFloorStyles(Picked: string, OnPick: (string) -> ())
	for _, name in sortedKeys(BLD_CONFIGS.FloorStyles, function(C) return C.Order end) do
		local config = BLD_CONFIGS.FloorStyles[name]

		addItem(config.DisplayName, config.Cost, config.Color, config.Order, name == Picked, function()
			OnPick(name)
		end)
	end
end

-- rebuild the option and item rows for the open tool
local function refresh()
	INT_UTILS.ClearClones(options)
	INT_UTILS.ClearClones(items)

	local wallStyle, floorStyle, paintTarget, paintStyle = BLD_Client:GetStyles()

	if mode == 'Room' then
		-- top row: wall style, bottom row: floor style
		for _, name in sortedKeys(BLD_CONFIGS.WallStyles, function(C) return C.Order end) do
			local config = BLD_CONFIGS.WallStyles[name]

			addOption(`{config.DisplayName} walls`, config.Order, name == wallStyle, function()
				BLD_CSignals.ModeRequested:Fire('Room', name, floorStyle)
			end)
		end

		addFloorStyles(floorStyle, function(Name)
			BLD_CSignals.ModeRequested:Fire('Room', wallStyle, Name)
		end)

	elseif mode == 'Wall' then
		addWallStyles(wallStyle, function(Name)
			BLD_CSignals.ModeRequested:Fire('Wall', Name)
		end)

	elseif mode == 'Floor' then
		addFloorStyles(floorStyle, function(Name)
			BLD_CSignals.ModeRequested:Fire('Floor', Name)
		end)

	elseif mode == 'Paint' then
		addOption('Walls', 1, paintTarget == 'Wall', function()
			BLD_CSignals.ModeRequested:Fire('Paint', 'Wall')
		end)

		addOption('Floors', 2, paintTarget == 'Floor', function()
			BLD_CSignals.ModeRequested:Fire('Paint', 'Floor')
		end)

		if paintTarget == 'Floor' then
			addFloorStyles(paintStyle, function(Name)
				BLD_CSignals.ModeRequested:Fire('Paint', 'Floor', Name)
			end)
		else
			addWallStyles(paintStyle, function(Name)
				BLD_CSignals.ModeRequested:Fire('Paint', 'Wall', Name)
			end)
		end

	elseif mode == 'Furniture' then
		for index, info in FUR_CONFIGS.Categories do
			addOption(info.DisplayName, index, info.Name == category, function()
				category = info.Name
				refresh()
			end)
		end

		for _, name in sortedKeys(FUR_CONFIGS.Items, function(C) return C.Order end) do
			local config = FUR_CONFIGS.Items[name]

			if config.Category ~= category then
				continue
			end

			local lock = MON_Client:GetItemLock(name)
			local premium = config.Premium
			local badge = if lock == 'Premium' and premium then `R${premium.RobuxPrice}`
				elseif lock == 'Vip' then 'VIP'
				elseif config.LightRange then 'Light'
				else nil

			addItem(config.DisplayName, config.Price, GREY, config.Order, name == furnitureItem, function()
				-- locked items open the purchase instead
				if lock == 'Premium' then
					MON_Client:PromptPremium(name)
				elseif lock == 'Vip' then
					MON_Client:PromptPass('VipFurniture')
				else
					BLD_CSignals.ModeRequested:Fire('Furniture', name)
				end
			end, badge)
		end
	end

	-- highlight the open tab
	for tabName, tabMode in TAB_MODES do
		local tab = tabs:FindFirstChild(tabName)

		if tab and tab:IsA('GuiButton') then
			tab.BackgroundColor3 = if tabMode == mode then INT_UTILS.Colors.Active else INT_UTILS.Colors.Button
		end
	end

	local hint = if mode == 'Furniture' and furnitureItem
		then 'Click to place  |  R rotate  |  Esc stop'
		else HINTS[mode]

	hintLabel.Text = if hint ~= '' then `{hint}\n{CAMERA_HINT}` else ''
end

-- open a tool using the last options picked for it
local function openTab(TabName: string)
	local tabMode = TAB_MODES[TabName]

	if tabMode then
		BLD_CSignals.ModeRequested:Fire(tabMode)
	end
end

-- show the floor being built on
local function refreshLevel(Level: number)
	local config = LND_CONFIGS.Levels[Level]

	levelLabel.Text = if config then config.DisplayName else `Floor {Level}`
end

-- initialize build ui
function Build:Init()
	buildBtn.Activated:Connect(function()
		if bar.Visible then
			BLD_CSignals.ModeRequested:Fire('None')
		else
			openTab('Room')
		end
	end)

	for tabName in TAB_MODES do
		local tab = tabs:FindFirstChild(tabName)

		if tab and tab:IsA('GuiButton') then
			tab.Activated:Connect(function()
				openTab(tabName)
			end)
		end
	end

	local close = INT_UTILS.Get(tabs, 'Close', 'TextButton') :: TextButton
	local undo = INT_UTILS.Get(tabs, 'Undo', 'TextButton') :: TextButton

	close.Activated:Connect(function()
		BLD_CSignals.ModeRequested:Fire('None')
	end)

	undo.Activated:Connect(function()
		BLD_Client:Undo()
	end)

	BLD_CSignals.ModeChanged:Connect(function(Mode, OptionA)
		mode = Mode
		furnitureItem = nil

		if Mode == 'Furniture' and OptionA then
			furnitureItem = OptionA

			local config = FUR_CONFIGS.Items[OptionA]

			if config then
				category = config.Category
			end
		end

		bar.Visible = Mode ~= 'None'
		actions.Visible = Mode == 'None'

		-- building closes any open panel
		if Mode ~= 'None' then
			INT_CSignals.PanelOpened:Fire('Build')
		end
		costLabel.Text = ''

		refresh()
	end)

	levelDown.Activated:Connect(function()
		BLD_Client:SetLevel(BLD_Client:GetLevel() - 1)
	end)

	levelUp.Activated:Connect(function()
		BLD_Client:SetLevel(BLD_Client:GetLevel() + 1)
	end)

	lightsBtn.Activated:Connect(function()
		BLD_View:SetLightView(not BLD_View:IsLightView())
		lightsBtn.Text = if BLD_View:IsLightView() then '\u{1F4A1} On' else '\u{1F4A1} Off'
	end)

	BLD_CSignals.LevelChanged:Connect(refreshLevel)
	refreshLevel(BLD_Client:GetLevel())

	BLD_CSignals.CostChanged:Connect(function(Cost)
		costLabel.Text = if Cost then `Cost: {STR_UTILS.FormatCash(Cost)}` else ''
	end)
end

return Build
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW36"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--!strict
-- bouncy buttons and panels that pop open, for every button / panel in the HUD
local Effects = {}

local PLS = game:GetService('Players')
local TWS = game:GetService('TweenService')

local plr = PLS.LocalPlayer :: Player
local hud = plr:WaitForChild('PlayerGui'):WaitForChild('HUD')

local HOVER_SCALE = 1.06
local PRESS_SCALE = 0.92
local QUICK = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local POP = TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

-- panels that pop when they open
local PANELS = {'HousesPanel', 'LandPanel', 'ShopPanel', 'Selection', 'BuildBar'}

local hooked: {[GuiButton]: boolean} = setmetatable({}, {__mode = 'k'}) :: any

-- get (or add) the UIScale on a gui object
local function getScale(Object: GuiObject): UIScale
	local scale = Object:FindFirstChildOfClass('UIScale')

	if not scale then
		local newScale = Instance.new('UIScale')
		newScale.Parent = Object
		scale = newScale
	end

	return scale :: UIScale
end

-- tween a scale to a size
local function scaleTo(Scale: UIScale, Size: number, Info: TweenInfo?)
	TWS:Create(Scale, Info or QUICK, {Scale = Size}):Play()
end

-- make a button grow on hover and squish when pressed
local function hookButton(Button: GuiButton)
	if hooked[Button] then
		return
	end

	hooked[Button] = true

	local scale = getScale(Button)
	scale.Scale = 1

	Button.MouseEnter:Connect(function()
		scaleTo(scale, HOVER_SCALE)
	end)

	Button.MouseLeave:Connect(function()
		scaleTo(scale, 1)
	end)

	Button.MouseButton1Down:Connect(function()
		scaleTo(scale, PRESS_SCALE)
	end)

	Button.MouseButton1Up:Connect(function()
		scaleTo(scale, HOVER_SCALE, POP)
	end)
end

-- make a panel pop in every time it becomes visible
local function hookPanel(Panel: GuiObject)
	local scale = getScale(Panel)

	Panel:GetPropertyChangedSignal('Visible'):Connect(function()
		if Panel.Visible then
			scale.Scale = 0.8
			scaleTo(scale, 1, POP)
		end
	end)
end

-- initialize effects
function Effects:Init()
	for _, descendant in hud:GetDescendants() do
		if descendant:IsA('GuiButton') then
			hookButton(descendant)
		end
	end

	hud.DescendantAdded:Connect(function(Descendant)
		if Descendant:IsA('GuiButton') then
			hookButton(Descendant)
		end
	end)

	for _, name in PANELS do
		local panel = hud:FindFirstChild(name)

		if panel and panel:IsA('GuiObject') then
			hookPanel(panel)
		end
	end
end

return Effects
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW37"><Properties><string name="Name">HouseLabels</string><ProtectedString name="Source"><![CDATA[--!strict
-- floating "House 1 | $8,400 | Rented" labels above the local player's houses
local HouseLabels = {}

local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local HSE_Client = require(RPS.Modules.Services.HouseService.HouseServiceClient)
local HSE_CSignals = require(RPS.Modules.Services.HouseService.HouseClientSignals)
local MKT_CSignals = require(RPS.Modules.Services.MarketService.MarketClientSignals)
local PLT_Client = require(RPS.Modules.Services.PlotService.PlotServiceClient)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)

local STATUS_COLORS: {[string]: Color3} = {
	Building = Color3.fromRGB(200, 200, 210),
	['For Sale'] = Color3.fromRGB(255, 210, 90),
	['For Rent'] = Color3.fromRGB(120, 190, 255),
	Rented = Color3.fromRGB(120, 230, 140),
}

local folder: Folder

-- make one label line
local function addLine(Parent: Instance, Text: string, Color: Color3, Order: number, Size: number)
	local label = Instance.new('TextLabel')
	label.BackgroundTransparency = 1
	label.Size = UDim2.new(1, 0, 0, Size)
	label.Font = Enum.Font.FredokaOne
	label.TextSize = Size - 4
	label.TextColor3 = Color
	label.TextStrokeTransparency = 0.3
	label.Text = Text
	label.LayoutOrder = Order
	label.Parent = Parent
end

-- rebuild every label
local function refresh()
	folder:ClearAllChildren()

	local origin = PLT_Client:GetOrigin()

	if not origin then
		return
	end

	for index, house in HSE_Client:GetHouses() do
		local status = HSE_Client:GetStatus(house.Id)
		local height = GRD_UTILS.LevelHeight(house.TopLevel) + BLD_CONFIGS.WallHeight + 4

		local anchor = Instance.new('Part')
		anchor.Name = house.Id
		anchor.Anchored = true
		anchor.CanCollide = false
		anchor.CanQuery = false
		anchor.CanTouch = false
		anchor.Transparency = 1
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.CFrame = CFrame.new(origin + Vector3.new(house.CenterX, height, house.CenterZ))
		anchor.Parent = folder

		local billboard = Instance.new('BillboardGui')
		billboard.Size = UDim2.fromOffset(220, 74)
		billboard.MaxDistance = 220
		billboard.Adornee = anchor
		billboard.Parent = anchor

		local layout = Instance.new('UIListLayout')
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
		layout.Parent = billboard

		addLine(billboard, `House {index}`, Color3.new(1, 1, 1), 1, 26)
		addLine(billboard, STR_UTILS.FormatCash(house.Value), Color3.fromRGB(120, 230, 140), 2, 24)
		addLine(billboard, if house.DirtCount > 0 then `{status}  |  {house.DirtCount} dirt` else status, STATUS_COLORS[status] or Color3.new(1, 1, 1), 3, 22)
	end
end

-- initialize house labels ui
function HouseLabels:Init()
	folder = Instance.new('Folder')
	folder.Name = 'HouseLabels'
	folder.Parent = WKS

	DAT_Client:waitForData()

	HSE_CSignals.HousesChanged:Connect(refresh)
	MKT_CSignals.ListingsChanged:Connect(refresh)
	DAT_Client:getChangedSignal('Rentals'):Connect(function()
		-- rent ticks change Rentals often; only redraw when a rental starts or ends
		local count = 0

		for _ in DAT_Client:get('Rentals') do
			count += 1
		end

		if count ~= folder:GetAttribute('Rentals') then
			folder:SetAttribute('Rentals', count)
			refresh()
		end
	end)
end

return HouseLabels
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW38"><Properties><string name="Name">Houses</string><ProtectedString name="Source"><![CDATA[--!strict
local Houses = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local HSE_Client = require(RPS.Modules.Services.HouseService.HouseServiceClient)
local HSE_CSignals = require(RPS.Modules.Services.HouseService.HouseClientSignals)
local MKT_Client = require(RPS.Modules.Services.MarketService.MarketServiceClient)
local MKT_CSignals = require(RPS.Modules.Services.MarketService.MarketClientSignals)
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)
local MKT_CONFIGS = require(RPS.Modules.Configs.MarketConfigs)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local PANEL_NAME = 'Houses'

local plr = PLS.LocalPlayer :: Player
local hud = plr:WaitForChild('PlayerGui'):WaitForChild('HUD')
local actions = INT_UTILS.Get(hud, 'Actions', 'Frame')
local housesBtn = INT_UTILS.Get(actions, 'Houses', 'TextButton') :: TextButton

local panel = INT_UTILS.Get(hud, 'HousesPanel', 'Frame') :: Frame
local closeBtn = INT_UTILS.Get(panel, 'Close', 'TextButton') :: TextButton
local collectBtn = INT_UTILS.Get(panel, 'CollectAll', 'TextButton') :: TextButton
local listBox = INT_UTILS.Get(panel, 'ListBox', 'Frame')
local noHouses = INT_UTILS.Get(listBox, 'NoHouses', 'TextLabel') :: TextLabel
local list = INT_UTILS.Get(listBox, 'List', 'ScrollingFrame') :: ScrollingFrame
local houseTemplate = INT_UTILS.Get(list, 'HouseTemplate', 'TextButton') :: TextButton

local details = INT_UTILS.Get(panel, 'Details', 'Frame')
local nameLabel = INT_UTILS.Get(details, 'Name', 'TextLabel') :: TextLabel
local statusLabel = INT_UTILS.Get(details, 'Status', 'TextLabel') :: TextLabel
local valueLabel = INT_UTILS.Get(details, 'Value', 'TextLabel') :: TextLabel
local statsLabel = INT_UTILS.Get(details, 'Stats', 'TextLabel') :: TextLabel
local roomsLabel = INT_UTILS.Get(details, 'Rooms', 'TextLabel') :: TextLabel
local buttons = INT_UTILS.Get(details, 'Buttons', 'Frame')
local sellBtn = INT_UTILS.Get(buttons, 'Sell', 'TextButton') :: TextButton
local rentBtn = INT_UTILS.Get(buttons, 'Rent', 'TextButton') :: TextButton
local unlistBtn = INT_UTILS.Get(buttons, 'Unlist', 'TextButton') :: TextButton
local evictBtn = INT_UTILS.Get(buttons, 'Evict', 'TextButton') :: TextButton
local noOffers = INT_UTILS.Get(details, 'NoOffers', 'TextLabel') :: TextLabel
local offersList = INT_UTILS.Get(details, 'Offers', 'ScrollingFrame') :: ScrollingFrame
local offerTemplate = INT_UTILS.Get(offersList, 'OfferTemplate', 'Frame') :: Frame

local selectedId: string? = nil
local timerLabels: {[string]: TextLabel} = {}
local lastOfferCount = 0

-- set a child label's text if it exists
local function setText(Parent: Instance, Name: string, Text: string)
	local label = Parent:FindFirstChild(Name)

	if label and label:IsA('TextLabel') then
		label.Text = Text
	end
end

-- "Bedroom and Bathroom"
local function roomNames(Types: {any}): string
	local names = {}

	for _, roomType in Types do
		table.insert(names, MKT_CONFIGS.RoomTypes[roomType].DisplayName)
	end

	return table.concat(names, ' and ')
end

-- percentage text
local function percent(Value: number): string
	return `{math.floor(Value * 100 + 0.5)}%`
end

-- the selected house (falls back to the first one)
local function getSelected(): (DAT_TYPES.HouseInfo?, number)
	local houses = HSE_Client:GetHouses()

	for index, house in houses do
		if house.Id == selectedId then
			return house, index
		end
	end

	selectedId = if houses[1] then houses[1].Id else nil

	return houses[1], 1
end

-- rebuild the offers list for the selected house
local function refreshOffers(House: DAT_TYPES.HouseInfo?)
	INT_UTILS.ClearClones(offersList)
	timerLabels = {}

	local listing = House and MKT_Client:GetListings()[House.Id]
	local offers = if listing then listing.Offers else {}

	noOffers.Visible = #offers == 0
	noOffers.Text = if listing then 'Waiting for offers...' else 'Put the house on the market to get offers'

	if not listing then
		return
	end

	local houseId = listing.HouseId
	local isSale = listing.Mode == 'Sale'

	for index, offer in offers do
		local row = INT_UTILS.CloneTemplate(offerTemplate)
		row.LayoutOrder = index

		setText(row, 'Buyer', offer.Name)
		setText(row, 'Amount', if isSale
			then STR_UTILS.FormatCash(offer.Amount)
			else `{STR_UTILS.FormatCash(offer.Amount)}/min`)

		local timerLabel = row:FindFirstChild('Timer')
		local acceptBtn = row:FindFirstChild('Accept')
		local declineBtn = row:FindFirstChild('Decline')

		if timerLabel and timerLabel:IsA('TextLabel') then
			timerLabels[offer.Id] = timerLabel
		end

		if acceptBtn and acceptBtn:IsA('GuiButton') then
			acceptBtn.Activated:Connect(function()
				MKT_Client:AcceptOffer(houseId, offer.Id)
			end)
		end

		if declineBtn and declineBtn:IsA('GuiButton') then
			declineBtn.Activated:Connect(function()
				MKT_Client:DeclineOffer(houseId, offer.Id)
			end)
		end
	end
end

-- show the selected house's details
local function refreshDetails()
	local house, number = getSelected()

	details.Visible = house ~= nil
	refreshOffers(house)

	if not house then
		return
	end

	local status = HSE_Client:GetStatus(house.Id)
	local rental = DAT_Client:get({'Rentals', house.Id})
	local listing = MKT_Client:GetListings()[house.Id]

	nameLabel.Text = `House {number}`
	valueLabel.Text = `Value: {STR_UTILS.FormatCash(house.Value)}`
	statsLabel.Text = `Lighting {percent(house.LitFraction)}  |  Clean {percent(house.Cleanliness)} ({house.DirtCount} dirt)  |  {house.CellCount} tiles`

	-- status line
	if status == 'Rented' and rental then
		statusLabel.Text = `Rented by {rental.Tenant} for {STR_UTILS.FormatCash(rental.Rent)}/min (less when dirty)`
	elseif listing then
		statusLabel.Text = `{status} at about {STR_UTILS.FormatCash(listing.Value)}`
	elseif not house.Livable then
		statusLabel.Text = `Needs a {roomNames(house.Missing)} to sell or rent`
	elseif house.Complete then
		statusLabel.Text = `Complete home! Value x{MKT_CONFIGS.CompleteMultiplier}`
	else
		statusLabel.Text = 'Ready to sell or rent'
	end

	-- rooms
	local lines = {}

	for _, room in house.Rooms do
		local roomType = room.Type
		local roomName = if roomType then MKT_CONFIGS.RoomTypes[roomType].DisplayName else 'Empty room'
		local lit = room.Lit / math.max(1, room.Size)

		table.insert(lines, `• {roomName} <font color="#AAB0BE">(floor {room.Level}, {room.Size} tiles, {percent(lit)} lit)</font>`)
	end

	roomsLabel.Text = table.concat(lines, '\n')

	-- buttons
	sellBtn.Visible = status == 'Building'
	rentBtn.Visible = status == 'Building'
	unlistBtn.Visible = status == 'For Sale' or status == 'For Rent'
	evictBtn.Visible = status == 'Rented'
end

-- rebuild the house list
local function refreshList()
	if not panel.Visible then
		return
	end

	INT_UTILS.ClearClones(list)

	local houses = HSE_Client:GetHouses()
	noHouses.Visible = #houses == 0

	for index, house in houses do
		local button = INT_UTILS.CloneTemplate(houseTemplate) :: TextButton
		button.LayoutOrder = index

		setText(button, 'Title', `House {index}`)
		setText(button, 'Status', HSE_Client:GetStatus(house.Id))
		setText(button, 'Value', STR_UTILS.FormatCash(house.Value))

		INT_UTILS.SetPicked(button, house.Id == selectedId)

		button.Activated:Connect(function()
			selectedId = house.Id
			refreshList()
		end)
	end

	refreshDetails()
end

-- total rent waiting
local function refreshCollect()
	local total = 0

	for _, rental in DAT_Client:get('Rentals') do
		total += math.floor(rental.Pending)
	end

	collectBtn.Text = `\u{1F4B5} Collect {STR_UTILS.FormatCash(total)}`
end

-- open / close the panel
local function setOpen(Open: boolean)
	panel.Visible = Open

	if Open then
		INT_CSignals.PanelOpened:Fire(PANEL_NAME)
		refreshList()
		refreshCollect()
	end
end

-- initialize houses ui
function Houses:Init()
	DAT_Client:waitForData()

	housesBtn.Activated:Connect(function()
		setOpen(not panel.Visible)
	end)

	closeBtn.Activated:Connect(function()
		setOpen(false)
	end)

	INT_CSignals.PanelOpened:Connect(function(Name)
		if Name ~= PANEL_NAME then
			panel.Visible = false
		end
	end)

	sellBtn.Activated:Connect(function()
		if selectedId then
			MKT_Client:ListHouse(selectedId, 'Sale')
		end
	end)

	rentBtn.Activated:Connect(function()
		if selectedId then
			MKT_Client:ListHouse(selectedId, 'Rent')
		end
	end)

	unlistBtn.Activated:Connect(function()
		if selectedId then
			MKT_Client:Unlist(selectedId)
		end
	end)

	evictBtn.Activated:Connect(function()
		if selectedId then
			MKT_Client:Evict(selectedId)
		end
	end)

	collectBtn.Activated:Connect(function()
		MKT_Client:CollectRent()
	end)

	HSE_CSignals.HousesChanged:Connect(refreshList)

	DAT_Client:getChangedSignal('Rentals'):Connect(function()
		refreshCollect()
	end)

	MKT_CSignals.ListingsChanged:Connect(function(Listings)
		refreshList()

		-- tell the player about new offers without opening the panel on top of what they're doing
		local offerCount = 0
		local newest: string? = nil

		for houseId, listing in Listings do
			offerCount += #listing.Offers

			if #listing.Offers > 0 then
				newest = houseId
			end
		end

		if offerCount > lastOfferCount and newest then
			if not panel.Visible then
				selectedId = newest
			end

			INT_CSignals.Notify:Fire('\u{1F4E8} New offer! Open Houses to see it', INT_UTILS.Colors.Gold)
		end

		lastOfferCount = offerCount
	end)

	-- offer countdowns
	task.spawn(function()
		while true do
			task.wait(0.5)

			for id, label in timerLabels do
				label.Text = `{math.ceil(MKT_Client:GetTimeLeft(id))}s`
			end
		end
	end)

	refreshCollect()
end

return Houses
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW39"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--!strict
local Hud = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local HSE_CSignals = require(RPS.Modules.Services.HouseService.HouseClientSignals)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)

local plr = PLS.LocalPlayer :: Player
local hud = plr:WaitForChild('PlayerGui'):WaitForChild('HUD')
local topBar = INT_UTILS.Get(hud, 'TopBar', 'Frame')

local cashLabel = INT_UTILS.Get(INT_UTILS.Get(topBar, 'Cash', 'Frame'), 'Amount', 'TextLabel') :: TextLabel
local valueLabel = INT_UTILS.Get(INT_UTILS.Get(topBar, 'Value', 'Frame'), 'Amount', 'TextLabel') :: TextLabel

local shownCash = Instance.new('NumberValue')
local cashTween: Tween?

-- count the cash label up / down to the new amount
local function updateCash()
	if cashTween then
		cashTween:Cancel()
	end

	local tween = TWS:Create(shownCash, TweenInfo.new(0.5, Enum.EasingStyle.Quad), {Value = DAT_Client:get('Cash')})
	cashTween = tween
	tween:Play()
end

-- initialize hud ui
function Hud:Init()
	DAT_Client:waitForData()

	shownCash.Changed:Connect(function(Value)
		cashLabel.Text = `\u{1F4B5} {STR_UTILS.FormatCash(math.floor(Value + 0.5))}`
	end)

	DAT_Client:getChangedSignal('Cash'):Connect(updateCash)

	-- estate value = every house added together
	HSE_CSignals.HousesChanged:Connect(function(Houses)
		local total = 0

		for _, house in Houses do
			total += house.Value
		end

		valueLabel.Text = `\u{1F3E0} Estate {STR_UTILS.FormatCash(total)}`
	end)

	updateCash()
end

return Hud
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW40"><Properties><string name="Name">Land</string><ProtectedString name="Source"><![CDATA[--!strict
local Land = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local PLT_Client = require(RPS.Modules.Services.PlotService.PlotServiceClient)
local MON_Client = require(RPS.Modules.Services.MonetizationService.MonetizationServiceClient)
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local LND_UTILS = require(RPS.Modules.Utils.LandUtils)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)

local PANEL_NAME = 'Land'

local plr = PLS.LocalPlayer :: Player
local hud = plr:WaitForChild('PlayerGui'):WaitForChild('HUD')
local actions = INT_UTILS.Get(hud, 'Actions', 'Frame')
local landBtn = INT_UTILS.Get(actions, 'Land', 'TextButton') :: TextButton

local panel = INT_UTILS.Get(hud, 'LandPanel', 'Frame') :: Frame
local closeBtn = INT_UTILS.Get(panel, 'Close', 'TextButton') :: TextButton
local grid = INT_UTILS.Get(panel, 'Grid', 'Frame')
local parcelTemplate = INT_UTILS.Get(grid, 'ParcelTemplate', 'TextButton') :: TextButton
local infoLabel = INT_UTILS.Get(panel, 'Info', 'TextLabel') :: TextLabel
local buyCashBtn = INT_UTILS.Get(panel, 'BuyCash', 'TextButton') :: TextButton
local buyRobuxBtn = INT_UTILS.Get(panel, 'BuyRobux', 'TextButton') :: TextButton
local levelInfo = INT_UTILS.Get(panel, 'LevelInfo', 'TextLabel') :: TextLabel
local unlockLevelBtn = INT_UTILS.Get(panel, 'UnlockLevel', 'TextButton') :: TextButton

local OWNED_COLOR = Color3.fromRGB(64, 168, 98)
local LOCKED_COLOR = Color3.fromRGB(34, 36, 46)

local selectedKey: string? = nil

-- rebuild the parcel grid and buttons
local function refresh()
	if not panel.Visible then
		return
	end

	INT_UTILS.ClearClones(grid)

	local parcels = DAT_Client:get('Parcels')
	local price = LND_UTILS.GetNextPrice(parcels)
	local size = LND_CONFIGS.ParcelGrid

	if selectedKey and not LND_UTILS.CanBuyParcel(parcels, selectedKey) then
		selectedKey = nil
	end

	-- far side of the land on top, road side at the bottom
	for z = 0, size - 1 do
		for x = 0, size - 1 do
			local key = GRD_UTILS.CellKey(x, z)
			local button = INT_UTILS.CloneTemplate(parcelTemplate) :: TextButton
			button.LayoutOrder = z * size + x

			if parcels[key] then
				button.Text = 'Owned'
				button.BackgroundColor3 = OWNED_COLOR
			elseif LND_UTILS.CanBuyParcel(parcels, key) then
				button.Text = if price then STR_UTILS.GetCondensedAmount(price) else ''
				button.BackgroundColor3 = INT_UTILS.Colors.Button
			else
				button.Text = 'Locked'
				button.BackgroundColor3 = LOCKED_COLOR
			end

			INT_UTILS.SetPicked(button, key == selectedKey)

			button.Activated:Connect(function()
				if LND_UTILS.CanBuyParcel(parcels, key) then
					selectedKey = key
				end

				refresh()
			end)
		end
	end

	-- buy buttons
	local tier = LND_UTILS.GetParcelTier(parcels)
	local canBuy = selectedKey ~= nil and price ~= nil

	buyCashBtn.Visible = canBuy
	buyRobuxBtn.Visible = canBuy and tier ~= nil

	if not price then
		infoLabel.Text = 'You own all the land!'
	elseif selectedKey then
		infoLabel.Text = 'Buy this parcel to build more houses'
		buyCashBtn.Text = `Buy {STR_UTILS.FormatCash(price)}`
		buyRobuxBtn.Text = if tier then `Buy R${tier.RobuxPrice}` else ''
	else
		infoLabel.Text = 'Pick a parcel next to your land'
	end

	-- floors
	local levels = DAT_Client:get('Levels')
	local nextLevel = LND_CONFIGS.Levels[levels + 1]

	levelInfo.Text = `Floors unlocked: {levels}/{LND_CONFIGS.MaxLevels}`
	unlockLevelBtn.Text = if nextLevel
		then `Unlock {nextLevel.DisplayName} - {STR_UTILS.FormatCash(nextLevel.Cost)}`
		else 'All floors unlocked'
end

-- open / close the panel
local function setOpen(Open: boolean)
	panel.Visible = Open

	if Open then
		INT_CSignals.PanelOpened:Fire(PANEL_NAME)
		refresh()
	end
end

-- initialize land ui
function Land:Init()
	DAT_Client:waitForData()

	landBtn.Activated:Connect(function()
		setOpen(not panel.Visible)
	end)

	closeBtn.Activated:Connect(function()
		setOpen(false)
	end)

	INT_CSignals.PanelOpened:Connect(function(Name)
		if Name ~= PANEL_NAME then
			panel.Visible = false
		end
	end)

	buyCashBtn.Activated:Connect(function()
		if selectedKey then
			PLT_Client:BuyParcel(selectedKey)
		end
	end)

	buyRobuxBtn.Activated:Connect(function()
		if selectedKey then
			MON_Client:PromptParcel(selectedKey)
		end
	end)

	unlockLevelBtn.Activated:Connect(function()
		PLT_Client:UnlockLevel()
	end)

	DAT_Client:getChangedSignal('Parcels'):Connect(refresh)
	DAT_Client:getChangedSignal('Levels'):Connect(refresh)
end

return Land
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW41"><Properties><string name="Name">Notify</string><ProtectedString name="Source"><![CDATA[--!strict
local Notify = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')

local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)

local plr = PLS.LocalPlayer :: Player
local hud = plr:WaitForChild('PlayerGui'):WaitForChild('HUD')
local container = INT_UTILS.Get(hud, 'Notifications', 'Frame') :: Frame
local template = INT_UTILS.Get(container, 'Template', 'TextLabel') :: TextLabel

local SHOW_TIME = 3.5
local MAX_SHOWN = 5
local FADE = TweenInfo.new(0.4)

local order = 0

-- show a message at the top of the screen
function Notify:Show(Text: string, Color: Color3?)
	order += 1

	local label = INT_UTILS.CloneTemplate(template) :: TextLabel
	label.Text = Text
	label.TextColor3 = Color or INT_UTILS.Colors.White
	label.LayoutOrder = order

	-- remove the oldest when there are too many
	local shown = {}

	for _, child in container:GetChildren() do
		if child:GetAttribute('Clone') and child:IsA('GuiObject') then
			table.insert(shown, child)
		end
	end

	if #shown > MAX_SHOWN then
		table.sort(shown, function(A, B)
			return A.LayoutOrder < B.LayoutOrder
		end)

		shown[1]:Destroy()
	end

	task.delay(SHOW_TIME, function()
		if not label.Parent then
			return
		end

		local tween = TWS:Create(label, FADE, {TextTransparency = 1, BackgroundTransparency = 1})
		tween:Play()
		tween.Completed:Wait()
		label:Destroy()
	end)
end

-- initialize notification ui
function Notify:Init()
	RPS.Remotes.InterfaceService.Notify.OnClientEvent:Connect(function(Text: string, Color: Color3?)
		Notify:Show(Text, Color)
	end)

	INT_CSignals.Notify:Connect(function(Text, Color)
		Notify:Show(Text, Color)
	end)

	RPS.Remotes.EconomyService.Rewarded.OnClientEvent:Connect(function(_Currency: string, Amount: number, _New: number, Tag: string?)
		-- refunds happen a lot while erasing, the cash counter is enough for those
		if Tag == 'Refund' then
			return
		end

		Notify:Show(`+{STR_UTILS.FormatCash(Amount)}`, INT_UTILS.Colors.Money)
	end)
end

return Notify
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW42"><Properties><string name="Name">Selection</string><ProtectedString name="Source"><![CDATA[--!strict
local Selection = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')

local FUR_CSignals = require(RPS.Modules.Services.FurnitureService.FurnitureClientSignals)
local FUR_Client = require(RPS.Modules.Services.FurnitureService.FurnitureServiceClient)
local FUR_CONFIGS = require(RPS.Modules.Configs.FurnitureConfigs)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)

local plr = PLS.LocalPlayer :: Player
local hud = plr:WaitForChild('PlayerGui'):WaitForChild('HUD')
local panel = INT_UTILS.Get(hud, 'Selection', 'Frame') :: Frame

local title = INT_UTILS.Get(panel, 'Title', 'TextLabel') :: TextLabel
local buttons = INT_UTILS.Get(panel, 'Buttons', 'Frame')
local rotateBtn = INT_UTILS.Get(buttons, 'Rotate', 'TextButton') :: TextButton
local moveBtn = INT_UTILS.Get(buttons, 'Move', 'TextButton') :: TextButton
local removeBtn = INT_UTILS.Get(buttons, 'Remove', 'TextButton') :: TextButton

-- initialize selection ui
function Selection:Init()
	FUR_CSignals.SelectionChanged:Connect(function(Id, ItemName)
		local config = ItemName and FUR_CONFIGS.Items[ItemName]

		panel.Visible = Id ~= nil

		if config then
			title.Text = config.DisplayName
			removeBtn.Text = `\u{1F4B0} Sell {STR_UTILS.FormatCash(math.floor(config.Price * BLD_CONFIGS.RefundRate))}`
		else
			title.Text = 'Furniture'
			removeBtn.Text = '\u{1F4B0} Sell (X)'
		end
	end)

	rotateBtn.Activated:Connect(function()
		FUR_Client:RotateSelected()
	end)

	moveBtn.Activated:Connect(function()
		FUR_Client:MoveSelected()
	end)

	removeBtn.Activated:Connect(function()
		FUR_Client:RemoveSelected()
	end)
end

return Selection
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW43"><Properties><string name="Name">Shop</string><ProtectedString name="Source"><![CDATA[--!strict
local Shop = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')

local MON_Client = require(RPS.Modules.Services.MonetizationService.MonetizationServiceClient)
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)
local MON_CONFIGS = require(RPS.Modules.Configs.MonetizationConfigs)
local MON_UTILS = require(RPS.Modules.Utils.MonetizationUtils)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)

local PANEL_NAME = 'Shop'

local plr = PLS.LocalPlayer :: Player
local hud = plr:WaitForChild('PlayerGui'):WaitForChild('HUD')
local actions = INT_UTILS.Get(hud, 'Actions', 'Frame')
local shopBtn = INT_UTILS.Get(actions, 'Shop', 'TextButton') :: TextButton

local panel = INT_UTILS.Get(hud, 'ShopPanel', 'Frame') :: Frame
local closeBtn = INT_UTILS.Get(panel, 'Close', 'TextButton') :: TextButton
local passes = INT_UTILS.Get(panel, 'Passes', 'ScrollingFrame')
local passTemplate = INT_UTILS.Get(passes, 'PassTemplate', 'Frame') :: Frame
local cash = INT_UTILS.Get(panel, 'Cash', 'Frame')
local cashTemplate = INT_UTILS.Get(cash, 'CashTemplate', 'TextButton') :: TextButton

-- set a child label's text if it exists
local function setText(Parent: Instance, Name: string, Text: string)
	local label = Parent:FindFirstChild(Name)

	if label and label:IsA('TextLabel') then
		label.Text = Text
	end
end

-- sort config names by their Order
local function sortedKeys<T>(Configs: {[string]: T}, GetOrder: (T) -> number): {string}
	local keys = {}

	for key in Configs do
		table.insert(keys, key)
	end

	table.sort(keys, function(A, B)
		return GetOrder(Configs[A]) < GetOrder(Configs[B])
	end)

	return keys
end

-- rebuild the gamepass list (shows Owned when bought)
local function refreshPasses()
	INT_UTILS.ClearClones(passes)

	for index, name in sortedKeys(MON_CONFIGS.Gamepasses, function(C) return C.Order end) do
		local pass = MON_CONFIGS.Gamepasses[name]
		local row = INT_UTILS.CloneTemplate(passTemplate)
		row.LayoutOrder = index

		setText(row, 'Title', pass.DisplayName)
		setText(row, 'Description', pass.Description)

		local buy = row:FindFirstChild('Buy')

		if buy and buy:IsA('TextButton') then
			local owned = MON_Client:HasPass(name)

			buy.Text = if owned then 'Owned' else `R${pass.RobuxPrice}`
			buy.Active = not owned

			buy.Activated:Connect(function()
				if not MON_Client:HasPass(name) then
					MON_Client:PromptPass(name)
				end
			end)
		end
	end
end

-- build the cash pack buttons
local function buildCashPacks()
	for index, name in sortedKeys(MON_CONFIGS.CashPacks, function(C) return C.Order end) do
		local pack = MON_CONFIGS.CashPacks[name]
		local button = INT_UTILS.CloneTemplate(cashTemplate) :: TextButton
		button.LayoutOrder = index

		setText(button, 'Amount', STR_UTILS.FormatCash(pack.Cash))
		setText(button, 'Price', `R${pack.RobuxPrice}`)

		button.Activated:Connect(function()
			MON_Client:PromptCashPack(name)
		end)
	end
end

-- open / close the panel
local function setOpen(Open: boolean)
	panel.Visible = Open

	if Open then
		INT_CSignals.PanelOpened:Fire(PANEL_NAME)
		refreshPasses()
	end
end

-- initialize shop ui
function Shop:Init()
	shopBtn.Activated:Connect(function()
		setOpen(not panel.Visible)
	end)

	closeBtn.Activated:Connect(function()
		setOpen(false)
	end)

	INT_CSignals.PanelOpened:Connect(function(Name)
		if Name ~= PANEL_NAME then
			panel.Visible = false
		end
	end)

	-- a pass was bought while the shop is open
	for name in MON_CONFIGS.Gamepasses do
		plr:GetAttributeChangedSignal(MON_UTILS.PassAttribute(name)):Connect(function()
			if panel.Visible then
				refreshPasses()
			end
		end)
	end

	buildCashPacks()
end

return Shop
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW46"><Properties><string name="Name">InterfaceService</string></Properties><Item class="ModuleScript" referent="NEW45"><Properties><string name="Name">InterfaceClientSignals</string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)

local InterfaceClientSignals = {
	-- a panel opened, others close themselves (name of the panel)
	PanelOpened = Signal() :: Signal.Signal<string>,

	-- show a message from client code
	Notify = Signal() :: Signal.Signal<string, Color3?>,
}

return InterfaceClientSignals
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW49"><Properties><string name="Name">MarketService</string></Properties><Item class="ModuleScript" referent="NEW47"><Properties><string name="Name">MarketClientSignals</string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local MarketClientSignals = {
	-- every house on the market (key = house id)
	ListingsChanged = Signal() :: Signal.Signal<{[string]: DAT_TYPES.ListingData}>,
}

return MarketClientSignals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW48"><Properties><string name="Name">MarketServiceClient</string><ProtectedString name="Source"><![CDATA[--!strict
local MarketServiceClient = {}

local RPS = game:GetService('ReplicatedStorage')

local MKT_CSignals = require(script.Parent.MarketClientSignals)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)

local remotes = RPS.Remotes.MarketService

local listings: {[string]: DAT_TYPES.ListingData} = {}
local expiresAt: {[string]: number} = {}

-- initialize market service client-side
function MarketServiceClient:Init()
	remotes.ListingsUpdated.OnClientEvent:Connect(function(Listings: {[string]: DAT_TYPES.ListingData})
		local now = os.clock()

		listings = Listings
		expiresAt = {}

		for _, listing in Listings do
			for _, offer in listing.Offers do
				expiresAt[offer.Id] = now + offer.Expires
			end
		end

		MKT_CSignals.ListingsChanged:Fire(Listings)
	end)
end

-- every house on the market (key = house id)
function MarketServiceClient:GetListings(): {[string]: DAT_TYPES.ListingData}
	return listings
end

-- seconds left on an offer
function MarketServiceClient:GetTimeLeft(OfferId: string): number
	local expires = expiresAt[OfferId]

	return if expires then math.max(0, expires - os.clock()) else 0
end

function MarketServiceClient:ListHouse(HouseId: string, Mode: CFG_TYPES.ListingMode)
	remotes.ListHouse:FireServer(HouseId, Mode)
end

function MarketServiceClient:Unlist(HouseId: string)
	remotes.Unlist:FireServer(HouseId)
end

function MarketServiceClient:AcceptOffer(HouseId: string, OfferId: string)
	remotes.AcceptOffer:FireServer(HouseId, OfferId)
end

function MarketServiceClient:DeclineOffer(HouseId: string, OfferId: string)
	remotes.DeclineOffer:FireServer(HouseId, OfferId)
end

function MarketServiceClient:CollectRent()
	remotes.CollectRent:FireServer()
end

function MarketServiceClient:Evict(HouseId: string)
	remotes.Evict:FireServer(HouseId)
end

return MarketServiceClient
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW51"><Properties><string name="Name">MonetizationService</string></Properties><Item class="ModuleScript" referent="NEW50"><Properties><string name="Name">MonetizationServiceClient</string><ProtectedString name="Source"><![CDATA[--!strict
local MonetizationServiceClient = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local MPS = game:GetService('MarketplaceService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)
local MON_CONFIGS = require(RPS.Modules.Configs.MonetizationConfigs)
local FUR_CONFIGS = require(RPS.Modules.Configs.FurnitureConfigs)
local LND_UTILS = require(RPS.Modules.Utils.LandUtils)
local MON_UTILS = require(RPS.Modules.Utils.MonetizationUtils)

local plr = PLS.LocalPlayer
local remotes = RPS.Remotes.MonetizationService

local RED = Color3.fromRGB(235, 80, 80)

-- tell the player a product isn't on the website yet
local function notSetUp()
	INT_CSignals.Notify:Fire('This purchase is not set up yet', RED)
end

-- prompt a developer product
local function promptProduct(Id: number)
	if Id == 0 then
		notSetUp()
		return
	end

	MPS:PromptProductPurchase(plr, Id)
end

-- initialize monetization service client-side
function MonetizationServiceClient:Init() end

-- check the local player owns a gamepass
function MonetizationServiceClient:HasPass(Name: string): boolean
	return MON_UTILS.HasPass(plr, Name)
end

-- buy a gamepass
function MonetizationServiceClient:PromptPass(Name: string)
	local pass = MON_CONFIGS.Gamepasses[Name]

	if not pass or pass.Id == 0 then
		notSetUp()
		return
	end

	MPS:PromptGamePassPurchase(plr, pass.Id)
end

-- buy a cash pack
function MonetizationServiceClient:PromptCashPack(Name: string)
	local pack = MON_CONFIGS.CashPacks[Name]

	if pack then
		promptProduct(pack.Id)
	end
end

-- buy a parcel with Robux (the server gives the picked parcel)
function MonetizationServiceClient:PromptParcel(Key: string)
	local tier = LND_UTILS.GetParcelTier(DAT_Client:get('Parcels'))

	if not tier then
		return
	end

	remotes.SetPendingParcel:FireServer(Key)
	promptProduct(tier.ProductId)
end

-- unlock a premium furniture item
function MonetizationServiceClient:PromptPremium(Name: string)
	local config = FUR_CONFIGS.Items[Name]
	local premium = config and config.Premium

	if premium then
		promptProduct(premium.ProductId)
	end
end

-- check the player can use an item, or why not ('Premium' / 'Vip')
function MonetizationServiceClient:GetItemLock(Name: string): string?
	local config = FUR_CONFIGS.Items[Name]

	if not config then
		return nil
	end

	if config.Premium and not DAT_Client:get({'UnlockedItems', Name}) then
		return 'Premium'
	end

	if config.Vip and not MON_UTILS.HasPass(plr, 'VipFurniture') then
		return 'Vip'
	end

	return nil
end

return MonetizationServiceClient
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW53"><Properties><string name="Name">PlotService</string></Properties><Item class="ModuleScript" referent="NEW52"><Properties><string name="Name">PlotServiceClient</string><ProtectedString name="Source"><![CDATA[--!strict
local PlotServiceClient = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local FUR_UTILS = require(RPS.Modules.Utils.FurnitureUtils)

local plr = PLS.LocalPlayer
local remotes = RPS.Remotes.PlotService

local dataReady = false

-- initialize plot service client-side
function PlotServiceClient:Init()
	task.spawn(function()
		DAT_Client:waitForData()
		dataReady = true
	end)
end

-- check data, land and rendered pieces have all loaded
function PlotServiceClient:IsReady(): boolean
	return dataReady and PlotServiceClient:GetPlot() ~= nil and PlotServiceClient:GetLandFolder() ~= nil
end

-- get the local player's land part
function PlotServiceClient:GetPlot(): BasePart?
	local name = plr:GetAttribute('Plot')
	local plots = WKS:FindFirstChild('Plot')
	local plot = typeof(name) == 'string' and plots and plots:FindFirstChild(name)

	if plot and plot:IsA('BasePart') then
		return plot
	end

	return nil
end

-- get the world position of the build grid corner
function PlotServiceClient:GetOrigin(): Vector3?
	local plot = PlotServiceClient:GetPlot()

	return plot and GRD_UTILS.GetOrigin(plot)
end

-- get the folder the server renders the land into
function PlotServiceClient:GetLandFolder(): Folder?
	local houses = WKS:FindFirstChild('Houses')
	local folder = houses and houses:FindFirstChild(`Land_{plr.UserId}`)

	if folder and folder:IsA('Folder') then
		return folder
	end

	return nil
end

-- get the folder of one kind of piece on one floor
function PlotServiceClient:GetPieceFolder(Level: number, Kind: string): Folder?
	local land = PlotServiceClient:GetLandFolder()
	local level = land and land:FindFirstChild(`L{Level}`)
	local folder = level and level:FindFirstChild(Kind)

	return if folder and folder:IsA('Folder') then folder else nil
end

-- what the player may build on
function PlotServiceClient:GetContext(): FUR_UTILS.PlaceContext
	return {
		Parcels = DAT_Client:get('Parcels'),
		Levels = DAT_Client:get('Levels'),
	}
end

-- buy a parcel with cash
function PlotServiceClient:BuyParcel(Key: string)
	remotes.BuyParcel:FireServer(Key)
end

-- unlock the next floor
function PlotServiceClient:UnlockLevel()
	remotes.UnlockLevel:FireServer()
end

return PlotServiceClient
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="NEW57"><Properties><string name="Name">Types</string></Properties><Item class="ModuleScript" referent="NEW55"><Properties><string name="Name">ConfigTypes</string><ProtectedString name="Source"><![CDATA[--!strict
export type WallKind = 'Wall' | 'Window' | 'Door'

export type RoomType = 'Bedroom' | 'Bathroom' | 'Kitchen' | 'LivingRoom' | 'DiningRoom' | 'Office' | 'Laundry'

export type FurnitureCategory = 'Bedroom' | 'Bathroom' | 'Kitchen' | 'Living' | 'Dining' | 'Office' | 'Laundry' | 'Lighting' | 'Decor' | 'Structure'

export type ListingMode = 'Sale' | 'Rent'

export type DirtKind = 'Dust' | 'Stain' | 'Trash'

export type RewardConfig = {
	Cash: number?,
	Transaction: Enum.AnalyticsEconomyTransactionType?
}

export type DeductionConfig = {
	Cash: number?,
	Transaction: Enum.AnalyticsEconomyTransactionType?
}

export type WallStyleConfig = {
	DisplayName: string,
	Order: number,
	Cost: number,
	Value: number,
	Color: Color3,
	Material: Enum.Material,
}

export type WallKindConfig = {
	DisplayName: string,
	Order: number,
	ExtraCost: number,
	ExtraValue: number,
}

export type FloorStyleConfig = {
	DisplayName: string,
	Order: number,
	Cost: number,
	Value: number,
	Color: Color3,
	Material: Enum.Material,
}

export type RoomTypeConfig = {
	DisplayName: string,
	Order: number,
	Bonus: number,
	IdealCells: number,
}

export type FurniturePartConfig = {
	Size: Vector3,
	Offset: Vector3,
	Color: Color3,
	Material: Enum.Material?,
	Transparency: number?,
	Light: boolean?, -- adds a PointLight (looks only - LightRange decides game lighting)
	Wedge: boolean?, -- WedgePart instead of Part (slope rises towards +Z)
	NoCollide: boolean?,
}

export type PremiumConfig = {
	ProductId: number, -- developer product that unlocks the item forever
	RobuxPrice: number, -- shown in the UI only, the real price is set on the website
}

export type FurnitureConfig = {
	DisplayName: string,
	Category: FurnitureCategory,
	Order: number,
	Price: number,
	Footprint: Vector2,
	Room: RoomType?, -- key item that decides a room's type
	Flat: boolean?, -- can overlap other furniture (rugs, ceiling lights)
	LightRange: number?, -- studs of floor this item lights up
	ValueRate: number?, -- overrides MarketConfigs.FurnitureValueRate
	CellAligned: boolean?, -- must line up with the build grid
	Stairs: boolean?, -- connects this floor to the one above
	Premium: PremiumConfig?, -- unlocked with Robux
	Vip: boolean?, -- needs the VIP Furniture gamepass
	Shape: {FurniturePartConfig}?,
}

export type ParcelTierConfig = {
	MaxOwned: number, -- tier used while the player owns this many parcels or fewer
	ProductId: number,
	RobuxPrice: number,
}

export type LevelConfig = {
	DisplayName: string,
	Cost: number,
}

export type GamepassConfig = {
	Id: number,
	DisplayName: string,
	Description: string,
	RobuxPrice: number,
	Order: number,
}

export type CashPackConfig = {
	Id: number,
	Cash: number,
	RobuxPrice: number,
	Order: number,
}

return nil
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW56"><Properties><string name="Name">DataTypes</string><ProtectedString name="Source"><![CDATA[--!strict
local CFG_TYPES = require(script.Parent.ConfigTypes)

--[[
	Keys used in data:
	cell        "x_z"        a tile on one floor
	edge        "X_x_z"      a wall line (see GridUtils)
	level cell  "level|x_z"  a tile on a given floor, e.g. "2|4_7"
	level key   "L1".."L3"   index into LandData.Levels
	parcel      "px_pz"      a 10x10 tile piece of land
]]

export type WallData = {
	Kind: CFG_TYPES.WallKind,
	Style: string,
}

export type LevelData = {
	Walls: {[string]: WallData},
	Floors: {[string]: string},
}

export type FurnitureData = {
	Name: string,
	Level: number,
	X: number, -- plot-local studs
	Z: number,
	Rotation: number,
}

export type DirtData = {
	Level: number,
	Cell: string,
	Kind: CFG_TYPES.DirtKind,
}

export type LandData = {
	Levels: {[string]: LevelData},
	Furniture: {[string]: FurnitureData},
	Dirt: {[string]: DirtData},
}

export type RentalData = {
	Tenant: string,
	Rent: number, -- per minute, before cleanliness and passes
	Value: number,
	Pending: number,
	Started: number,
	Cells: {string}, -- level cells of the house
}

export type StatsData = {
	HousesSold: number,
	HousesRented: number,
	TotalEarned: number,
	DirtCleaned: number,
}

export type PlayerData = {
	Cash: number,
	Parcels: {[string]: boolean},
	Levels: number, -- floors unlocked
	Land: LandData,
	Rentals: {[string]: RentalData}, -- key = house id
	UnlockedItems: {[string]: boolean},
	Purchases: {string},
	Stats: StatsData,
	LastOnline: number,
}

export type OfferData = {
	Id: string,
	Name: string,
	Amount: number, -- sale price, or rent per minute
	Expires: number, -- server: os.clock() time / client: seconds left when sent
}

export type ListingData = {
	HouseId: string,
	Mode: CFG_TYPES.ListingMode,
	Value: number,
	Offers: {OfferData},
}

export type RoomData = {
	Level: number,
	Cells: {string},
	Size: number,
	Type: CFG_TYPES.RoomType?,
	Lit: number, -- how many of its tiles are lit
	LitCells: {[string]: boolean},
}

export type HouseInfo = {
	Id: string, -- lowest level cell of the house, stays the same while it is locked
	Rooms: {RoomData},
	Cells: {[string]: boolean}, -- level cells
	CellCount: number,
	LitFraction: number,
	DirtCount: number,
	Cleanliness: number, -- 0.5 .. 1 value multiplier
	BaseValue: number, -- before cleanliness
	Value: number,
	Livable: boolean,
	Complete: boolean,
	Missing: {CFG_TYPES.RoomType},
	CenterX: number, -- plot-local studs
	CenterZ: number,
	TopLevel: number,
}

return nil
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW67"><Properties><string name="Name">Utils</string></Properties><Item class="ModuleScript" referent="NEW58"><Properties><string name="Name">BuildUtils</string><ProtectedString name="Source"><![CDATA[--!strict
local BuildUtils = {}

local RPS = game:GetService('ReplicatedStorage')

local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

-- bind position to grid
function BuildUtils.BindToGrid(pos: Vector3, gridSize: number): Vector3
	return Vector3.new(
		math.floor(pos.X / gridSize + 0.5) * gridSize,
		pos.Y,
		math.floor(pos.Z / gridSize + 0.5) * gridSize
	)
end

-- get the cost of one wall piece
function BuildUtils.GetWallCost(Wall: DAT_TYPES.WallData): number
	local style = BLD_CONFIGS.WallStyles[Wall.Style]
	local kind = BLD_CONFIGS.WallKinds[Wall.Kind]

	if not style or not kind then
		return 0
	end

	return style.Cost + kind.ExtraCost
end

-- get the value of one wall piece
function BuildUtils.GetWallValue(Wall: DAT_TYPES.WallData): number
	local style = BLD_CONFIGS.WallStyles[Wall.Style]
	local kind = BLD_CONFIGS.WallKinds[Wall.Kind]

	if not style or not kind then
		return 0
	end

	return style.Value + kind.ExtraValue
end

-- make a part for a house piece
local function newPart(Name: string, Size: Vector3, CF: CFrame, Color: Color3, Material: Enum.Material): Part
	local part = Instance.new('Part')
	part.Name = Name
	part.Anchored = true
	part.Size = Size
	part.CFrame = CF
	part.Color = Color
	part.Material = Material
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth

	return part
end

-- turn a model into a see-through preview
function BuildUtils.MakeGhost(Model: Model, Color: Color3?)
	for _, child in Model:GetDescendants() do
		if child:IsA('BasePart') then
			child.Anchored = true
			child.CanCollide = false
			child.CanTouch = false
			child.CanQuery = false
			child.CastShadow = false
			child.Transparency = math.max(child.Transparency, 0.5)

			if Color then
				child.Color = Color
			end
		elseif child:IsA('Light') then
			child.Enabled = false
		end
	end
end

-- create a wall, window or door piece on an edge
function BuildUtils.CreateWall(Origin: Vector3, Level: number, Key: string, Wall: DAT_TYPES.WallData): Model
	local style = BLD_CONFIGS.WallStyles[Wall.Style] or BLD_CONFIGS.WallStyles.Plaster
	local axis, x, z = GRD_UTILS.ParseEdgeKey(Key)

	local length = BLD_CONFIGS.CellSize
	local height = BLD_CONFIGS.WallHeight
	local thick = BLD_CONFIGS.WallThickness

	-- centre of the edge, rotated so local X runs along the wall
	local center = if axis == 'X'
		then GRD_UTILS.PointToWorld(Origin, x + 0.5, z, Level)
		else GRD_UTILS.PointToWorld(Origin, x, z + 0.5, Level)

	local base = CFrame.new(center)

	if axis == 'Z' then
		base *= CFrame.Angles(0, math.rad(90), 0)
	end

	local model = Instance.new('Model')
	model.Name = Key
	model:SetAttribute('Piece', 'Wall')
	model:SetAttribute('Level', Level)

	-- add a solid block between two heights
	local function addBlock(Name: string, Bottom: number, Top: number, Width: number?, OffsetX: number?)
		local part = newPart(
			Name,
			Vector3.new(Width or length, Top - Bottom, thick),
			base * CFrame.new(OffsetX or 0, (Bottom + Top) / 2, 0),
			style.Color,
			style.Material
		)

		part.Parent = model
	end

	if Wall.Kind == 'Window' then
		local bottom = BLD_CONFIGS.WindowBottom
		local top = BLD_CONFIGS.WindowTop

		addBlock('Lower', 0, bottom)
		addBlock('Upper', top, height)

		local glass = newPart(
			'Glass',
			Vector3.new(length, top - bottom, thick * 0.3),
			base * CFrame.new(0, (bottom + top) / 2, 0),
			Color3.fromRGB(190, 225, 255),
			Enum.Material.Glass
		)

		glass.Transparency = 0.5
		glass.Parent = model

	elseif Wall.Kind == 'Door' then
		local top = BLD_CONFIGS.DoorTop
		local jamb = 0.4

		addBlock('Lintel', top, height)
		addBlock('LeftJamb', 0, top, jamb, -(length - jamb) / 2)
		addBlock('RightJamb', 0, top, jamb, (length - jamb) / 2)

	else
		addBlock('Wall', 0, height)
	end

	model.PrimaryPart = model:FindFirstChildWhichIsA('BasePart')

	return model
end

-- create a corner post that fills the gap where walls meet
function BuildUtils.CreatePost(Origin: Vector3, Level: number, X: number, Z: number, Style: string): Part
	local style = BLD_CONFIGS.WallStyles[Style] or BLD_CONFIGS.WallStyles.Plaster
	local size = BLD_CONFIGS.WallThickness + 0.02
	local height = BLD_CONFIGS.WallHeight

	local post = newPart(
		`P_{X}_{Z}`,
		Vector3.new(size, height, size),
		CFrame.new(GRD_UTILS.PointToWorld(Origin, X, Z, Level) + Vector3.new(0, height / 2, 0)),
		style.Color,
		style.Material
	)

	post:SetAttribute('Piece', 'Post')

	return post
end

-- create a floor tile on a cell
function BuildUtils.CreateFloor(Origin: Vector3, Level: number, Key: string, Style: string): Part
	local style = BLD_CONFIGS.FloorStyles[Style] or BLD_CONFIGS.FloorStyles.Wood
	local x, z = GRD_UTILS.ParseCellKey(Key)
	local size = BLD_CONFIGS.CellSize
	local thick = BLD_CONFIGS.FloorThickness

	local floor = newPart(
		Key,
		Vector3.new(size, thick, size),
		CFrame.new(GRD_UTILS.CellToWorld(Origin, x, z, Level) + Vector3.new(0, thick / 2, 0)),
		style.Color,
		style.Material
	)

	floor:SetAttribute('Piece', 'Floor')
	floor:SetAttribute('Level', Level)

	return floor
end

-- create a dirt spot on a cell (cleaned with its ProximityPrompt)
function BuildUtils.CreateDirt(Origin: Vector3, Dirt: DAT_TYPES.DirtData, Id: string): Part
	local x, z = GRD_UTILS.ParseCellKey(Dirt.Cell)

	-- spread spots around the tile so they don't all sit in the middle
	local seed = 0

	for index = 1, #Id do
		seed += string.byte(Id, index)
	end

	local offset = Vector3.new((seed % 5 - 2) * 0.5, 0, (seed % 7 - 3) * 0.4)
	local base = GRD_UTILS.CellToWorld(Origin, x, z, Dirt.Level) + Vector3.new(0, BLD_CONFIGS.FloorThickness, 0) + offset

	local spot: Part

	if Dirt.Kind == 'Trash' then
		spot = newPart(Id, Vector3.new(1.2, 1.2, 1.2), CFrame.new(base + Vector3.new(0, 0.6, 0)), Color3.fromRGB(40, 40, 45), Enum.Material.Plastic)
		spot.Shape = Enum.PartType.Ball
	else
		local color = if Dirt.Kind == 'Stain' then Color3.fromRGB(95, 70, 45) else Color3.fromRGB(150, 140, 120)

		spot = newPart(Id, Vector3.new(0.05, 2.6, 2.6), CFrame.new(base + Vector3.new(0, 0.03, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, Enum.Material.Sand)
		spot.Shape = Enum.PartType.Cylinder
		spot.Transparency = 0.15
	end

	spot.CanCollide = false
	spot.CanTouch = false
	spot.CastShadow = false
	spot:SetAttribute('Piece', 'Dirt')
	spot:SetAttribute('Level', Dirt.Level)

	local prompt = Instance.new('ProximityPrompt')
	prompt.Name = 'CleanPrompt'
	prompt.ActionText = 'Clean'
	prompt.ObjectText = Dirt.Kind
	prompt.HoldDuration = 0.4
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = spot

	return spot
end

return BuildUtils
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW59"><Properties><string name="Name">FurnitureUtils</string><ProtectedString name="Source"><![CDATA[--!strict
local FurnitureUtils = {}

local RPS = game:GetService('ReplicatedStorage')

local FUR_CONFIGS = require(RPS.Modules.Configs.FurnitureConfigs)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local OVERLAP_TOLERANCE = 0.05

-- what a player is allowed to build on (from their data)
export type PlaceContext = {
	Parcels: {[string]: boolean},
	Levels: number,
}

function FurnitureUtils.GetPosition(
	Position: Vector3,
	Rotation: number
): CFrame
	return CFrame.new(Position)
		* CFrame.Angles(0, math.rad(Rotation), 0)
end

function FurnitureUtils.PlaceFurniture(
	Furniture: Model,
	Position: Vector3,
	Rotation: number
)
	Furniture:PivotTo(
		FurnitureUtils.GetPosition(Position, Rotation)
	)
end

-- check a rotation is one of the four allowed angles
function FurnitureUtils.IsValidRotation(Rotation: number): boolean
	return Rotation == 0 or Rotation == 90 or Rotation == 180 or Rotation == 270
end

-- world position (bottom centre) of a placed item
function FurnitureUtils.GetWorldPosition(Origin: Vector3, Item: DAT_TYPES.FurnitureData): Vector3
	return GRD_UTILS.LocalToWorld(Origin, Item.X, Item.Z, Item.Level) + Vector3.new(0, BLD_CONFIGS.FloorThickness, 0)
end

-- create a furniture model with its pivot at the bottom centre
function FurnitureUtils.CreateModel(Name: string): Model?
	local config = FUR_CONFIGS.Items[Name]

	if not config then
		return nil
	end

	local templates = RPS:FindFirstChild('Furniture')
	local template = templates and templates:FindFirstChild(Name)
	local model: Model

	if template and template:IsA('Model') then
		-- a hand-made model from ReplicatedStorage.Furniture
		model = template:Clone()

		local boxCFrame, boxSize = model:GetBoundingBox()
		local bottom = boxCFrame.Position - Vector3.new(0, boxSize.Y / 2, 0)

		model.PrimaryPart = nil
		model.WorldPivot = CFrame.new(bottom)

	elseif config.Shape then
		-- build it from the config shape
		model = Instance.new('Model')

		for index, partConfig in config.Shape do
			local part: BasePart = if partConfig.Wedge then Instance.new('WedgePart') else Instance.new('Part')
			part.Name = `Part{index}`
			part.Size = partConfig.Size
			part.CFrame = CFrame.new(partConfig.Offset)
			part.Color = partConfig.Color
			part.Material = partConfig.Material or Enum.Material.SmoothPlastic
			part.Transparency = partConfig.Transparency or 0
			part.CanCollide = not partConfig.NoCollide
			part.TopSurface = Enum.SurfaceType.Smooth
			part.BottomSurface = Enum.SurfaceType.Smooth

			if partConfig.Light then
				local light = Instance.new('PointLight')
				light.Range = config.LightRange or 12
				light.Brightness = 1.2
				light.Color = partConfig.Color
				light.Shadows = true
				light.Parent = part
			end

			part.Parent = model
		end

		model.WorldPivot = CFrame.new()
	else
		return nil
	end

	for _, child in model:GetDescendants() do
		if child:IsA('BasePart') then
			child.Anchored = true
		end
	end

	model.Name = Name
	model:SetAttribute('Piece', 'Furniture')

	return model
end

-- get the footprint corners (plot-local studs) of a placed item
function FurnitureUtils.GetBounds(Name: string, X: number, Z: number, Rotation: number): (number, number, number, number)
	local config = FUR_CONFIGS.Items[Name]
	local footprint = if config then config.Footprint else Vector2.new(1, 1)

	local width, depth = footprint.X, footprint.Y

	if Rotation == 90 or Rotation == 270 then
		width, depth = depth, width
	end

	return X - width / 2, Z - depth / 2, X + width / 2, Z + depth / 2
end

-- every cell an item's footprint covers
function FurnitureUtils.GetCoveredCells(Name: string, X: number, Z: number, Rotation: number): {string}
	local size = BLD_CONFIGS.CellSize
	local minX, minZ, maxX, maxZ = FurnitureUtils.GetBounds(Name, X, Z, Rotation)
	local cells = {}

	for cellX = math.floor((minX + OVERLAP_TOLERANCE) / size), math.floor((maxX - OVERLAP_TOLERANCE) / size) do
		for cellZ = math.floor((minZ + OVERLAP_TOLERANCE) / size), math.floor((maxZ - OVERLAP_TOLERANCE) / size) do
			table.insert(cells, GRD_UTILS.CellKey(cellX, cellZ))
		end
	end

	return cells
end

-- level cells that are stair openings (the floor above every staircase)
function FurnitureUtils.GetStairwells(Land: DAT_TYPES.LandData): {[string]: boolean}
	local stairwells: {[string]: boolean} = {}

	for _, item in Land.Furniture do
		local config = FUR_CONFIGS.Items[item.Name]

		if config and config.Stairs then
			for _, cell in FurnitureUtils.GetCoveredCells(item.Name, item.X, item.Z, item.Rotation) do
				stairwells[GRD_UTILS.LevelCell(item.Level + 1, cell)] = true
			end
		end
	end

	return stairwells
end

-- check an item can go at a spot (owned land, right floor, not overlapping)
function FurnitureUtils.CanPlace(
	Land: DAT_TYPES.LandData,
	Context: PlaceContext,
	Name: string,
	Level: number,
	X: number,
	Z: number,
	Rotation: number,
	IgnoreId: string?
): (boolean, string?)
	local config = FUR_CONFIGS.Items[Name]

	if not config then
		return false, 'Unknown item'
	end

	if not FurnitureUtils.IsValidRotation(Rotation) then
		return false, 'Bad rotation'
	end

	if Level < 1 or Level > Context.Levels or Level % 1 ~= 0 then
		return false, 'Unlock this floor first'
	end

	local minX, minZ, maxX, maxZ = FurnitureUtils.GetBounds(Name, X, Z, Rotation)

	-- stairs and similar must line up with the tiles
	if config.CellAligned then
		local size = BLD_CONFIGS.CellSize

		if math.abs(minX / size - math.floor(minX / size + 0.5)) > 0.01
			or math.abs(minZ / size - math.floor(minZ / size + 0.5)) > 0.01
		then
			return false, 'Line it up with the tiles'
		end
	end

	local levelData = Land.Levels[GRD_UTILS.LevelKey(Level)]
	local aboveData = Land.Levels[GRD_UTILS.LevelKey(Level + 1)]

	for _, cell in FurnitureUtils.GetCoveredCells(Name, X, Z, Rotation) do
		if not GRD_UTILS.IsCellInside(cell) or not Context.Parcels[GRD_UTILS.CellParcel(cell)] then
			return false, 'Buy this land first'
		end

		if Level > 1 and not (levelData and levelData.Floors[cell]) then
			return false, 'Needs a floor under it'
		end

		if config.Stairs and aboveData and aboveData.Floors[cell] then
			return false, 'Remove the floor above the stairs first'
		end
	end

	if config.Stairs and Level + 1 > Context.Levels then
		return false, 'Unlock the next floor first'
	end

	if config.Flat then
		return true
	end

	for id, item in Land.Furniture do
		local otherConfig = FUR_CONFIGS.Items[item.Name]

		if id == IgnoreId or item.Level ~= Level or not otherConfig or otherConfig.Flat then
			continue
		end

		local oMinX, oMinZ, oMaxX, oMaxZ = FurnitureUtils.GetBounds(item.Name, item.X, item.Z, item.Rotation)

		local overlapX = math.min(maxX, oMaxX) - math.max(minX, oMinX)
		local overlapZ = math.min(maxZ, oMaxZ) - math.max(minZ, oMinZ)

		if overlapX > OVERLAP_TOLERANCE and overlapZ > OVERLAP_TOLERANCE then
			return false, 'Something is in the way'
		end
	end

	return true
end

return FurnitureUtils
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW60"><Properties><string name="Name">GridUtils</string><ProtectedString name="Source"><![CDATA[--!strict
local GridUtils = {}

local RPS = game:GetService('ReplicatedStorage')

local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)

export type Axis = 'X' | 'Z'

--[[
	The build grid covers the whole land and starts at its -X/-Z corner.

	cell        "x_z"        - the square between points (x, z) and (x + 1, z + 1)
	point                    - a grid corner, used by walls
	edge        "X_x_z"      - wall from point (x, z) to (x + 1, z)
	            "Z_x_z"      - wall from point (x, z) to (x, z + 1)
	level cell  "level|x_z"  - a cell on a given floor
	parcel      "px_pz"      - ParcelCells x ParcelCells cells of land
]]

-- cells per side of a whole land
GridUtils.LandCells = LND_CONFIGS.ParcelGrid * LND_CONFIGS.ParcelCells

-- studs per side of a whole land
GridUtils.LandStuds = GridUtils.LandCells * BLD_CONFIGS.CellSize

-- get the world position of the grid corner (top of the land part)
function GridUtils.GetOrigin(Land: BasePart): Vector3
	return Land.Position - Vector3.new(Land.Size.X / 2, -Land.Size.Y / 2, Land.Size.Z / 2)
end

-- height of a floor above the land (level 1 = 0)
function GridUtils.LevelHeight(Level: number): number
	return (Level - 1) * BLD_CONFIGS.WallHeight
end

-- data key for a floor ("L1", "L2", ...)
function GridUtils.LevelKey(Level: number): string
	return `L{Level}`
end

-- cell keys
function GridUtils.CellKey(X: number, Z: number): string
	return `{X}_{Z}`
end

function GridUtils.ParseCellKey(Key: string): (number, number)
	local parts = string.split(Key, '_')

	return tonumber(parts[1]) or 0, tonumber(parts[2]) or 0
end

-- level cell keys ("2|4_7")
function GridUtils.LevelCell(Level: number, Key: string): string
	return `{Level}|{Key}`
end

function GridUtils.ParseLevelCell(Key: string): (number, string)
	local parts = string.split(Key, '|')

	return tonumber(parts[1]) or 1, parts[2] or ''
end

-- edge keys
function GridUtils.EdgeKey(Axis: Axis, X: number, Z: number): string
	return `{Axis}_{X}_{Z}`
end

function GridUtils.ParseEdgeKey(Key: string): (Axis, number, number)
	local parts = string.split(Key, '_')
	local axis: Axis = if parts[1] == 'Z' then 'Z' else 'X'

	return axis, tonumber(parts[2]) or 0, tonumber(parts[3]) or 0
end

-- check keys are real and inside the land
function GridUtils.IsCellInside(Key: string): boolean
	local parts = string.split(Key, '_')
	local x, z = tonumber(parts[1]), tonumber(parts[2])
	local size = GridUtils.LandCells

	if #parts ~= 2 or not x or not z then
		return false
	end

	return x % 1 == 0 and z % 1 == 0 and x >= 0 and z >= 0 and x < size and z < size
end

function GridUtils.IsEdgeInside(Key: string): boolean
	local parts = string.split(Key, '_')
	local x, z = tonumber(parts[2]), tonumber(parts[3])
	local size = GridUtils.LandCells

	if #parts ~= 3 or not x or not z or x % 1 ~= 0 or z % 1 ~= 0 then
		return false
	end

	if parts[1] == 'X' then
		return x >= 0 and x < size and z >= 0 and z <= size
	elseif parts[1] == 'Z' then
		return x >= 0 and x <= size and z >= 0 and z < size
	end

	return false
end

-- the two cells on each side of an edge (either may be outside the land)
function GridUtils.EdgeCells(Key: string): (string, string)
	local axis, x, z = GridUtils.ParseEdgeKey(Key)

	if axis == 'X' then
		return GridUtils.CellKey(x, z - 1), GridUtils.CellKey(x, z)
	end

	return GridUtils.CellKey(x - 1, z), GridUtils.CellKey(x, z)
end

-- the four edges around a cell
function GridUtils.CellEdges(X: number, Z: number): {string}
	return {
		GridUtils.EdgeKey('X', X, Z),
		GridUtils.EdgeKey('X', X, Z + 1),
		GridUtils.EdgeKey('Z', X, Z),
		GridUtils.EdgeKey('Z', X + 1, Z),
	}
end

-- get every edge on a straight line between two points
function GridUtils.EdgesBetween(AX: number, AZ: number, BX: number, BZ: number): {string}
	local edges = {}

	if AZ == BZ and AX ~= BX then
		for x = math.min(AX, BX), math.max(AX, BX) - 1 do
			table.insert(edges, GridUtils.EdgeKey('X', x, AZ))
		end
	elseif AX == BX and AZ ~= BZ then
		for z = math.min(AZ, BZ), math.max(AZ, BZ) - 1 do
			table.insert(edges, GridUtils.EdgeKey('Z', AX, z))
		end
	end

	return edges
end

-- get every cell in the rectangle between two cells
function GridUtils.CellsBetween(AX: number, AZ: number, BX: number, BZ: number): {string}
	local cells = {}

	for x = math.min(AX, BX), math.max(AX, BX) do
		for z = math.min(AZ, BZ), math.max(AZ, BZ) do
			table.insert(cells, GridUtils.CellKey(x, z))
		end
	end

	return cells
end

-- get the edges touching a point (used for corner posts)
function GridUtils.EdgesAtPoint(X: number, Z: number): {string}
	return {
		GridUtils.EdgeKey('X', X - 1, Z),
		GridUtils.EdgeKey('X', X, Z),
		GridUtils.EdgeKey('Z', X, Z - 1),
		GridUtils.EdgeKey('Z', X, Z),
	}
end

-- get the two end points of an edge
function GridUtils.EdgePoints(Key: string): (number, number, number, number)
	local axis, x, z = GridUtils.ParseEdgeKey(Key)

	if axis == 'X' then
		return x, z, x + 1, z
	end

	return x, z, x, z + 1
end

-- parcel holding a cell
function GridUtils.CellParcel(Key: string): string
	local x, z = GridUtils.ParseCellKey(Key)
	local size = LND_CONFIGS.ParcelCells

	return GridUtils.CellKey(math.floor(x / size), math.floor(z / size))
end

-- world positions
function GridUtils.PointToWorld(Origin: Vector3, X: number, Z: number, Level: number?): Vector3
	local size = BLD_CONFIGS.CellSize

	return Origin + Vector3.new(X * size, GridUtils.LevelHeight(Level or 1), Z * size)
end

function GridUtils.CellToWorld(Origin: Vector3, X: number, Z: number, Level: number?): Vector3
	local size = BLD_CONFIGS.CellSize

	return Origin + Vector3.new((X + 0.5) * size, GridUtils.LevelHeight(Level or 1), (Z + 0.5) * size)
end

-- plot-local studs (used by furniture) to world
function GridUtils.LocalToWorld(Origin: Vector3, X: number, Z: number, Level: number?): Vector3
	return Origin + Vector3.new(X, GridUtils.LevelHeight(Level or 1), Z)
end

function GridUtils.WorldToLocal(Origin: Vector3, Position: Vector3): (number, number)
	local offset = Position - Origin

	return offset.X, offset.Z
end

-- nearest grid point to a world position
function GridUtils.WorldToPoint(Origin: Vector3, Position: Vector3): (number, number)
	local size = BLD_CONFIGS.CellSize
	local x, z = GridUtils.WorldToLocal(Origin, Position)

	return math.floor(x / size + 0.5), math.floor(z / size + 0.5)
end

-- cell under a world position
function GridUtils.WorldToCell(Origin: Vector3, Position: Vector3): (number, number)
	local size = BLD_CONFIGS.CellSize
	local x, z = GridUtils.WorldToLocal(Origin, Position)

	return math.floor(x / size), math.floor(z / size)
end

-- cell that holds a plot-local position
function GridUtils.LocalToCell(X: number, Z: number): string
	local size = BLD_CONFIGS.CellSize

	return GridUtils.CellKey(math.floor(X / size), math.floor(Z / size))
end

return GridUtils
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW61"><Properties><string name="Name">HouseUtils</string><ProtectedString name="Source"><![CDATA[--!strict
local HouseUtils = {}

local RPS = game:GetService('ReplicatedStorage')

local MKT_CONFIGS = require(RPS.Modules.Configs.MarketConfigs)
local FUR_CONFIGS = require(RPS.Modules.Configs.FurnitureConfigs)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local BLD_UTILS = require(RPS.Modules.Utils.BuildUtils)
local FUR_UTILS = require(RPS.Modules.Utils.FurnitureUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)

export type HousePieces = {
	Walls: {{Level: number, Key: string}},
	Floors: {{Level: number, Key: string}},
	Furniture: {string},
	Dirt: {string},
}

-- rooms that make up one house while grouping
type Group = {
	Rooms: {DAT_TYPES.RoomData},
	RoomIndexes: {[number]: boolean},
	Cells: {[string]: boolean},
	Id: string,
}

local EMPTY_LEVEL: DAT_TYPES.LevelData = {Walls = {}, Floors = {}}

-- create empty land data
function HouseUtils.NewLand(): DAT_TYPES.LandData
	local levels: {[string]: DAT_TYPES.LevelData} = {}

	for level = 1, LND_CONFIGS.MaxLevels do
		levels[GRD_UTILS.LevelKey(level)] = {Walls = {}, Floors = {}}
	end

	return {
		Levels = levels,
		Furniture = {},
		Dirt = {},
	}
end

-- deep copy land data
function HouseUtils.CloneLand(Land: DAT_TYPES.LandData): DAT_TYPES.LandData
	local copy = HouseUtils.NewLand()

	for levelKey, levelData in Land.Levels do
		local levelCopy: DAT_TYPES.LevelData = {Walls = {}, Floors = {}}

		for key, wall in levelData.Walls do
			levelCopy.Walls[key] = table.clone(wall)
		end

		for key, style in levelData.Floors do
			levelCopy.Floors[key] = style
		end

		copy.Levels[levelKey] = levelCopy
	end

	for id, item in Land.Furniture do
		copy.Furniture[id] = table.clone(item)
	end

	for id, dirt in Land.Dirt do
		copy.Dirt[id] = table.clone(dirt)
	end

	return copy
end

-- get one floor's walls and floors (empty if missing)
function HouseUtils.GetLevel(Land: DAT_TYPES.LandData, Level: number): DAT_TYPES.LevelData
	return Land.Levels[GRD_UTILS.LevelKey(Level)] or EMPTY_LEVEL
end

-- most dirt spots a house of this size can have
function HouseUtils.GetMaxDirt(CellCount: number): number
	return math.max(1, math.floor(CellCount / MKT_CONFIGS.CellsPerDirt))
end

-- value multiplier for a number of dirt spots
function HouseUtils.GetCleanFactor(DirtCount: number): number
	return math.max(MKT_CONFIGS.MinCleanFactor, 1 - DirtCount * MKT_CONFIGS.DirtPenalty)
end

-- get the starting rent per minute for a house value
function HouseUtils.GetBaseRent(Value: number): number
	return math.max(1, math.floor(Value * MKT_CONFIGS.RentPerMinuteRate))
end

-- find every valid room on one floor (closed in by walls, fully floored, has a way in)
function HouseUtils.GetRooms(Land: DAT_TYPES.LandData, Level: number, Stairwells: {[string]: boolean}): {DAT_TYPES.RoomData}
	local levelData = HouseUtils.GetLevel(Land, Level)
	local size = GRD_UTILS.LandCells
	local visited: {[string]: boolean} = {}
	local rooms: {DAT_TYPES.RoomData} = {}

	-- a stair opening counts as floor and as a way in
	local function isFloored(Key: string): boolean
		return levelData.Floors[Key] ~= nil or Stairwells[GRD_UTILS.LevelCell(Level, Key)] == true
	end

	for startKey in levelData.Floors do
		if visited[startKey] then
			continue
		end

		visited[startKey] = true

		local startX, startZ = GRD_UTILS.ParseCellKey(startKey)
		local queue: {{number}} = {{startX, startZ}}
		local cells: {string} = {}
		local head = 1

		local outdoor = false
		local floored = true
		local hasEntrance = false

		-- flood fill until walls stop us
		while head <= #queue do
			local x, z = queue[head][1], queue[head][2]
			head += 1

			local key = GRD_UTILS.CellKey(x, z)
			table.insert(cells, key)

			if not isFloored(key) then
				floored = false
			end

			if Stairwells[GRD_UTILS.LevelCell(Level, key)] then
				hasEntrance = true
			end

			local neighbours = {
				{x - 1, z, GRD_UTILS.EdgeKey('Z', x, z)},
				{x + 1, z, GRD_UTILS.EdgeKey('Z', x + 1, z)},
				{x, z - 1, GRD_UTILS.EdgeKey('X', x, z)},
				{x, z + 1, GRD_UTILS.EdgeKey('X', x, z + 1)},
			}

			for _, neighbour in neighbours do
				local nextX = neighbour[1] :: number
				local nextZ = neighbour[2] :: number
				local wall = levelData.Walls[neighbour[3] :: string]

				if wall then
					if wall.Kind == 'Door' then
						hasEntrance = true
					end

					continue
				end

				if nextX < 0 or nextZ < 0 or nextX >= size or nextZ >= size then
					outdoor = true
					continue
				end

				local nextKey = GRD_UTILS.CellKey(nextX, nextZ)

				if not visited[nextKey] then
					visited[nextKey] = true
					table.insert(queue, {nextX, nextZ})
				end
			end
		end

		if not outdoor and floored and hasEntrance and #cells >= MKT_CONFIGS.MinRoomCells then
			table.insert(rooms, {
				Level = Level,
				Cells = cells,
				Size = #cells,
				Type = nil,
				Lit = 0,
				LitCells = {},
			})
		end
	end

	return rooms
end

-- find every house: rooms joined by doors, or stacked on top of each other
-- returns the houses (sorted by id) and a map of level cell -> house id
function HouseUtils.GetHouses(Land: DAT_TYPES.LandData): ({DAT_TYPES.HouseInfo}, {[string]: string})
	local stairwells = FUR_UTILS.GetStairwells(Land)
	local rooms: {DAT_TYPES.RoomData} = {}
	local cellRoom: {[string]: number} = {}

	for level = 1, LND_CONFIGS.MaxLevels do
		for _, room in HouseUtils.GetRooms(Land, level, stairwells) do
			table.insert(rooms, room)

			for _, cell in room.Cells do
				cellRoom[GRD_UTILS.LevelCell(level, cell)] = #rooms
			end
		end
	end

	-- union-find over rooms
	local parent: {number} = {}

	for index in rooms do
		parent[index] = index
	end

	local function find(Index: number): number
		while parent[Index] ~= Index do
			parent[Index] = parent[parent[Index]]
			Index = parent[Index]
		end

		return Index
	end

	local function union(A: number, B: number)
		local rootA, rootB = find(A), find(B)

		if rootA ~= rootB then
			parent[rootB] = rootA
		end
	end

	for index, room in rooms do
		local levelData = HouseUtils.GetLevel(Land, room.Level)

		for _, cell in room.Cells do
			-- through doors
			local x, z = GRD_UTILS.ParseCellKey(cell)

			for _, edge in GRD_UTILS.CellEdges(x, z) do
				local wall = levelData.Walls[edge]

				if wall and wall.Kind == 'Door' then
					local a, b = GRD_UTILS.EdgeCells(edge)
					local other = if a == cell then b else a
					local otherRoom = cellRoom[GRD_UTILS.LevelCell(room.Level, other)]

					if otherRoom then
						union(index, otherRoom)
					end
				end
			end

			-- stacked floors
			if room.Level > 1 then
				local below = cellRoom[GRD_UTILS.LevelCell(room.Level - 1, cell)]

				if below then
					union(index, below)
				end
			end
		end
	end

	-- room types from key furniture, and which lights are in which room
	local votes: {[number]: {[CFG_TYPES.RoomType]: number}} = {}
	local roomLights: {[number]: {DAT_TYPES.FurnitureData}} = {}
	local itemRoom: {[string]: number} = {}

	for id, item in Land.Furniture do
		local config = FUR_CONFIGS.Items[item.Name]
		local index = cellRoom[GRD_UTILS.LevelCell(item.Level, GRD_UTILS.LocalToCell(item.X, item.Z))]

		if not config or not index then
			continue
		end

		itemRoom[id] = index

		if config.Room then
			votes[index] = votes[index] or {}
			votes[index][config.Room] = (votes[index][config.Room] or 0) + 1
		end

		if config.LightRange then
			roomLights[index] = roomLights[index] or {}
			table.insert(roomLights[index], item)
		end
	end

	local cellSize = BLD_CONFIGS.CellSize

	for index, room in rooms do
		-- type
		local best: CFG_TYPES.RoomType? = nil
		local bestVotes = 0

		for roomType, count in votes[index] or {} do
			local better = count > bestVotes
				or (count == bestVotes and best ~= nil
					and MKT_CONFIGS.RoomTypes[roomType].Order < MKT_CONFIGS.RoomTypes[best].Order)

			if better then
				best = roomType
				bestVotes = count
			end
		end

		room.Type = best

		-- lighting: lamps light tiles in range, windows light the tile next to them
		local levelData = HouseUtils.GetLevel(Land, room.Level)
		local lights = roomLights[index] or {}
		local lit = 0

		for _, cell in room.Cells do
			local x, z = GRD_UTILS.ParseCellKey(cell)
			local centerX, centerZ = (x + 0.5) * cellSize, (z + 0.5) * cellSize
			local isLit = false

			for _, edge in GRD_UTILS.CellEdges(x, z) do
				local wall = levelData.Walls[edge]

				if wall and wall.Kind == 'Window' then
					isLit = true
					break
				end
			end

			if not isLit then
				for _, item in lights do
					local range = FUR_CONFIGS.Items[item.Name].LightRange or 0
					local dx, dz = item.X - centerX, item.Z - centerZ

					if dx * dx + dz * dz <= range * range then
						isLit = true
						break
					end
				end
			end

			if isLit then
				lit += 1
				room.LitCells[cell] = true
			end
		end

		room.Lit = lit
	end

	-- group rooms into houses
	local groups: {[number]: Group} = {}

	for index, room in rooms do
		local root = find(index)
		local group = groups[root]

		if not group then
			group = {Rooms = {}, RoomIndexes = {}, Cells = {}, Id = ''}
			groups[root] = group
		end

		assert(group)

		table.insert(group.Rooms, room)
		group.RoomIndexes[index] = true

		for _, cell in room.Cells do
			local levelCell = GRD_UTILS.LevelCell(room.Level, cell)
			group.Cells[levelCell] = true

			if group.Id == '' or levelCell < group.Id then
				group.Id = levelCell
			end
		end
	end

	local houses: {DAT_TYPES.HouseInfo} = {}
	local cellHouse: {[string]: string} = {}

	for _, group in groups do
		local total = 0
		local cellCount, litCount = 0, 0
		local sumX, sumZ, topLevel = 0, 0, 1
		local countedWalls: {[string]: boolean} = {}

		-- walls and floors around / under every tile
		for levelCell in group.Cells do
			local level, cell = GRD_UTILS.ParseLevelCell(levelCell)
			local levelData = HouseUtils.GetLevel(Land, level)
			local x, z = GRD_UTILS.ParseCellKey(cell)

			cellCount += 1
			sumX += (x + 0.5) * cellSize
			sumZ += (z + 0.5) * cellSize
			topLevel = math.max(topLevel, level)
			cellHouse[levelCell] = group.Id

			local style = levelData.Floors[cell]
			local floorConfig = style and BLD_CONFIGS.FloorStyles[style]

			if floorConfig then
				total += floorConfig.Value
			end

			for _, edge in GRD_UTILS.CellEdges(x, z) do
				local wall = levelData.Walls[edge]
				local wallKey = `{level}|{edge}`

				if wall and not countedWalls[wallKey] then
					countedWalls[wallKey] = true
					total += BLD_UTILS.GetWallValue(wall)
				end
			end
		end

		-- furniture
		for id, index in itemRoom do
			if group.RoomIndexes[index] then
				local item = Land.Furniture[id]
				local config = FUR_CONFIGS.Items[item.Name]

				total += config.Price * (config.ValueRate or MKT_CONFIGS.FurnitureValueRate)
			end
		end

		-- room bonuses (biggest rooms of each type count first)
		local sorted = table.clone(group.Rooms)
		local counted: {[CFG_TYPES.RoomType]: number} = {}

		table.sort(sorted, function(A, B)
			return A.Size > B.Size
		end)

		for _, room in sorted do
			litCount += room.Lit

			local roomType = room.Type

			if not roomType then
				continue
			end

			local config = MKT_CONFIGS.RoomTypes[roomType]
			local count = counted[roomType] or 0

			if count < MKT_CONFIGS.MaxBonusRoomsPerType then
				counted[roomType] = count + 1
				total += config.Bonus * math.min(1, room.Size / config.IdealCells)
			end
		end

		-- requirements
		local missing: {CFG_TYPES.RoomType} = {}

		for _, roomType in MKT_CONFIGS.RequiredRooms do
			if not counted[roomType] then
				table.insert(missing, roomType)
			end
		end

		local complete = true

		for _, roomType in MKT_CONFIGS.CompleteRooms do
			if not counted[roomType] then
				complete = false
			end
		end

		-- lighting and completeness
		local litFraction = if cellCount > 0 then litCount / cellCount else 0
		local minLight = MKT_CONFIGS.MinLightFactor

		total *= minLight + (1 - minLight) * litFraction

		if complete then
			total *= MKT_CONFIGS.CompleteMultiplier
		end

		table.insert(houses, {
			Id = group.Id,
			Rooms = group.Rooms,
			Cells = group.Cells,
			CellCount = cellCount,
			LitFraction = litFraction,
			DirtCount = 0,
			Cleanliness = 1,
			BaseValue = math.floor(total),
			Value = math.floor(total),
			Livable = #missing == 0,
			Complete = complete,
			Missing = missing,
			CenterX = sumX / math.max(1, cellCount),
			CenterZ = sumZ / math.max(1, cellCount),
			TopLevel = topLevel,
		})
	end

	-- dirt lowers value
	local houseById: {[string]: DAT_TYPES.HouseInfo} = {}

	for _, house in houses do
		houseById[house.Id] = house
	end

	for _, dirt in Land.Dirt do
		local houseId = cellHouse[GRD_UTILS.LevelCell(dirt.Level, dirt.Cell)]
		local house = houseId and houseById[houseId]

		if house then
			house.DirtCount += 1
		end
	end

	for _, house in houses do
		house.Cleanliness = HouseUtils.GetCleanFactor(house.DirtCount)
		house.Value = math.floor(house.BaseValue * house.Cleanliness)
	end

	table.sort(houses, function(A, B)
		return A.Id < B.Id
	end)

	return houses, cellHouse
end

-- everything that belongs to a house (walls shared with another house are kept)
function HouseUtils.GetHousePieces(Land: DAT_TYPES.LandData, House: DAT_TYPES.HouseInfo, CellHouse: {[string]: string}): HousePieces
	local pieces: HousePieces = {Walls = {}, Floors = {}, Furniture = {}, Dirt = {}}
	local seenWalls: {[string]: boolean} = {}

	for levelCell in House.Cells do
		local level, cell = GRD_UTILS.ParseLevelCell(levelCell)
		local levelData = HouseUtils.GetLevel(Land, level)
		local x, z = GRD_UTILS.ParseCellKey(cell)

		if levelData.Floors[cell] then
			table.insert(pieces.Floors, {Level = level, Key = cell})
		end

		for _, edge in GRD_UTILS.CellEdges(x, z) do
			local wallKey = `{level}|{edge}`

			if not levelData.Walls[edge] or seenWalls[wallKey] then
				continue
			end

			seenWalls[wallKey] = true

			local a, b = GRD_UTILS.EdgeCells(edge)
			local other = if a == cell then b else a
			local otherHouse = CellHouse[GRD_UTILS.LevelCell(level, other)]

			if not otherHouse or otherHouse == House.Id then
				table.insert(pieces.Walls, {Level = level, Key = edge})
			end
		end
	end

	for id, item in Land.Furniture do
		if House.Cells[GRD_UTILS.LevelCell(item.Level, GRD_UTILS.LocalToCell(item.X, item.Z))] then
			table.insert(pieces.Furniture, id)
		end
	end

	for id, dirt in Land.Dirt do
		if House.Cells[GRD_UTILS.LevelCell(dirt.Level, dirt.Cell)] then
			table.insert(pieces.Dirt, id)
		end
	end

	return pieces
end

-- tile columns ("x_z", every floor) covered by a list of level cells
function HouseUtils.GetColumns(LevelCells: {string}): {[string]: boolean}
	local columns: {[string]: boolean} = {}

	for _, levelCell in LevelCells do
		local _, cell = GRD_UTILS.ParseLevelCell(levelCell)
		columns[cell] = true
	end

	return columns
end

-- turn a house's cell set into a sorted list (for saving)
function HouseUtils.GetCellList(House: DAT_TYPES.HouseInfo): {string}
	local list = {}

	for levelCell in House.Cells do
		table.insert(list, levelCell)
	end

	table.sort(list)

	return list
end

return HouseUtils
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW62"><Properties><string name="Name">InputUtils</string><ProtectedString name="Source"><![CDATA[--!strict
-- client-side helpers for working out what the mouse / finger is pointing at
local InputUtils = {}

local UIS = game:GetService('UserInputService')
local WKS = game:GetService('Workspace')

local RAY_LENGTH = 1000

-- ray from the camera through the pointer
function InputUtils.GetPointerRay(): Ray
	local camera = WKS.CurrentCamera
	local location = UIS:GetMouseLocation()

	return camera:ViewportPointToRay(location.X, location.Y)
end

-- where the pointer meets a flat plane at a height (ignores every part)
function InputUtils.HitPlane(Height: number): Vector3?
	local ray = InputUtils.GetPointerRay()

	if math.abs(ray.Direction.Y) < 1e-4 then
		return nil
	end

	local distance = (Height - ray.Origin.Y) / ray.Direction.Y

	if distance < 0 or distance > RAY_LENGTH then
		return nil
	end

	return ray.Origin + ray.Direction * distance
end

-- raycast from the pointer, only hitting the given instances
function InputUtils.RaycastInclude(Include: {Instance}): RaycastResult?
	local ray = InputUtils.GetPointerRay()
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = Include

	return WKS:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, params)
end

-- check an input is a click / tap
function InputUtils.IsPress(Input: InputObject): boolean
	return Input.UserInputType == Enum.UserInputType.MouseButton1
		or Input.UserInputType == Enum.UserInputType.Touch
end

return InputUtils
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW63"><Properties><string name="Name">InterfaceUtils</string><ProtectedString name="Source"><![CDATA[--!strict
local InterfaceUtils = {}

InterfaceUtils.Colors = {
	Button = Color3.fromRGB(118, 132, 172),
	Active = Color3.fromRGB(66, 135, 245),
	Green = Color3.fromRGB(76, 190, 92),
	Red = Color3.fromRGB(235, 84, 84),
	Gold = Color3.fromRGB(255, 196, 40),
	Ink = Color3.fromRGB(34, 38, 66),
	Money = Color3.fromRGB(120, 255, 140),
	Muted = Color3.fromRGB(112, 118, 140),
	White = Color3.new(1, 1, 1),
}

-- clone a hidden template and mark the copy so it can be cleared later
function InterfaceUtils.CloneTemplate(Template: GuiObject): GuiObject
	local clone = Template:Clone()
	clone.Visible = true
	clone:SetAttribute('Clone', true)
	clone.Parent = Template.Parent

	return clone
end

-- destroy every copy made with CloneTemplate inside a container
function InterfaceUtils.ClearClones(Container: Instance)
	for _, child in Container:GetChildren() do
		if child:GetAttribute('Clone') then
			child:Destroy()
		end
	end
end

-- show a button as picked / not picked
function InterfaceUtils.SetPicked(Button: GuiObject, Picked: boolean)
	local stroke = Button:FindFirstChildOfClass('UIStroke')

	if stroke then
		stroke.Color = if Picked then InterfaceUtils.Colors.Gold else InterfaceUtils.Colors.Ink
		stroke.Thickness = if Picked then 5 else 3
	end
end

-- find a child and make sure it is the expected class (errors early if the UI was renamed)
function InterfaceUtils.Get(Parent: Instance, Name: string, ClassName: string): Instance
	local child = Parent:WaitForChild(Name, 10)

	assert(child, `[InterfaceUtils]: Missing {Name} in {Parent:GetFullName()}`)
	assert(child:IsA(ClassName), `[InterfaceUtils]: {child:GetFullName()} should be a {ClassName}`)

	return child
end

return InterfaceUtils
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW64"><Properties><string name="Name">LandUtils</string><ProtectedString name="Source"><![CDATA[--!strict
local LandUtils = {}

local RPS = game:GetService('ReplicatedStorage')

local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)

-- how many parcels are owned
function LandUtils.CountParcels(Parcels: {[string]: boolean}): number
	local count = 0

	for _, owned in Parcels do
		if owned then
			count += 1
		end
	end

	return count
end

-- cash price of the next parcel (nil when every parcel is owned)
function LandUtils.GetNextPrice(Parcels: {[string]: boolean}): number?
	return LND_CONFIGS.ParcelPrices[LandUtils.CountParcels(Parcels)]
end

-- Robux product tier for the next parcel
function LandUtils.GetParcelTier(Parcels: {[string]: boolean}): CFG_TYPES.ParcelTierConfig?
	local owned = LandUtils.CountParcels(Parcels)

	for _, tier in LND_CONFIGS.ParcelTiers do
		if owned <= tier.MaxOwned then
			return tier
		end
	end

	return nil
end

-- check a parcel key is on the land
function LandUtils.IsParcelInside(Key: string): boolean
	local parts = string.split(Key, '_')
	local x, z = tonumber(parts[1]), tonumber(parts[2])
	local size = LND_CONFIGS.ParcelGrid

	return #parts == 2 and x ~= nil and z ~= nil and x % 1 == 0 and z % 1 == 0
		and x >= 0 and z >= 0 and x < size and z < size
end

-- a parcel can be bought when it is free and touches one you own
function LandUtils.CanBuyParcel(Parcels: {[string]: boolean}, Key: string): boolean
	if not LandUtils.IsParcelInside(Key) or Parcels[Key] then
		return false
	end

	local x, z = GRD_UTILS.ParseCellKey(Key)

	for _, offset in {{1, 0}, {-1, 0}, {0, 1}, {0, -1}} do
		if Parcels[GRD_UTILS.CellKey(x + offset[1], z + offset[2])] then
			return true
		end
	end

	return false
end

-- first parcel that can be bought (used when a Robux purchase has no parcel picked)
function LandUtils.GetFirstBuyable(Parcels: {[string]: boolean}): string?
	for x = 0, LND_CONFIGS.ParcelGrid - 1 do
		for z = LND_CONFIGS.ParcelGrid - 1, 0, -1 do
			local key = GRD_UTILS.CellKey(x, z)

			if LandUtils.CanBuyParcel(Parcels, key) then
				return key
			end
		end
	end

	return nil
end

-- check a cell is on owned land
function LandUtils.IsCellOwned(Parcels: {[string]: boolean}, Cell: string): boolean
	return GRD_UTILS.IsCellInside(Cell) and Parcels[GRD_UTILS.CellParcel(Cell)] == true
end

-- a wall can go on an edge when the tile on either side is owned
function LandUtils.IsEdgeOwned(Parcels: {[string]: boolean}, Edge: string): boolean
	if not GRD_UTILS.IsEdgeInside(Edge) then
		return false
	end

	local a, b = GRD_UTILS.EdgeCells(Edge)

	return LandUtils.IsCellOwned(Parcels, a) or LandUtils.IsCellOwned(Parcels, b)
end

return LandUtils
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW65"><Properties><string name="Name">MonetizationUtils</string><ProtectedString name="Source"><![CDATA[--!strict
-- shared gamepass checks (the server stores owned passes as player attributes)
local MonetizationUtils = {}

-- attribute name for a gamepass
function MonetizationUtils.PassAttribute(Name: string): string
	return `Pass_{Name}`
end

-- check a player owns a gamepass (works on server and client)
function MonetizationUtils.HasPass(Player: Player, Name: string): boolean
	return Player:GetAttribute(MonetizationUtils.PassAttribute(Name)) == true
end

return MonetizationUtils
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW66"><Properties><string name="Name">StringUtils</string><ProtectedString name="Source"><![CDATA[--!strict
local StringUtils = {}

local SUFFIXES = {'', 'K', 'M', 'B', 'T'}

-- 1234567 -> "1,234,567"
function StringUtils.FormatNumber(Amount: number): string
	local whole = tostring(math.floor(math.abs(Amount)))
	local grouped = string.gsub(whole:reverse(), '(%d%d%d)', '%1,')
	local formatted = grouped:reverse()

	if formatted:sub(1, 1) == ',' then
		formatted = formatted:sub(2)
	end

	return if Amount < 0 then `-{formatted}` else formatted
end

-- 1234567 -> "$1,234,567"
function StringUtils.FormatCash(Amount: number): string
	return `${StringUtils.FormatNumber(Amount)}`
end

-- 1234567 -> "1.2M"
function StringUtils.GetCondensedAmount(Amount: number): string
	local value = math.abs(Amount)
	local index = 1

	while value >= 1000 and index < #SUFFIXES do
		value /= 1000
		index += 1
	end

	local text = if index == 1
		then tostring(math.floor(value))
		else (string.gsub(string.format('%.1f', math.floor(value * 10) / 10), '%.0$', ''))

	return `{if Amount < 0 then '-' else ''}{text}{SUFFIXES[index]}`
end

return StringUtils
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="NEW98"><Properties><string name="Name">Remotes</string></Properties><Item class="Folder" referent="NEW74"><Properties><string name="Name">BuildService</string></Properties><Item class="RemoteEvent" referent="NEW69"><Properties><string name="Name">PlaceFloors</string></Properties></Item><Item class="RemoteEvent" referent="NEW70"><Properties><string name="Name">PlaceRoom</string></Properties></Item><Item class="RemoteEvent" referent="NEW71"><Properties><string name="Name">PlaceWalls</string></Properties></Item><Item class="RemoteEvent" referent="NEW72"><Properties><string name="Name">RemovePiece</string></Properties></Item><Item class="RemoteEvent" referent="NEW73"><Properties><string name="Name">Undo</string></Properties></Item></Item><Item class="Folder" referent="NEW77"><Properties><string name="Name">EconomyService</string></Properties><Item class="RemoteEvent" referent="NEW75"><Properties><string name="Name">Deducted</string></Properties></Item><Item class="RemoteEvent" referent="NEW76"><Properties><string name="Name">Rewarded</string></Properties></Item></Item><Item class="Folder" referent="NEW82"><Properties><string name="Name">FurnitureService</string></Properties><Item class="RemoteEvent" referent="NEW78"><Properties><string name="Name">MoveFurniture</string></Properties></Item><Item class="RemoteEvent" referent="NEW79"><Properties><string name="Name">PlaceFurniture</string></Properties></Item><Item class="RemoteEvent" referent="NEW80"><Properties><string name="Name">RemoveFurniture</string></Properties></Item><Item class="RemoteEvent" referent="NEW81"><Properties><string name="Name">RotateFurniture</string></Properties></Item></Item><Item class="Folder" referent="NEW84"><Properties><string name="Name">InterfaceService</string></Properties><Item class="RemoteEvent" referent="NEW83"><Properties><string name="Name">Notify</string></Properties></Item></Item><Item class="Folder" referent="NEW92"><Properties><string name="Name">MarketService</string></Properties><Item class="RemoteEvent" referent="NEW85"><Properties><string name="Name">AcceptOffer</string></Properties></Item><Item class="RemoteEvent" referent="NEW86"><Properties><string name="Name">CollectRent</string></Properties></Item><Item class="RemoteEvent" referent="NEW87"><Properties><string name="Name">DeclineOffer</string></Properties></Item><Item class="RemoteEvent" referent="NEW88"><Properties><string name="Name">Evict</string></Properties></Item><Item class="RemoteEvent" referent="NEW89"><Properties><string name="Name">ListHouse</string></Properties></Item><Item class="RemoteEvent" referent="NEW90"><Properties><string name="Name">ListingsUpdated</string></Properties></Item><Item class="RemoteEvent" referent="NEW91"><Properties><string name="Name">Unlist</string></Properties></Item></Item><Item class="Folder" referent="NEW94"><Properties><string name="Name">MonetizationService</string></Properties><Item class="RemoteEvent" referent="NEW93"><Properties><string name="Name">SetPendingParcel</string></Properties></Item></Item><Item class="Folder" referent="NEW97"><Properties><string name="Name">PlotService</string></Properties><Item class="RemoteEvent" referent="NEW95"><Properties><string name="Name">BuyParcel</string></Properties></Item><Item class="RemoteEvent" referent="NEW96"><Properties><string name="Name">UnlockLevel</string></Properties></Item></Item></Item></Item><Item class="ScriptService" referent="RBX1454"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name">ScriptService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="Selection" referent="RBX1451"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name">Selection</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="SerializationService" referent="RBX1559"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name">SerializationService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ServerScriptService" referent="RBX1560"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><bool name="LoadStringEnabled">false</bool><string name="Name">ServerScriptService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Script" referent="NEW133"><Properties><string name="Name">Runtime</string><ProtectedString name="Source"><![CDATA[--!strict
