	}
}

export type ActiveTrooperData = {
	Target: ActiveTrooperData?,
	
	ConfigKey: string,
	Index: string | number,
	
	Model: Model,
	RootPart: BasePart,
	Animator: Animator,
	Humanoid: Humanoid,
	
	Level: number,
