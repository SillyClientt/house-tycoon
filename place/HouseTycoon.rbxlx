local Velvet = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local WKS = game:GetService('Workspace')
local PPS = game:GetService('ProximityPromptService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local RWD_UTILS = require(RPS.Modules.Services.RewardService.RewardUtils)
local TOL_CONFIGS = require(RPS.Modules.Services.ToolService.ToolConfigs)
local STR_CONFIGS = require(RPS.Modules.Services.StoreService.StoreConfigs)
local IMG_CONFIGS = require(RPS.Modules.Services.ImageService.ImageConfigs)
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)

local plr = PLS.LocalPlayer :: Player
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local velvet = gui:WaitForChild('Velvet')
local store = velvet:WaitForChild('Store')
local collection = velvet:WaitForChild('Collection')
local closeB = velvet:WaitForChild('Close')
local currencies = velvet:WaitForChild('Currencies')
local scroller = collection:WaitForChild('Scroller')
local itemTemplate = scroller:WaitForChild('Item')

local tweens: {[Instance]: Tween} = {}

local orders: {Tool: {[string]: number}, Skin: {[string]: number}} = {
	Tool = {
		Sponge = 0,
		Scraper = 10,
		Toothbrush = 20,
		Helmet = 30,
		Station = 40
	},
	
	Skin = {
		Kelp = 0,
		Coral = 100,
		Toxic = 200,
		Gold = 300,
		Pearl = 400,
		Daily = 500
	}
}

local toggle = false
local newStock = false
local lastSound: Sound?
local selected: typeof(itemTemplate)?

-- rotate button on hover
local function addButtonEffect(Button: GuiButton, Hover: {[string]: any}?, Leave: {[string]: any}?)
	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), Hover or {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1)
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), Leave or {
			Rotation = 0,
			Size = size
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- select skin item button
local function selectItem(ItemButton: typeof(itemTemplate)?)
	if not ItemButton and selected then
		selected.Equip.Visible = false
		selected.Unequip.Visible = false
		return
	end
	
	if ItemButton then
		if ItemButton.Locked.Visible then
			INT_CSignals.Notify:Fire('This item is locked! Buy it to unlock it!')
			return
		end
		
		if selected then
			selected.Equip.Visible = false
			selected.Unequip.Visible = false
		end

		local skinsData = DAT_Client:get('Skins')
		
		local tool = ItemButton:GetAttribute('Tool') :: string
		local skin = ItemButton:GetAttribute('Skin') :: string
		
		if not skinsData[skin] or not skinsData[skin][tool] then
			ItemButton.Equip.Visible = false
			ItemButton.Unequip.Visible = false
			return
		end

		local equippedData = DAT_Client:get('EquippedTools')
		local station = DAT_Client:get('StationSkin')
		local helmet = DAT_Client:get('HelmetSkin')
		
		if tool == 'Helmet' then
			ItemButton.Equip.Visible = helmet ~= skin
			ItemButton.Unequip.Visible = helmet == skin
		elseif tool == 'Station' then
			ItemButton.Equip.Visible = station ~= skin
			ItemButton.Unequip.Visible = station == skin
		else
			local equipped = equippedData[tool]
			
			ItemButton.Equip.Visible = equipped ~= skin
			ItemButton.Unequip.Visible = equipped == skin
		end
		
		selected = ItemButton
	end
end

-- restock velvet's store stock
local function updateStock(StockData: any?)
	local stockData = DAT_Client:get('VelvetStock')
	local newStock = StockData or stockData.Stock

	local skinsData = DAT_Client:get('Skins')
	
	for tool, inStock in newStock do
		local config = STR_CONFIGS.Skins[inStock]
		
		local itemB = store.Items:FindFirstChild(tool) :: typeof(store.Items.Helmet)
		local skinTitle = store.Skins:FindFirstChild(tool) :: TextLabel
		local mutationCost = store.MutationCosts:FindFirstChild(tool) :: typeof(store.MutationCosts.Helmet)
		local shellsCost = store.ShellCosts:FindFirstChild(tool) :: typeof(store.ShellCosts.Helmet)
		local unlocked = skinsData[config.SkinCurrency] and skinsData[config.SkinCurrency][config.Tool] and true or false
		local buyB = itemB.Buy

		itemB.Icon.Image = config.Image
		itemB.Owned.Visible = unlocked
		
		if itemB.Buy.Visible then
			itemB.Buy.Visible = not unlocked
		end
		
		skinTitle.Text = config.DisplayName:upper()
		
		mutationCost.Amount.Text = RWD_UTILS.ToString(config.Cost)
		mutationCost.Icon.Image = IMG_CONFIGS[config.SkinCurrency]
		
		shellsCost.Amount.Text = RWD_UTILS.ToString(config.ShellsCost)
		
		if itemB:GetAttribute('Connected') then
			continue
		end
		
		itemB:SetAttribute('Connected', true)
		
		addButtonEffect(buyB)
		
		buyB.Activated:Connect(function()
			RPS.Remotes.ToolService.BuySkin:FireServer(tool)
		end)
		
		itemB.Activated:Connect(function()
			for _, child in store.Items:GetChildren() :: {typeof(store.Items.Helmet)} do
				child.Buy.Visible = child.Name == itemB.Name and not child.Owned.Visible
			end
		end)
	end
	
	local char = plr.Character or plr.CharacterAdded:Wait()
	
	for toolName, config in STR_CONFIGS.Skins do
		local found = scroller:FindFirstChild(toolName) :: typeof(itemTemplate)?
		local item = found or itemTemplate:Clone()
		local unlocked = skinsData[config.SkinCurrency] and skinsData[config.SkinCurrency][config.Tool] and true or false

		local order = 0
		
		item.Visible = config.Tool ~= 'Toothbrush'
		
		order += orders.Tool[config.Tool] or 0
		order += orders.Skin[config.SkinCurrency] or 0
		
		item.Name = toolName
		item.Icon.Image = config.Image
		item.Title.Text = config.DisplayName:upper()
		
		item.LayoutOrder = order
		
		item.Equipped.Visible = plr.Backpack:FindFirstChild(toolName) and true or char:FindFirstChild(toolName) and true or false
		
		if item.Equipped.Visible then
			item.Locked.Visible = false
		else
			item.Locked.Visible = not unlocked
		end
		
		item.Visible = true
		item.Parent = scroller
			
		if not found then
			item:SetAttribute('Tool', config.Tool)
			item:SetAttribute('Skin', config.SkinCurrency)
			
			addButtonEffect(item)
			
			addButtonEffect(item.Equip)
			addButtonEffect(item.Unequip)
			
			item.Equip.Activated:Connect(function()
				RPS.Remotes.ToolService.EquipSkin:FireServer(config.Tool, config.SkinCurrency)
			end)
			
			item.Unequip.Activated:Connect(function()
				RPS.Remotes.ToolService.UnequipSkin:FireServer(config.Tool)
			end)
			
			item.Activated:Connect(function()
				selectItem(item, config.Tool, config.SkinCurrency)
			end)
		end
	end
	
	selectItem(selected)
end

-- toggle store
local function toggleStore(Toggle: boolean)
	local old = toggle
	
	if not velvet.Visible then
		old = false
	end
	
	if Toggle == nil then
		toggle = not toggle
	else
		toggle = Toggle
	end
	
	if toggle == old then
		return
	end

	if tweens[velvet] then
		tweens[velvet]:Destroy()
	end
	
	if toggle and not velvet.Visible then
		velvet.GroupTransparency = 1
		velvet.Visible = true
	end
	
	if toggle then
		if lastSound then
			lastSound:Stop()
		end
		
		local sound = script.NewStock
		
		if not newStock then
			local greetings = script.Greetings:GetChildren() :: {Sound}
			sound = greetings[math.random(1, #greetings)]
		end
		
		sound:Play()
		lastSound = sound
	end

	local finalTransparency = toggle and 0 or 1
	velvet.Interactable = toggle

	tweens[velvet] = TWS:Create(velvet, TweenInfo.new(.25, Enum.EasingStyle.Cubic), {
		GroupTransparency = finalTransparency
	})
	tweens[velvet]:Play()
end

-- initialize velvet ui
function Velvet:Init()
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		if Prompt:HasTag('VelvetPrompt') and Player == plr then
			toggleStore(true)

			Prompt.PromptHidden:Once(function()
				if lastSound then
					lastSound:Stop()
				end
				toggleStore(false)
			end)
		end
	end)
	
	updateStock()
	RPS.Remotes.ToolService.UpdateVelvetStock.OnClientEvent:Connect(updateStock)
	
	RPS.Remotes.ToolService.UpdateVelvetTimer.OnClientEvent:Connect(function(Timer: number)
		store.Stock.Timer.Text = 'NEW STYLES IN '..RWD_UTILS.ToTimer2(math.max(Timer, 0))
	end)

	addButtonEffect(closeB)

	closeB.Activated:Connect(function()
		if collection.Visible then
			collection.Visible = false
			return
		end
		
		toggleStore(false)
	end)
	
	addButtonEffect(store.ViewCollection)
	
	store.ViewCollection.Activated:Connect(function()
		collection.Visible = not collection.Visible
	end)
	
	for _, buy in store.Buy:GetChildren() :: {ImageButton} do
		addButtonEffect(buy)
		
		buy.Activated:Connect(function()
			RPS.Remotes.ToolService.BuySkin:FireServer(buy.Name)
		end)
	end
	
	DAT_Client:getChangedSignal('VelvetStock'):Connect(function()
		updateStock()
	end)
	DAT_Client:getChangedSignal('MutationCurrencies'):Connect(function(NewCurrencies)
		if typeof(NewCurrencies) == 'number' then
			return
		end
		
		for mutation, amount in NewCurrencies do
			local frame = currencies:FindFirstChild(mutation)

			if frame then
				local label = frame:FindFirstChild('Amount') :: TextLabel
				label.Text = RWD_UTILS.ToString(amount)
			end
		end
	end)
	
	DAT_Client:getChangedSignal('Shells'):Connect(function(NewShells)
		currencies.Shells.Amount.Text = RWD_UTILS.ToString(NewShells)
	end)

	local shells = DAT_Client:get('Shells')
	currencies.Shells.Amount.Text = RWD_UTILS.ToString(shells)
	
	local mutationCurrencies = DAT_Client:get('MutationCurrencies')

	for mutation, amount in mutationCurrencies do
		local frame = currencies:FindFirstChild(mutation)

		if frame then
			local label = frame:FindFirstChild('Amount') :: TextLabel
			label.Text = RWD_UTILS.ToString(amount)
		end
	end
	
	DAT_Client:getChangedSignal('Skins'):Connect(function()
		updateStock()
	end)
	DAT_Client:getChangedSignal('EquippedTools'):Connect(function()
		updateStock()
	end)
	DAT_Client:getChangedSignal('StationSkin'):Connect(function()
		updateStock()
	end)
	DAT_Client:getChangedSignal('HelmetSkin'):Connect(function()
		updateStock()
	end)
end

return Velvet
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="Folder" referent="RBX1264"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">Greetings</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Sound" referent="RBX1265"><Properties><bool name="AcousticSimulationEnabled">true</bool><BinaryString name="AttributesSerialize"></BinaryString><Content name="SoundId"><url>rbxassetid://99127411765630</url></Content><bool name="DefinesCapabilities">false</bool><NumberRange name="LoopRegion">0 60000 </NumberRange><bool name="Looped">false</bool><string name="Name">Greeting1</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0 60000 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1</float><bool name="Playing">false</bool><float name="RollOffMaxDistance">10000</float><float name="RollOffMinDistance">10</float><token name="RollOffMode">3</token><string name="SerializedOverrides"></string><Ref name="SoundGroup">null</Ref><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0</double><float name="Volume">2</float></Properties></Item><Item class="Sound" referent="RBX1266"><Properties><bool name="AcousticSimulationEnabled">true</bool><BinaryString name="AttributesSerialize"></BinaryString><Content name="SoundId"><url>rbxassetid://111472231643179</url></Content><bool name="DefinesCapabilities">false</bool><NumberRange name="LoopRegion">0 60000 </NumberRange><bool name="Looped">false</bool><string name="Name">Greeting2</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0 60000 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1</float><bool name="Playing">false</bool><float name="RollOffMaxDistance">10000</float><float name="RollOffMinDistance">10</float><token name="RollOffMode">3</token><string name="SerializedOverrides"></string><Ref name="SoundGroup">null</Ref><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0</double><float name="Volume">2</float></Properties></Item></Item><Item class="Sound" referent="RBX1263"><Properties><bool name="AcousticSimulationEnabled">true</bool><BinaryString name="AttributesSerialize"></BinaryString><Content name="SoundId"><url>rbxassetid://125668450180614</url></Content><bool name="DefinesCapabilities">false</bool><NumberRange name="LoopRegion">0 60000 </NumberRange><bool name="Looped">false</bool><string name="Name">NewStock</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0 60000 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1</float><bool name="Playing">false</bool><float name="RollOffMaxDistance">10000</float><float name="RollOffMinDistance">10</float><token name="RollOffMode">3</token><string name="SerializedOverrides"></string><Ref name="SoundGroup">null</Ref><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0</double><float name="Volume">2</float></Properties></Item></Item><Item class="ModuleScript" referent="RBX1267"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Hank</string><string name="ScriptGuid">{3247f6be-f63c-4e0d-b284-70a9fdcdb034}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Hank = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local WKS = game:GetService('Workspace')
local PPS = game:GetService('ProximityPromptService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local RWD_UTILS = require(RPS.Modules.Services.RewardService.RewardUtils)
local TOL_CONFIGS = require(RPS.Modules.Services.ToolService.ToolConfigs)
local IMG_CONFIGS = require(RPS.Modules.Services.ImageService.ImageConfigs)
local INT_UTILS = require(RPS.Modules.Services.InterfaceService.InterfaceUtils)

local plr = PLS.LocalPlayer :: Player
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local hank = gui:WaitForChild('Hank')
local details = hank:WaitForChild('Details')
local sidebar = hank:WaitForChild('Sidebar'):WaitForChild('Tools')

local initPos = hank.Position
local hiddenPos = UDim2.fromScale(initPos.X.Scale, initPos.Y.Scale + 1)

local tweens: {[Instance]: Tween} = {}

local toggle = false
local newStock = false
local lastSound: Sound?
local selected = 'Sponge'

-- rotate button on hover
local function addButtonEffect(Button: GuiButton, Hover: {[string]: any}?, Leave: {[string]: any}?)
	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), Hover or {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1)
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), Leave or {
			Rotation = 0,
			Size = size
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- toggle store
local function toggleStore(Toggle: boolean)
	local old = toggle
	
	if not hank.Visible then
		old = false
	end
	
	if Toggle == nil then
		toggle = not toggle
	else
		toggle = Toggle
	end
	
	if toggle == old then
		return
	end
	
	if toggle and not hank.Visible then
		hank.Position = hiddenPos
		hank.Visible = true
	end
	
	if toggle then
		if lastSound then
			lastSound:Stop()
		end
		
		local sound = script.NewStock
		
		if not newStock then
			local greetings = script.Greetings:GetChildren() :: {Sound}
			sound = greetings[math.random(1, #greetings)]
		end
		
		sound:Play()
		lastSound = sound
	end

	local finalHankPos = toggle and initPos or hiddenPos

	INT_UTILS.TweenGuiObject(hank, TweenInfo.new(.25, Enum.EasingStyle.Cubic), {
		Position = finalHankPos
	})
end

-- update details frame to match selected tool
local function updateDetails(Tool: string?)
	selected = Tool or selected
	
	local upgradesData = DAT_Client:get('ToolUpgrades')

	local level = upgradesData[selected]
	local toolConfig = TOL_CONFIGS.Upgrades[selected :: 'Sponge' | 'Scraper']
	local config = toolConfig[level]
	local baseConfig = toolConfig[0]
	
	if not toolConfig then
		return
	end
	
	for _, child in sidebar:GetChildren() :: {typeof(sidebar.Sponge)} do
		if not child:IsA('GuiButton') then
			continue
		end
		
		local name = child.Name :: 'Sponge' | 'Scraper'

		child.Highlight.Visible = child.Name == selected
		child.Level.Text = 'Level '..upgradesData[name]
		
		for _, frame in child.Levels:GetChildren() :: {typeof(child.Levels['1'])} do
			if not frame:IsA('Frame') then
				continue
			end
			
			local num = tonumber(frame.Name)
			frame.Fill.Visible = num <= upgradesData[name]
		end
	end
	
	local nextConfig = toolConfig[level + 1]
	
	details.Efficiency.Change.Current.Text = '+'..math.floor((math.floor(config.Damage/baseConfig.Damage * 100)/100 - 1)*100)..'%'
	details.Efficiency.Change.Next.Text = nextConfig and '+'..math.floor((math.floor(nextConfig.Damage/baseConfig.Damage * 100)/100 - 1)*100)..'%' or 'MAX'
	
	details.Level.Current.Text = 'Level '..level
	details.Level.Next.Text = nextConfig and 'Level '..(level + 1) or 'MAX'
	
	details.Upgrade.Cost.Amount.Text = nextConfig and tostring(nextConfig.Cost) or 'MAX'
	details.Back.Icon.Image = IMG_CONFIGS[selected]
	
	details.Description.Text = config.Description
	details.Title.Text = selected:upper()
end

-- initialize hank ui
function Hank:Init()
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		if Prompt:HasTag('HankPrompt') and Player == plr then
			toggleStore(true)

			Prompt.PromptHidden:Once(function()
				if lastSound then
					lastSound:Stop()
				end
				toggleStore(false)
			end)
		end
	end)
	
	updateDetails(selected)
	
	addButtonEffect(hank.Close)
	hank.Close.Activated:Connect(function()
		toggleStore(false)
	end)
	
	-- init sidebar buttons
	for _, button in sidebar:GetChildren() do
		if not button:IsA('GuiButton') then
			continue
		end
		
		button.Activated:Connect(function()
			updateDetails(button.Name)
		end)
	end
	
	addButtonEffect(details.Upgrade)
	details.Upgrade.Activated:Connect(function()
		RPS.Remotes.ToolService.UpgradeTool:FireServer(selected)
	end)
	
	DAT_Client:getChangedSignal('ToolUpgrades'):Connect(function()
		updateDetails()
	end)
end

return Hank
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="Folder" referent="RBX1269"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">Greetings</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Sound" referent="RBX1270"><Properties><bool name="AcousticSimulationEnabled">true</bool><BinaryString name="AttributesSerialize"></BinaryString><Content name="SoundId"><url>rbxassetid://88532283180462</url></Content><bool name="DefinesCapabilities">false</bool><NumberRange name="LoopRegion">0 60000 </NumberRange><bool name="Looped">false</bool><string name="Name">Greeting1</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0 60000 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1</float><bool name="Playing">false</bool><float name="RollOffMaxDistance">10000</float><float name="RollOffMinDistance">10</float><token name="RollOffMode">3</token><string name="SerializedOverrides"></string><Ref name="SoundGroup">null</Ref><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0</double><float name="Volume">2</float></Properties></Item><Item class="Sound" referent="RBX1271"><Properties><bool name="AcousticSimulationEnabled">true</bool><BinaryString name="AttributesSerialize"></BinaryString><Content name="SoundId"><url>rbxassetid://106058325175565</url></Content><bool name="DefinesCapabilities">false</bool><NumberRange name="LoopRegion">0 60000 </NumberRange><bool name="Looped">false</bool><string name="Name">Greeting2</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0 60000 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1</float><bool name="Playing">false</bool><float name="RollOffMaxDistance">10000</float><float name="RollOffMinDistance">10</float><token name="RollOffMode">3</token><string name="SerializedOverrides"></string><Ref name="SoundGroup">null</Ref><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0</double><float name="Volume">2</float></Properties></Item></Item><Item class="Sound" referent="RBX1268"><Properties><bool name="AcousticSimulationEnabled">true</bool><BinaryString name="AttributesSerialize"></BinaryString><Content name="SoundId"><url>rbxassetid://97766597574582</url></Content><bool name="DefinesCapabilities">false</bool><NumberRange name="LoopRegion">0 60000 </NumberRange><bool name="Looped">false</bool><string name="Name">NewStock</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0 60000 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1</float><bool name="Playing">false</bool><float name="RollOffMaxDistance">10000</float><float name="RollOffMinDistance">10</float><token name="RollOffMode">3</token><string name="SerializedOverrides"></string><Ref name="SoundGroup">null</Ref><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0</double><float name="Volume">2</float></Properties></Item></Item><Item class="ModuleScript" referent="RBX1272"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">LikeGame</string><string name="ScriptGuid">{cb1a3faa-f75f-4895-9b6a-ff5bfd37cbb5}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local TPHome = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local WKS = game:GetService('Workspace')
local GRP = game:GetService('GroupService')
local PPS = game:GetService('ProximityPromptService')

local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)

local plr = PLS.LocalPlayer :: Player
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local likeGame = gui:WaitForChild('LikeGame')

local tweens: {[Instance]: Tween} = {}

-- rotate button on hover
local function addButtonEffect(Button: ImageButton)
	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1)
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = size
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- initialize home teleport ui
function TPHome:Init()
	addButtonEffect(likeGame.Close)
	addButtonEffect(likeGame.Objective.Like)
	
	likeGame.Close.Activated:Connect(function()
		likeGame.Visible = false
	end)

	likeGame.Objective.Like.Activated:Connect(function()
		local status = GRP:PromptJoinAsync(348279)
		
		if status == Enum.GroupMembershipStatus.Joined then
			INT_CSignals.Notify:Fire('Like and join again for the reward!')
			likeGame.Visible = false
		end
	end)
	
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		if Player ~= plr then
			return
		end
		
		if Prompt:HasTag('JoinGroupPrompt') then
			if likeGame.Visible then
				return
			end
			
			likeGame.Visible = true
			
			Prompt.PromptHidden:Once(function()
				likeGame.Visible = false
			end)
		end
	end)
end

return TPHome
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1273"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Order</string><string name="ScriptGuid">{79fd1072-a2ce-44f6-9a91-02431dccf78a}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Order = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local WKS = game:GetService('Workspace')
local GRP = game:GetService('GroupService')
local PPS = game:GetService('ProximityPromptService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)
local ORD_CONFIGS = require(RPS.Modules.Services.OrdersService.OrderConfigs)
local RWD_UTILS = require(RPS.Modules.Services.RewardService.RewardUtils)

local plr = PLS.LocalPlayer :: Player
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local order = gui:WaitForChild('Order')
local close = order:WaitForChild('Close')

local tweens: {[Instance]: Tween} = {}

-- rotate button on hover
local function addButtonEffect(Button: ImageButton)
	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1)
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = size
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- update orders frames
local function updateOrders()
	local ordersData = DAT_Client:get('Orders')
	
	for _, child in order.Orders:GetChildren() :: {typeof(order.Orders.Basic)} do
		local orderData = ordersData[child.Name]
		
		child.Target.Text = RWD_UTILS.ToString(math.floor(orderData.Reached)).. '/' ..RWD_UTILS.ToString(orderData.Target)
		
		local orderConfig = ORD_CONFIGS.Orders[orderData.Name]
		
		child.Title.Text = orderConfig.Name
		child.Icon.Image = orderConfig.Icon
		child.Reward.Amount.Text = '+'..math.floor((orderConfig.Difficulties[child.Name] :: ORD_CONFIGS.DifficultyConfig).RewardPerTarget * orderData.Target)
		
		child.Bar.Fill.Size = UDim2.fromScale(orderData.Reached/orderData.Target, 1)
	end
end

-- initialize orders ui
function Order:Init()
	addButtonEffect(close)
	
	for _, child in order.Orders:GetChildren() :: {typeof(order.Orders.Basic)} do
		addButtonEffect(child.Complete)
		addButtonEffect(child.Refresh)
		
		child.Complete.Activated:Connect(function()
			RPS.Remotes.OrderService.CompleteOrder:FireServer(child.Name)
		end)
		child.Refresh.Activated:Connect(function()
			RPS.Remotes.OrderService.RefreshOrder:FireServer(child.Name)
		end)
	end
	
	close.Activated:Connect(function()
		order.Visible = false
	end)
	
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		if Player ~= plr then
			return
		end
		
		if Prompt:HasTag('ViewOrderPrompt') then
			if order.Visible then
				return
			end
			
			order.Visible = true
			
			for _, child in order.Orders:GetChildren() :: {typeof(order.Orders.Basic)} do
				child.Visible = Prompt:GetAttribute('OrderType') == child.Name
			end
			
			Prompt.PromptHidden:Once(function()
				order.Visible = false
			end)
		end
	end)
	
	updateOrders()
	DAT_Client:getChangedSignal('Orders'):Connect(updateOrders)
end

return Order
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1274"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Decorate</string><string name="ScriptGuid">{3dd0b92e-380b-41cd-bf77-4c78820c1d67}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Decorate = {}

local PPS = game:GetService('ProximityPromptService')
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')
local PLS = game:GetService('Players')
local STG = game:GetService('StarterGui')

local INT_UTILS = require(RPS.Modules.Services.InterfaceService.InterfaceUtils)
local STT_CONFIGS = require(RPS.Modules.Services.StationService.StationConfigs)
local RWD_UTILS = require(RPS.Modules.Services.RewardService.RewardUtils)
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)
local DAT_Client = require(RPS.Modules.Packages.DataService).client

local plr = PLS.LocalPlayer :: Player
local hud = plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(STG.HUD)
local decorate = hud:WaitForChild('Decorate')
local scroller = decorate:WaitForChild('Scroller')
local itemTemplate = scroller:WaitForChild('Empty')

local activeType = 'Bed'
local selected = itemTemplate
local activePrompt: ProximityPrompt?

local preview: Model?

local prevTransparencies: {[BasePart]: number} = {}

-- select new item
local function selectNew(ItemButton: typeof(selected))
	if selected and selected.Parent then
		selected.UIStroke.Transparency = .5
		selected.More.Visible = false
	end

	selected = ItemButton
	ItemButton.UIStroke.Transparency = 0
end

-- show holo
local function showHolo(Decoration: string, Pivot: BasePart)
	if preview then
		preview:Destroy()
		preview = nil
	end
	
	local hoverModel = Decoration and RPS.Assets.Models.Decorations:FindFirstChild(Decoration) :: Model

	if not hoverModel then
		return
	end

	local clone = hoverModel:Clone()
	local human = clone:FindFirstChildOfClass('Humanoid')

	if not human then
		Instance.new('Humanoid', clone)
	end

	for _, child in clone:GetChildren() :: {BasePart} do
		if not child:IsA('BasePart') or child == clone.PrimaryPart then
			continue
		end

		child.Transparency = 0.99
	end
	
	local highlight = Instance.new('Highlight')
	
	highlight.FillColor = Color3.new(0.240909, 0.874708, 1)
	highlight.FillTransparency = 0.5

	highlight.Parent = clone

	clone:PivotTo(Pivot:GetPivot())
	clone.Parent = WKS.Temp
	
	preview = clone
end

-- hide model
local function hide(Model: Model)
	for _, child in Model:GetChildren() do
		if not child:IsA('BasePart') then
			continue
		end
		
		if prevTransparencies[child] then
			continue
		end
		
		prevTransparencies[child] = child.Transparency
		child.Transparency = 1
	end
end

-- show saved models
local function showSaved()
	for child, trans in prevTransparencies do
		child.Transparency = trans
		prevTransparencies[child] = nil
	end
end

-- preview model
local function previewModel(Decoration: string, Pivot: BasePart)
	local oldModel = (Pivot.Parent :: Folder):FindFirstChildOfClass('Model')
	
	if oldModel then
		hide(oldModel)
	end
	
	if preview then
		preview:Destroy()
		preview = nil
	end
	
	local decorConfig = STT_CONFIGS.Decorations[Decoration]
	
	if not decorConfig then
		return
	end
	
	local decorModel =	decorConfig.Model

	local clone = decorModel:Clone()

	local purchased = DAT_Client:get('DecorationsPurchased')
	
	if not table.find(purchased, Decoration) then
		local highlight = Instance.new('Highlight')
		highlight.FillColor = Color3.new(0.986572, 0.0886244, 0.188876)
		highlight.FillTransparency = 0.75

		highlight.Parent = clone
	end

	clone:PivotTo(Pivot:GetPivot())
	clone.Parent = WKS.Temp

	preview = clone
end

-- update decoration buttons
local function updateDecorationsUI(Pivot: BasePart)
	for _, child in scroller:GetChildren() do
		if child == itemTemplate or not child:IsA('TextButton') then
			continue
		end
		
		child:Destroy()
	end

	decorate.Title.Text = activeType:upper()

	local equippedData = DAT_Client:get('EquippedDecorations')
	
	for decor, decorConfig in STT_CONFIGS.Decorations do
		if decorConfig.Type ~= activeType then
			continue
		end
		
		local clone = itemTemplate:Clone()
		clone.Name = decor
		clone.Empty.Visible = false
		clone.Details.Visible = true
		clone.Details.Title.Text = decorConfig.Name
		clone.Details.Icon.Image = decorConfig.Icon
		
		clone.ZIndex = -decorConfig.Cost
		clone.LayoutOrder = decorConfig.Cost
		
		clone.More.Buy.Amount.Text = RWD_UTILS.ToString(decorConfig.Cost)
		clone.More.Icon.Image = decorConfig.Bonus and decorConfig.Bonus.Icon or ''
		clone.More.Amount.Text = decorConfig.Bonus and decorConfig.Bonus.Text or 'NO BONUS'
		clone.More.Description.Text = decorConfig.Description
		clone.UIStroke.Transparency = .5
		
		clone.More.Buy.Visible = not table.find(DAT_Client:get('DecorationsPurchased'), decor)
		clone.More.Visible = DAT_Client:get('EquippedDecorations')[decorConfig.Type] == decor

		clone.MouseEnter:Connect(function()
			clone.UIStroke.Transparency = 0
		end)
		
		clone.MouseLeave:Connect(function()
			if selected == clone then
				return
			end
			
			clone.UIStroke.Transparency = .5
		end)
		
		clone.Activated:Connect(function()
			selectNew(clone)
			
			clone.More.Visible = true
			
			local decorData = DAT_Client:get('DecorationsPurchased')
			local equippedData = DAT_Client:get('EquippedDecorations')
			
			if equippedData[decorConfig.Type] == decor then
				if preview then
					preview:Destroy()
					preview = nil
				end
				
				showSaved()
				return
			end
			
			if table.find(decorData, decor) then
				RPS.Remotes.StationService.EquipDecoration:FireServer(decor)
			else
				previewModel(decor, Pivot)
			end
		end)
		
		clone.More.Buy.Activated:Connect(function()
			RPS.Remotes.StationService.BuyDecoration:FireServer(decor)
		end)
		
		clone.Parent = scroller
		
		if equippedData[decorConfig.Type] == decor then
			selectNew(clone)
		end
	end
end

-- update current
local function updateCurrentUI()
	local decorData = DAT_Client:get('DecorationsPurchased')
	
	for _, button in scroller:GetChildren() :: {typeof(itemTemplate)} do
		if button == itemTemplate or not button:IsA('TextButton') then
			continue
		end
		
		local config = STT_CONFIGS.Decorations[button.Name]
		button.More.Buy.Visible = not table.find(decorData, button.Name)

		if not preview then
			continue
		end

		if selected == button and preview.Name == button.Name then
			preview:Destroy()
			preview = nil
		end
	end
end

-- initialize decorate ui
function Decorate:Init()
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		if Player ~= plr then
			return
		end
		
		if decorate.Visible then
			return
		end
		
		if not Prompt:HasTag('DecorationPrompt') then
			return
		end
		
		local station = Prompt:FindFirstAncestorWhichIsA('Model') :: Model
		
		if station:GetAttribute('Player') ~= plr.Name then
			INT_CSignals.Notify:Fire('This is not your station!')
			return
		end
		
		local config = STT_CONFIGS.Decorations[Prompt:GetAttribute('HoverDecor') :: string]
		activeType = config.Type
		
		local pivot = Prompt:FindFirstAncestorWhichIsA('BasePart') :: BasePart
		updateDecorationsUI(pivot)
		
		decorate.Visible = true
	end)

	PPS.PromptShown:Connect(function(Prompt)
		if not Prompt:HasTag('DecorationPrompt') then
			return
		end
		
		local station = Prompt:FindFirstAncestorWhichIsA('Model') :: typeof(RPS.Assets.Models.Stations.Normal)
		
		activePrompt = Prompt
		
		if station:GetAttribute('Player') ~= plr.Name then
			return
		end
		
		local hoverModelName = Prompt:GetAttribute('HoverDecor') :: string?
		
		if not hoverModelName then
			return
		end

		local config = STT_CONFIGS.Decorations[hoverModelName]
		local folder = station.Decorations:FindFirstChild(config.Type) :: Folder

		if folder:FindFirstChildOfClass('Model') then
			return
		end
		
		local pivot = Prompt:FindFirstAncestorWhichIsA('BasePart') :: BasePart
		
		showHolo(hoverModelName, pivot)
	end)
	
	PPS.PromptHidden:Connect(function(Prompt: ProximityPrompt)
		if not Prompt:HasTag('DecorationPrompt') then
			return
		end
		
		if preview then
			preview:Destroy()
			preview = nil
		end
		
		activePrompt = nil
		
		decorate.Visible = false
		
		showSaved()
	end)
	
	itemTemplate.Activated:Connect(function()
		RPS.Remotes.StationService.UnequipDecoration:FireServer(activeType)
		
		selectNew(itemTemplate)
		
		if activePrompt then
			showHolo(activePrompt:GetAttribute('HoverDecor') :: string, activePrompt:FindFirstAncestorWhichIsA('BasePart') :: BasePart)
		end
	end)
	
	DAT_Client:getChangedSignal('DecorationsPurchased'):Connect(function()
		updateCurrentUI()
	end)
	DAT_Client:getChangedSignal('EquippedDecorations'):Connect(function()
		updateCurrentUI()
	end)
end

return Decorate]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item></Item><Item class="Folder" referent="RBX1318"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">Utils</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1319"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">CameraUtils</string><string name="ScriptGuid">{14ef9741-6a12-46a3-88c6-e573e1c8a664}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local CutsceneUtils = {}

local WKS = game:GetService('Workspace')
local TWS = game:GetService('TweenService')
local PLS = game:GetService('Players')

local plr = PLS.LocalPlayer :: Player
local char = plr.Character or plr.CharacterAdded:Wait()
local cam = WKS.CurrentCamera :: Camera

local tween: Tween?
local fovTween: Tween?

-- get camera
function CutsceneUtils.GetCamera(): Camera
	return cam
end

-- play a cutscene panning the camer from cframe1 to cframe2 over the given tween info
function CutsceneUtils.PlayCutscene(CFrame1: CFrame, CFrame2: CFrame, Info: TweenInfo, FieldOfView1: number?, FieldOfView2: number?): Tween
	if fovTween then
		fovTween:Destroy()
		fovTween = nil
	end
	
	if tween then
		tween:Destroy()
	end
	
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame1
	cam.FieldOfView = FieldOfView1 or cam.FieldOfView
	
	local props = {
		CFrame = CFrame2,
	}
	
	if FieldOfView2 then
		props.FieldOfView = FieldOfView2
	end
	
	tween = TWS:Create(cam, Info, props);
	(tween :: Tween):Play()
	
	return tween :: Tween
end

-- follow object
function CutsceneUtils.SubjectToObject(Object: BasePart, Type: Enum.CameraType, FieldOfView1: number, Info: TweenInfo?, FieldOfView2: number?)
	cam.CameraType = Type
	cam.CameraSubject = Object

	if fovTween then
		fovTween:Destroy()
		fovTween = nil
	end
	
	cam.FieldOfView = FieldOfView1
	
	if Info and FieldOfView2 then
		if FieldOfView2 then
			fovTween = TWS:Create(cam, Info, {FieldOfView = FieldOfView2});
			(fovTween :: Tween):Play()
		end
	end
end

-- reset camera to normal
function CutsceneUtils.ResetCamera(FOV: number?, Subject: Humanoid?)
	if tween then
		tween:Destroy()
		tween = nil
	end
	
	if fovTween then
		fovTween:Destroy()
		fovTween = nil
	end
	
	cam.CameraSubject = Subject or cam.CameraSubject
	cam.CameraType = Enum.CameraType.Custom
	cam.FieldOfView = FOV or 70
end

-- get if a cutscene is playing and return the tween if it is
function CutsceneUtils.GetPlayingCutscene(): (Tween?, Tween?)
	return tween, fovTween
end

-- set camera to a cframe
function CutsceneUtils.SetCameraToCFrame(CFrame: CFrame, FOV: number?)
	if fovTween then
		fovTween:Destroy()
		fovTween = nil
	end
	
	if tween then
		tween:Destroy()
		tween = nil
	end
	
	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame = CFrame
	cam.FieldOfView = FOV or cam.FieldOfView
end

-- tween the camera's field of view
function CutsceneUtils.TweenFOV(FOV: number, Info: TweenInfo): Tween
	if fovTween then
		fovTween:Destroy()
		fovTween = nil
	end
	
	fovTween = TWS:Create(cam, Info, {FieldOfView = FOV});
	(fovTween :: Tween):Play()
	
	return fovTween :: Tween
end

return CutsceneUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1320"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">PropUtils</string><string name="ScriptGuid">{781f3a58-bcc8-45b2-8e13-a47d4c486787}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local PropUtils = {}

local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService("TweenService")
local WKS = game:GetService('Workspace')
local RNS = game:GetService('RunService')

local EFX_UTILS = require(RPS.Modules.Utils.EffectsUtils)

local tweens: {[Instance]: Tween} = {}
local initCF: {[Instance]: CFrame} = {}

-- open door double sided
function PropUtils.OpenDoor(Door: Model, Info: TweenInfo?, Outward: boolean?): (Tween, Tween)
	local right = Door:FindFirstChild('Right') :: Model
	local left = Door:FindFirstChild('Left') :: Model
	
	return PropUtils.OpenDoorSingle(right, Info, Outward), PropUtils.OpenDoorSingle(left, Info, not Outward)
end

-- open door single sided
function PropUtils.OpenDoorSingle(Door: Model, Info: TweenInfo?, Outward: boolean?): Tween
	local info = Info or TweenInfo.new(.4, Enum.EasingStyle.Cubic)

	initCF[Door] = initCF[Door] or Door:GetPivot()

	local pivot = Door.PrimaryPart :: BasePart

	local cFV = pivot:FindFirstChildOfClass('CFrameValue') :: CFrameValue
	if not cFV then
		local newCFV = Instance.new('CFrameValue')
		newCFV = Instance.new('CFrameValue')
		newCFV.Value = Door:GetPivot()
		newCFV.Parent = pivot

		newCFV.Changed:Connect(function()
			Door:PivotTo(newCFV.Value)
		end)

		cFV = newCFV
	end

	if tweens[Door] then
		tweens[Door]:Destroy()
	end

	tweens[Door] = TWS:Create(cFV, info, {Value = initCF[Door] * CFrame.Angles(0, math.rad(Outward and -90 or 90), 0)})
	tweens[Door]:Play()
	
	return tweens[Door]
end

-- close door
function PropUtils.CloseDoor(Door: Model, Info: TweenInfo?): (Tween, Tween)
	local right = Door:FindFirstChild('Right') :: Model
	local left = Door:FindFirstChild('Left') :: Model

	return PropUtils.CloseDoorSingle(right, Info), PropUtils.CloseDoorSingle(left, Info)
end

-- close door single
function PropUtils.CloseDoorSingle(Door: Model, Info: TweenInfo?): Tween
	local info = Info or TweenInfo.new(.4, Enum.EasingStyle.Cubic)

	initCF[Door] = initCF[Door] or Door:GetPivot()

	local pivot = Door.PrimaryPart :: BasePart

	local cFV = pivot:FindFirstChildOfClass('CFrameValue') :: CFrameValue
	if not cFV then
		local newCFV = Instance.new('CFrameValue')
		newCFV = Instance.new('CFrameValue')
		newCFV.Value = Door:GetPivot()
		newCFV.Parent = pivot

		newCFV.Changed:Connect(function()
			Door:PivotTo(newCFV.Value)
		end)

		cFV = newCFV
	end

	if tweens[Door] then
		tweens[Door]:Destroy()
	end

	tweens[Door] = TWS:Create(cFV, info, {Value = initCF[Door]})
	tweens[Door]:Play()

	return tweens[Door]
end

-- add cframe value
function PropUtils.AddBoundCFrameValue(Prop: Model): CFrameValue
	local cFV = Prop:FindFirstChildOfClass('CFrameValue') :: CFrameValue
	
	if not cFV then
		local newCFV = Instance.new('CFrameValue')
		newCFV.Value = Prop:GetPivot()
		newCFV.Parent = Prop.PrimaryPart
		
		newCFV.Changed:Connect(function()
			Prop:PivotTo(newCFV.Value)
		end)
		
		cFV = newCFV
	end
	
	return cFV
end

-- open gift box
function PropUtils.OpenGiftBox(GiftBox: Model)
	local body = GiftBox:FindFirstChild('Body') :: Model
	local top = GiftBox:FindFirstChild('Top') :: Model

	local giftV = GiftBox:FindFirstChildOfClass('CFrameValue') or PropUtils.AddBoundCFrameValue(GiftBox)
	local topV = top:FindFirstChildOfClass('CFrameValue') or PropUtils.AddBoundCFrameValue(top)
	local bodyV = body:FindFirstChildOfClass('CFrameValue') or PropUtils.AddBoundCFrameValue(body)

	local initG = GiftBox:GetPivot()
	local initT = top:GetPivot()
	local initB = body:GetPivot()

	local t: Tween

	for i = 1, 2 do
		local timer = math.random(10,25)/100
		t = TWS:Create(giftV, TweenInfo.new(timer, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {Value = initG * CFrame.new(0.3,.7,0) * CFrame.Angles(0,0,math.rad(-5))})
		t:Play()
		t.Completed:Wait()

		t = TWS:Create(giftV, TweenInfo.new(timer, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {Value = initG})
		t:Play()
		t.Completed:Wait()

		timer = math.random(10,25)/100
		t = TWS:Create(giftV, TweenInfo.new(timer, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {Value = initG * CFrame.new(-0.3,.7,0) * CFrame.Angles(0,0,math.rad(5))})
		t:Play()
		t.Completed:Wait()

		t = TWS:Create(giftV, TweenInfo.new(timer, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out), {Value = initG})
		t:Play()
		t.Completed:Wait()
	end

	local sound = GiftBox:FindFirstChildWhichIsA('Sound', true)
	if sound then
		sound:Play()
	end

	t = TWS:Create(topV, TweenInfo.new(.35, Enum.EasingStyle.Cubic, Enum.EasingDirection.In), {Value = initT * CFrame.new(3,.7,0) * CFrame.Angles(0,0,math.rad(-135))})
	t:Play()
	t.Completed:Wait()

	local bT = TWS:Create(bodyV, TweenInfo.new(.6, Enum.EasingStyle.Cubic), {Value = initB * CFrame.new(0,.25,.3) * CFrame.Angles(math.rad(-30), 0, 0)})
	bT:Play()
	bT.Completed:Wait()
end

-- open treasure chest
function PropUtils.OpenTreasureChest(TreasureChest: Model, Amount: number?)
	local top = TreasureChest:FindFirstChild('Top') :: Model
	local bottom = TreasureChest:FindFirstChild('Bottom') :: Model
	local topV = top:FindFirstChildOfClass('CFrameValue') or PropUtils.AddBoundCFrameValue(top)
	
	initCF[top] = initCF[top] or top:GetPivot()
	
	if tweens[TreasureChest] then
		tweens[TreasureChest]:Destroy()
	end
	
	local infoOut = TweenInfo.new(.3, Enum.EasingStyle.Cubic, Enum.EasingDirection.Out)
	local infoIn = TweenInfo.new(.3, Enum.EasingStyle.Cubic, Enum.EasingDirection.In)
	local tween = TWS:Create(topV, infoOut, {Value = initCF[top] * CFrame.Angles(math.rad(-90),0,0)})
	tween:Play()
	
	tweens[TreasureChest] = tween

	local amount = Amount and (Amount <= 10 and Amount or Amount <= 50 and 15 or Amount <= 100 and 20 or math.clamp(Amount/10, 20, 50)) or 10
	
	print(Amount, amount)

	tween.Completed:Once(function()
		for i = 1, amount do
			task.delay(math.random(50, 1000)/1000, function()
				local coin = RPS.Assets.BaseParts.Props.Coin:Clone()
				coin.CFrame = bottom:GetPivot() * CFrame.new(0,3,0) * CFrame.Angles(0,0,math.rad(90))
				EFX_UTILS.AddTrail(coin, RPS.Assets.BaseParts.Trails.Coin)
				coin.Parent = WKS.Temp
				
				local pos = coin.Position
				local targetPos = (bottom:GetPivot() * CFrame.new(math.random(-100, 100)/10, 0, math.random(35, 155)/10)).Position
				local bezierPos = (pos + targetPos)/2 + Vector3.new(0,5,0)
				
				local timer = 24 / (targetPos - pos).Magnitude
				local t = 0
				
				local conn: RBXScriptConnection; conn = RNS.Heartbeat:Connect(function(DT)
					if t > 1 then
						conn:Disconnect()
						
						task.delay(2, function()
							coin:Destroy()
						end)
						
						return
					end

					t += DT * timer
					coin.Position = EFX_UTILS.BezierCurve(t, pos, bezierPos, targetPos)
				end)
			end)
		end
	end)

	task.delay(2.3, function()
		tweens[TreasureChest] = TWS:Create(topV, infoIn, {Value = initCF[top]})
		tweens[TreasureChest]:Play()
	end)
end

return PropUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1321"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">DressUtils</string><string name="ScriptGuid">{06e20ab8-1a27-42cc-b6ed-7706966d7165}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local DressUtils = {}

local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService("TweenService")
local PLS = game:GetService('Players')
local GUI = game:GetService('GuiService')

local tweens: {[Instance]: Tween} = {}
local initCF: {[Instance]: CFrame} = {}

-- wear accessories on character
function DressUtils.DressUp(Character: Model, Accessories: {Accessory | Pants | Shirt}, Tag: string?, WithoutHair: boolean?)
	local clothed = {} :: {Accessory | Pants | Shirt}
	
	for _, accessory in Accessories do
		local att = accessory:FindFirstChildWhichIsA('Attachment', true) :: Attachment?
		
		for _, worn in Character:GetChildren() do
			if not worn:IsA('Accessory') and not worn:IsA('Shirt') and not worn:IsA('Pants') then
				continue
			end
			
			if worn:GetAttribute('Hair') then
				local basePart = worn:FindFirstChildWhichIsA('BasePart') :: BasePart
				basePart.Transparency = WithoutHair and 1 or 0
				continue
			end
			
			if table.find(clothed, worn) then
				continue
			end
			
			if worn:IsA("Accessory") and att and worn:FindFirstChild(att.Name, true) then
				worn:Destroy()
			elseif worn:IsA('Pants') or worn:IsA('Shirt') then
				worn:Destroy()
			elseif Tag and worn:GetAttribute(Tag) then
				worn:Destroy()
			end
		end
		
		local clone = accessory:Clone()
		
		if Tag then
			clone:SetAttribute(Tag, true)
		end
		
		clone.Parent = Character

		if clone:IsA('Accessory') then
			local part = clone:FindFirstChildWhichIsA('BasePart') :: BasePart
			local att = part:FindFirstChildWhichIsA('Attachment') :: Attachment
			local constraint = part:FindFirstChildOfClass('RigidConstraint') :: RigidConstraint

			if not constraint then
				local newConstraint = Instance.new('RigidConstraint')
				newConstraint.Attachment0 = att
				newConstraint.Parent = att.Parent
				newConstraint.Name = 'AccessoryRigidConstraint'

				constraint = newConstraint
			end

			local att1: Attachment
			for _, child in Character:GetChildren() do
				if not child:IsA('BasePart') then
					continue
				end

				local charAtt = child:FindFirstChild(att.Name) :: Attachment?

				if charAtt then
					att1 = charAtt
					break
				end
			end
			
			part.CanCollide = false
			part.Anchored = false
			part.Massless = true
			part.Position = att1.WorldPosition
			constraint.Attachment1 = att1
		end
		
		table.insert(clothed, clone)
	end
end

-- wear clothes on character
function DressUtils.DressClothes(Character: Model, Shirt: Shirt?, Pants: Pants?)
	for _, child in Character:GetChildren() do
		if child:IsA("Shirt") and Shirt then
			child:Destroy()
		elseif child:IsA('Pants') and Pants then
			child:Destroy()
		end
	end
	
	if Shirt then
		local clone = Shirt:Clone()
		clone.Parent = Character
	end
	
	if Pants then
		local clone = Pants:Clone()
		clone.Parent = Character
	end
end

-- wear player crown
function DressUtils.WearCrown(Character: Model, Type: string): Accessory
	local crown = RPS.Assets.Accessories.Crowns:FindFirstChild(Type) :: Accessory?
	if not crown then
		error('crown not found '..Type)
	end
	
	local clone = crown:Clone()
	clone.Parent = Character
	
	return clone
end

return DressUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1322"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">LightUtils</string><string name="ScriptGuid">{0e937a38-fd61-42aa-9906-ab3905f2bef7}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local LightUtils = {}

local LTG = game:GetService('Lighting')
local TWS = game:GetService("TweenService")

local tween: Tween
local initCF: {[Instance]: CFrame} = {}

-- tween lighting
function LightUtils.TweenLighting(Props: {[string]: any}, Info: TweenInfo): Tween
	if tween then
		tween:Destroy()
	end
	
	tween = TWS:Create(LTG, Info, Props)
	tween:Play()
	
	return tween
end

return LightUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1323"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">AnimationUtils</string><string name="ScriptGuid">{d4651efc-d0b3-4779-85b2-447b06cb7ded}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local AnimationUtils = {}

local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService("TweenService")

local anims: {[Animator]: AnimationTrack} = {}
local secondary: {[Animator]: AnimationTrack} = {}

-- play animation on character model
function AnimationUtils.PlayAnimation(Animator: Animator, Animation: Animation, FadeIn: number?): AnimationTrack
	if anims[Animator] then
		if anims[Animator].Animation == Animation and anims[Animator].IsPlaying then
			return anims[Animator]
		end
		
		anims[Animator]:Stop()
		anims[Animator]:Destroy()
	end
	
	local track = Animator:LoadAnimation(Animation)
	track.Priority = Enum.AnimationPriority.Action
	anims[Animator] = track
	
	track:Play(FadeIn)
	
	return track
end

-- play secondary animation
function AnimationUtils.PlaySecondaryAnimation(Animator: Animator, Animation: Animation, FadeIn: number?): AnimationTrack
	if secondary[Animator] then
		if secondary[Animator].Animation == Animation and secondary[Animator].IsPlaying then
			return secondary[Animator]
		end
		
		secondary[Animator]:Stop()
		secondary[Animator]:Destroy()
	end
	
	local track = Animator:LoadAnimation(Animation)
	track.Priority = Enum.AnimationPriority.Action2
	secondary[Animator] = track
	
	track:Play(FadeIn)
	
	return track
end

-- stop all animations
function AnimationUtils.StopAll(Animator: Animator)
	if anims[Animator] then
		anims[Animator]:Stop()
		anims[Animator]:Destroy()
	end
	
	if secondary[Animator] then
		secondary[Animator]:Stop()
		secondary[Animator]:Destroy()
	end
end

-- get animation from path
function AnimationUtils.GetAnimationFromPath(Path: {string}): Animation
	local current = RPS.Animations
	for _, name in Path do
		current = current:FindFirstChild(name)
		
		if not current then
			break
		end
		
		if current:IsA('Animation') then
			return current
		end
	end
	
	error('Animation not found')
end

-- play in parallel
function AnimationUtils.PlayInParallel(Animator: Animator, Animation: Animation, FadeIn: number?, Priority: Enum.AnimationPriority?): AnimationTrack
	local track = Animator:LoadAnimation(Animation)
	track.Priority = Priority or Enum.AnimationPriority.Action4
	track:Play(FadeIn)
	
	return track
end

return AnimationUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1324"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">AudioUtils</string><string name="ScriptGuid">{2ee149ca-1e31-4c1d-b0a9-70e376fb9eda}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local AudioUtils = {}

local SDS = game:GetService('SoundService')
local TWS = game:GetService('TweenService')

local music: Sound
local tweens: {[Sound]: Tween} = {}

-- play music change if another is active
function AudioUtils.PlayMusic(Sound: Sound, Info: TweenInfo?, Props: {[string]: any}?, InitialProps: {[string]: any}?)
	if music and music.IsPlaying then
		music:Stop()
	end
	
	music = Sound
	music:Play()
	
	if InitialProps then
		for property, value in InitialProps do
			music[property] = value
		end
	end
	
	if Info and Props then
		AudioUtils.TweenMusic(Info, Props)
	end
end

-- tween sound
function AudioUtils.TweenMusic(Info: TweenInfo, Props: {[string]: any}, InitialProps: {[string]: any}?): Tween
	if InitialProps then
		for property, value in InitialProps do
			music[property] = value
		end
	end

	local tween = TWS:Create(music, Info, Props)
	tween:Play()
	
	tweens[music] = tween
	
	return tweens[music]
end

-- return playing music
function AudioUtils.GetMusic(): Sound
	return music
end

-- get mumble for gender
function AudioUtils.AddMumble(Character: Model, Gender: string): Sound
	local sounds = (SDS.Mumbles:FindFirstChild(Gender) :: Folder):GetChildren()
	local sound = sounds[math.random(1, #sounds)]:Clone() :: Sound
	
	sound.Parent = Character:FindFirstChild('Head') :: BasePart
	
	return sound
end

-- reset music
function AudioUtils.ResetMusic()
	AudioUtils.PlayMusic(SDS.Ambience.Ambient)
end

return AudioUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1325"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">InterfaceUtils</string><string name="ScriptGuid">{a6a6123d-d0d4-4538-9730-4dfd7228699f}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local InterfaceUtils = {}

local PLS = game:GetService('Players')
local GUI = game:GetService('GuiService')
local TWS = game:GetService('TweenService')
local RPS = game:GetService('ReplicatedStorage')
local STG = game:GetService('StarterGui')
local SDS = game:GetService('SoundService')

local IMG_CONFIGS = require(RPS.Modules.Configs.ImageConfigs)
local ANM_UTILS = require(script.Parent.AnimationUtils)
local CHR_UTILS = require(script.Parent.CharacterUtils)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local DCS_CSignals = require(RPS.Modules.Services.DecisionService.DecisionClientSignals)
local AUD_UTILS = require(script.Parent.AudioUtils)

local plr = PLS.LocalPlayer :: Player
local mouse = plr:GetMouse()
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(STG.HUD))
local decisionGui = plr.PlayerGui:WaitForChild('DecisionGui', 100) :: typeof(STG.DecisionGui)
local personGui = plr.PlayerGui:WaitForChild('Person')

local tweens: {[GuiObject]: Tween} = {}
local hoverConns: {[GuiButton]: {Enter: RBXScriptConnection, Leave: RBXScriptConnection}} = {}

local dialogueInstances: {BillboardGui | Attachment} = {}

-- change amount to spaced between every 3 digits
function InterfaceUtils.GetSpacedAmount(Amount: number): string
	local split = tostring(math.floor(Amount)):split('')
	local newText = ''

	for i = 1, #split do
		local char = split[i]

		if (#split - i) % 3 == 0 and i ~= #split then
			newText ..= char .. ' '
		else
			newText ..= char
		end
	end

	return newText
end

-- add stats gui to character
function InterfaceUtils.AddStats(Model: Model, Level: number, Name: {Title: string, Color: Color3}?): (BillboardGui, Frame, Frame)
	local head = Model:FindFirstChild('Head') :: BasePart

	local gui = script.Stats:Clone()
	gui.Parent = head
	gui.Enabled = true
	gui.Health.Visible = false

	local bar = gui.Health.Fill
	bar.Size = UDim2.new(1, 0, 1, 0)

	if Name then
		gui.Title.Text = Name.Title
		gui.Title.TextColor3 = Name.Color
		gui.Title.Visible = true
	end

	for i = 1, Level do 
		local imgL = gui.Levels:FindFirstChild('Lvl'..i) :: ImageLabel
		if not imgL then
			continue
		end

		imgL.Visible = true
	end

	return gui, bar, gui.Levels
end

-- tween gui object
function InterfaceUtils.TweenGuiObject(GuiObject: GuiObject, TweenInfo: TweenInfo, Properties: {[string]: any}): Tween
	if tweens[GuiObject] then
		tweens[GuiObject]:Destroy()
	end

	local tween = TWS:Create(GuiObject, TweenInfo, Properties)
	tween:Play()

	tweens[GuiObject] = tween

	return tween
end

-- return if gui object is tweening is tweening
function InterfaceUtils.IsTweening(GuiObject: GuiObject): (boolean, Tween?)
	local tween = tweens[GuiObject]
	return tween and tween.PlaybackState == Enum.PlaybackState.Playing or false, tween
end


-- add button hover effect
function InterfaceUtils.AddButtonEffect(Button: GuiButton, Hover: {[string]: any}?, Leave: {[string]: any}?, TInfo: TweenInfo?, HoverSound: Sound?): {Enter: RBXScriptConnection, Leave: RBXScriptConnection}
	local size = Button.Size

	if hoverConns[Button] then
		hoverConns[Button].Enter:Disconnect()
		hoverConns[Button].Leave:Disconnect()
	end

	local info = TInfo or TweenInfo.new(.15, Enum.EasingStyle.Cubic)

	local enter: RBXScriptConnection; enter = Button.MouseEnter:Connect(function()
		InterfaceUtils.TweenGuiObject(Button, info, Hover or {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1)
		})
		
		if HoverSound then
			HoverSound:Play()
		else
			SDS.UI.Hover:Play()
		end
	end)
	local leave: RBXScriptConnection; leave = Button.MouseLeave:Connect(function()
		InterfaceUtils.TweenGuiObject(Button, info, Leave or {
			Rotation = 0,
			Size = size
		})
	end)

	hoverConns[Button] = {
		Enter = enter,
		Leave = leave
	}

	return hoverConns[Button]
end


-- play dialogue
function InterfaceUtils.PlayDialogue(Character: Model, Object: Model | string, Mumble: Sound, Animation: {string}?, PCFrame: CFrame?): (Attachment, BillboardGui)
	local root = Character:FindFirstChild('HumanoidRootPart') :: BasePart
	local pictureAtt = root:FindFirstChild('PictureAtt') :: typeof(script.PictureAtt)
	
	local gui: typeof(script.PictureAtt.SpeechGui)
	
	if not pictureAtt then
		pictureAtt = script.PictureAtt:Clone()
		gui = pictureAtt.SpeechGui
		
		gui.Frame.Bubble1.Size = UDim2.new()
		gui.Frame.Bubble2.Size = UDim2.new()
		gui.Frame.Main.Size = UDim2.new()
		
		pictureAtt.Parent = root

		local info = TweenInfo.new(.3, Enum.EasingStyle.Cubic)

		local bubble1T = InterfaceUtils.TweenGuiObject(gui.Frame.Bubble1, info, {Size = UDim2.fromScale(.9,.1)})
		bubble1T.Completed:Wait()
		
		local bubble2T = InterfaceUtils.TweenGuiObject(gui.Frame.Bubble2, info, {Size = UDim2.fromScale(.9,.15)})
		bubble2T.Completed:Wait()
		
		local mainT = InterfaceUtils.TweenGuiObject(gui.Frame.Main, info, {Size = UDim2.fromScale(.9,.6)})
		mainT.Completed:Wait()
	end
	
	gui = pictureAtt.Gui.Value
	gui.Parent = plr.PlayerGui

	local info = TweenInfo.new(.225, Enum.EasingStyle.Cubic)
	local view = gui.Frame.Main.View
	local icon = gui.Frame.Main.Icon

	if view.Size.X.Scale > 0 and view.Visible then
		local closeT = InterfaceUtils.TweenGuiObject(view, info, {Size = UDim2.new()})
		closeT.Completed:Wait()
	elseif icon.Size.X.Scale > 0 and icon.Visible then
		local closeT = InterfaceUtils.TweenGuiObject(icon, info, {Size = UDim2.new()})
		closeT.Completed:Wait()
	end
	
	local openT: Tween
	
	if typeof(Object) == 'Instance' and Object:IsA('Model') then
		Object:PivotTo(PCFrame or Object:GetAttribute('ViewCF') or CFrame.new(0,-3,0))
		
		local existingModel = view.WorldModel:FindFirstChildOfClass('Model')

		if existingModel then
			existingModel:Destroy()
		end
		
		Object.Parent = view.WorldModel
		view.Visible = true

		local animator = Object:FindFirstChildWhichIsA('Animator', true)
		if animator and Animation then
			ANM_UTILS.PlayAnimation(animator, ANM_UTILS.GetAnimationFromPath(Animation))
		end
		
		openT = InterfaceUtils.TweenGuiObject(view, info, {Size = UDim2.fromScale(.6,.6)})
	elseif typeof(Object) == 'string' then
		icon.Image = Object
		openT = InterfaceUtils.TweenGuiObject(icon, info, {Size = UDim2.fromScale(.5,.5)})
	end
	
	openT.Completed:Wait()
	Mumble:Play()
	
	if not table.find(dialogueInstances :: {Attachment}, pictureAtt) then
		table.insert(dialogueInstances, pictureAtt :: Attachment)
	end
	
	if not table.find(dialogueInstances, gui) then
		table.insert(dialogueInstances, gui)
	end
	
	return pictureAtt, gui
end

-- hide and destroy dialogue instances
function InterfaceUtils.HideDialogueInstances(Info: TweenInfo?)
	local tween: Tween?
	if Info then
		for _, instance in dialogueInstances :: {typeof(script.PictureAtt.SpeechGui)} do
			if not instance:IsA('BillboardGui') then
				continue
			end
			
			tween = InterfaceUtils.TweenGuiObject(instance.Frame, Info, {GroupTransparency = 1})
		end
	end
	
	task.spawn(function()
		if tween then
			tween.Completed:Wait()
		end

		for _, instance in dialogueInstances do
			instance:Destroy()
		end
		
		table.clear(dialogueInstances)
	end)
end

-- create viewport from view config
function InterfaceUtils.CreateViewportFromViewConfig(ViewConfig: CFG_TYPES.ViewConfig, Parent: Instance, Plaintiffs: {[number]: Model}): ViewportFrame
	local view = script.View:Clone()
	view.Parent = Parent
	view.Position = ViewConfig.Position
	view.Size = ViewConfig.Size
	view.ZIndex = ViewConfig.ZIndex or view.ZIndex

	local object = ViewConfig.Subject

	local clone: Model
	local animator: Animator
	if typeof(object) == 'Instance' and object:IsA('Model') then
		clone = object:Clone()
	elseif typeof(object) == 'number' then
		clone = Plaintiffs[object]:Clone()
	elseif typeof(object) == 'string' then
		clone, animator = CHR_UTILS.Create(object)
	elseif object == nil then
		local char = plr.Character or plr.CharacterAdded:Wait()
		clone = char
	end

	animator = animator or clone:FindFirstChildWhichIsA('Animator', true) :: Animator

	local animPath = ViewConfig.Animation

	if animPath then
		ANM_UTILS.PlayAnimation(animator, ANM_UTILS.GetAnimationFromPath(animPath))
	end

	clone:PivotTo(ViewConfig.CFrame)
	clone.Parent = view.WorldModel
	
	return view
end

-- play decision
function InterfaceUtils.PlayDecision(Parent: Instance, DecisionConfig: CFG_TYPES.DecisionConfig, Plaintiffs: {[number]: Model}): Attachment
	local decisionAtt = Parent:FindFirstChild('DecisionAtt') :: Attachment
	
	if not decisionAtt then
		decisionAtt = script.DecisionAtt:Clone()
	end
	
	decisionGui.Adornee = decisionAtt
	decisionAtt.Parent = Parent
	
	local num = 0
	
	for _, child in decisionGui.Frame.Choices:GetChildren() do
		if child.Name ~= 'Choice' then
			child:Destroy()
		end
	end
	
	for _, choice in DecisionConfig.Choices do
		num += 1
	end
	
	local choiceBs: {GuiButton} = {}
	
	local added = 0
	for choiceIndex, choice in DecisionConfig.Choices do
		local choiceB = decisionGui.Frame.Choices.Choice:Clone()
		choiceB.Title.Text = choice.Title
		choiceB.Parent = decisionGui.Frame.Choices
		choiceB.Name = 'Choice'..added
		choiceB.Visible = true
		
		if num == 1 then
			choiceB.Position = UDim2.fromScale(1.5, .5)
		elseif num == 2 then
			choiceB.Position = UDim2.fromScale(1.5, .25 + .5 * added)
		elseif num == 3 then
			choiceB.Position = UDim2.fromScale(1.5, .165 + .33 * added)
		end
		
		for _, subject in choice.Subjects do
			InterfaceUtils.CreateViewportFromViewConfig(subject, choiceB, Plaintiffs)
		end
		
		table.insert(choiceBs, choiceB)
		
		InterfaceUtils.AddButtonEffect(choiceB, {ImageColor3 = Color3.fromRGB(255, 239, 149), Size = UDim2.fromScale(choiceB.Size.X.Scale * 1.1, choiceB.Size.Y.Scale * 1.1)}, {ImageColor3 = Color3.new(1,1,1), Size = UDim2.fromScale(choiceB.Size.X.Scale, choiceB.Size.Y.Scale)}, TweenInfo.new(.15, Enum.EasingStyle.Cubic))
		
		choiceB.Activated:Connect(function()
			SDS.UI.Choice:Play()
			DCS_CSignals.DecisionMade:Fire(choiceIndex)
			InterfaceUtils.HideDecision()
		end)
		
		if DecisionConfig.Name == 'Wolves' then
			InterfaceUtils.TweenGuiObject(choiceB, TweenInfo.new(.25, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut, -1, true), {ImageColor3 = Color3.fromRGB(255, 239, 149)})
		end
		
		added += 1
	end
	
	decisionGui.Frame.Scene.Position = UDim2.fromScale(-1.05, .5)
	decisionGui.Frame.Scene.Portrait.Title.TextLabel.Text = DecisionConfig.Portrait.Title
	decisionGui.Enabled = true
	
	for _, subject in DecisionConfig.Portrait.Subjects do
		InterfaceUtils.CreateViewportFromViewConfig(subject, decisionGui.Frame.Scene, Plaintiffs)
	end
	
	local info = TweenInfo.new(.45, Enum.EasingStyle.Cubic)
	
	local sceneTween = InterfaceUtils.TweenGuiObject(decisionGui.Frame.Scene, info, {Position = UDim2.fromScale(.05, .5)})
	sceneTween.Completed:Wait()
	
	for _, choiceB in choiceBs do
		local tween = InterfaceUtils.TweenGuiObject(choiceB, info, {Position = UDim2.fromScale(0.5, choiceB.Position.Y.Scale)})
		tween.Completed:Once(function()
			choiceB.Active = true
		end)
		
		task.wait(.25)
	end
	
	return decisionAtt
end

-- hide decision
function InterfaceUtils.HideDecision()
	local dur = .4
	local info = TweenInfo.new(dur, Enum.EasingStyle.Cubic)
	InterfaceUtils.TweenGuiObject(decisionGui.Frame.Scene, info, {Position = UDim2.fromScale(-1.05, .5)})
	
	for _, choiceB in decisionGui.Frame.Choices:GetChildren() :: {GuiButton} do
		choiceB.Active = false
		InterfaceUtils.TweenGuiObject(choiceB, info, {Position = UDim2.fromScale(1.5, choiceB.Position.Y.Scale)})
	end
	
	task.delay(dur, function()
		decisionGui.Enabled = false
	end)
end

-- blink
function InterfaceUtils.Blink(Duration: number?): number
	local duration = Duration and Duration/2 or 0.165
	
	local info = TweenInfo.new(.165, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut, 0, true)

	InterfaceUtils.TweenGuiObject(personGui.UpperLid, info, {Position = UDim2.fromScale(.5, .5)})
	InterfaceUtils.TweenGuiObject(personGui.LowerLid, info, {Position = UDim2.fromScale(.5, .5)})
	
	return duration
end


-- play blackscreen
function InterfaceUtils.PlayBlackScreen(Duration: number?)
	local duration = Duration and Duration/2 or 0.165

	local info = TweenInfo.new(duration, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut, 0, true)

	InterfaceUtils.TweenGuiObject(gui.Blackscreen, info, {BackgroundTransparency = 0})

	return duration
end


-- pop up currency
function InterfaceUtils.PopUpCurrency(Currency: string, Amount: number)
	if Amount <= 0 then
		return
	end

	local imageL = gui.Popups.Icon

	if not imageL then
		return
	end

	local popups = math.ceil(Amount > 50 and math.max(50, Amount/10) or Amount)
	popups = math.clamp(popups, 1, 100)

	local inset = GUI:GetGuiInset()
	local initSize = UDim2.new()
	local mousePos = UDim2.fromOffset(mouse.X + inset.X, mouse.Y + inset.Y)
	local newSize = UDim2.fromScale(0.05, 0.06)

	for i = 1, popups do
		local clone = imageL:Clone()
		clone.Image = IMG_CONFIGS.Currency[Currency]
		clone.Size = initSize
		clone.Position = mousePos
		clone.Parent = gui.Popups.Temp
		clone.Rotation = math.random(0, 360)
		clone.Visible = true

		--local newPos = UDim2.fromOffset(mouse.X + inset.X + math.random(-100, 100), mouse.Y + inset.Y + math.random(-100, 100))

		local sizeInfo = TweenInfo.new(math.random(10,15)/100, Enum.EasingStyle.Back)
		local sizeTween = TWS:Create(clone, sizeInfo, {
			Size = newSize
		})
		sizeTween:Play()

		local newRot = math.random(0, 360)
		local timeToPos = math.random(30,40)/100
		local posInfo = TweenInfo.new(timeToPos, Enum.EasingStyle.Cubic)
		local posTween = TWS:Create(clone, posInfo, {
			Position = UDim2.new(math.random(-175, 175)/1000, mouse.X + inset.X, math.random(-300, 300)/1000, mouse.Y + inset.Y),
		})
		posTween:Play()

		local rotTween = TWS:Create(clone, TweenInfo.new(timeToPos + timeToPos/3, Enum.EasingStyle.Back), {
			Rotation = newRot
		})
		rotTween:Play()

		posTween.Completed:Once(function()
			task.wait(.35)
			sizeTween:Destroy()
			sizeTween = TWS:Create(clone, sizeInfo, {
				Size = initSize
			})
			sizeTween:Play()

			sizeTween.Completed:Once(function()
				clone:Destroy()
			end)
		end)
	end
end

-- gold billboard gui popup
function InterfaceUtils.GoldBillboardGuiPopup(Character: Model | BasePart, Amount: number | string)
	local num = typeof(Amount) == 'string' and tonumber(Amount)
	if typeof(Amount) == 'number' and Amount <= 0 or num and num <= 0 then
		return
	end
	
	local head = Character:IsA('BasePart') and Character or Character:FindFirstChild('Head') :: BasePart

	local gui = script.Gold:Clone()
	gui.Amount.Text = typeof(Amount) == 'string' and Amount or tostring(math.floor(Amount))
	gui.Parent = head

	local info = TweenInfo.new(1, Enum.EasingStyle.Cubic)
	local tween = TWS:Create(gui, info, {StudsOffset = Vector3.new(math.random(-150, 150)/100, math.random(1050, 1150)/100, 0)})

	tween:Play()
	tween.Completed:Once(function()
		info = TweenInfo.new(.3, Enum.EasingStyle.Sine)
		tween = InterfaceUtils.TweenGuiObject(gui.Amount, info, {TextTransparency = 1})
		InterfaceUtils.TweenGuiObject(gui.Icon, info, {ImageTransparency = 1})
		TWS:Create(gui.Amount.UIStroke, info, {Transparency = 1}):Play()

		tween.Completed:Wait()
		gui:Destroy()
	end)
end

-- tax billboard gui popup
function InterfaceUtils.TaxBillboardGuiPopup(Character: Model, Amount: number)
	if Amount <= 0 then
		return
	end

	local head = Character:FindFirstChild('Head') :: BasePart

	local gui = script.Tax:Clone()
	gui.Amount.Text = tostring(math.floor(Amount))
	gui.Parent = head

	local info = TweenInfo.new(1, Enum.EasingStyle.Cubic)
	local tween = TWS:Create(gui, info, {StudsOffset = Vector3.new(math.random(-150, 150)/100, math.random(650, 750)/100, 0)})

	tween:Play()
	tween.Completed:Once(function()
		info = TweenInfo.new(.3, Enum.EasingStyle.Sine)
		tween = InterfaceUtils.TweenGuiObject(gui.Amount, info, {TextTransparency = 1})
		InterfaceUtils.TweenGuiObject(gui.Icon, info, {ImageTransparency = 1})
		TWS:Create(gui.Amount.UIStroke, info, {Transparency = 1}):Play()

		tween.Completed:Wait()
		gui:Destroy()
	end)
end

