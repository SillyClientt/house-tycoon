-- initialize upgrade interface
function Upgrade:Init()
	for _, btn in CLS:GetTagged('UpgradeButton') :: {GuiButton} do
		Upgrade:SetupBuildingUpgradeButton(btn)
	end
	
	CLS:GetInstanceAddedSignal('UpgradeButton'):Connect(function(Tagged: GuiButton)
		Upgrade:SetupBuildingUpgradeButton(Tagged)
	end)
end

-- setup upgrade button
function Upgrade:SetupBuildingUpgradeButton(Button: GuiButton)
	local upgradeModel = Button:FindFirstAncestorOfClass('Model') :: Model
	local building = upgradeModel.Parent :: Model
	local pivot = building:GetAttribute('Pivot') :: string
	
	print(Button)
	Button.Activated:Connect(function()
		print('activated')
		RPS.Remotes.PlotService.RequestUpgrade:FireServer(pivot)
	end)
end

return Upgrade
