	Construction: {
		Built: boolean,
		Progress: number
	}
}

export type AmbientNPCData = {
	DefiningState: 'Peace' | 'War',
	State: string,
	Type: string,
	Model: Model,
	Position: Vector3Value,
	Animator: Animator,
