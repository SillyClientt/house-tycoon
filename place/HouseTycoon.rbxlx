				local hank = station:FindFirstChild('Hank') :: Model?
				local att = hank and hank:FindFirstChildWhichIsA('Attachment', true)

				if hank then
					highlight = TUT_UTILS.Highlight(hank, Color3.new(0.95, 0.5, 0.25))
				end

				if att then
					TUT_UTILS.DirectArrowsAt(att)
				end
			end
			
			if not gui.Hank.Visible then
				gui.Hank:GetPropertyChangedSignal('Visible'):Wait()
			end
			
			local isTweening, tween = INT_UTILS.IsTweening(gui.Hank)
			
			if isTweening and tween then
				tween.Completed:Wait()
			end
			
			local focus, tap = TUT_UTILS.FocusFrameOnGuiObject(gui.Hank.Details.Upgrade)
			
			while DAT_Client:get('ToolUpgrades').Sponge == 0 do
				if gui.Hank.Visible then
					focus, tap = TUT_UTILS.FocusFrameOnGuiObject(gui.Hank.Details.Upgrade)
