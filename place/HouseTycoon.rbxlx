local InvasionServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local PPS = game:GetService('ProximityPromptService')
local RNS = game:GetService('RunService')
local WKS = game:GetService('Workspace')
local HTP = game:GetService('HttpService')
local ANS = game:GetService('AnalyticsService')
local SSG = game:GetService('ServerStorage')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local ANS_SSignals = require(SSG.Modules.Services.AnalyticsService.AnalyticsServerSignals)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local CHN_UTILS = require(RPS.Modules.Utils.ChanceUtils)
local INV_CONFIGS = require(RPS.Modules.Configs.InvasionConfigs)
local INV_SSignals = require(script.Parent.InvasionServerSignals)
local ECN_SSignals = require(SSG.Modules.Services.EconomyService.EconomyServerSignals)
local PLT_CONTAINER = require(SSG.Modules.Services.PlotService.PlotContainer)
local INV_CONTAINER = require(script.Parent.InvasionContainer)

-- initialize plot service server-side
function InvasionServiceServer:Init()
	PLS.PlayerRemoving:Connect(function(Player)
		INV_CONTAINER[Player] = nil
	end)
	
	task.spawn(function()
		while true do
			local waited = task.wait(0.3)
			
			for plr, plot in PLT_CONTAINER do
				local data = DAT_Server:waitForData(plr)
				local active = data:get({'Invasion', 'StoredInvasion', 'Active'})
				
				if active then
					continue
				end
				
				local timer = data:get({'Invasion', 'Timer'})
				local newTimer = timer - waited

				RPS.Remotes.InvasionService.UpdateTimer:FireClient(plr, newTimer)
				
				if newTimer <= 0 then
					if not INV_CONTAINER[plr] then
						local invasion = InvasionServiceServer:CreateInvasion(plr)
						local troopsData = InvasionServiceServer:CreateTroopsData(plr, PLT_CONTAINER[plr], invasion)
						
						INV_CONTAINER[plr] = troopsData
					end
					
					InvasionServiceServer:PlayInvasion(plr,  INV_CONTAINER[plr])
					newTimer = 65
				elseif newTimer <= 30 then
					if not INV_CONTAINER[plr] then
						local invasion = InvasionServiceServer:CreateInvasion(plr)
						local troopsData = InvasionServiceServer:CreateTroopsData(plr, PLT_CONTAINER[plr], invasion)
						
						RPS.Remotes.InvasionService.Station:FireAllClients(plr, troopsData, 'Bandits')
						
						INV_CONTAINER[plr] = troopsData
					end
				end
				
				data:update({'Invasion', 'Timer'}, function()
					return newTimer
				end)
			end
		end
	end)
end

-- get invasion budget
function InvasionServiceServer:GetInvasionBudget(Player: Player): number
	local npcsData = DAT_Server:get(Player, 'PersistentNPCs')
	local guards = npcsData.Guards
	local knights = npcsData.Knights
	
	local invasionsData = DAT_Server:get(Player, 'Invasion')
	local prestige = DAT_Server:get(Player, 'Prestige')
	
	local budget = 300
	
	local progress = math.min((-5 + invasionsData.Completed) * 0.025, 0.3) + math.min(prestige / 20000, 0.15)
	local defensePower = 0
	
	for _, data in guards do
		local config = INV_CONFIGS.Units['Guard'][data.Level]
		defensePower += config.Cost
	end
	
	for unit, data in knights do
		local config = INV_CONFIGS.Units[unit][data.Level]
		defensePower += config.Cost
	end
	
	local consecutives = invasionsData.Consecutives * 0.06
	
	budget += defensePower * 0.6
	budget *= 1 + progress
	budget *= 1 + consecutives
	
	return budget
end

-- create invasion
function InvasionServiceServer:CreateInvasion(Player: Player): {[string]: {[number]: number}}
	local allocatedBudget = InvasionServiceServer:GetInvasionBudget(Player)
	local threat = DAT_Server:get(Player, {'Invasion', 'Threat'})
	
	print(allocatedBudget)
	
	local pool = INV_CONFIGS.Invasions['Bandits'].UnitPool
	local unitConfigs = INV_CONFIGS.Units
	
	local group = {} :: {[string]: {[number]: number}}
	
	while true do
		local levelPoolToPickFrom = {} :: {[string]: {[number]: number}}

		for _, unit in pool do
			for level, config in unitConfigs[unit] do
				if config.MinThreatTier > threat then
					continue
				end

				if config.Cost > allocatedBudget then
					continue
				end

				levelPoolToPickFrom[unit] = levelPoolToPickFrom[unit] or {}
				levelPoolToPickFrom[unit][level] = config.Weight
			end
		end
		
		local unitPoolToPickFrom = {} :: {[string]: number}
		local poolNum = 0

		for unit, levelPool in levelPoolToPickFrom do
			poolNum += 1
			
			local totWeight = 0
			for level, weight in levelPool do
				totWeight += weight
			end
			
			unitPoolToPickFrom[unit] = totWeight
		end
		
		if poolNum == 0 then
			break
		end
		
		local chosenUnit = CHN_UTILS.PickKeyFromPool(unitPoolToPickFrom)
		local chosenLevel = CHN_UTILS.PickKeyFromPool(levelPoolToPickFrom[chosenUnit])
		
		group[chosenUnit] = group[chosenUnit] or {}
		group[chosenUnit][chosenLevel] = group[chosenUnit][chosenLevel] or 0
		group[chosenUnit][chosenLevel] += 1
		
		allocatedBudget -= unitConfigs[chosenUnit][chosenLevel].Cost
		
		if allocatedBudget <= 0 then
			break
		end
	end
	
	return group
end

-- warn of invasion
function InvasionServiceServer:PlayInvasion(Player: Player, Troops: {Defenders: {Tag: string, Data: {DAT_TYPES.TroopData}}, Invaders: {Tag: string, Data: {DAT_TYPES.TroopData}}})
	DAT_Server:update(Player, {'Invasion', 'StoredInvasion', 'Active'}, function()
		return true
	end)
	
	RPS.Remotes.InvasionService.Battle:FireAllClients(Player)

	local outcome = 'Victory'

	while true do
		local defenderAlive = false

		for _, data in Troops.Defenders.Data do
			if data.Health > 0 then
				defenderAlive = true
				break
			end
		end
		
		if not defenderAlive then
			outcome = 'Defeat'
			break
		end

		local invaderAlive = false

		for _, data in Troops.Invaders.Data do
			if data.Health > 0 then
				invaderAlive = true
				break
			end
		end
		
		if not invaderAlive then
			outcome = 'Victory'
			break
		end
		
		InvasionServiceServer:UpdateTroopStates(Player, Troops.Defenders, Troops.Invaders)
		InvasionServiceServer:UpdateTroopStates(Player, Troops.Invaders, Troops.Defenders)
		
		task.wait(.1)
	end
	
	local additive = outcome == 'Victory' and 1 or -1
	
	RPS.Remotes.InvasionService.Aftermath:FireAllClients(Player, outcome)

	DAT_Server:update(Player, {'Invasion', 'Consecutives'}, function(Old)
		return Old + additive
	end)
	DAT_Server:update(Player, {'Invasion', 'StoredInvasion', 'Active'}, function()
		return false
	end)
	
	INV_CONTAINER[Player] = nil
end

-- update troops data
function InvasionServiceServer:UpdateTroopStates(Player: Player, Attackers: {Tag: string, Data: {DAT_TYPES.TroopData}}, Targets: {Tag: string, Data: {DAT_TYPES.TroopData}})
	for attackerIndex, attacker in Attackers.Data do
		if attacker.Health <= 0 then
			continue
		end
		
		local now = os.clock()
		local lastState = attacker.State
		local lastUpdate = attacker.LastUpdate or now
		local passed = now - lastUpdate
		
		local attackerConfig = INV_CONFIGS.Units[attacker.ConfigKey][attacker.Level]
		local attackerCF = attacker.RelCFrame :: CFrame
		
		if not attacker.Target then
			local distance = 10000
			for defenderIndex, defender in Targets.Data do
				if defender.Health <= 0 then
					continue
				end
				
				local defenderCF = defender.RelCFrame :: CFrame
				local dis = (defenderCF.Position - attackerCF.Position).Magnitude
				
				if dis < distance then
					attacker.Target = defenderIndex
					distance = dis
				end
			end

			local defender = attacker.Target and Targets.Data[attacker.Target]

			RPS.Remotes.InvasionService.UpdateTarget:FireAllClients(Player, attacker.Index, defender and defender.Index, attacker.Group, defender and defender.Group)
		end
		
		local defenderIndex = attacker.Target
		local defender = defenderIndex and Targets.Data[defenderIndex]

		if defender then
			local defenderConfig = INV_CONFIGS.Units[defender.ConfigKey][defender.Level]
			local defenderCF = defender.RelCFrame :: CFrame
			
			local diff = defenderCF.Position - attackerCF.Position
			local distance = diff.Magnitude

			if distance > attackerConfig.Range then
				attacker.RelCFrame = CFrame.lookAt(attackerCF.Position, defenderCF.Position) * CFrame.new(0, 0, -attackerConfig.WalkSpeed * passed)
				attacker.State = 'Moving'
			else
				attacker.State = 'Idle'

				if os.clock() - attacker.LastHit > attackerConfig.Rate then
					attacker.State = 'Attacking'
					attacker.LastHit = now

					task.delay(attackerConfig.DamageDelay, function()
						if not attacker.Target or attacker.Health <= 0 then
							return
						end

						local damage = attackerConfig.Damage
						defender.Health -= damage
					
						RPS.Remotes.InvasionService.UpdateHealth:FireAllClients(Player, defender.Index, defender.Health, defender.Group)

						if defender.Health <= 0 then
							if not defender.Dispensed and defender.Group == 'Invaders' then
								local config = INV_CONFIGS.Units[defender.ConfigKey][defender.Level]
								if config.Reward then
									ECN_SSignals.Reward:Fire(Player, config.Reward, 'Kill')
								end
								
								defender.Dispensed = true
							end
							
							for _, data in Attackers.Data do
								if data.Target and data.Target == defenderIndex then
									data.Target = nil
								end
							end
						end
					end)
				end
			end
		end
		
		attacker.LastUpdate = now
		
		if lastState ~= attacker.State then
			RPS.Remotes.InvasionService.UpdateState:FireAllClients(Player, attacker.Index, attacker.State, attacker.Group)
		end
	end
end

-- create troops data from invasion
function InvasionServiceServer:CreateTroopsData(Player: Player, Plot: typeof(WKS.Plots.Plot), Invasion: {[string]: {[number]: number}}): {Defenders: {Tag: string, Data: {DAT_TYPES.TroopData}}, Invaders: {Tag: string, Data: {DAT_TYPES.TroopData}}}
	local troops = {
		Defenders = {
			Tag = 'Defenders',
			Data = {}
		},
		Invaders = {
			Tag = 'Invaders',
			Data = {}
		}
	} :: {Defenders: {Tag: string, Data: {DAT_TYPES.TroopData}}, Invaders: {Tag: string, Data: {DAT_TYPES.TroopData}}}
	
	local defenderCFVs = Plot.NPCs.Pivots.Invasion.Troops:GetChildren()
	local defenderCFs: {[number]: CFrame} = {}

	local spawnI = 1
	local loops = 0

	for i = 1, 60 do
		defenderCFs[i] = (Plot.NPCs.Pivots.Invasion.Troops:FindFirstChild('Spawn'..spawnI) :: CFrameValue).Value * CFrame.new(0,0,10*loops)
		
		spawnI += 1
		
		if spawnI > #defenderCFVs then
			spawnI = 1
			loops += 1
		end
	end

	local filled = 1
	local npcsData = DAT_Server:get(Player, 'PersistentNPCs')
	local knightsData = npcsData.Knights
	local guardsData = npcsData.Guards
	
	for name, data in knightsData do
		local config = INV_CONFIGS.Units[name][data.Level]
		local defenderData: DAT_TYPES.TroopData = {
			Group = 'Knights',
			ConfigKey = name,
			Dispensed = false,
			Index = name,
			Level = data.Level,
			Health = config.Health,
			State = 'Idle',
			LastState = '',
			LastHit = 0,
			RelCFrame = defenderCFs[filled]
		}
		
		table.insert(troops.Defenders.Data, defenderData)
		filled += 1
	end

	for index, data in guardsData do
		local config = INV_CONFIGS.Units.Guard[data.Level]
		
		local defenderData: DAT_TYPES.TroopData = {
			Group = 'Guards',
			ConfigKey = 'Guard',
			Dispensed = false,
			Index = index,
			Level = data.Level,
			Health = config.Health,
			State = 'Idle',
			LastState = '',
			LastHit = 0,
			RelCFrame = defenderCFs[filled]
		}

		table.insert(troops.Defenders.Data, defenderData)
		filled += 1
	end
	
	local invaderCFVs = Plot.NPCs.Pivots.Invasion.Invaders:GetChildren()
	local invaderCFs: {[number]: CFrame} = {}

	spawnI = 1
	loops = 0
	
	for i = 1, 60 do
		invaderCFs[i] = (Plot.NPCs.Pivots.Invasion.Invaders:FindFirstChild('Spawn'..spawnI) :: CFrameValue).Value * CFrame.new(0,0,10*loops)

		spawnI += 1

		if spawnI > #defenderCFVs then
			spawnI = 1
			loops += 1
		end
	end
	
	filled = 1
	
	for unit, levelPool in Invasion do
		for level, amount in levelPool do
			local config = INV_CONFIGS.Units[unit][level]
			
			for i = 1, amount do
				local invaderData: DAT_TYPES.TroopData = {
					Group = 'Invaders',
					ConfigKey = unit,
					Dispensed = false,
					Index = filled,
					Level = level,
					Health = config.Health,
					State = 'Idle',
					LastState = '',
					LastHit = 0,
					RelCFrame = invaderCFs[filled]
				}
				
				table.insert(troops.Invaders.Data, invaderData)
				filled += 1
			end
		end
	end
	
	return troops
end


return InvasionServiceServer
