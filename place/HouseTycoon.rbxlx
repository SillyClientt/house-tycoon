/int><string name="SerializedOverrides"></string><token name="Sink">0</token><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>6</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">-1</int64><token name="Style">0</token><bool name="Visible">true</bool><int name="ZIndex">1</int></Properties></Item><Item class="NumberValue" referent="RBX1164"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name">NumValue</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64><double name="Value">0</double></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBX1166"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Store</string><string name="ScriptGuid">{57624880-e1e2-4368-8cbf-fd2ffbc2f325}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Store = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local MPS = game:GetService('MarketplaceService')
local PPS = game:GetService('ProximityPromptService')

local STR_CONFIGS = require(RPS.Modules.Services.StoreService.StoreConfigs)
local TOL_CONFIGS = require(RPS.Modules.Services.ToolService.ToolConfigs)
local FSH_CONFIGS = require(RPS.Modules.Services.FishService.FishConfigs)
local IMG_CONFIGS = require(RPS.Modules.Services.ImageService.ImageConfigs)
local DAT_Client = require(RPS.Modules.Packages.DataService).client

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui
local hud = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local sidebar = hud:WaitForChild('Sidebar')
local store = hud:WaitForChild('Store')
local storeSidebar = store:WaitForChild('Sidebar')
local storeB = sidebar:WaitForChild('Store')
local scroller = store:WaitForChild('Scroller')
local actions = store:WaitForChild('Actions')
local newOffers = store:WaitForChild('NewOffers')
local closeB = store:WaitForChild('Close')
local details = store:WaitForChild('Details')
local searchBox = actions:WaitForChild('Search'):WaitForChild('TextBox')
local upgradeB = details:WaitForChild('Upgrades'):WaitForChild('Upgrade')
local mainBuyB = details:WaitForChild('Buy'):WaitForChild('Buy')
local equipB = details.Buy:WaitForChild('Equip')
local unequipB = details.Buy:WaitForChild('Unequip')
local serverBuyB = details:WaitForChild('Server'):WaitForChild('Buy')
local purchaseB = details:WaitForChild('Purchase'):WaitForChild('Purchase')

local tweens: {[Instance]: Tween} = {}
local hidden: {TextButton | ImageButton} = {}

local sortList = {
	PayType = {
		Shells = 0,
		Robux = 10000000,
	}
}

local selected: typeof(scroller:WaitForChild('Sponge')) | typeof(scroller:WaitForChild('CoralHelmet')) | typeof(scroller:WaitForChild('ShellRush15')) = scroller.ShellsRush15
local selectedCat = storeSidebar:WaitForChild('Upgrades')
local sortType = 'Price'
local lastAffordable = 0

-- get product data from name
local function getProductData(Name: string): ({Name: string, Id: number}?, boolean?)
	for id, data in STR_CONFIGS.Gamepasses do
		if data.Name == Name then
			return data, true
		end
	end
	
	for id, data in STR_CONFIGS.DevProducts do
		if data.Name == Name then
			return data, false
		end
	end
	
	return nil, nil
end

-- sort store buttons
local function sort()
	if sortType == 'Price' then
		scroller.UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		
		for _, child in scroller:GetChildren() do
			if not child:IsA('TextButton') then
				continue
			end

			local details = child:GetAttribute('Details')
			local isUpgrade = details == 'Upgrades'

			local productData = not isUpgrade and getProductData(child.Name)
			local productInfo = productData and MPS:GetProductInfoAsync(productData.Id)
			
			local name = isUpgrade and child.Name :: 'Sponge' | 'Scraper' | 'Toothbrush'
			
			local upgradesData = name and DAT_Client:get('ToolUpgrades')
			
			local config = name and TOL_CONFIGS.Upgrades[name]
			local price = name and config and TOL_CONFIGS.Upgrades[name][upgradesData[name] + 1].Cost or productInfo and productInfo.PriceInRobux
			
			child.LayoutOrder = sortList.PayType[isUpgrade and 'Shells' or 'Robux'] - (price or 0)
			
			child.ZIndex = -child.LayoutOrder
		end
	elseif sortType == 'Name' then
		scroller.UIListLayout.SortOrder = Enum.SortOrder.Name
	end
end

-- filter store buttons
local function filter()
	for _, child in scroller:GetChildren() do
		if not child:IsA('TextButton') then
			continue
		end
		
		if table.find(hidden, child) then
			continue
		end
		
		local visible = (child.Name:lower()):match((searchBox.Text:lower())) and true or false
		
		child.Visible = visible
	end
end

-- get store config from name
local function getIdFromName(Name: string): (number, Enum.InfoType)
	local matchingId: number = 0
	local category = 'Gamepasses'

	for cat, data in pairs(STR_CONFIGS :: {[string]: {[number]: {Id: number, Name: string}}}) do
		for id, info in pairs(data) do
			if info.Name == Name then
				category = cat
				matchingId = info.Id
				break
			end
		end

		if matchingId ~= 0 then
			break
		end
	end
	
	return matchingId, category == 'Gamepasses' and Enum.InfoType.GamePass or Enum.InfoType.Product
end

-- update owned
local function updateOwned()
	for _, child in scroller:GetChildren() do
		if not child:IsA('TextButton') then
			continue
		end
		
		local data, isGamepass = getProductData(child.Name)
		
		if data then
			if isGamepass then
				local owned = (child :: typeof(scroller:WaitForChild('Aquarium'))).Icon.Owned
				
				if data.Name == 'WhaleLicense' then
					owned.Visible = DAT_Client:get('WhaleLicense') or MPS:UserOwnsGamePassAsync(plr.UserId, data.Id)
				else
					owned.Visible = MPS:UserOwnsGamePassAsync(plr.UserId, data.Id)
				end
			end
		elseif child:GetAttribute('Details') == 'Buy' then
			local skinsData = DAT_Client:get('Skins')
			local config = STR_CONFIGS.Skins[child.Name]
			local isOwned = skinsData[config.SkinCurrency][config.Tool];
			--(child :: typeof(scroller:WaitForChild('PearlHelmet'))).Icon.Owned.Visible = isOwned
		end
	end
end

-- update details panel
local function updateDetails()
	local detailsAtt = selected:GetAttribute('Details')
	local isUpgrade = detailsAtt == 'Upgrades'
	
	for _, child in details:GetChildren() do
		if not child:IsA('Frame') then
			continue
		end
		
		child.Visible = child.Name == detailsAtt
	end

	local upgradesFrame = details.Upgrades
	local purchaseFrame = details.Purchase
	local buyFrame = details.Buy
	local serverFrame = details.Server

	if isUpgrade then
		local upgradesData = DAT_Client:get('ToolUpgrades')
		local level = upgradesData[selected.Name]
		local configs = TOL_CONFIGS.Upgrades[selected.Name :: 'Sponge' | 'Scraper' | 'Toothbrush']
		
		local base = configs[0].Damage
		local current = configs[level].Damage / base
		local nextRate = configs[level + 1] and configs[level + 1].Damage / base
		
		current = math.round(current * 100) / 100
		nextRate = nextRate and math.round(nextRate * 100) / 100
		
		upgradesFrame.Top.Title.Text = selected.Name:upper()
		upgradesFrame.Back.Icon.Image = selected.Content.Icon.Image
		
		upgradesFrame.Description.NextLevel.Text = 'Level ' .. level .. ' → ' .. (nextRate and level + 1 or 'MAX')
		upgradesFrame.Description.NextRate.Text = 'Rate ' .. current .. ' → ' .. (nextRate or 'MAX')
		
		upgradesFrame.Info.Level.Value.Text = level
		upgradesFrame.Info.UpgradeCost.Value.Text = configs[level + 1] and tostring(configs[level + 1].Cost) or 'MAX'

		selected.Content.Level.Amount.Text = upgradesData[selected.Name] or '0'
	elseif detailsAtt == 'Purchase' then
		local id, infoType = getIdFromName(selected.Name)
		
		if id == 0 then
			return
		end
		
		local productInfo = MPS:GetProductInfoAsync(id, infoType)
		
		if not productInfo then
			return
		end
		
		purchaseFrame.Top.Title.Text = selected.Title.Text
		purchaseFrame.Description.TextLabel.Text = productInfo.Description
		purchaseFrame.Info.PurchaseCost.Value.Text = productInfo.PriceInRobux
		purchaseFrame.Back.Icon.Image = 'rbxassetid://'..(productInfo.IconImageAssetId)
	elseif detailsAtt == 'Buy' then
		local config = STR_CONFIGS.Skins[selected.Name]
		buyFrame.Top.Title.Text = selected.Title.Text
		buyFrame.Info.Skin.Value.Text = config.SkinCurrency
			
		buyFrame.Info.BuyCost.Icon.Image = config.Priceless and IMG_CONFIGS.Unlockable or selected.Cost.Icon.Image
		buyFrame.Info.BuyCost.Value.Text = config.Priceless and 'Unlockable' or tostring(config.Cost)
		buyFrame.Info.ShellsCost.Value.Text = config.Priceless and 'Unlockable' or tostring(config.ShellsCost)
		buyFrame.Back.Icon.Image = selected.Icon.Image
		
		local skins = DAT_Client:get('Skins')
		local equipped = DAT_Client:get('EquippedTools')
		local stationSkin = DAT_Client:get('StationSkin')
		local helmetSkin = DAT_Client:get('HelmetSkin')
		
		local skinOwned = skins[config.SkinCurrency][config.Tool]
		
		if config.Tool == 'Station' then
			equipB.Visible = skinOwned and stationSkin ~= config.SkinCurrency
			unequipB.Visible = skinOwned and stationSkin == config.SkinCurrency
			mainBuyB.Visible = not skinOwned and not config.Priceless
		elseif config.Tool == 'Helmet' then
			equipB.Visible = skinOwned and helmetSkin ~= config.SkinCurrency
			unequipB.Visible = skinOwned and helmetSkin == config.SkinCurrency
			mainBuyB.Visible = not skinOwned and not config.Priceless
		else
			equipB.Visible = skinOwned and equipped[config.Tool] ~= config.SkinCurrency
			unequipB.Visible = skinOwned and equipped[config.Tool] == config.SkinCurrency
			mainBuyB.Visible = not skinOwned and not config.Priceless
		end
	elseif detailsAtt == 'Server' then
		local boost = selected.Name:gsub('Boost','')
		local config = FSH_CONFIGS.ServerBoosts[boost]

		serverFrame.Back.Icon.Image = selected.Icon.Image
		serverFrame.Top.Title.Text = selected.Title.Text:upper()
		serverFrame.Info.Boost.Value.Text = boost
		serverFrame.Info.BuyCost.Value.Text = tostring(config.ShellsCost)
		serverFrame.Info.Boost.Icon.Image = selected.Icon.Image
	end
end

-- initialize scroller buttons
local function initButtons()
	for _, child in scroller:GetChildren() do
		if child:IsA('TextButton') or child:IsA('ImageButton') then
			if not child.Visible then
				table.insert(hidden, child)
			end
		end
	end
	
	updateOwned()
	updateDetails()
	
	local toolData = DAT_Client:get('ToolUpgrades')

	for _, button in scroller:GetChildren() do
		if not button:IsA('TextButton') then
			continue
		end

		local detailsAtt = button:GetAttribute('Details')
		local isUpgrade = detailsAtt == 'Upgrades'
		local isSkin = detailsAtt == 'Buy'
		local isBoost = detailsAtt == 'Server'

		if isUpgrade then
			--(button :: typeof(scroller.Sponge)).Content.Level.Amount.Text = toolData[button.Name] or '0'
		elseif isSkin then
			--[[local config = STR_CONFIGS.Skins[button.Name]
			local skinButton = (button :: typeof(scroller.CoralHelmet))
			skinButton.Cost.Amount.Text = tostring(config.Cost)
			skinButton.ShellsCost.Amount.Text = tostring(config.ShellsCost)]]
		elseif isBoost then
			local boost = button.Name:gsub('Boost', '')
			local shellsBuyB = button:FindFirstChild('ShellsBuy') :: TextButton
			local initSize = shellsBuyB.Size
			local config = FSH_CONFIGS.ServerBoosts[boost]
			local boostButton = button :: typeof(scroller.EpicBoost)
			
			boostButton.ShellsBuy.Amount.Text = tostring(config.ShellsCost)
			boostButton.Label.Text = 'x' .. config.Multiplier .. ' ' .. boost .. ' Fish'
			boostButton.Time.Amount.Text = tostring(math.floor(config.Duration / 60))

			shellsBuyB.MouseEnter:Connect(function()
				if tweens[shellsBuyB] then
					tweens[shellsBuyB]:Destroy()
				end

				tweens[shellsBuyB] = TWS:Create(shellsBuyB, TweenInfo.new(0.15, Enum.EasingStyle.Cubic), {
					Size = UDim2.fromScale(initSize.X.Scale * 1.1, initSize.Y.Scale * 1.1),
					BackgroundColor3 = Color3.fromRGB(251, 146, 235),
					Rotation = -5
				})
				tweens[shellsBuyB]:Play()
			end)

			shellsBuyB.MouseLeave:Connect(function()
				if tweens[shellsBuyB] then
					tweens[shellsBuyB]:Destroy()
				end

				tweens[shellsBuyB] = TWS:Create(shellsBuyB, TweenInfo.new(0.15, Enum.EasingStyle.Cubic), {
					Size = initSize,
					BackgroundColor3 = Color3.fromRGB(211, 89, 184),
					Rotation = 0
				})
				tweens[shellsBuyB]:Play()
			end)

			shellsBuyB.MouseButton1Click:Connect(function()
				RPS.Remotes.FishService.BuyBoost:FireServer(boost)
			end)
		else
			local productData, isGamepass = getProductData(button.Name)
			
			if productData and productData.Name ~= 'AutoToolSwitch' then
				local productInfo = MPS:GetProductInfoAsync(productData.Id, isGamepass and Enum.InfoType.GamePass or Enum.InfoType.Product);

				(button :: typeof(scroller.ShellsRush15)).Buy.Amount.Text = productInfo.PriceInRobux
			end
		end

		local colors = {
			Hover = button:GetAttribute('Hover'),
			Natural = button:GetAttribute('Neutral')
		}

		local buyB = button:FindFirstChild('Buy') :: TextButton?
		if buyB then
			local initSize = buyB.Size

			buyB.MouseEnter:Connect(function()
				if tweens[buyB] then
					tweens[buyB]:Destroy()
				end

				tweens[buyB] = TWS:Create(buyB, TweenInfo.new(0.15, Enum.EasingStyle.Cubic), {
					Size = UDim2.fromScale(initSize.X.Scale * 1.1, initSize.Y.Scale * 1.1),
					BackgroundColor3 = Color3.fromRGB(157, 249, 117),
					Rotation = -5
				})
				tweens[buyB]:Play()
			end)

			buyB.MouseLeave:Connect(function()
				if tweens[buyB] then
					tweens[buyB]:Destroy()
				end

				tweens[buyB] = TWS:Create(buyB, TweenInfo.new(0.15, Enum.EasingStyle.Cubic), {
					Size = initSize,
					BackgroundColor3 = Color3.fromRGB(92, 209, 62),
					Rotation = 0
				})
				tweens[buyB]:Play()
			end)
			
			buyB.MouseButton1Click:Connect(function()
				local productData, isGamepass = getProductData(button.Name)
				
				if productData then
					if isGamepass then
						if productData.Name == 'WhaleLicense' then
							if DAT_Client:get('WhaleLicense') then
								return
							end
						end
						
						MPS:PromptGamePassPurchase(plr, productData.Id)
					else
						if button.Name:match('Rush') then
							local data = DAT_Client:get('ShellsRush')

							if data.Active then
								return
							end
						end
						
						MPS:PromptProductPurchase(plr, productData.Id)
					end
				end
			end)
		end

		button.MouseEnter:Connect(function()
			if tweens[button] then
				tweens[button]:Destroy()
			end

			tweens[button] = TWS:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = colors.Hover
			})
			tweens[button]:Play()
		end)
		button.MouseLeave:Connect(function()
			if selected == button then
				return
			end

			if tweens[button] then
				tweens[button]:Destroy()
			end

			tweens[button] = TWS:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = colors.Natural
			})
			tweens[button]:Play()
		end)

		button.MouseButton1Click:Connect(function()
			if selected == button then
				return
			end

			if tweens[button] then
				tweens[button]:Destroy()
			end

			if selected then
				if tweens[selected] then
					tweens[selected]:Destroy()
				end

				selected.BackgroundColor3 = selected:GetAttribute('Neutral')
			end

			button.BackgroundColor3 = colors.Hover

			selected = button :: typeof(selected)
			updateDetails()
		end)
	end
end

-- play new affordable
local function newAffordable(Upgradeable: string)
	local button = scroller:FindFirstChild(Upgradeable) :: typeof(scroller.Sponge) | typeof(scroller.CoralHelmet)
	local isUpgrade = button:GetAttribute('Details') == 'Upgrades'

	if button:GetAttribute('Notification') or button.Name:match('Toothbrush') then
		return
	end
	
	button:SetAttribute('Notification', true)
	
	local frame = storeB.NewAffordable.Frame
	local oldTween = tweens[frame]
	
	if oldTween then
		oldTween:Destroy()
	end
	
	storeB.NewAffordable.Visible = true
	
	frame.Title.Text = 'New Affordable!'
	frame.Icon.Image = isUpgrade and button.Content.Icon.Image or button.Icon.Image
	frame.Position = UDim2.fromScale(1,0)
	
	tweens[frame] = TWS:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
		Position = UDim2.fromScale(1,1)
	})
	tweens[frame]:Play()
	
	store.NewAffordableSound:Play()
	lastAffordable = tick()
	
	task.spawn(function()
		task.wait(1.5)
		
		if tick() - lastAffordable >= 1.45 then
			tweens[frame] = TWS:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Position = UDim2.fromScale(0,1)
			})
			tweens[frame]:Play()

			tweens[frame].Completed:Wait()
			if frame.Position == UDim2.fromScale(0,1) then
				storeB.NewAffordable.Visible = false
			end
		end
	end)
end

-- rotate button on hover
local function addButtonEffect(Button: TextButton)
	local colors = {
		Hover = Button:GetAttribute('Hover'),
		Normal = Button:GetAttribute('Normal')
	}
	
	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 5,
			Size = UDim2.fromScale(1,.11),
			BackgroundColor3 = colors.Hover
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = UDim2.fromScale(1,.1),
			BackgroundColor3 = colors.Normal
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- initialize store interface
function Store:Init()
	initButtons()
	
	DAT_Client:getChangedSignal('ToolUpgrades'):Connect(function(Data)
		updateDetails()
	end)
	DAT_Client:getChangedSignal('Skins'):Connect(function(Data)
		updateOwned()
	end)
	
	DAT_Client:getChangedSignal('Shells'):Connect(function(Shells)
		local upgradesData = DAT_Client:get('ToolUpgrades')
		
		for _, button in scroller:GetChildren() do
			if not button:IsA('TextButton') or button:GetAttribute('Details') ~= 'Upgrades' then
				continue
			end
			
			local name = button.Name :: 'Sponge' | 'Scraper' | 'Toothbrush'
			local config = TOL_CONFIGS.Upgrades[name][upgradesData[button.Name] + 1]
			
			local cost = config and config.Cost
			
			if cost and Shells >= cost then
				--newAffordable(name)
			else
				button:SetAttribute('Notification', nil)
			end
		end
	end)
	
	DAT_Client:getChangedSignal('MutationCurrencies'):Connect(function(Data)
		for _, button in scroller:GetChildren() do
			if not button:IsA('TextButton') or button:GetAttribute('Details') ~= 'Buy' then
				continue
			end

			local name = button.Name
			local config = STR_CONFIGS.Skins[name]

			local skins = DAT_Client:get('Skins')

			if not Data[config.SkinCurrency] then
				continue
			end

			if Data[config.SkinCurrency] >= config.Cost and not skins[config.SkinCurrency][config.Tool] then
				--newAffordable(name)
			else
				button:SetAttribute('Notification', nil)
			end
		end
	end)
	
	DAT_Client:getChangedSignal('Skins'):Connect(updateDetails)
	DAT_Client:getChangedSignal('EquippedTools'):Connect(updateDetails)
	DAT_Client:getChangedSignal('HelmetSkin'):Connect(updateDetails)
	DAT_Client:getChangedSignal('StationSkin'):Connect(updateDetails)

	local upgradesAbsY = scroller:WaitForChild('Boosters').AbsolutePosition.Y
	
	for _, sidebarButton in storeSidebar:GetChildren() do
		if not sidebarButton:IsA('TextButton') then
			continue
		end
		
		sidebarButton.MouseEnter:Connect(function()
			if tweens[sidebarButton] then
				tweens[sidebarButton]:Destroy()
			end
			
			local tween = TWS:Create(sidebarButton, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = Color3.fromRGB(124, 198, 255)
			})
			tweens[sidebarButton] = tween
			tween:Play()
		end)
		sidebarButton.MouseLeave:Connect(function()
			if selectedCat == sidebarButton then
				return
			end
			
			if tweens[sidebarButton] then
				tweens[sidebarButton]:Destroy()
			end

			local tween = TWS:Create(sidebarButton, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = Color3.fromRGB(17, 47, 91)
			})
			tweens[sidebarButton] = tween
			tween:Play()
		end)
		
		sidebarButton.MouseButton1Click:Connect(function()
			if sidebarButton == selectedCat then
				return
			end
			
			if tweens[sidebarButton] then
				tweens[sidebarButton]:Destroy()
			end
			
			sidebarButton.BackgroundColor3 = Color3.fromRGB(124, 198, 255);
			
			selectedCat.BackgroundColor3 = Color3.fromRGB(17, 47, 91)
			selectedCat = sidebarButton :: typeof(selectedCat)
			
			local frame = scroller:FindFirstChild(sidebarButton.Name) :: Frame
			local diff = scroller.Server.AbsolutePosition.Y - scroller.Boosters.AbsolutePosition.Y
			
			local absY = frame.AbsolutePosition.Y
			
			local posY = scroller.CanvasPosition.Y
			local newPosY = (posY + absY) - upgradesAbsY + 15
			
			scroller.CanvasPosition = Vector2.new(0, newPosY)
			
			filter()
		end)
	end
	
	closeB.MouseEnter:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end
		
		local tween = TWS:Create(closeB, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 15,
			Size = UDim2.fromScale(.175,.175)
		})
		tweens[closeB] = tween
		tween:Play()
	end)
	closeB.MouseLeave:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end

		local tween = TWS:Create(closeB, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = UDim2.fromScale(.15,.15)
		})
		tweens[closeB] = tween
		tween:Play()
	end)
	
	closeB.MouseButton1Click:Connect(function()
		store.Visible = false
	end)
	
	addButtonEffect(upgradeB)
	addButtonEffect(purchaseB)
	addButtonEffect(mainBuyB)
	addButtonEffect(serverBuyB)
	addButtonEffect(equipB)
	addButtonEffect(unequipB)
	
	upgradeB.MouseButton1Click:Connect(function()
		if selected:GetAttribute('Details') == 'Upgrades' then
			RPS.Remotes.ToolService.UpgradeTool:FireServer(selected.Name)
			selected:SetAttribute('Notification', nil)
		end
	end)
	purchaseB.MouseButton1Click:Connect(function()
		if selected:GetAttribute('Details') == 'Purchase' then
			local data, isGamepass = getProductData(selected.Name)
			
			if data then
				if isGamepass then
					MPS:PromptGamePassPurchase(plr, data.Id)
				else
					if selected.Name:match('Rush') then
						local data = DAT_Client:get('ShellsRush')
						
						if data.Active then
							return
						end
					end
					
					MPS:PromptProductPurchase(plr, data.Id)
				end
			end
		end
	end)
	mainBuyB.MouseButton1Click:Connect(function()
		if selected:GetAttribute('Details') == 'Buy' then
			local config = STR_CONFIGS.Skins[selected.Name]
			RPS.Remotes.ToolService.BuySkin:FireServer(config.Tool, config.SkinCurrency)
		end
	end)
	equipB.MouseButton1Click:Connect(function()
		if selected:GetAttribute('Details') == 'Buy' then
			local config = STR_CONFIGS.Skins[selected.Name]
			RPS.Remotes.ToolService.EquipSkin:FireServer(config.Tool, config.SkinCurrency)
		end
	end)
	unequipB.MouseButton1Click:Connect(function()
		if selected:GetAttribute('Details') == 'Buy' then
			local config = STR_CONFIGS.Skins[selected.Name]
			RPS.Remotes.ToolService.UnequipSkin:FireServer(config.Tool)
		end
	end)
	serverBuyB.MouseButton1Click:Connect(function()
		if selected:GetAttribute('Details') == 'Server' then
			local boost = selected.Name:gsub('Boost', '')
			RPS.Remotes.FishService.BuyBoost:FireServer(boost)
		end
	end)
	
	searchBox:GetPropertyChangedSignal('Text'):Connect(function()
		filter()
	end)
	
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		if Player == plr then
			if Prompt.Name == 'Aquarium' then
				store.Visible = true
				
				local frame = scroller.Passes
				local diff = scroller.Server.AbsolutePosition.Y - scroller.Boosters.AbsolutePosition.Y

				local absY = frame.AbsolutePosition.Y

				local posY = scroller.CanvasPosition.Y
				local newPosY = (posY + absY) - upgradesAbsY + 15

				scroller.CanvasPosition = Vector2.new(0, newPosY)
			end
		end
	end)
end

return Store
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1167"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Sidebar</string><string name="ScriptGuid">{162af72a-db0f-42b8-9c76-b147cedcef1c}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Sidebar = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')

local FSH_CONFIGS = require(RPS.Modules.Services.FishService.FishConfigs)

local plr = PLS.LocalPlayer :: Player
local mouse = plr:GetMouse()

local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local sidebar = gui:WaitForChild('Sidebar')

local tweens: {[Instance]: Tween} = {}

local instances = {
	gui:WaitForChild('Store'),
	gui:WaitForChild('Fishclopedia'),
	gui:WaitForChild('Home'),
	gui:WaitForChild('Daily'),
	gui:WaitForChild('Gizmo'),
	gui:WaitForChild('Backpack'),
	gui:WaitForChild('Velvet'),
	gui:WaitForChild('LikeGame'),
	gui:WaitForChild('Order'),
	gui:WaitForChild('Hank')
}

-- initialize sidebar interface
function Sidebar:Init()
	for _, frame in instances do
		frame:GetPropertyChangedSignal('Visible'):Connect(function()
			if frame.Visible then
				for _, child in instances do
					child.Visible = frame == child
				end
			end
		end)
	end
	
	for _, child: typeof(sidebar:WaitForChild('Daily')) in sidebar:GetChildren() do
		if not child:IsA('ImageButton') then
			continue
		end

		local frame = gui:FindFirstChild(child.Name) :: ImageLabel

		child.MouseEnter:Connect(function()
			if tweens[child] then
				tweens[child]:Destroy()
			end

			if tweens[child.Icon] then
				tweens[child.Icon]:Destroy()
			end

			tweens[child] = TWS:Create(child, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Size = UDim2.fromScale(.85,.85)
			})

			tweens[child.Icon] = TWS:Create(child.Icon, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), {
				Rotation = 15,
				Size = UDim2.fromScale(.8,.8)
			})

			tweens[child]:Play()
			tweens[child.Icon]:Play()
		end)

		child.MouseLeave:Connect(function()
			if tweens[child] then
				tweens[child]:Destroy()
			end

			if tweens[child.Icon] then
				tweens[child.Icon]:Destroy()
			end

			tweens[child] = TWS:Create(child, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Size = UDim2.fromScale(.7,.7)
			})

			tweens[child.Icon] = TWS:Create(child.Icon, TweenInfo.new(0.15, Enum.EasingStyle.Back, Enum.EasingDirection.InOut), {
				Rotation = 0,
				Size = UDim2.fromScale(.6,.6)
			})

			tweens[child]:Play()
			tweens[child.Icon]:Play()
		end)

		child.MouseButton1Click:Connect(function()
			frame.Visible = not frame.Visible
		end)
	end
end

return Sidebar
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1168"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Daily</string><string name="ScriptGuid">{ee42671b-bc93-4a6c-b347-9dc91393a00f}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Daily = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local MPS = game:GetService('MarketplaceService')
local WKS = game:GetService('Workspace')

local DAY_CONFIGS = require(RPS.Modules.Services.DailyService.DailyConfigs)
local DAT_Client = require(RPS.Modules.Packages.DataService).client
local IMG_CONFIGS = require(RPS.Modules.Services.ImageService.ImageConfigs)

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui
local hud = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local sidebar = hud:WaitForChild('Sidebar')
local daily = hud:WaitForChild('Daily')
local dailySidebar = daily:WaitForChild('Sidebar')
local dailyB = sidebar:WaitForChild('Daily')
local scroller = daily:WaitForChild('Scroller')
local closeB = daily:WaitForChild('Close')
local claimB = daily:WaitForChild('Claim')
local nextDaily = daily:WaitForChild('NextDaily')

local tweens: {[Instance]: Tween} = {}

local dayTemplate = script.DayTemplate
local lastReward = 0

-- initialize scroller buttons
local function initButtons()
	local dailyData = DAT_Client:get('Daily')
	
	local lastClaimed = dailyData.LastClaimed :: number
	local dayReached = dailyData.DayReached :: number
	local fishCleaned = dailyData.FishCleaned :: boolean
	
	local currentMonth = math.floor(dayReached / 30) % 5 + 1
	local currentDay = dayReached % 30 + 1
	
	for day, rewards in DAY_CONFIGS[currentMonth] do
		local button = dayTemplate:Clone()
		button.Name = 'Day'..day
		
		local colors = {
			Hover = button:GetAttribute('Hover'),
			Natural = button:GetAttribute('Neutral')
		}
		
		button.MouseEnter:Connect(function()
			if tweens[button] then
				tweens[button]:Destroy()
			end

			tweens[button] = TWS:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = colors.Hover
			})
			tweens[button]:Play()
		end)
		button.MouseLeave:Connect(function()
			if tweens[button] then
				tweens[button]:Destroy()
			end

			tweens[button] = TWS:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = colors.Natural
			})
			tweens[button]:Play()
		end)
		
		button.Title.Text = 'DAY '..day
		
		if day <= dayReached then
			button.Check.Visible = true
		end
		
		local rewardsNo = 0
		
		local shells = rewards.Shells
		local mutationCurrency = rewards.MutationCurrency
		local item = rewards.Item
		
		rewardsNo += shells and 1 or 0
		rewardsNo += mutationCurrency and 1 or 0
		rewardsNo += item and 1 or 0
		
		local withItem = item and 'WithItem' or 'Default'
		
		local frame = button:FindFirstChild('Rewards'..rewardsNo) :: typeof(button.Rewards3)
		frame.Visible = true;
		
		local innerFrame = frame:FindFirstChild(withItem) :: typeof(frame.WithItem)
		innerFrame.Visible = true

		if rewardsNo == 1 then
			if item then
				innerFrame.Item.Image = IMG_CONFIGS[item] 
			elseif mutationCurrency then
				innerFrame.Reward1.Icon.Image = IMG_CONFIGS[mutationCurrency.Currency]
				innerFrame.Reward1.Amount.Text = tostring(mutationCurrency.Amount)
			elseif shells then
				innerFrame.Reward1.Icon.Image = IMG_CONFIGS.Shells
				innerFrame.Reward1.Amount.Text = tostring(shells)
			end
		elseif rewardsNo == 2 then
			if item then
				innerFrame.Item.Image = IMG_CONFIGS[item]
				
				if mutationCurrency then
					innerFrame.Reward1.Icon.Image = IMG_CONFIGS[mutationCurrency.Currency]
					innerFrame.Reward1.Amount.Text = tostring(mutationCurrency.Amount)
				elseif shells then
					innerFrame.Reward1.Icon.Image = IMG_CONFIGS.Shells
					innerFrame.Reward1.Amount.Text = tostring(shells)
				end
			else
				if shells then
					innerFrame.Reward1.Icon.Image = IMG_CONFIGS.Shells
					innerFrame.Reward1.Amount.Text = tostring(shells)
				end
				
				if mutationCurrency then
					innerFrame.Reward2.Icon.Image = IMG_CONFIGS[mutationCurrency.Currency]
					innerFrame.Reward2.Amount.Text = tostring(mutationCurrency.Amount)
				end
			end
		elseif rewardsNo == 3 then
			if item then
				innerFrame.Item.Image = IMG_CONFIGS[item]
			end
			
			if shells then
				innerFrame.Reward1.Icon.Image = IMG_CONFIGS.Shells
				innerFrame.Reward1.Amount.Text = tostring(shells)
			end
			
			if mutationCurrency then
				innerFrame.Reward2.Icon.Image = IMG_CONFIGS[mutationCurrency.Currency]
				innerFrame.Reward2.Amount.Text = tostring(mutationCurrency.Amount)
			end
		end
		
		button.Featured.Visible = day == currentDay
		button.Parent = scroller
	end
end

-- play new daily reward
local function newReward()
	if dailyB:GetAttribute('Notification') then
		return
	end
	
	dailyB:SetAttribute('Notification', true)
	
	local frame = dailyB.NewReward.Frame
	local oldTween = tweens[frame]
	
	if oldTween then
		oldTween:Destroy()
	end
	
	dailyB.NewReward.Visible = true
	
	frame.Position = UDim2.fromScale(1,0)
	
	tweens[frame] = TWS:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
		Position = UDim2.fromScale(1,1)
	})
	tweens[frame]:Play()
	
	daily.NewDaily:Play()
	lastReward = tick()
	
	task.spawn(function()
		task.wait(1.5)
		
		if tick() - lastReward >= 1.45 then
			tweens[frame] = TWS:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Position = UDim2.fromScale(0,1)
			})
			tweens[frame]:Play()

			tweens[frame].Completed:Wait()
			if frame.Position == UDim2.fromScale(0,1) then
				dailyB.NewReward.Visible = false
			end
		end
	end)
end

-- update timer
local function updateDaily()
	local dailyData = DAT_Client:get('Daily')
	local dayReached = dailyData.DayReached
	local currentMonth = math.floor(dayReached / 30) % 5 + 1
	
	local lastClaimed = dailyData.LastClaimed
	
	local timer = DateTime.now().UnixTimestamp - lastClaimed
	local timeLeft = math.max(3600 * 24 - timer, 0)
	
	local hours = math.floor(timeLeft / 3600)
	local minutes = math.floor((timeLeft - hours * 3600) / 60)
	
	daily.Sidebar.Chapter.Title.Text = `CHAPTER {currentMonth}/5`
	
	nextDaily.Amount.Text = `{(hours < 10 and '0'..hours or hours)}h {(minutes < 10 and '0'..minutes or minutes)}m`
	
	if timeLeft == 0 then
		nextDaily.TextLabel.Visible = false
		nextDaily.Amount.Visible = false
		
		if dailyData.FishCleaned then
			nextDaily.Clean.Visible = false
			nextDaily.Claim.Visible = true

			claimB.Interactable = true
			claimB.BackgroundColor3 = Color3.fromRGB(92, 209, 62)
			claimB.UIStroke.Color = Color3.fromRGB(17, 255, 0)

			newReward()
		else
			nextDaily.Clean.Visible = true
			nextDaily.Claim.Visible = false

			claimB.Interactable = false
			claimB.BackgroundColor3 = Color3.new(.7, .7, .7)
			claimB.UIStroke.Color = Color3.new(1,1,1)
		end
	else
		nextDaily.Clean.Visible = false
		nextDaily.Claim.Visible = false
		
		nextDaily.TextLabel.Visible = true
		nextDaily.Amount.Visible = true

		claimB.Interactable = false
		claimB.BackgroundColor3 = Color3.new(.7, .7, .7)
		claimB.UIStroke.Color = Color3.new(1,1,1)
	end
end

-- rotate button on hover
local function addButtonEffect(Button: TextButton)
	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 5,
			Size = UDim2.fromScale(1,.11),
			BackgroundColor3 = Color3.fromRGB(120, 255, 76)
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = UDim2.fromScale(1,.1),
			BackgroundColor3 = Color3.fromRGB(39, 234, 0)
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- initialize daily interface
function Daily:Init()
	initButtons()
	
	DAT_Client:getChangedSignal('Daily'):Connect(function(New)
		local dayReached = New.DayReached
		local oldDay = dayReached % 30
		local currentDay = oldDay + 1

		local oldButton = scroller:FindFirstChild('Day'..oldDay) :: typeof(dayTemplate)?
		local button = scroller:FindFirstChild('Day'..currentDay) :: typeof(dayTemplate)
		
		button.Featured.Visible = true
		
		if oldButton then
			oldButton.Check.Visible = true
			oldButton.Featured.Visible = false
		end
		
		dailyB:SetAttribute('Notification', nil)
	end)
	
	closeB.MouseEnter:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end
		
		local tween = TWS:Create(closeB, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 15,
			Size = UDim2.fromScale(.175,.175)
		})
		tweens[closeB] = tween
		tween:Play()
	end)
	closeB.MouseLeave:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end

		local tween = TWS:Create(closeB, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = UDim2.fromScale(.15,.15)
		})
		tweens[closeB] = tween
		tween:Play()
	end)
	
	closeB.MouseButton1Click:Connect(function()
		daily.Visible = false
	end)
	
	claimB.MouseButton1Click:Connect(function()
		RPS.Remotes.DailyService.ClaimDaily:FireServer()
	end)
	
	addButtonEffect(claimB)
	
	task.spawn(function()
		while true do
			task.wait(0.3)
			updateDaily()
		end
	end)
end

