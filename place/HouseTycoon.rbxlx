local CleanBar = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')

local plr = PLS.LocalPlayer :: Player
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local cleanBar = gui:WaitForChild('CleanBar')
local fill = cleanBar:WaitForChild('Fill')
local title = cleanBar:WaitForChild('Title')
local description = cleanBar:WaitForChild('Description')

local tween: Tween
local toggle = false
local lastToggleOn = 0

-- toggle clean bar
local function toggleBar(Toggle: boolean?)
	local last = toggle
	
	if Toggle == nil then
		toggle = not toggle
	else
		toggle = Toggle
	end
	
	if toggle then
		lastToggleOn = os.clock()
	end
	
	if last == toggle then
		return
	end
	
	local size = toggle and UDim2.fromScale(.2, .1) or UDim2.new()
	
	if tween then
		tween:Destroy()
	end
	
	tween = TWS:Create(cleanBar, TweenInfo.new(.3, Enum.EasingStyle.Back), {
		Size = size
	})
	tween:Play()
end

-- initialize clean bar ui
function CleanBar:Init()
	RPS.Remotes.CleanService.UpdateCleanBar.OnClientEvent:Connect(function(Obstacle: string, Percent: number)
		toggleBar(true)
		
		fill.Size = UDim2.fromScale(Percent, 1)
		description.Text = Obstacle == 'Dirt' and 'HOLD OVER DIRT!' or Obstacle == 'Barnacle' and 'CLICK TO REMOVE!' or 'TAP THE LIMBS!'
		title.Text = Obstacle:upper()
		
		if Percent >= 1 then
			toggleBar(false)
		end
	end)
	
	task.spawn(function()
		while true do
			task.wait(1)
			if os.clock() - lastToggleOn > 5 then
				toggleBar(false)
			end
		end
	end)
end

return CleanBar
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1253"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">TPHome</string><string name="ScriptGuid">{2c54fe4a-c166-47e3-8211-3843026b6831}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local TPHome = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local WKS = game:GetService('Workspace')

local DAT_Client = require(RPS.Modules.Packages.DataService).client

local plr = PLS.LocalPlayer :: Player
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local tPHome = gui:WaitForChild('TPHome')
local tPLeaderboards = gui:WaitForChild('TPLeaderboards')

local tweens: {[Instance]: Tween} = {}

-- rotate button on hover
local function addButtonEffect(Button: ImageButton)
	local colors = {
		Hover = Button:GetAttribute('Hover'),
		Neutral = Button:GetAttribute('Neutral')
	}

	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1),
			BackgroundColor3 = colors.Hover
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = size,
			BackgroundColor3 = colors.Neutral
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- initialize home teleport ui
function TPHome:Init()
	local onboardingTutorial = DAT_Client:get('OnboardingTutorial')
	if onboardingTutorial.Finished then
		tPHome.Visible = true
		tPLeaderboards.Visible = true
	end
	
	DAT_Client:getChangedSignal('OnboardingTutorial'):Connect(function(NewData)
		if NewData.Finished then
			tPHome.Visible = true
			tPLeaderboards.Visible = true
		end
	end)

	addButtonEffect(tPHome)
	tPHome.MouseButton1Click:Connect(function()
		local char = plr.Character
		local spawnCF = RPS.Remotes.StationService.GetPlotSpawnCFrame:InvokeServer(plr) :: CFrame?
		if char and spawnCF then
			char:PivotTo(spawnCF)
		end
	end)

	addButtonEffect(tPLeaderboards)
	tPLeaderboards.MouseButton1Click:Connect(function()
		local char = plr.Character
		local leaderboardCF = RPS.Remotes.StationService.GetLeaderboardsCFrame:InvokeServer(plr) :: CFrame?
		if char and leaderboardCF then
			char:PivotTo(leaderboardCF)
		end
	end)
end

return TPHome
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1254"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Label</string><string name="ScriptGuid">{9f96d7f2-69c2-4a2e-aa28-2d67d6cf16e5}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Label = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local WKS = game:GetService('Workspace')
local RNS = game:GetService('RunService')
local GUI = game:GetService('GuiService')

local plr = PLS.LocalPlayer :: Player
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local label = gui:WaitForChild('Label')

local tweens: {[Instance]: Tween} = {}

local toggle = false
local tween: Tween

-- toggle label
local function toggleLabel(Toggle: boolean?)
	local last = toggle

	if Toggle == nil then
		toggle = not toggle
	else
		toggle = Toggle
	end

	if last == toggle then
		return
	end

	local size = toggle and UDim2.fromScale(.2, .05) or UDim2.new()

	if tween then
		tween:Destroy()
	end

	tween = TWS:Create(label, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
		Size = size
	})
	tween:Play()
end

-- update label text
local function updateLabel(Text: string)
	label.TextLabel.Text = Text
end

-- update label position
local function updateLabelPos(X: number, Y: number)
	local inset = GUI:GetGuiInset()
	label.Position = UDim2.fromOffset(X + inset.X, Y + inset.Y)
end

-- initialize label ui
function Label:Init()
	RNS.RenderStepped:Connect(function()
		local mouse = plr:GetMouse()
		updateLabelPos(mouse.X, mouse.Y)
	end)
	
	local function addConn(GuiObject: GuiObject, Text: string)
		GuiObject.MouseEnter:Connect(function()
			updateLabel(Text)
			toggleLabel(true)
		end)

		GuiObject.MouseLeave:Connect(function()
			toggleLabel(false)
		end)
	end
	
	for _, child in gui.Sidebar:GetChildren() do
		if not child:IsA('GuiButton') then
			continue
		end
		
		addConn(child, child.Name:upper())
	end

	--addConn(gui.Daily.Close, 'CLOSE')
	--addConn(gui.Home.Close, 'CLOSE')
	--addConn(gui.Store.Close, 'CLOSE')
	--addConn(gui.Fishclopedia.Close, 'CLOSE')
	
	--addConn(gui.Objective.Close, 'TOGGLE')
	--addConn(gui.ToggleCurrency, 'TOGGLE')
	
	--addConn(gui.TPHome, 'TELEPORT')
	--addConn(gui.TPLeaderboards, 'TELEPORT')
end

return Label
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1255"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Gizmo</string><string name="ScriptGuid">{544b6292-a400-4838-a41f-27fc35a6e0a5}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Gizmo = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local WKS = game:GetService('Workspace')
local PPS = game:GetService('ProximityPromptService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local RWD_UTILS = require(RPS.Modules.Services.RewardService.RewardUtils)
local TOL_CONFIGS = require(RPS.Modules.Services.ToolService.ToolConfigs)
local INT_UTILS = require(RPS.Modules.Services.InterfaceService.InterfaceUtils)

local plr = PLS.LocalPlayer :: Player
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local gizmo = gui:WaitForChild('Gizmo')
local gill = gizmo:WaitForChild('Gill')
local store = gizmo:WaitForChild('Store')
local bubble = gizmo:WaitForChild('Bubble')
local scroller = store:WaitForChild('Scroller')
local itemTemplate = scroller:WaitForChild('Item')

local initPos = {
	Gill = gill.Position,
	Store = store.Position,
	Bubble = bubble.Position
}

local hiddenPos = {
	Gill = UDim2.fromScale(-.2, .6),
	Store = UDim2.fromScale(1.2, .85),
	Bubble = UDim2.fromScale(.2, -.1)
}

local tweens: {[Instance]: Tween} = {}

local toggle = false
local newStock = false
local lastSound: Sound?

-- rotate button on hover
local function addButtonEffect(Button: GuiButton, Hover: {[string]: any}?, Leave: {[string]: any}?)
	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), Hover or {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1)
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), Leave or {
			Rotation = 0,
			Size = size
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- restock gizmo's store stock
local function restock(StockData: any?)
	local stockData = DAT_Client:get('GizmoStock')
	local newStock = StockData or stockData.Stock
	
	local zappedFish = DAT_Client:get('ZappedFish')

	for itemName, config in TOL_CONFIGS.Gizmo do
		local data = newStock[itemName]
		local found = scroller:FindFirstChild(itemName) :: typeof(itemTemplate)?
		local item = found or itemTemplate:Clone()
		local left = data and data.AmountLeft > 0 and data.AmountLeft
		
		item.Name = itemName
		item.Icon.Image = config.Image
		item.Left.Amount.Text = left and data.AmountLeft..' LEFT' or 'NO STOCK'
		item.Left.ImageColor3 = left and Color3.new(1,1,1) or Color3.new(.3,.3,.3)
		item.Buy.Cost.Text = RWD_UTILS.ToString(config.Cost)
		item.Description.Text = config.Description
		item.Title.Text = itemName
		item.ImageColor3 = left and Color3.new(1,1,1) or Color3.new(.6,.6,.6)
		item.InfoFrame.Description.Text = config.Info
		item.LayoutOrder = config.Cost
		item.ZIndex = config.Cost

		if zappedFish == 0 then
			if itemName:match('Battery') then
				item.Title.Text = '???'
				item.Description.Text = '???'
				item.InfoFrame.Description.Text = '???'
			end
		end

		item.Visible = true
		item.Parent = scroller

		if not found then
			item.Buy.MouseButton1Click:Connect(function()
				RPS.Remotes.ToolService.BuyGadget:FireServer(itemName)
			end)

			addButtonEffect(item.Buy, {BackgroundTransparency = 0.7}, {BackgroundTransparency = 1})

			item.Info.MouseButton1Click:Connect(function()
				item.InfoFrame.Visible = true
			end)

			item.Info.MouseLeave:Connect(function()
				item.InfoFrame.Visible = false
			end)
		end
	end
end

-- toggle store
local function toggleStore(Toggle: boolean)
	local old = toggle
	
	if not gizmo.Visible then
		old = false
	end
	
	if Toggle == nil then
		toggle = not toggle
	else
		toggle = Toggle
	end
	
	if toggle == old then
		return
	end

	if tweens[gill] then
		tweens[gill]:Destroy()
	end

	if tweens[bubble] then
		tweens[bubble]:Destroy()
	end

	if tweens[store] then
		tweens[store]:Destroy()
	end
	
	if toggle and not gizmo.Visible then
		gill.Position = hiddenPos.Gill
		bubble.Position = hiddenPos.Bubble
		store.Position = initPos.Store
		
		gizmo.Visible = true
	end
	
	if toggle then
		if lastSound then
			lastSound:Stop()
		end
		
		local sound = script.NewStock
		
		if not newStock then
			local greetings = script.Greetings:GetChildren() :: {Sound}
			sound = greetings[math.random(1, #greetings)]
		end
		
		sound:Play()
		lastSound = sound
	end

	local finalGillPos = toggle and initPos.Gill or hiddenPos.Gill
	local finalBubblePos = toggle and initPos.Bubble or hiddenPos.Bubble
	local finalStorePos = toggle and initPos.Store or hiddenPos.Store

	INT_UTILS.TweenGuiObject(gill, TweenInfo.new(.25, Enum.EasingStyle.Cubic), {Position = finalGillPos})
	INT_UTILS.TweenGuiObject(bubble, TweenInfo.new(.25, Enum.EasingStyle.Cubic), {Position = finalBubblePos})
	INT_UTILS.TweenGuiObject(store, TweenInfo.new(.25, Enum.EasingStyle.Cubic), {Position = finalStorePos})
end

-- initialize gizmo ui
function Gizmo:Init()
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		if Prompt:HasTag('GizmoPrompt') and Player == plr then
			toggleStore(true)

			Prompt.PromptHidden:Once(function()
				if lastSound then
					lastSound:Stop()
				end
				toggleStore(false)
			end)
		end
	end)
	
	restock()
	RPS.Remotes.ToolService.UpdateGizmoStock.OnClientEvent:Connect(restock)
	DAT_Client:getChangedSignal('GizmoStock'):Connect(function()
		restock()
	end)

	RPS.Remotes.ToolService.UpdateGizmoTimer.OnClientEvent:Connect(function(Timer: number)
		store.Timer.Text = RWD_UTILS.ToTimer2(math.max(Timer, 0))
	end)
	
	addButtonEffect(store.Close)
	
	store.Close.Activated:Connect(function()
		toggleStore(false)
	end)
end

return Gizmo
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="Folder" referent="RBX1257"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">Greetings</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Sound" referent="RBX1258"><Properties><bool name="AcousticSimulationEnabled">true</bool><BinaryString name="AttributesSerialize"></BinaryString><Content name="SoundId"><url>rbxassetid://112597314653151</url></Content><bool name="DefinesCapabilities">false</bool><NumberRange name="LoopRegion">0 60000 </NumberRange><bool name="Looped">false</bool><string name="Name">Greeting1</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0 60000 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1</float><bool name="Playing">false</bool><float name="RollOffMaxDistance">10000</float><float name="RollOffMinDistance">10</float><token name="RollOffMode">3</token><string name="SerializedOverrides"></string><Ref name="SoundGroup">null</Ref><int64 name="SourceAssetId">-1</int64><double name="TimePosition">0</double><float name="Volume">2</float></Properties></Item><Item class="Sound" referent="RBX1259"><Properties><bool name="AcousticSimulationEnabled">true</bool><BinaryString name="AttributesSerialize"></BinaryString><Content name="SoundId"><url>rbxassetid://81224692432097</url></Content><bool name="DefinesCapabilities">false</bool><NumberRange name="LoopRegion">0 60000 </NumberRange><bool name="Looped">false</bool><string name="Name">Greeting2</string><bool name="PlayOnRemove">false</bool><NumberRange name="PlaybackRegion">0 60000 </NumberRange><bool name="PlaybackRegionsEnabled">false</bool><float name="PlaybackSpeed">1</float><bool name="Playing">false</bool><float name="RollOffMaxDistance">1000