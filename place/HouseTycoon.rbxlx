]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW21"><Properties><string name="Name">Packages</string></Properties><Item class="ModuleScript" referent="NEW19"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[local server = require(script.DataServiceServer)
