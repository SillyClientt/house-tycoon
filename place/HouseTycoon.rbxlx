local PropServiceClient = {}

local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService("Workspace")
local CLS = game:GetService('CollectionService')
local PLS = game:GetService('Players')
local SDS = game:GetService('SoundService')

local PRP_UTILS = require(RPS.Modules.Utils.PropUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)
local EFX_UTILS = require(RPS.Modules.Utils.EffectsUtils)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)

local plr = PLS.LocalPlayer :: Player

local open: {[Model]: boolean} = {}
local lastTouch: {[Model]: number} = {}

local lastRequest = 0

-- initialize cutscene service client-side
function PropServiceClient:Init()
	for _, sensor in CLS:GetTagged('GateSensor') :: {BasePart} do
		sensor.Touched:Connect(function(Touch)
			PropServiceClient:LogTouch(sensor, Touch)
		end)
	end
	
	CLS:GetInstanceAddedSignal('GateSensor'):Connect(function(Sensor: BasePart)
		Sensor.Touched:Connect(function(Touch)
			PropServiceClient:LogTouch(Sensor, Touch)
		end)
	end)
	
	for _, sensor in CLS:GetTagged('TreasurySensor') :: {BasePart} do
		PropServiceClient:SetupTreasurySensor(sensor)
	end
	
	CLS:GetInstanceAddedSignal('TreasurySensor'):Connect(function(Sensor: BasePart)
		PropServiceClient:SetupTreasurySensor(Sensor)
	end)
end

-- log touch for gate
function PropServiceClient:LogTouch(Sensor: BasePart, Touch: BasePart)
	local gate = Sensor.Parent :: Model
	local model = Touch:FindFirstAncestorOfClass('Model')
	if not model then
		return
	end

	local human = model:FindFirstChildOfClass('Humanoid')
	if not human then
		return
	end

	lastTouch[gate] = os.clock()

	task.delay(5, function()
		if os.clock() - lastTouch[gate] < 5 then
			return
		end

		open[gate] = nil
		PRP_UTILS.CloseDoor(gate, TweenInfo.new(Sensor:GetAttribute('TweenTime'), Enum.EasingStyle.Cubic))
	end)

	if open[gate] then
		return
	end

	local sound = Sensor:FindFirstChildOfClass('Sound')
	if sound then
		sound:Play()
	end
	
	open[gate] = true
	PRP_UTILS.OpenDoor(gate, TweenInfo.new(Sensor:GetAttribute('TweenTime'), Enum.EasingStyle.Cubic))
end

-- setup treasury sensor
function PropServiceClient:SetupTreasurySensor(Sensor: BasePart)
	local plot = Sensor:FindFirstAncestor('Plot')
	if not plot or plot:GetAttribute('Player') ~= plr.Name then
		return
	end

	local chest = Sensor.Parent :: Model
	local bottom = chest:FindFirstChild('Bottom') :: Model
	local pivot = bottom:FindFirstChild('Pivot') :: BasePart
	local label = Sensor:FindFirstChildWhichIsA('TextLabel', true) :: TextLabel

	Sensor.Touched:Connect(function()
		if os.clock() - lastRequest < 3 then
			return
		end
		
		lastRequest = os.clock()
		
		RPS.Remotes.PlotService.CollectTreasury:FireServer()
		
		local amount = STR_UTILS.GetUncondensedAmount(label.Text)

		PRP_UTILS.OpenTreasureChest(Sensor.Parent :: Model, amount)
		INT_UTILS.GoldBillboardGuiPopup(pivot, label.Text)
		EFX_UTILS.PlaySound(SDS.UI.Treasury, pivot.Position)
	end)
end

return PropServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1295"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">MusicService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1296"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">MusicServiceClient</string><string name="ScriptGuid">{a966ec75-c227-49e1-ad41-b6b0f3d4c521}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local MusicServiceClient = {}

local RPS = game:GetService('ReplicatedStorage')
local CLS = game:GetService('CollectionService')
local SDS = game:GetService('SoundService')
local PLS = game:GetService('Players')

local plr = PLS.LocalPlayer :: Player

local AUD_UTILS = require(RPS.Modules.Utils.AudioUtils)

local playing: BasePart
local lastTouch: {[Model]: number} = {}

-- initialize cutscene service client-side
function MusicServiceClient:Init()
	for _, sensor in CLS:GetTagged('MusicSensor') :: {BasePart} do
		sensor.Touched:Connect(function(Touch)
			MusicServiceClient:LogTouch(sensor, Touch)
		end)
	end
	
	CLS:GetInstanceAddedSignal('MusicSensor'):Connect(function(Sensor: BasePart)
		Sensor.Touched:Connect(function(Touch)
			MusicServiceClient:LogTouch(Sensor, Touch)
		end)
	end)
end

-- log touch for gate
function MusicServiceClient:LogTouch(Sensor: BasePart, Touch: BasePart)
	local gate = Sensor.Parent :: Model
	local model = Touch:FindFirstAncestorOfClass('Model')
	if not model then
		return
	end

	local human = model:FindFirstChildOfClass('Humanoid')
	if not human then
		return
	end
	
	if plr.Character ~= model then
		return
	end
	
	if playing == Sensor then
		return
	end
	
	local playingMusic = AUD_UTILS.GetMusic()

	if playingMusic and playingMusic.Parent ~= SDS.Ambience then
		return
	end

	local musicName = Sensor:GetAttribute('Music')
	local music = SDS.Ambience:FindFirstChild(musicName) :: Sound?

	if playingMusic == music then
		return
	end
	
	if not music then
		return
	end
	
	playing = Sensor
	AUD_UTILS.PlayMusic(music)
end

return MusicServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1297"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">WorldService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1298"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">WorldServiceClient</string><string name="ScriptGuid">{1359ccc5-c70c-4e69-8d6c-7cc2c9ea8b17}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local WorldServiceClient = {}

local RPS = game:GetService('ReplicatedStorage')
local PLS = game:GetService('Players')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local ANM_UTILS = require(RPS.Modules.Utils.AnimationUtils)
local CHR_UTILS = require(RPS.Modules.Utils.CharacterUtils)

local snapshots: {
	[string]: {
		[string]: {
			Category: string,
			Color: string,
			Hair: string,
			Name: string,
			State: string
		}
	}
} = {}

local ambientNPCs: {[string]: Model} = {}
local playerNPCs: {[string]: Model} = {}

local MAX_NPCS = 20
local MAX_AMBIENT_NPCS = 30

-- initialize world service client-side
function WorldServiceClient:Init()
	RPS.Remotes.WorldService.Ready.OnClientEvent:Connect(function(Snapshots: any)
		snapshots = Snapshots
	end)
	
	RPS.Remotes.WorldService.Ready:FireServer()
	
	RPS.Remotes.WorldService.AddNPC.OnClientEvent:Connect(function(Data: {
			Id: string,
			Category: string,
			Color: string,
			Hair: string,
			Name: string,
			State: string,
			Player: string
		})
		
		WorldServiceClient:AddNPC(Data)
	end)
	
	RPS.Remotes.WorldService.UpdateState.OnClientEvent:Connect(function(Id: string, State: string, Player: string)
		WorldServiceClient:UpdateState(Id, State, Player)
	end)
end

-- rebuild snapshot
function WorldServiceClient:RebuildSnapshots()
	for i = 1, MAX_NPCS do
		
	end
end

-- update state
function WorldServiceClient:UpdateState(Id: string, State: string, Player: string)
	if not snapshots[Player] or not snapshots[Player][Id] then
		return
	end
	
end

-- add npc
function WorldServiceClient:AddNPC(Data: {
	Id: string,
	Category: string,
	Color: string,
	Hair: string,
	Name: string,
	State: string,
	Player: string
	})

	local data = {
		Category = Data.Category,
		Color = Data.Color,
		Hair = Data.Hair,
		Name = Data.Name,
		State = Data.State
	}

	snapshots[Data.Player] = snapshots[Data.Player] or {}
	snapshots[Data.Player][Data.Id] = data
end

-- add ambient npcs
function WorldServiceClient:AddAmbientNPCs()
	
end

return WorldServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1299"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">InvasionService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1300"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">InvasionServiceClient</string><string name="ScriptGuid">{b2da6f3d-7994-4386-91e2-9a15987c0976}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local InvasionServiceClient = {}
	
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService("Workspace")
local PLS = game:GetService('Players')
local RNS = game:GetService('RunService')
local CTP = game:GetService('ContentProvider')
local SDS = game:GetService('SoundService')
local RPF = game:GetService('ReplicatedFirst')
local PPS = game:GetService('ProximityPromptService')
local PLS = game:GetService('Players')
local TWS = game:GetService('TweenService')

local plr = PLS.LocalPlayer :: Player

local CAM_UTILS = require(RPS.Modules.Utils.CameraUtils)
local PRP_UTILS = require(RPS.Modules.Utils.PropUtils)
local LGT_UTILS = require(RPS.Modules.Utils.LightUtils)
local ANM_UTILS = require(RPS.Modules.Utils.AnimationUtils)
local AUD_UTILS = require(RPS.Modules.Utils.AudioUtils)
local CHR_UTILS = require(RPS.Modules.Utils.CharacterUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)
local EFX_UTILS = require(RPS.Modules.Utils.EffectsUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local INV_CONFIGS = require(RPS.Modules.Configs.InvasionConfigs)
local NPC_CSignals = require(RPS.Modules.Services.NPCService.NPCClientSignals)
local INV_CSignals =require(script.Parent.InvasionClientSignals)

local INV_CONTAINER = require(script.Parent.InvasionContainer)
local NPC_CONTAINER = require(RPS.Modules.Services.NPCService.NPCContainer)

-- update health bar
local function updateHealth(npc: DAT_TYPES.ActiveTrooperData)
	local bar = npc.HealthBar;

	(bar.Parent :: Frame).Visible = npc.Health > 0;
	((bar.Parent :: Frame).Parent :: BillboardGui).Enabled = npc.Health > 0
	bar.Size = UDim2.new(math.max(npc.Health / npc.MaxHealth, 0), 0, 1, 0)
end

-- play damage ui effect
local function damageIndicator(npc: DAT_TYPES.ActiveTrooperData, Damage: number)
	local head = npc.Model:FindFirstChild('Head') :: BasePart
	
	local gui = script.Damage:Clone()
	gui.Amount.Text = tostring(math.floor(Damage))
	gui.Parent = head
	
	local info = TweenInfo.new(1, Enum.EasingStyle.Cubic)
	local tween = TWS:Create(gui, info, {StudsOffset = Vector3.new(math.random(-150, 150)/100, math.random(750, 850)/100, 0)})
	
	tween:Play()
	tween.Completed:Once(function()
		info = TweenInfo.new(.3, Enum.EasingStyle.Sine)
		tween = INT_UTILS.TweenGuiObject(gui.Amount, info, {TextTransparency = 1})
		TWS:Create(gui.Amount.UIStroke, info, {Transparency = 1}):Play()
		
		tween.Completed:Wait()
		gui:Destroy()
	end)
end

-- update troopers movment
local function updateMovement(TroopersData: {[string | number]: {Pivot: CFrame, Data: DAT_TYPES.ActiveTrooperData}})
	for troopIndex, trooperData in TroopersData do
		local trooper = trooperData.Data
		
		if trooper.Health <= 0 then
			continue
		end

		if not trooper.Target then
			trooper.Humanoid:Move(Vector3.zero)
			continue
		end
		
		if trooper.Target then
			local config = INV_CONFIGS.Units[trooper.ConfigKey][trooper.Level]
			local diff = trooper.Target.RootPart.Position - trooper.RootPart.Position

			if diff.Magnitude > config.Range then
				trooper.Humanoid:Move(diff.Unit)
			else
				trooper.Humanoid:Move(Vector3.zero)
			end
		end
	end
end

-- initialize cutscene service client-side
function InvasionServiceClient:Init()
	local defenderAnims = RPS.Animations.Character.Stances:GetChildren() :: {Animation}
	local invaderAnims = RPS.Animations.Character.Taunts:GetChildren() :: {Animation}
	
	NPC_CSignals.TroopStationed:Connect(function(Player, NPC, Index)
		if INV_CONTAINER[Player].Battling then
			return
		end
		
		local invasion = INV_CONTAINER[Player]
		local configKey = NPC.Model:GetAttribute('Type') or NPC.Model.Name
		local pivot: CFrame
		
		if configKey == 'Guard' then
			local guardData = invasion.Guards[Index :: number]
			pivot = guardData.Pivot
		else
			local knightData = invasion.Knights[Index :: string]
			pivot = knightData.Pivot
		end
		
		local pos = NPC.RootPart.Position
		local trg = pivot.Position
		local diff = Vector3.new(trg.X, 0, trg.Z) - Vector3.new(pos.X, 0, pos.Z)
		
		NPC.Track = ANM_UTILS.PlayAnimation(NPC.Animator, NPC.MoveAnimation)

		while diff.Magnitude > 1 do
			if INV_CONTAINER[Player].Battling then
				return
			end
			
			NPC.Humanoid:Move(diff.Unit)
			pos = NPC.RootPart.Position
			diff = Vector3.new(trg.X, 0, trg.Z) - Vector3.new(pos.X, 0, pos.Z)
			task.wait(0.005)
		end

		NPC.Humanoid:Move(Vector3.zero)
		NPC.Model:PivotTo(pivot)
		NPC.Track = ANM_UTILS.PlayAnimation(NPC.Animator, defenderAnims[math.random(1, #defenderAnims)])
		
		local animationsF = RPS.Animations.Combat:FindFirstChild(configKey) :: Folder?
		local statsTable = NPC.Stats :: {Gui: BillboardGui, HealthBar: Frame}

		local config = INV_CONFIGS.Units[configKey][NPC.Level :: number]
	end)
	
	RPS.Remotes.InvasionService.Station.OnClientEvent:Connect(function(Player: Player, Invasion: {Defenders: {Tag: string, Data: {DAT_TYPES.TroopData}}, Invaders: {Tag: string, Data: {DAT_TYPES.TroopData}}}, ConfigKey: string)
		local npcsList = NPC_CONTAINER[Player]
		
		local musicF = SDS.Invasion:FindFirstChild(ConfigKey) :: Folder
		local sound = musicF:FindFirstChild('Horn') :: Sound
		AUD_UTILS.PlayMusic(sound)
		
		local plot: typeof(WKS.Plots.Plot)
		
		while not plot do
			for _, model in WKS.Plots:GetChildren() :: {typeof(WKS.Plots.Plot)} do
				if model:GetAttribute('Player') == Player.Name then
					plot = model
					break
				end
			end
		end
		
		local container = {
			Battling = false,
			Invasion = ConfigKey,
			Knights = {},
			Guards = {},
			Invaders = {}
		}
		
		for _, data in Invasion.Defenders.Data do
			local animationsF: Folder? = RPS.Animations.Combat:FindFirstChild(data.ConfigKey) :: Folder?
			
			if data.ConfigKey == 'Guard' then
				local npcData = npcsList.Guards[data.Index :: number]
				local statsTable = npcData.Stats :: {Gui: BillboardGui, HealthBar: Frame}

				local config = INV_CONFIGS.Units[data.ConfigKey][data.Level]
				npcData.Humanoid.WalkSpeed = config.WalkSpeed
				
				container.Guards[data.Index :: number] = {
					Pivot = data.RelCFrame :: CFrame,

					Data = {
						Index = data.Index,
						ConfigKey = data.ConfigKey,
						Level = data.Level,
						Model = npcData.Model,
						Track = npcData.Track,

						RootPart = npcData.RootPart,
						Humanoid = npcData.Humanoid,
						Animator = npcData.Animator,

						State = data.State,
						LastState = data.LastState,
						Health = data.Health,
						MaxHealth = data.Health,

						Stats = statsTable.Gui,
						HealthBar = statsTable.HealthBar,

						Animations = {
							Idle = animationsF and animationsF:FindFirstChild('Idle') ::Animation? or RPS.Animations.Character.Idle,
							Run = animationsF and animationsF:FindFirstChild('Run') ::Animation? or RPS.Animations.Character.Run,
							Attack = animationsF and animationsF:FindFirstChild('Attack') ::Animation? or RPS.Animations.Combat.Guard.Attack,
						}
					}
				}
			else
				local npcData = npcsList.Knights[data.Index :: string]
				local statsTable = npcData.Stats :: {Gui: BillboardGui, HealthBar: Frame}

				local config = INV_CONFIGS.Units[data.ConfigKey][data.Level]
				npcData.Humanoid.WalkSpeed = config.WalkSpeed
				
				container.Knights[data.Index :: string] = {
					Pivot = data.RelCFrame :: CFrame,

					Data = {
						Index = data.Index,
						ConfigKey = data.ConfigKey,
						Level = data.Level,
						Model = npcData.Model,
						Track = npcData.Track,

						RootPart = npcData.RootPart,
						Humanoid = npcData.Humanoid,
						Animator = npcData.Animator,

						State = data.State,
						LastState = data.LastState,
						Health = data.Health,
						MaxHealth = data.Health,

						Stats = statsTable.Gui,
						HealthBar = statsTable.HealthBar,

						Animations = {
							Idle = animationsF and animationsF:FindFirstChild('Idle') ::Animation? or RPS.Animations.Character.Idle,
							Run = animationsF and animationsF:FindFirstChild('Run') ::Animation? or RPS.Animations.Character.Run,
							Attack = animationsF and animationsF:FindFirstChild('Attack') ::Animation? or RPS.Animations.Combat.Guard.Attack,
						}
					}
				}
			end
		end
		
		for _, data in Invasion.Invaders.Data do
			container.Invaders[data.Index :: number] = {
				Pivot = data.RelCFrame :: CFrame,
				Data = InvasionServiceClient:CreateTrooperData(data, invaderAnims[math.random(1, #invaderAnims)], plot.NPCs.Invasion.Invaders)
			}
		end
		
		INV_CONTAINER[Player] = container
		
		sound.Ended:Wait()
		AUD_UTILS.PlayMusic(SDS.Invasion.Arms)

		--[[
		local ang = CFrame.Angles(math.rad(35), math.rad(180), 0)
		local xOffset = math.min(#defenderModels / 2, 6) * 5
		local startCF = spawnPivot * CFrame.new(xOffset, 15, -15) * ang
		local endCF = spawnPivot * CFrame.new(-xOffset, 15, -15) * ang

		local tween = CAM_UTILS.PlayCutscene(startCF, endCF, TweenInfo.new(6, Enum.EasingStyle.Linear), 35)
		tween.Completed:Wait()
		
		task.wait(1)
		
		spawnPivot = invaders.Spawn1.Value
		xOffset = math.min(#invaderModels / 2, 6) * 5
		startCF = spawnPivot * CFrame.new(xOffset, 15, -15) * ang
		endCF = spawnPivot * CFrame.new(-xOffset, 15, -15) * ang

		tween = CAM_UTILS.PlayCutscene(startCF, endCF, TweenInfo.new(6, Enum.EasingStyle.Linear), 35)
		tween.Completed:Wait()
		]]
	end)
	
	RPS.Remotes.InvasionService.Battle.OnClientEvent:Connect(function(Player: Player)
		local invasion = INV_CONTAINER[Player]
		
		if not invasion then
			return
		end
		
		invasion.Battling = true
		
		CAM_UTILS.ResetCamera(70)
		local musicF = SDS.Invasion:FindFirstChild(invasion.Invasion) :: Folder
		AUD_UTILS.PlayMusic(musicF:FindFirstChild('Music') :: Sound)
		
		for _, npc in NPC_CONTAINER[Player].Guards do
			npc.Position = NPC_CONTAINER[Player].SignificantPositions.GateEntrance
		end
		for _, npc in NPC_CONTAINER[Player].Knights do
			npc.Position = NPC_CONTAINER[Player].SignificantPositions.GateEntrance
		end
		
		for _, trooperData in invasion.Knights :: {[string]: {Pivot: CFrame, Data: DAT_TYPES.ActiveTrooperData}} do
			local data = trooperData.Data
			data.Humanoid.WalkSpeed = INV_CONFIGS.Units[data.ConfigKey][data.Level].WalkSpeed
			trooperData.Data.Model:PivotTo(trooperData.Pivot)
		end
		for _, trooperData in invasion.Guards :: {[number]: {Pivot: CFrame, Data: DAT_TYPES.ActiveTrooperData}} do
			local data = trooperData.Data
			data.Humanoid.WalkSpeed = INV_CONFIGS.Units[data.ConfigKey][data.Level].WalkSpeed
			trooperData.Data.Model:PivotTo(trooperData.Pivot)
		end

		while invasion.Battling do
			updateMovement(invasion.Knights)
			updateMovement(invasion.Guards)
			updateMovement(invasion.Invaders)
			task.wait(.1)
		end
	end)
	
	RPS.Remotes.InvasionService.Aftermath.OnClientEvent:Connect(function(Player: Player, Outcome: string)
		local invasion = INV_CONTAINER[Player]

		if not invasion then
			return
		end

		invasion.Battling = false

		local celebrations = {
			RPS.Animations.Character.Flex,
			RPS.Animations.Character.Celebrate,
			RPS.Animations.Character.Dance
		}

		local alive = {} :: {DAT_TYPES.ActiveTrooperData}
		local troopsData = {} :: {DAT_TYPES.ActiveTrooperData}
		
		for _, trooperData in invasion.Knights :: {[string]: {Data: DAT_TYPES.ActiveTrooperData}} do
			local data = trooperData.Data
			table.insert(troopsData, data)
		end

		for _, trooperData in invasion.Guards :: {[number]: {Data: DAT_TYPES.ActiveTrooperData}} do
			local data = trooperData.Data
			table.insert(troopsData, data)
		end
		
		if Outcome == 'Victory' then
			AUD_UTILS.PlayMusic(SDS.Invasion.Victory)
			
			local i = 1
			for _, trooperData in invasion.Knights :: {[string]: {Data: DAT_TYPES.ActiveTrooperData}} do
				local data = trooperData.Data

				if data.Health <= 0 then
					continue
				end
				
				data.Humanoid:Move(Vector3.zero)
				data.Track = ANM_UTILS.PlayAnimation(data.Animator, celebrations[i])
				i += 1

				if not celebrations[i] then
					i = 1
				end
				
				table.insert(alive, data)
			end

			for _, trooperData in invasion.Guards :: {[number]: {Data: DAT_TYPES.ActiveTrooperData}} do
				local data = trooperData.Data

				if data.Health <= 0 then
					continue
				end

				data.Humanoid:Move(Vector3.zero)
				data.Track = ANM_UTILS.PlayAnimation(data.Animator, celebrations[i])
				i += 1

				if not celebrations[i] then
					i = 1
				end

				table.insert(alive, data)
			end
		elseif Outcome == 'Defeat' then
			AUD_UTILS.PlayMusic(SDS.Invasion.Defeat)
			
			local i = 1
			for _, trooperData in invasion.Invaders :: {[number]: {Data: DAT_TYPES.ActiveTrooperData}} do
				local data = trooperData.Data
				table.insert(troopsData, data)

				if data.Health <= 0 then
					continue
				end

				data.Humanoid:Move(Vector3.zero)
				data.Track = ANM_UTILS.PlayAnimation(data.Animator, celebrations[i])
				i += 1

				if not celebrations[i] then
					i = 1
				end
				
				table.insert(alive, data)
			end
		end
		
		local start = os.clock()
		
		while true do
			if os.clock() - start > 20 then
				break
			end
			
			task.wait(math.random(80,160)/100)

			local trooper = alive[math.random(1, #alive)]
			local pos = trooper.RootPart.Position

			EFX_UTILS.PlaySoundAtRandom(SDS.Combat.Celebrate:FindFirstChild( trooper.Model:GetAttribute('Gender')) :: Folder, trooper.RootPart.Position)
		end
		
		for _, data in troopsData do
			(data.HealthBar.Parent :: Frame).Visible = false
			data.Stats.Enabled = true
		end
		
		AUD_UTILS.PlayMusic(SDS.Ambience.Ambient)
		INV_CSignals.Aftermath:Fire(Player, Outcome, troopsData)
		
		for _, trooperData in invasion.Invaders :: {[number]: {Data: DAT_TYPES.ActiveTrooperData}} do
			local data = trooperData.Data
			data.Model:Destroy()
		end
		
		INV_CONTAINER[Player] = nil
	end)
	
	RPS.Remotes.InvasionService.UpdateTarget.OnClientEvent:Connect(function(Player: Player, Index: string | number, TargetIndex: (string | number)?, Group: string, TargetGroup: string?)
		local invasion = INV_CONTAINER[Player]
		
		if not invasion then
			return
		end

		local group = invasion[Group] :: {[string | number]: {Data: DAT_TYPES.ActiveTrooperData}}
		local targetGroup = TargetGroup and invasion[TargetGroup] :: {[string | number]: {Data: DAT_TYPES.ActiveTrooperData}}

		if not group then
			warn('No group to update')
			return
		end
		
		local trooper = group[Index].Data
		local oldTarget = trooper.Target
		local newTarget = TargetIndex and targetGroup and targetGroup[TargetIndex].Data

		if oldTarget == newTarget then
			return
		end

		trooper.Target = newTarget
	end)
	
	RPS.Remotes.InvasionService.UpdateState.OnClientEvent:Connect(function(Player: Player, Index: number, NewState: string, Group: string)
		local invasion = INV_CONTAINER[Player]
		
		if not invasion then
			return
		end
		
		local group = invasion[Group] :: {[string | number]: {Data: DAT_TYPES.ActiveTrooperData}}
		
		if not group then
			warn('No group to update')
			return
		end
		
		local trooper = group[Index].Data
		local oldState = trooper.State
		
		if oldState == NewState then
			return
		end
		
		if NewState == 'Attacking' then
			local soundsF: Folder
			local target = trooper.Target :: DAT_TYPES.ActiveTrooperData
			
			if Group == 'Invaders' then
				soundsF = SDS.Combat.EnemyAttacks
			else
				soundsF = SDS.Combat.SwordHits
			end
			
			EFX_UTILS.HighlightInstance(target.Model, Color3.new(1,0,0), .4)
			EFX_UTILS.PlaySoundAtRandom(soundsF, target.RootPart.Position)
			ANM_UTILS.PlaySecondaryAnimation(trooper.Animator, trooper.Animations.Attack)
		elseif NewState == 'Idle' then
			trooper.Track = ANM_UTILS.PlayAnimation(trooper.Animator, trooper.Animations.Idle)
		elseif NewState == 'Moving' then
			trooper.Track = ANM_UTILS.PlayAnimation(trooper.Animator, trooper.Animations.Run)
		end
		
		trooper.State = NewState
	end)
	
	RPS.Remotes.InvasionService.UpdateHealth.OnClientEvent:Connect(function(Player: Player, Index: number, NewHealth: number, Group: string)
		local invasion = INV_CONTAINER[Player]

		if not invasion then
			return
		end

		local group = invasion[Group] :: {[string | number]: {Data: DAT_TYPES.ActiveTrooperData}}

		if not group then
			warn('No group to update')
			return
		end

		local trooper = group[Index].Data
		
		local oldHealth = trooper.Health
		trooper.Health = NewHealth
		
		local diff = oldHealth - NewHealth
		
		updateHealth(trooper)
		damageIndicator(trooper, math.floor(diff))

		if oldHealth <= 0 then
			return
		end
		
		local trgModel = trooper.Model

		if trooper.Health <= 0 then
			if Group == 'Invaders' then
				local reward = INV_CONFIGS.Units[trooper.ConfigKey][trooper.Level].Reward
				
				if reward and reward.Gold then
					INT_UTILS.GoldBillboardGuiPopup(trgModel, reward.Gold)
					EFX_UTILS.PlaySound(SDS.UI.Gold, trgModel:GetPivot().Position)
				end
			end
			
			EFX_UTILS.PlaySoundAtRandom(SDS.Combat.Deaths:FindFirstChild( trooper.Model:GetAttribute('Gender')) :: Folder, trooper.RootPart.Position)

			for _, track in trooper.Animator:GetPlayingAnimationTracks() do
				track:Stop()
			end

			for _, desc in trgModel:GetDescendants() do
				if desc:IsA('AnimationConstraint') then
					desc.Enabled = false
				end
			end

			for _, trooperData in invasion.Guards do
				local data = trooperData.Data :: DAT_TYPES.ActiveTrooperData

				if data.Target and data.Target.Model == trgModel then
					data.Target = nil
				end
			end
			
			for _, trooperData in invasion.Knights do
				local data = trooperData.Data :: DAT_TYPES.ActiveTrooperData
				
				if data.Target and data.Target.Model == trgModel then
					data.Target = nil
				end
			end
			
			for _, trooperData in invasion.Invaders do
				local data = trooperData.Data :: DAT_TYPES.ActiveTrooperData

				if data.Target and data.Target.Model == trgModel then
					data.Target = nil
				end
			end

			for _, child in trgModel:GetChildren() do
				if child:IsA('BasePart') then
					child.CanCollide = true
				end
			end
		end
	end)
end

-- create trooper data
function InvasionServiceClient:CreateTrooperData(Data: DAT_TYPES.TroopData,  StartingAnimation: Animation, Parent: Folder): DAT_TYPES.ActiveTrooperData
	local trooperConfig = INV_CONFIGS.Units[Data.ConfigKey][Data.Level]

	local model = trooperConfig.Model
	local troop: Model, animator: Animator
	local animationsF: Folder? = RPS.Animations.Combat:FindFirstChild(Data.ConfigKey) :: Folder?
	
	if typeof(model) == 'string' then
		troop, animator = CHR_UTILS.Create(model, nil, nil, trooperConfig.Scale)
	else
		troop = model:Clone()
		animator = troop:FindFirstChildWhichIsA('Animator', true) :: Animator
	end
	
	troop:PivotTo(Data.RelCFrame :: CFrame)
	troop.Parent = Parent

	local statsGui, bar = INT_UTILS.AddStats(troop, Data.Level, trooperConfig.Name)
	local human = animator.Parent :: Humanoid

	human.WalkSpeed = trooperConfig.WalkSpeed
	ANM_UTILS.PlayAnimation(animator, StartingAnimation)
	
	return {
		Index = Data.Index,
		ConfigKey = Data.ConfigKey,
		Level = Data.Level,
		Model = troop,
		
		RootPart = troop:FindFirstChild('HumanoidRootPart') :: BasePart,
		Humanoid = human,
		Animator = animator,
		
		State = Data.State,
		LastState = Data.LastState,
		Health = Data.Health,
		MaxHealth = Data.Health,
		
		Stats = statsGui,
		HealthBar = bar,
		
		Animations = {
			Idle = animationsF and animationsF:FindFirstChild('Idle') ::Animation? or RPS.Animations.Character.Idle,
			Run = animationsF and animationsF:FindFirstChild('Run') ::Animation? or RPS.Animations.Character.Run,
			Attack = animationsF and animationsF:FindFirstChild('Attack') ::Animation? or RPS.Animations.Combat.Guard.Attack,
		}
	}
end


return InvasionServiceClient
