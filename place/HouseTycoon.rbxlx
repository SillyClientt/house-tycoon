]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1401"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">BuildConfigs</string><string name="ScriptGuid">{74ef4fe5-ad31-43b3-8a2b-7969b611b058}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
