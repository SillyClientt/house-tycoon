local Signal = require(RPS.Modules.Packages.Signal)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local DecisionClientSignals = {
	TroopStationed = Signal() :: Signal.Signal<Player, DAT_TYPES.AmbientNPCData, number | string>
}

return DecisionClientSignals
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1310"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">NPCContainer</string><string name="ScriptGuid">{525dc372-77ef-466b-b851-5574b0807014}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')

local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local NPCContainer: {[Player]: {
	Plot: typeof(WKS.Plots.Plot),
	Positions: Folder,
	Graph: {[Vector3Value]: {Vector3Value}},
	KingdomState: 'Peace' | 'War',
	SignificantPositions: {
		GateEntrance: Vector3Value,
	},

	Knights: {[string]: DAT_TYPES.AmbientNPCData},
	Farm1: {DAT_TYPES.AmbientNPCData},
	Farm2: {DAT_TYPES.AmbientNPCData},
	Housing1: {DAT_TYPES.AmbientNPCData},
	Housing2: {DAT_TYPES.AmbientNPCData},
	Housing3: {DAT_TYPES.AmbientNPCData},
	Nobles: {DAT_TYPES.AmbientNPCData},
	Guards: {DAT_TYPES.AmbientNPCData}
}} = {}

return NPCContainer
