local RPS = game:GetService('ReplicatedStorage')

local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local InvasionContainer: {[Player]: {Battling: boolean, Invasion: string, Knights: {[string]: {Pivot: CFrame, Data: DAT_TYPES.ActiveTrooperData}}, Guards: {[number]: {Pivot: CFrame, Data: DAT_TYPES.ActiveTrooperData}}, Invaders: {[number]: {Pivot: CFrame, Data: DAT_TYPES.ActiveTrooperData}}}} = {}

return InvasionContainer
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1307"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">NPCService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1308"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">NPCServiceClient</string><string name="ScriptGuid">{a14e91ca-c6c3-4d4e-9247-2a7eafb74ff5}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local NPCServiceClient = {}
	
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService("Workspace")
local PLS = game:GetService('Players')
local RNS = game:GetService('RunService')
local CTP = game:GetService('ContentProvider')
local SDS = game:GetService('SoundService')

local plr = PLS.LocalPlayer :: Player

local CAM_UTILS = require(RPS.Modules.Utils.CameraUtils)
local PRP_UTILS = require(RPS.Modules.Utils.PropUtils)
local ANM_UTILS = require(RPS.Modules.Utils.AnimationUtils)
local AUD_UTILS = require(RPS.Modules.Utils.AudioUtils)
local CHR_UTILS = require(RPS.Modules.Utils.CharacterUtils)
local PTH_UTILS = require(RPS.Modules.Utils.PathfindingUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)
local EFX_UTILS = require(RPS.Modules.Utils.EffectsUtils)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildingConfigs)
local INV_CONFIGS = require(RPS.Modules.Configs.InvasionConfigs)
local NPC_CSignals = require(script.Parent.NPCClientSignals)
local INV_CSignals = require(RPS.Modules.Services.InvasionService.InvasionClientSignals)
local DAT_Client = require(RPS.Modules.Packages.DataService).client

local NPC_CONTAINER = require(script.Parent.NPCContainer)
local INV_CONTAINER = require(RPS.Modules.Services.InvasionService.InvasionContainer)

-- initialize npc service client-side
function NPCServiceClient:Init()
	NPCServiceClient:InstantiatePlayerData(plr)
	
	task.spawn(function()
		while true do
			for _, player in PLS:GetPlayers() do
				NPCServiceClient:UpdateAllPaths(player)
			end
			
			task.wait(.005)
		end
	end)
	
	PLS.PlayerAdded:Connect(function(Player)
		RPS.Remotes.NPCService.RequestData:FireServer(Player)
	end)
	
	RPS.Remotes.NPCService.RequestData.OnClientEvent:Connect(function(Player, Data: {Knights: {[string]: {Level: number}}, Guards: {[number]: {Level: number}}, Buildings: {[string]: {Level: number}}})
		NPCServiceClient:UpdateNPCs(Player, Data)
	end)

	RPS.Remotes.NPCService.UpdateData.OnClientEvent:Connect(function(Player, Data: {Knights: {[string]: {Level: number}}?, Guards: {[number]: {Level: number}}?, Buildings: {[string]: {Level: number}}?})
		if Data.Knights then
			NPCServiceClient:UpdateKnights(Player, Data.Knights)
		end
		
		if Data.Guards then
			NPCServiceClient:UpdateGuards(Player, Data.Guards)
		end
		
		if Data.Buildings then
			NPCServiceClient:UpdateAmbientNPCs(Player, Data.Buildings)
		end
	end)
	
	RPS.Remotes.InvasionService.Station.OnClientEvent:Connect(function(Player: Player, Invasion: {Defenders: {Tag: string, Data: {DAT_TYPES.TroopData}}, Invaders: {Tag: string, Data: {DAT_TYPES.TroopData}}}, ConfigKey: string)
		NPC_CONTAINER[Player].KingdomState = 'War'
		NPCServiceClient:UpdateAllPaths(Player)
	end)
	
	INV_CSignals.Aftermath:Connect(function(Player, Outcome, Troops)
		print(Outcome, Troops)

		for _, troop in Troops do
			for _, desc in troop.Model:GetDescendants() do
				if desc:IsA('AnimationConstraint') then
					desc.Enabled = true
				elseif desc:IsA('BasePart') and desc.Parent == troop.Model then
					desc.CanCollide = desc.Name == 'HumanoidRootPart' or desc.Name == 'LowerTorso' or desc.Name == 'UpperTorso'
				end
			end
		end

		NPC_CONTAINER[Player].KingdomState = 'Peace'
		
		if Outcome == 'Victory' then
			
		else
			
		end
	end)
	
	RPS.Remotes.NPCService.RequestData:FireServer(plr)
	
	RPS.Remotes.PlotService.DispenseHousingTax.OnClientEvent:Connect(function(Player: Player, HousingKey: string, Amount: number)
		local npcs = NPC_CONTAINER[Player][HousingKey]

		for _, npc in npcs :: {DAT_TYPES.AmbientNPCData} do
			EFX_UTILS.PlaySound(SDS.UI.Gold, npc.RootPart.Position)
			INT_UTILS.TaxBillboardGuiPopup(npc.Model, Amount)
		end
	end)
end

-- instantiate client data pertaining input player
function NPCServiceClient:InstantiatePlayerData(Player: Player)
	local plot: typeof(WKS.Plots.Plot)
	
	while not plot do
		task.wait()
		for _, plotModel in WKS.Plots:GetChildren() :: {typeof(plot)} do
			if plotModel:IsA('Model') and plotModel:GetAttribute('Player') == Player.Name then
				plot = plotModel
				break
			end
		end
	end

	local idles: {Animation} = {RPS.Animations.Character.Idle, RPS.Animations.Character.Wait}

	local positions = plot.Waypoints.Pathfinding.Positions
	local graph = PTH_UTILS.GenerateWaypointGraph(positions)
	
	NPC_CONTAINER[Player] = {
		Plot = plot,
		Graph = graph,
		Positions = positions,
		KingdomState = 'Peace',
		SignificantPositions = {
			GateEntrance = positions.X46.Spawn92
		},
		
		Knights = {},
		Guards = {},
		Farm1 = {},
		Farm2 = {},
		Housing1 = {},
		Housing2 = {},
		Housing3 = {},
		Nobles = {}
	}
end

-- update npcs
function NPCServiceClient:UpdateNPCs(Player: Player, Data: {Buildings: {[string]: {Level: number}}, Guards: {[number]: {Level: number}}, Knights: {[string]: {Level: number}}})
	NPCServiceClient:UpdateGuards(Player, Data.Guards)
	NPCServiceClient:UpdateKnights(Player, Data.Knights)
	NPCServiceClient:UpdateAmbientNPCs(Player, Data.Buildings)
end

-- update guards
function NPCServiceClient:UpdateGuards(Player: Player, Guards: {[number]: {Level: number}})
	local npcsList = NPC_CONTAINER[Player]
	local npcGuards = npcsList.Guards
	
	for i = 1, #Guards do
		local guard = Guards[i]
		local existing = npcGuards[i]
		
		if guard then
			if existing and existing.Level ~= guard.Level or not existing then
				local config = INV_CONFIGS.Units.Guard[guard.Level]
				local model = config.Model
				local scale = config.Scale
				
				local char = CHR_UTILS.Create(model, nil, nil, scale)
				local pos, posV: Vector3Value

				if existing then
					posV =  existing.Position
				else
					pos, posV = PTH_UTILS.GetRandomPos(npcsList.Positions)
				end
				
				local guard = NPCServiceClient:GenerateNPC(Player, char, posV, npcsList.Plot.NPCs.Persistent, 'Fighter', guard.Level)
				npcsList.Guards[i] = guard
			end
		elseif existing then
			npcsList.Guards[i].Model:Destroy()
			npcsList.Guards[i] = nil
		end
	end
end

-- update knights
function NPCServiceClient:UpdateKnights(Player: Player, Knights: {[string]: {Level: number}})
	local npcsList = NPC_CONTAINER[Player]
	local npcKnights = npcsList.Knights

	for knight, data in Knights do
		local existing = npcKnights[knight]

		if existing and existing.Level ~= data.Level or not existing then
			local model = INV_CONFIGS.Units.Guard[data.Level].Model
			local char = CHR_UTILS.Create(model)
			local pos, posV: Vector3Value

			if existing then
				posV =  existing.Position
			else
				pos, posV = PTH_UTILS.GetRandomPos(npcsList.Positions)
			end

			local knightNPC = NPCServiceClient:GenerateNPC(Player, char, posV, npcsList.Plot.NPCs.Persistent, 'Fighter', data.Level)
			npcsList.Knights[knight] = knightNPC
		end
	end
end

-- update ambient npcs
function NPCServiceClient:UpdateAmbientNPCs(Player: Player, Buildings: {[string]: {Level: number}})
	local npcsList = NPC_CONTAINER[Player]

	local housing1Config = BLD_CONFIGS.Buildings.Housing[Buildings['Housing1'].Level]
	local housing2Config = BLD_CONFIGS.Buildings.Housing[Buildings['Housing2'].Level]
	local housing3Config = BLD_CONFIGS.Buildings.Housing[Buildings['Housing3'].Level]

	local farm1Level = Buildings['Farm1'].Level
	local farm2Level = Buildings['Farm2'].Level

	local npcsList = NPC_CONTAINER[Player]
	local graph = npcsList.Graph
	local plot = npcsList.Plot
	local positions = npcsList.Positions

	local pops = {
		Farm1 = 0,
		Farm2 = 0,
		Housing1 = 0,
		Housing2 = 0,
		Housing3 = 0
	}
	
	if farm1Level > 0 then
		for i = #npcsList.Farm1 + 1, 2 do
			local char = CHR_UTILS.Create('Farmer')
			local randomPos, posV = PTH_UTILS.GetRandomPos(positions)
			local farmer = NPCServiceClient:GenerateNPC(Player, char, posV, plot.NPCs.Ambient, 'Farm1')
			table.insert(npcsList.Farm1, farmer)
		end
	end

	if farm2Level > 0 then
		for i = #npcsList.Farm1 + 1, 2 do
			local char = CHR_UTILS.Create('Farmer')
			local randomPos, posV = PTH_UTILS.GetRandomPos(positions)
			local farmer = NPCServiceClient:GenerateNPC(Player, char, posV, plot.NPCs.Ambient, 'Farm2')
			table.insert(npcsList.Farm1, farmer)
		end
	end

	for i = #npcsList.Housing1 + 1, housing1Config.Population do
		local char = CHR_UTILS.Create(housing1Config.Clothes :: CFG_TYPES.NPCCategory)
		local randomPos, posV = PTH_UTILS.GetRandomPos(positions)
		local peasant = NPCServiceClient:GenerateNPC(Player, char, posV, plot.NPCs.Ambient, 'Housing1')
		table.insert(npcsList.Housing1, peasant)
	end
	
	for i = #npcsList.Housing2 + 1, housing2Config.Population do
		local char = CHR_UTILS.Create(housing2Config.Clothes :: CFG_TYPES.NPCCategory)
		local randomPos, posV = PTH_UTILS.GetRandomPos(positions)
		local peasant = NPCServiceClient:GenerateNPC(Player, char, posV, plot.NPCs.Ambient, 'Housing2')
		table.insert(npcsList.Housing2, peasant)
	end
	
	for i = #npcsList.Housing3 + 1, housing3Config.Population do
		local char = CHR_UTILS.Create(housing3Config.Clothes :: CFG_TYPES.NPCCategory)
		local randomPos, posV = PTH_UTILS.GetRandomPos(positions)
		local peasant = NPCServiceClient:GenerateNPC(Player, char, posV, plot.NPCs.Ambient, 'Housing3')
		table.insert(npcsList.Housing3, peasant)
	end
	
	for _, npc in npcsList.Housing1 do
		if npc.Model:GetAttribute('Type') ~= housing1Config.Clothes then
			CHR_UTILS.ChangeNPCType(npc.Model, housing1Config.Clothes :: CFG_TYPES.NPCCategory)
		end
	end
	
	for _, npc in npcsList.Housing2 do
		if npc.Model:GetAttribute('Type') ~= housing2Config.Clothes then
			CHR_UTILS.ChangeNPCType(npc.Model, housing2Config.Clothes :: CFG_TYPES.NPCCategory)
		end
	end
	
	for _, npc in npcsList.Housing3 do
		if npc.Model:GetAttribute('Type') ~= housing3Config.Clothes then
			CHR_UTILS.ChangeNPCType(npc.Model, housing3Config.Clothes :: CFG_TYPES.NPCCategory)
		end
	end
end

-- generate persistent npc
function NPCServiceClient:GenerateNPC(Player: Player, Model: Model, PosV: Vector3Value, Parent: Folder, Type: string, Level: number?): DAT_TYPES.AmbientNPCData
	local animator = Model:FindFirstChildWhichIsA('Animator', true) :: Animator
	local human = animator.Parent :: Humanoid
	local root = Model:FindFirstChild('HumanoidRootPart') :: BasePart
	local cF = CFrame.new(PosV.Value) * CFrame.Angles(0, math.rad(math.random(0,360)), 0)

	Model:PivotTo(cF)
	Model.Parent = Parent
	
	local gui: BillboardGui?, levels: Frame, bar: Frame
	
	if Level then
		local modelType = Model:GetAttribute('Type') or Model.Name
		local config = INV_CONFIGS.Units[modelType][Level]
		gui, bar, levels = INT_UTILS.AddStats(Model, Level, config.Name)
	end
	
	return {
		DefiningState = 'Peace',
		State = 'Wandering',
		Level = Level,
		Type = Type,
		Model = Model,
		Position = PosV,
		RootPart = root,
		Animator = animator,
		Humanoid = human,
		Track = ANM_UTILS.PlayAnimation(animator, RPS.Animations.Character.Idle),
		
		IdleAnimation = RPS.Animations.Character.Wait,
		MoveAnimation = RPS.Animations.Character.Walk,
		
		Stats = gui and {
			Gui = gui,
			Levels = levels,
			HealthBar = bar,
		},
		
		LastAcknowledge = 0,
		Acknowledging = false,
		Subverted = false,
		Stationed = false,
		Pathing = false,
		LastIdle = 0,
		PathIndex = 0
	}
end

-- update player npcs
function NPCServiceClient:UpdateAllPaths(Player: Player)
	local npcsList = NPC_CONTAINER[Player]
	
	if not npcsList then
		return
	end
	
	NPCServiceClient:UpdateGroupPaths(Player, npcsList.Guards)
	NPCServiceClient:UpdateGroupPaths(Player, npcsList.Housing1)
	NPCServiceClient:UpdateGroupPaths(Player, npcsList.Housing2)
	NPCServiceClient:UpdateGroupPaths(Player, npcsList.Housing3)
	NPCServiceClient:UpdateGroupPaths(Player, npcsList.Farm1)
	NPCServiceClient:UpdateGroupPaths(Player, npcsList.Farm2)
end

-- update pathfinding
function NPCServiceClient:UpdateGroupPaths(Player: Player, Group: {DAT_TYPES.AmbientNPCData})
	local npcsList = NPC_CONTAINER[Player]
	
	for npcIndex, npc in Group do
		if npc.Stationed then
			if npcsList.KingdomState == 'Peace' then
				npc.Stationed = false
				print(npc.Stationed)
			else
				continue
			end
		end
		
		local index = npc.PathIndex
		
		if not npc.Path or npc.DefiningState ~= npcsList.KingdomState then
			if npcsList.KingdomState == 'Peace' then
				if os.clock() - npc.LastIdle < 5 or npc.Acknowledging or npc.Subverted then
					continue
				end
			end
			
			npc.DefiningState = npcsList.KingdomState
			NPCServiceClient:SetNPCPath(Player, npc)
		end
		
		local newIndex = npc.PathIndex
		
		if npc.Path and newIndex ~= index then
			npc.Track = ANM_UTILS.PlayAnimation(npc.Animator, npc.MoveAnimation)
			
			task.spawn(function()
				for _, posV in npc.Path do
					if npc.PathIndex ~= newIndex then
						break
					end
					
					local trg = posV.Value
					local pos = npc.RootPart.Position
					
					local diff = Vector3.new(trg.X, 0, trg.Z) - Vector3.new(pos.X, 0, pos.Z)
					
					while diff.Magnitude > 1 do
						if npc.PathIndex ~= newIndex then
							break
						end
						
						if INV_CONTAINER[Player] and INV_CONTAINER[Player].Battling and npc.Type == 'Fighter' then
							break
						end
						
						npc.Humanoid:Move(diff.Unit)
						
						pos = npc.RootPart.Position
						diff = Vector3.new(trg.X, 0, trg.Z) - Vector3.new(pos.X, 0, pos.Z)
						
						NPCServiceClient:AcknowledgeNPC(npc)
						
						task.wait(0.005)
					end
					
					npc.Position = posV
				end

				npc.Humanoid:Move(Vector3.zero)
				
				if npc.PathIndex == newIndex then
					if npc.DefiningState == 'War' and npc.Type == 'Fighter' then
						npc.Stationed = true

						if not INV_CONTAINER[Player].Battling then
							NPC_CSignals.TroopStationed:Fire(Player, npc, npcIndex)
						end
					else
						npc.Track = ANM_UTILS.PlayAnimation(npc.Animator, npc.IdleAnimation)
					end
					
					npc.Path = nil
				end
			end)
		end

		task.wait(.005)
	end
end

-- set npc path according to kingdom state
function NPCServiceClient:SetNPCPath(Player: Player, NPC: DAT_TYPES.AmbientNPCData)
	if NPC.Stationed then
		return
	end
	
	local npcsList = NPC_CONTAINER[Player]
	local significantPositions = npcsList.SignificantPositions
	
	local _, posV: Vector3Value = PTH_UTILS.GetRandomPos(npcsList.Positions)
	local moveAnim = RPS.Animations.Character.Run
	local idleAnim = ({RPS.Animations.Character.Wait, RPS.Animations.Character.Idle})[math.random(1,2)]
	local animsF: Folder?

	if npcsList.KingdomState == 'War' then
		local npcType = NPC.Model:GetAttribute('Type') or NPC.Model.Name
		animsF = RPS.Animations.Combat:FindFirstChild(npcType) :: Folder?

		local walkSpeed = 16

		if NPC.Type == 'Fighter' then
			walkSpeed = 32
			posV = significantPositions.GateEntrance
		end

		NPC.Humanoid.WalkSpeed = walkSpeed
	else
		moveAnim = RPS.Animations.Character.Walk
		NPC.Humanoid.WalkSpeed = 8
	end
	
	NPC.MoveAnimation = animsF and animsF:FindFirstChild('Run') :: Animation? or moveAnim
	NPC.IdleAnimation = animsF and animsF:FindFirstChild('Idle') :: Animation? or idleAnim
	
	local path = PTH_UTILS.GetPath(NPC.Position, posV, npcsList.Graph)
	NPC.PathIndex += 1
	NPC.Path = path
end

-- acknowledge if near
function NPCServiceClient:AcknowledgeNPC(NPC: DAT_TYPES.AmbientNPCData)
	local char = plr.Character
	local diff = char and char:GetPivot().Position - NPC.RootPart.Position
	
	if diff and diff.Magnitude < 15 and NPC.DefiningState == 'Peace' and os.clock() - NPC.LastAcknowledge > 15 then
		NPC.Acknowledging = true

		NPC.Humanoid:Move(diff.Unit)
		task.wait(.3)

		NPC.Humanoid:Move(Vector3.zero)
		NPC.Track = ANM_UTILS.PlayAnimation(NPC.Animator, RPS.Animations.Character.Kneel, .4)

		task.wait(1.6)
		
		NPC.Track:Stop(.4)
		
		task.wait(.4)
		
		NPC.Track = ANM_UTILS.PlayAnimation(NPC.Animator, NPC.IdleAnimation)

		task.wait(4)

		NPC.LastAcknowledge = os.clock()
		NPC.LastIdle = os.clock()
		NPC.Track = ANM_UTILS.PlayAnimation(NPC.Animator, NPC.MoveAnimation)
		NPC.Acknowledging = false
	end
end

return NPCServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1309"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">NPCClientSignals</string><string name="ScriptGuid">{7d1eab4e-cead-4a98-ae4c-4a7962207ad9}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
