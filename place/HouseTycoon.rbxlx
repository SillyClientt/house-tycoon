local LandConfigs = {}

local RPS = game:GetService('ReplicatedStorage')

local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)

-- Each player's land is a 4x4 grid of parcels, each parcel is 8x8 tiles (48x48 studs).
-- Full land = 32x32 tiles = 192x192 studs.
LandConfigs.ParcelCells = 8
LandConfigs.ParcelGrid = 4

-- the free parcel everyone starts with (front row, next to the road where players spawn)
LandConfigs.StartParcel = '1_3'

-- cash price of the next parcel, by how many parcels the player already owns
LandConfigs.ParcelPrices = {
	[1] = 2500,
	[2] = 6000,
	[3] = 12000,
	[4] = 20000,
	[5] = 32000,
	[6] = 50000,
	[7] = 75000,
	[8] = 110000,
	[9] = 160000,
	[10] = 230000,
	[11] = 320000,
	[12] = 450000,
	[13] = 620000,
	[14] = 850000,
	[15] = 1200000,
}

-- Robux parcel products. Make 3 developer products on the website and paste their ids here.
local parcelTiers: {CFG_TYPES.ParcelTierConfig} = {
	{MaxOwned = 4, ProductId = 0, RobuxPrice = 49},
	{MaxOwned = 9, ProductId = 0, RobuxPrice = 99},
	{MaxOwned = 15, ProductId = 0, RobuxPrice = 199},
}

LandConfigs.ParcelTiers = parcelTiers

-- floors
local levels: {[number]: CFG_TYPES.LevelConfig} = {
	[1] = {DisplayName = 'Ground Floor', Cost = 0},
	[2] = {DisplayName = '2nd Floor', Cost = 25000},
	[3] = {DisplayName = '3rd Floor', Cost = 100000},
}

LandConfigs.Levels = levels
LandConfigs.MaxLevels = #levels

-- Where the neighbourhood is built (6 lands, 3 x 2, with roads between).
-- Move Center to place it somewhere else on your map. Set Max Players to 6 in Game Settings.
LandConfigs.Neighborhood = {
	Center = Vector3.new(-560, 0.1, -100), -- top of the ground (just above the baseplate, west of spawn)
	Columns = 3,
	Rows = 2,
	RoadWidth = 40,
	GrassColor = Color3.fromRGB(96, 156, 82),
	RoadColor = Color3.fromRGB(70, 72, 78),
}

return LandConfigs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW4"><Properties><string name="Name">MapConfigs</string><ProtectedString name="Source"><![CDATA[--!strict
local MapConfigs = {}

-- The suburb is built around the lands when the server starts (see MapServiceServer).
-- Everything here is safe to tweak. Sizes are in studs.

-- turn the grey Baseplate into grass so the suburb doesn't float on studs
MapConfigs.RecolorBaseplate = true

MapConfigs.Colors = {
	Grass = Color3.fromRGB(104, 168, 84),
	Road = Color3.fromRGB(64, 66, 72),
	RoadLine = Color3.fromRGB(250, 214, 80),
	Sidewalk = Color3.fromRGB(205, 200, 190),
	Curb = Color3.fromRGB(170, 166, 158),
	Fence = Color3.fromRGB(250, 248, 240),
	Trunk = Color3.fromRGB(110, 78, 52),
	Leaves = {
		Color3.fromRGB(86, 160, 72),
		Color3.fromRGB(70, 140, 62),
		Color3.fromRGB(112, 176, 80),
		Color3.fromRGB(150, 190, 80),
	},
	LampPost = Color3.fromRGB(48, 52, 64),
	LampGlow = Color3.fromRGB(255, 214, 150),
	Mailbox = Color3.fromRGB(58, 110, 200),
	Flowers = {
		Color3.fromRGB(240, 90, 110),
		Color3.fromRGB(255, 200, 70),
		Color3.fromRGB(190, 120, 230),
		Color3.fromRGB(255, 255, 255),
	},
}

-- streets
MapConfigs.SidewalkWidth = 7
MapConfigs.CurbHeight = 0.3
MapConfigs.DashLength = 8
MapConfigs.DashGap = 10

-- picket fence around the sides and back of each land (the front stays open)
MapConfigs.FenceHeight = 3.5
MapConfigs.PicketSpacing = 5

-- street lamps along every sidewalk
MapConfigs.LampSpacing = 48
MapConfigs.LampHeight = 14
MapConfigs.LampRange = 28
MapConfigs.LampBrightness = 2

-- green belt and park around the neighbourhood
MapConfigs.ParkWidth = 110 -- grass around the outside edge
MapConfigs.ParkTrees = 70
MapConfigs.TreesPerVerge = 3 -- trees on the sidewalk side of each land

-- town square in front of the neighbourhood, where visitors come from
MapConfigs.TownSquare = {
	Depth = 90,
	Width = 200,
	PavingColor = Color3.fromRGB(214, 196, 168),
	Shops = {
		{Name = 'Realty Office', Color = Color3.fromRGB(240, 120, 90)},
		{Name = 'Furniture Store', Color = Color3.fromRGB(90, 150, 230)},
		{Name = 'Cafe', Color = Color3.fromRGB(250, 196, 80)},
	},
}

-- day and night
MapConfigs.DayCycle = {
	Enabled = true,
	MinutesPerDay = 12, -- real minutes for a full 24 hours
	StartTime = 9, -- clock time when the server starts
	NightStart = 18.25, -- street lamps turn on
	NightEnd = 6.25, -- street lamps turn off
}

-- lighting is blended between these two looks as the sun moves
MapConfigs.DayLook = {
	Ambient = Color3.fromRGB(120, 120, 130),
	OutdoorAmbient = Color3.fromRGB(150, 150, 140),
	Brightness = 3,
	ColorTint = Color3.fromRGB(255, 246, 232),
	Saturation = 0.12,
	AtmosphereColor = Color3.fromRGB(199, 220, 240),
	AtmosphereDecay = Color3.fromRGB(106, 150, 190),
}

MapConfigs.NightLook = {
	Ambient = Color3.fromRGB(70, 74, 110),
	OutdoorAmbient = Color3.fromRGB(80, 88, 130),
	Brightness = 1.2,
	ColorTint = Color3.fromRGB(210, 220, 255),
	Saturation = 0.05,
	AtmosphereColor = Color3.fromRGB(60, 70, 110),
	AtmosphereDecay = Color3.fromRGB(40, 44, 80),
}

return MapConfigs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW5"><Properties><string name="Name">MarketConfigs</string><ProtectedString name="Source"><![CDATA[--!strict
local MarketConfigs = {}

local RPS = game:GetService('ReplicatedStorage')

local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)

-- rooms
-- A room is an area fully closed in by walls, fully floored, with a door (or stairs).
-- Its type comes from the key furniture inside it (FurnitureConfigs.Items[...].Room).
-- Rooms joined by a door, or stacked on top of each other, are one house.
MarketConfigs.MinRoomCells = 2
MarketConfigs.MaxBonusRoomsPerType = 3

local roomTypes: {[CFG_TYPES.RoomType]: CFG_TYPES.RoomTypeConfig} = {
	Bedroom = {DisplayName = 'Bedroom', Order = 1, Bonus = 800, IdealCells = 6},
	Bathroom = {DisplayName = 'Bathroom', Order = 2, Bonus = 700, IdealCells = 3},
	Kitchen = {DisplayName = 'Kitchen', Order = 3, Bonus = 900, IdealCells = 4},
	LivingRoom = {DisplayName = 'Living Room', Order = 4, Bonus = 800, IdealCells = 8},
	DiningRoom = {DisplayName = 'Dining Room', Order = 5, Bonus = 500, IdealCells = 4},
	Office = {DisplayName = 'Office', Order = 6, Bonus = 500, IdealCells = 3},
	Laundry = {DisplayName = 'Laundry Room', Order = 7, Bonus = 400, IdealCells = 2},
}

MarketConfigs.RoomTypes = roomTypes

-- a house can only be sold or rented when it has these rooms
local requiredRooms: {CFG_TYPES.RoomType} = {'Bedroom', 'Bathroom'}
MarketConfigs.RequiredRooms = requiredRooms

-- having all of these multiplies the whole value
local completeRooms: {CFG_TYPES.RoomType} = {'Bedroom', 'Bathroom', 'Kitchen', 'LivingRoom'}
MarketConfigs.CompleteRooms = completeRooms
MarketConfigs.CompleteMultiplier = 1.25

-- every furniture piece in a house adds Price * this (items can override with ValueRate)
MarketConfigs.FurnitureValueRate = 1.1

-- lighting: house value * (MinLightFactor + (1 - MinLightFactor) * lit fraction)
MarketConfigs.MinLightFactor = 0.5
MarketConfigs.WindowLightCells = 1 -- tiles lit inwards from each window

-- cleanliness: each dirt spot takes this much off, down to the minimum
MarketConfigs.DirtPenalty = 0.06
MarketConfigs.MinCleanFactor = 0.5
MarketConfigs.CellsPerDirt = 3 -- most dirt a house can have = tiles / this (at least 1)
MarketConfigs.DirtInterval = {Rented = 60, Other = 180} -- seconds between new dirt per house
MarketConfigs.DirtTick = 5
MarketConfigs.CleanDistance = 12

-- offers
MarketConfigs.FirstOfferDelay = {Min = 5, Max = 10}
MarketConfigs.OfferDelay = {Min = 10, Max = 20}
MarketConfigs.OfferLifetime = 45
MarketConfigs.MaxOffers = 3
MarketConfigs.SaleOfferRange = {Min = 0.85, Max = 1.2} -- times the house value
MarketConfigs.RentOfferRange = {Min = 0.85, Max = 1.15} -- times the base rent

-- rent
MarketConfigs.RentPerMinuteRate = 0.012 -- rent per minute = value * rate
MarketConfigs.RentTickInterval = 5
MarketConfigs.OfflineRentHours = 3

MarketConfigs.FirstNames = {
	'Ava', 'Noah', 'Mia', 'Liam', 'Zara', 'Omar', 'Lena', 'Yusuf', 'Ivy', 'Leo',
	'Sara', 'Adam', 'Nora', 'Ethan', 'Layla', 'Hugo', 'Maya', 'Idris', 'Chloe', 'Sam',
}

MarketConfigs.LastNames = {
	'Hart', 'Stone', 'Rivers', 'Khan', 'Brooks', 'Ward', 'Fields', 'Moss', 'Reed', 'Lane',
	'Price', 'Hale', 'Cole', 'Frost', 'Wells', 'Nash', 'Grant', 'Shaw', 'Blake', 'Dale',
}

return MarketConfigs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW6"><Properties><string name="Name">MonetizationConfigs</string><ProtectedString name="Source"><![CDATA[--!strict
local MonetizationConfigs = {}

local RPS = game:GetService('ReplicatedStorage')

local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)

-- Make these on the website (Creator Hub > your game > Monetization) and paste the ids.
-- Id = 0 means "not set up yet": the button tells the player instead of prompting.
-- Everything here gives a fixed, guaranteed result (no luck, no crates).

local gamepasses: {[string]: CFG_TYPES.GamepassConfig} = {
	DoubleRent = {
		Id = 0,
		DisplayName = '2x Rent',
		Description = 'Every tenant pays you double rent.',
		RobuxPrice = 249,
		Order = 1,
	},
	AutoCleaner = {
		Id = 0,
		DisplayName = 'Auto Cleaner',
		Description = 'A cleaner removes one dirt spot every 15 seconds.',
		RobuxPrice = 199,
		Order = 2,
	},
	VipFurniture = {
		Id = 0,
		DisplayName = 'VIP Furniture',
		Description = 'Unlocks the VIP furniture set (worth 50% more).',
		RobuxPrice = 299,
		Order = 3,
	},
	QuickSale = {
		Id = 0,
		DisplayName = 'Quick Sale',
		Description = 'Offers come twice as fast and are 10% higher.',
		RobuxPrice = 149,
		Order = 4,
	},
}

MonetizationConfigs.Gamepasses = gamepasses

local cashPacks: {[string]: CFG_TYPES.CashPackConfig} = {
	Small = {Id = 0, Cash = 10000, RobuxPrice = 49, Order = 1},
	Medium = {Id = 0, Cash = 50000, RobuxPrice = 199, Order = 2},
	Large = {Id = 0, Cash = 250000, RobuxPrice = 799, Order = 3},
	Huge = {Id = 0, Cash = 1000000, RobuxPrice = 2499, Order = 4},
}

MonetizationConfigs.CashPacks = cashPacks

-- gamepass effects
MonetizationConfigs.DoubleRentMultiplier = 2
MonetizationConfigs.AutoCleanInterval = 15
MonetizationConfigs.QuickSaleDelayMultiplier = 0.5
MonetizationConfigs.QuickSaleOfferBonus = 1.1

-- how many purchase ids to remember (stops a receipt being granted twice)
MonetizationConfigs.PurchaseHistory = 50

return MonetizationConfigs
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW7"><Properties><string name="Name">TenantConfigs</string><ProtectedString name="Source"><![CDATA[--!strict
