</token><bool name="TextScaled">true</bool><float name="TextSize">14</float><Color3 name="TextStrokeColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextStrokeTransparency">1</float><float name="TextTransparency">0</float><token name="TextTruncate">0</token><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">1</token><bool name="Visible">true</bool><int name="ZIndex">2</int></Properties></Item><Item class="UIAspectRatioConstraint" referent="RBX1142"><Properties><float name="AspectRatio">3</float><token name="AspectType">0</token><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><token name="DominantAxis">0</token><string name="Name">UIAspectRatioConstraint</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="UICorner" referent="RBX1143"><Properties><BinaryString name="AttributesSerialize"></BinaryString><UDim name="BottomLeftRadius"><S>0.100000001</S><O>0</O></UDim><UDim name="BottomRightRadius"><S>0.100000001</S><O>0</O></UDim><bool name="DefinesCapabilities">false</bool><string name="Name">UICorner</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64><UDim name="TopLeftRadius"><S>0.100000001</S><O>0</O></UDim><UDim name="TopRightRadius"><S>0.100000001</S><O>0</O></UDim></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBX1144"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Fishclopedia</string><string name="ScriptGuid">{e053848d-4034-4895-a9e2-061b5d574c5d}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Fishclopedia = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local MPS = game:GetService('MarketplaceService')
local PPS = game:GetService('ProximityPromptService')

local FSH_CONFIGS = require(RPS.Modules.Services.FishService.FishConfigs)
local FSH_TYPES = require(RPS.Modules.Services.FishService.FishTypes)
local DAT_Client = require(RPS.Modules.Packages.DataService).client

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui
local hud = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local sidebar = hud:WaitForChild('Sidebar')
local fishclopedia = hud:WaitForChild('Fishclopedia')
local fCSidebar = fishclopedia:WaitForChild('Sidebar')
local fishclopediaB = sidebar:WaitForChild('Fishclopedia')
local scroller = fishclopedia:WaitForChild('Scroller')
local totalDiscovered = fishclopedia:WaitForChild('Discovered')
local actions = fishclopedia:WaitForChild('Actions')
local searchBox = actions:WaitForChild('Search'):WaitForChild('TextBox')
local closeB = fishclopedia:WaitForChild('Close')
local details = fishclopedia:WaitForChild('Details')
local addToAquarium = fishclopedia:WaitForChild('AddAquarium')
local removeFromAquarium = fishclopedia:WaitForChild('RemoveAquarium')
local template = script.FishTemplate

local tweens: {[Instance]: Tween} = {}

local selectedRarity = 'AllItems'
local sortType = 'Rarity'
local selectedFish: typeof(template)?
local absY: number

local sortList = {
	Rarity = {
		Common = 0,
		Uncommon = 1000,
		Rare = 2000,
		Epic = 3000,
		Legendary = 4000,
		Mythical = 5000,
		Exotic = 6000,
	}
}

local lastDiscovery = 0

-- sort fish buttons
local function sort()
	if sortType == 'Rarity' or sortType == 'Chance' then
		scroller.UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
		
		for _, child in scroller:GetChildren() do
			if not child:IsA('TextButton') then
				continue
			end

			local config = FSH_CONFIGS.Fish[child.Name] or FSH_CONFIGS.Whales[child.Name]

			if sortType == 'Rarity' then
				child.LayoutOrder = sortList.Rarity[child:GetAttribute('Rarity')] :: number - config.Weight
			elseif sortType == 'Chance' then
				child.LayoutOrder = -config.Weight
			end
			
			child.ZIndex = -child.LayoutOrder
		end
	elseif sortType == 'Name' then
		scroller.UIListLayout.SortOrder = Enum.SortOrder.Name
	end
end

-- filter fish buttons
local function filter()
	for _, child in scroller:GetChildren() do
		if not child:IsA('TextButton') then
			continue
		end
		
		local visible = (child.Name:lower()):match((searchBox.Text:lower())) and true or false
		
		if selectedRarity == 'AllItems' then
			visible = visible and true
		else
			visible = visible and child:GetAttribute('Rarity') == selectedRarity
		end
		
		child.Visible = visible
	end
end

-- update details panel
local function updateDetails()
	local fishclopediaData = selectedFish and DAT_Client:get('Fishclopedia')[selectedFish.Name]
	
	if not fishclopediaData or not selectedFish then
		details.Top.Title.Text = '???'
		details.Top.Rarity.Icon.Image = selectedFish and FSH_CONFIGS.RarityStars[selectedFish:GetAttribute('Rarity')] or FSH_CONFIGS.RarityStars.Exotic
		details.Top.Rarity.Title.Text = selectedFish and selectedFish:GetAttribute('Rarity') or '???'
		details.Back.Icon.Visible = false
		details.Back.Unknown.Visible = true
		details.Description.TextLabel.Text = '???'
		details.Info.BestMutation.Value.Text = 'None'
		details.Info.Cleaned.Value.Text = '0'
		return
	end

	local config = FSH_CONFIGS.Fish[selectedFish.Name] or FSH_CONFIGS.Whales[selectedFish.Name]

	details.Top.Title.Text = selectedFish.Name
	details.Top.Rarity.Icon.Image =  FSH_CONFIGS.RarityStars[selectedFish:GetAttribute('Rarity')]
	details.Top.Rarity.Title.Text = selectedFish:GetAttribute('Rarity')
	details.Back.Icon.Image = config.Icon
	details.Back.Icon.Visible = true
	details.Back.Unknown.Visible = false
	details.Description.TextLabel.Text = config.Description
	details.Info.BestMutation.Value.Text = fishclopediaData.BestMutation
	details.Info.Cleaned.Value.Text = fishclopediaData.Cleaned
	
	if fishclopediaData.Cleaned > 0 then
		if not MPS:UserOwnsGamePassAsync(plr.UserId, 1952572159) then
			return
		end
		
		local aquariumData = DAT_Client:get('Aquarium')
		local added = table.find(aquariumData, selectedFish.Name)
		
		if added then
			addToAquarium.Visible = false
			removeFromAquarium.Visible = true
		else
			addToAquarium.Visible = true
			removeFromAquarium.Visible = false
		end
	else
		addToAquarium.Visible = false
		removeFromAquarium.Visible = false
	end
end

-- play new fish discovered
local function newFishDiscovered(Fish: string)
	local frame = fishclopediaB.NewFish.Frame
	local oldTween = tweens[frame]
	
	if oldTween then
		oldTween:Destroy()
	end
	
	local config = FSH_CONFIGS.Fish[Fish] or FSH_CONFIGS.Whales[Fish]
	
	fishclopediaB.NewFish.Visible = true
	
	frame.Title.Text = Fish..' discovered!'
	frame.Icon.Image = config.Icon
	frame.Position = UDim2.fromScale(1,0)
	
	tweens[frame] = TWS:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
		Position = UDim2.fromScale(1,1)
	})
	tweens[frame]:Play()
	
	fishclopedia.NewFishSound:Play()
	lastDiscovery = tick()
	
	task.spawn(function()
		task.wait(1.5)
		
		if tick() - lastDiscovery >= 1.45 then
			tweens[frame] = TWS:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Position = UDim2.fromScale(0,1)
			})
			tweens[frame]:Play()

			tweens[frame].Completed:Wait()
			if frame.Position == UDim2.fromScale(0,1) then
				fishclopediaB.NewFish.Visible = false
			end
		end
	end)
end

local function addToFishclopedia(StoredData, Fish: string, Config, Total: {[string]: number}, Discovered: {[string]: number})
	local exists = StoredData[Fish]
	local button = template:Clone()
	button.Name = Fish
	button.Title.Text = exists and Fish or '???'
	button.Icon.Image = Config.Icon
	button:SetAttribute('Rarity', Config.Rarity)
	button.Rarity.Title.Text = Config.Rarity
	button.Rarity.Icon.Image = FSH_CONFIGS.RarityStars[Config.Rarity]
	button.Icon.Visible = exists and true or false
	button.Unknown.Visible = not button.Icon.Visible
	button.Visible = true

	button.Parent = scroller

	absY = button.AbsoluteSize.Y
	Total[Config.Rarity] += 1
	Total.AllItems += 1

	Discovered[Config.Rarity] += exists and 1 or 0
	Discovered.AllItems += exists and 1 or 0

	button.MouseEnter:Connect(function()
		if tweens[button] then
			tweens[button]:Destroy()
		end

		tweens[button] = TWS:Create(button, TweenInfo.new(0.15, Enum.EasingStyle.Cubic), {
			BackgroundColor3 = Color3.fromRGB(124, 198, 255)
		})
		tweens[button]:Play()
	end)
	button.MouseLeave:Connect(function()
		if selectedFish == button then
			return
		end

		if tweens[button] then
			tweens[button]:Destroy()
		end

		tweens[button] = TWS:Create(button, TweenInfo.new(0.1, Enum.EasingStyle.Cubic), {
			BackgroundColor3 = Color3.fromRGB(22, 60, 104)
		})
		tweens[button]:Play()
	end)

	button.MouseButton1Click:Connect(function()
		if selectedFish == button then
			return
		end

		if tweens[button] then
			tweens[button]:Destroy()
		end

		if selectedFish then
			if tweens[selectedFish] then
				tweens[selectedFish]:Destroy()
			end

			selectedFish.BackgroundColor3 = Color3.fromRGB(22, 60, 104)
		end

		button.BackgroundColor3 = Color3.fromRGB(124, 198, 255)

		if button.New.Visible then
			RPS.Remotes.RewardService.ClickedFishButton:FireServer(Fish)
		end

		selectedFish = button
		updateDetails()
	end)
end

-- rotate button on hover
local function addButtonEffect(Button: TextButton)
	local colors = {
		Hover = Button:GetAttribute('Hover'),
		Neutral = Button:GetAttribute('Neutral')
	}

	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1),
			BackgroundColor3 = colors.Hover
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = size,
			BackgroundColor3 = colors.Neutral
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- initialize fishclopedia interface
function Fishclopedia:Init()
	local fishclopediaData = DAT_Client:get('Fishclopedia')
	
	local total: {[string]: number} = {
		Common = 0,
		Uncommon = 0,
		Rare = 0,
		Epic = 0,
		Legendary = 0,
		Mythical = 0,
		Exotic = 0,
		AllItems = 0
	}
	
	local discoveredFish: {[string]: number} = {
		Common = 0,
		Uncommon = 0,
		Rare = 0,
		Epic = 0,
		Legendary = 0,
		Mythical = 0,
		Exotic = 0,
		AllItems = 0
	}
	
	for fish, data in FSH_CONFIGS.Fish do
		addToFishclopedia(fishclopediaData, fish, data, total, discoveredFish)
	end

	for whale, data in FSH_CONFIGS.Whales do
		addToFishclopedia(fishclopediaData, whale, data, total, discoveredFish)
	end
	
	sort()
	--scroller.CanvasSize = UDim2.fromOffset(0, #scroller:GetChildren() / 5 * absY + 100)
	
	for title, count in total do
		(fCSidebar:FindFirstChild(title) :: typeof(fCSidebar:WaitForChild('Common'))).Amount.Text = discoveredFish[title]..' / '..count
	end
	
	totalDiscovered:WaitForChild('Amount').Text = discoveredFish.AllItems..' / '..total.AllItems
	
	DAT_Client:getChangedSignal('Fishclopedia'):Connect(function(Data)
		local lastFish = DAT_Client:get('LastFish')
		
		local discovered: {[string]: number} = {
			Common = 0,
			Uncommon = 0,
			Rare = 0,
			Epic = 0,
			Legendary = 0,
			Mythical = 0,
			Exotic = 0,
			AllItems = 0
		}
		
		for fish, data in pairs(Data) do
			local button = scroller:FindFirstChild(fish) :: typeof(template)?
			if not button then continue end
			
			button.Icon.Visible = true
			button.Unknown.Visible = false
			button.Title.Text = fish
			button.New.Visible = data.New
			
			discovered[button:GetAttribute('Rarity')] += 1
			discovered.AllItems += 1
			
			if not data.Registered then
				newFishDiscovered(fish)
			end
		end
		
		for title, count in discovered do
			(fCSidebar:FindFirstChild(title) :: typeof(fCSidebar.Common)).Amount.Text = count..' / '..total[title]
		end
		
		totalDiscovered.Amount.Text = discovered.AllItems..' / '..total.AllItems
		
		updateDetails()
	end)
	
	DAT_Client:getChangedSignal('Aquarium'):Connect(updateDetails)
	
	for _, sidebarButton in fCSidebar:GetChildren() do
		if not sidebarButton:IsA('TextButton') then
			continue
		end
		
		sidebarButton.MouseEnter:Connect(function()
			if tweens[sidebarButton] then
				tweens[sidebarButton]:Destroy()
			end
			
			local tween = TWS:Create(sidebarButton, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = Color3.fromRGB(124, 198, 255)
			})
			tweens[sidebarButton] = tween
			tween:Play()
		end)
		sidebarButton.MouseLeave:Connect(function()
			if selectedRarity == sidebarButton.Name then
				return
			end
			
			if tweens[sidebarButton] then
				tweens[sidebarButton]:Destroy()
			end

			local tween = TWS:Create(sidebarButton, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = Color3.fromRGB(17, 47, 91)
			})
			tweens[sidebarButton] = tween
			tween:Play()
		end)
		
		sidebarButton.MouseButton1Click:Connect(function()
			if sidebarButton.Name == selectedRarity then
				return
			end
			
			if tweens[sidebarButton] then
				tweens[sidebarButton]:Destroy()
			end
			
			sidebarButton.BackgroundColor3 = Color3.fromRGB(124, 198, 255);
			
			(fCSidebar:FindFirstChild(selectedRarity) :: TextButton).BackgroundColor3 = Color3.fromRGB(17, 47, 91)
			selectedRarity = sidebarButton.Name
			
			filter()
		end)
	end
	
	closeB.MouseEnter:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end
		
		local tween = TWS:Create(closeB, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 15,
			Size = UDim2.fromScale(.175,.175)
		})
		tweens[closeB] = tween
		tween:Play()
	end)
	closeB.MouseLeave:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end

		local tween = TWS:Create(closeB, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = UDim2.fromScale(.15,.15)
		})
		tweens[closeB] = tween
		tween:Play()
	end)
	
	closeB.MouseButton1Click:Connect(function()
		fishclopedia.Visible = false
	end)
	
	searchBox:GetPropertyChangedSignal('Text'):Connect(function()
		filter()
	end)
	
	addToAquarium.MouseButton1Click:Connect(function()
		if not selectedFish then
			return
		end
		
		RPS.Remotes.StationService.AddToAquarium:FireServer(selectedFish.Name)
	end)
	removeFromAquarium.MouseButton1Click:Connect(function()
		if not selectedFish then
			return
		end
		RPS.Remotes.StationService.RemoveFromAquarium:FireServer(selectedFish.Name)
	end)
	
	addButtonEffect(addToAquarium)
	addButtonEffect(removeFromAquarium)
	
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		if Prompt:HasTag('FishclopediaPrompt') and Player == plr then
			fishclopedia.Visible = true
		end
		
		Prompt.PromptHidden:Once(function()
			fishclopedia.Visible = false
		end)
	end)
end

return Fishclopedia
