export type NPCCategory = 'Peasant' | 'Knight' | 'Blacksmith' | 'Merchant' | 'King' | 'Farmer' | 'Noble' | 'Guard' | 'GuardCaptain' | 'Bandit' | 'Brute' | 'Reaver'

export type Rarity = 'Common' | 'Uncommon' | 'Rare' | 'Epic' | 'Legendary'

export type Animal = 'Chicken' | 'Cow' | 'Sheep' | 'Goat' | 'Horse' | 'Dog' | 'Cat' | 'Bear' | 'Fox' | 'Wolf' | 'Rabbit' | 'Deer' | 'Bee' | 'Butterfly' | 'Fish' 

export type Choice = 'Release' | 'Cook' | 'Knight' | 'Pardon' | 'Sell' | 'Grant' | 'Aid' | 'Accept' | 'Refuse' | 'Dungeon' | 'Ignore' | 'Send Guards'

export type Building = 'Farm' | 'Blacksmith' | 'Wizard Tower' | 'Barracks' | 'Stables' 

export type LayoutType = 'Faceoff' | 'Diagonal' | 'Vertical'

export type Gender = 'Male' | 'Female'

export type SpawnOffset = 'Random' | 'Consistent'

export type RewardConfig = {
	Gold: number?,
	Reputation: number?,
	Prestige: number?,
	Transaction: Enum.AnalyticsEconomyTransactionType?
}

export type DeductionConfig = {
	Gold: number?,
	Reputation: number?,
	Prestige: number?,
	Transaction: Enum.AnalyticsEconomyTransactionType?
}

export type CutsceneConfig = {
	Spawn: {
		[number]: {
			Offset: SpawnOffset,
			Amount: number,
			Interval: number,
			Animation: {string}?,
			WalkSpeed: number?,
		
			Subject: NPCCategory | number,
			WithoutHair: boolean?,
			Pivot: string?
		}
	}?,
	
	Music: Sound?,
	Folder: string,
	Info: TweenInfo,
	FOV: {
		Start: number,
		End: number?,
	}?,
	Wipe: {number}?,
	WipePreviousCutscene: boolean?,
}

export type OutcomeConfig = {
	Building: Building,
	
	Spawn: {
		[number]: {
			Animation: {string}?,
			Subject: NPCCategory | number,
			WithoutHair: boolean?,
			Gender: Gender?,
			Pivot: string,
			Prompt: {
				ActionText: string,
				Dialogue: {
					[number]: {
						Subject: (NPCCategory | Model)?,
						WithoutHair: boolean?,
						Gender: Gender?,
						CFrame: CFrame?,
						Amount: number?,
						Order: number,
						Animation: {string}?
					}
				},
				Gift: boolean?
			}?
		}
	}?,
	
	Music: {
		Sound: Sound,
		Volume: number,
		Radius: number
	}?,
}

export type ViewConfig = {
	Subject: (NPCCategory | number | Model)?,
	WithoutHair: boolean?,
	CFrame: CFrame,
	Animation: {string}?,
	Position: UDim2,
	Size: UDim2,
	Amount: number?,
	Title: string?,
	ZIndex: number?
}

export type DialogueConfig = {
	Subject: (NPCCategory | number | Model)?,
	WithoutHair: boolean?,
	Gender: Gender?,
	CFrame: CFrame?,
	Amount: number?,
	Order: number,
	Animation: {string}?
}

export type DecisionConfig = {
	Name: string,
	Recurring: boolean,
	Weight: number,
	Queue: {
		Min: number,
		Max: number
	},

	Rarity: Rarity,
	DecisionPlaintiff: number,
	
	Plaintiffs: {
		{
			Category: NPCCategory | Model,
			WithoutHair: boolean?,
			Enter: boolean?,
			Rarity: Rarity?,
			Object: string?,
			Gender: Gender?,
			Animation: {string}?,
			Mumble: Sound?,
			
			Dialogue: {DialogueConfig}?
		}
	},

	Requires: {
		NPCs: {[NPCCategory]: {[Rarity]: number}},
		Buildings: {[Building]: number},
		Choices: {[string]: Choice},
	},
	
	Portrait: {
		Image: string,
		Title: string,
		
		Subjects: {ViewConfig}
	},

	Choices: {
		[Choice]: {
			Reward: {
				When: 'Direct' | 'Dialogue',
				Dispense: RewardConfig
			}?,
			
			Deduction: {
				When: 'Direct' | 'Dialogue',
				Dispense: DeductionConfig
			}?,
			
			Order: number,
			Title: string,
			Subjects: {ViewConfig},
			Cutscene: {CutsceneConfig}?,
			Outcome: {OutcomeConfig}?
		}
	}
}

export type UnitConfig = {
	Model: NPCCategory | Model,
	Health: number,
	Damage: number,
	DamageDelay: number,
	Rate: number,
	Range: number,
	Cost: number,
	MinThreatTier: number,
	Weight: number,
	WalkSpeed: number,
	Scale: number?,
	Name: {
		Title: string,
		Color: Color3
	}?,
	Reward: RewardConfig?
}

export type InvasionConfig = {
	Name: string,
	MinThreatTier: number,
	UnitPool: {string},
}

return nil
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1404"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">DataTypes</string><string name="ScriptGuid">{fdd4a4e9-ed31-4c73-ae42-ea164e436fd1}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local CFG_TYPES = require(script.Parent.ConfigTypes)

export type NPCData = {
	Name: string?,
	Gender: string,
	Type: CFG_TYPES.NPCCategory,
	Rarity: CFG_TYPES.Rarity?,
	BodyColor: string,
	Hair: string?,
