local DecisionServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local PPS = game:GetService('ProximityPromptService')
local RNS = game:GetService('RunService')
local WKS = game:GetService('Workspace')
local HTP = game:GetService('HttpService')
local ANS = game:GetService('AnalyticsService')
local SSG = game:GetService('ServerStorage')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local DCS_CONFIGS = require(RPS.Modules.Configs.DecisionConfigs)
local DRS_UTILS = require(RPS.Modules.Utils.DressUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local ECN_SSignals = require(SSG.Modules.Services.EconomyService.EconomyServerSignals)

-- initialize plot service server-side
function DecisionServiceServer:Init()
	RPS.Remotes.DecisionService.ChoiceMade.OnServerEvent:Connect(function(Player, Choice: CFG_TYPES.Choice, NPCs: {[number]: DAT_TYPES.NPCData})
		local decision = DAT_Server:get(Player, {'Decisions', 'Current', 'Name'})
		local choice = DAT_Server:get(Player, {'Decisions', 'Current', 'Choice'})
		
		if choice == Choice then
			return
		end
		
		local config = DCS_CONFIGS.Decisions[decision]
		local choiceConfig = config.Choices[Choice]
		if not choiceConfig then
			return
		end

		local rewarded = false
		if choiceConfig.Reward and choiceConfig.Reward.When == 'Direct' then
			ECN_SSignals.Reward:Fire(Player, choiceConfig.Reward.Dispense)
			rewarded = true
		end
		
		local deducted = false
		if choiceConfig.Deduction and choiceConfig.Deduction.When == 'Direct' then
			ECN_SSignals.Deduct:Fire(Player, choiceConfig.Deduction.Dispense)
			deducted = true
		end
		
		DAT_Server:update(Player, {'Decisions', 'Current', 'Choice'}, function()
			return {
				Current = Choice,
				NPCs = NPCs
			}
		end)
		
		DAT_Server:update(Player, {'Decisions', 'Current', 'RewardDispensed'}, function()
			return rewarded
		end)
		
		DAT_Server:update(Player, {'Decisions', 'Current', 'DeductionDispensed'}, function()
			return deducted
		end)
	end)
		RPS.Remotes.DecisionService.OutcomePlayed.OnServerEvent:Connect(function(Player)
		local decision = DAT_Server:get(Player, {'Decisions', 'Current', 'Name'})
		local decisionConfig = DCS_CONFIGS.Decisions[decision]
		
		if not decisionConfig then
			return
		end
		
		local choice = DAT_Server:get(Player, {'Decisions', 'Current', 'Choice'})
		local choiceConfig = decisionConfig.Choices[choice]
		if not choiceConfig then
			return
		end
		
		if not DAT_Server:get(Player, {'Decisions', 'Current', 'RewardDispensed'}) then
			local reward = choiceConfig.Reward
			if reward then
				ECN_SSignals.Reward:Fire(Player, reward.Dispense)
				
				DAT_Server:update(Player, {'Decisions', 'Current', 'RewardDispensed'}, function()
					return true
				end)
			end
		end
		
		if not DAT_Server:get(Player, {'Decisions', 'Current', 'DeductionDispensed'}) then
			local deduction = choiceConfig.Deduction
			if deduction then
				ECN_SSignals.Deduct:Fire(Player, deduction.Dispense)
				
				DAT_Server:update(Player, {'Decisions', 'Current', 'DeductionDispensed'}, function()
					return true
				end)
			end
		end
	end)
end

return DecisionServiceServer
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1413"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">PlotService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1414"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">PlotServiceServer</string><string name="ScriptGuid">{58a893d5-e0a3-4c6a-8972-19ed4ae9c159}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local PlotServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local PPS = game:GetService('ProximityPromptService')
local RNS = game:GetService('RunService')
local WKS = game:GetService('Workspace')
local HTP = game:GetService('HttpService')
local ANS = game:GetService('AnalyticsService')
local SSG = game:GetService('ServerStorage')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local DRS_UTILS = require(RPS.Modules.Utils.DressUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local DCS_CONFIGS = require(RPS.Modules.Configs.DecisionConfigs)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local CHR_UTILS = require(RPS.Modules.Utils.CharacterUtils)
local ANM_UTILS = require(RPS.Modules.Utils.AnimationUtils)
local ACT_UTILS = require(RPS.Modules.Utils.InteractUtils)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildingConfigs)
local INV_SSignals = require(SSG.Modules.Services.InvasionService.InvasionServerSignals)
local ECN_SSignals = require(SSG.Modules.Services.EconomyService.EconomyServerSignals)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)

local PLT_CONTAINER = require(script.Parent.PlotContainer)

-- initialize plot service server-side
function PlotServiceServer:Init()
	PLS.PlayerAdded:Connect(function(Player)
		local designatedPlot: typeof(WKS.Plots.Plot)?
		
		for _, plot in WKS.Plots:GetChildren() :: {typeof(WKS.Plots.Plot)} do
			local plr = plot:GetAttribute('Player')
			
			if plr == nil then
				plot:SetAttribute('Player', Player.Name)
				Player.RespawnLocation = plot:FindFirstChild('SpawnLocation') :: SpawnLocation
				PLT_CONTAINER[Player] = plot
				designatedPlot = plot
				
				break
			end
		end
		
		if not designatedPlot then
			Player:Kick('No plots available!')
			return
		end
		
		local data = DAT_Server:waitForData(Player)
		
		if data:get('Onboarding') ~= 'Coronation' then
			PlotServiceServer:LoadCourtRoom(Player)
			
			local char = Player.Character
			local cf = (designatedPlot:FindFirstChild('SpawnLocation') :: SpawnLocation):GetPivot() * CFrame.new(0,3,0)
			
			if char then
				char:PivotTo(cf)
			else
				char = Player.CharacterAdded:Wait()
				char:PivotTo(cf)
			end
		end
		
		PlotServiceServer:LoadBuildings(Player)
	end)
	
	PLS.PlayerRemoving:Connect(function(Player)
		PLT_CONTAINER[Player]:SetAttribute('Player', nil)
		PLT_CONTAINER[Player] = nil
	end)
	
	RPS.Remotes.OnboardingService.FinishedCoronation.OnServerEvent:Connect(function(Player)
		if DAT_Server:get(Player, 'Onboarding') ~= 'Coronation' then
			return
		end
		
		local char = Player.Character
		if char then
			DRS_UTILS.WearCrown(char, 'Normal')
		end
		
		DAT_Server:update(Player, 'Onboarding', function(Old)
			return 'Decision'
		end)
		
		PlotServiceServer:LoadCourtRoom(Player, true)
	end)
	
	RPS.Remotes.DecisionService.ChoiceMade.OnServerEvent:Connect(function(Player, Choice: CFG_TYPES.Choice, NPCs: {[number]: DAT_TYPES.NPCData})
		PlotServiceServer:PlayChoiceOutcome(Player, Choice, NPCs)
	end)
	
	task.spawn(function()
		while true do
			local waited = task.wait(0.25)
			
			for _, plr in PLS:GetPlayers() do
				PlotServiceServer:DispenseHousingTax(plr, 'Housing1', waited)
				PlotServiceServer:DispenseHousingTax(plr, 'Housing2', waited)
				PlotServiceServer:DispenseHousingTax(plr, 'Housing3', waited)
				
				PlotServiceServer:UpdateConstructionTimers(plr, waited)
			end
		end
	end)
	
	RPS.Remotes.PlotService.CollectTreasury.OnServerEvent:Connect(function(Player)
		local plot = PLT_CONTAINER[Player]
		local treasury = plot.Structures.Models:FindFirstChild('Treasury') :: Model?
		local chest = treasury and treasury:FindFirstChild('Chest') :: Model?
		local textLabel = chest and chest:FindFirstChildWhichIsA('TextLabel', true)
		
		DAT_Server:update(Player, 'TreasuryGold', function(Old)
			ECN_SSignals.Reward:Fire(Player, {Gold = Old}, 'Tax')
			return 0
		end)
		
		if textLabel then
			textLabel.Text = '0'
		end
	end)
	
	RPS.Remotes.PlotService.RequestUpgrade.OnServerEvent:Connect(function(Player, Pivot: string)
		local plot = PLT_CONTAINER[Player]
		local pivotModel = plot.Structures.Pivots:FindFirstChild(Pivot) :: Model?
		
		if not pivotModel then
			return
		end

		if DAT_Server:get(Player, {'Buildings', pivotModel.Name, 'Upgrading'}) then
			return
		end
		
		local buildingName = BLD_CONFIGS.PivotsToBuildings[pivotModel.Name] :: string
		local buildingConfig = BLD_CONFIGS.Buildings[buildingName]
		
		local data = DAT_Server:get(Player, {'Buildings', pivotModel.Name})
		local config = buildingConfig[data.Level]
		local nextConfig = buildingConfig[data.Level + 1]
		
		if not nextConfig then
			return
		end
		
		if DAT_Server:get(Player, 'Gold') < nextConfig.Cost then
			RPS.Remotes.InterfaceService.Notify:FireClient(Player, 'Not enough gold!', Color3.new(1,0,0))
			return
		end
		
		local buildingObjV = pivotModel:FindFirstChildOfClass('ObjectValue') :: ObjectValue
		
		local building = buildingObjV.Value :: Model
		if building then
			building:Destroy()
		end
		
		local newBuilding = nextConfig.Constructing:Clone() :: Model
		newBuilding:PivotTo(pivotModel:GetPivot())
		newBuilding:SetAttribute('Pivot', Pivot)
		newBuilding.Parent = plot.Structures.Models

		local primary = newBuilding.PrimaryPart
		local sound = primary and primary:FindFirstChildOfClass('Sound') :: Sound?

		if sound then
			sound:Play()
		end
		
		buildingObjV.Value = newBuilding
		
		ECN_SSignals.Deduct:Fire(Player, {Gold = nextConfig.Cost :: number}, 'Purchase')
		
		DAT_Server:update(Player, {'Buildings', pivotModel.Name}, function(Old)
			Old.Upgrading = true
			Old.TimeRemaining = nextConfig.ConstructionTime
			return Old
		end)
	end)
end

-- load player courtroom
function PlotServiceServer:LoadCourtRoom(Player: Player, SitOnThrone: boolean?): Model
	local plot = PLT_CONTAINER[Player]
	local courtRoom = RPS.Assets.Models.Courts.Court:Clone()
	
	courtRoom:PivotTo(plot:GetPivot())
	courtRoom.Parent = (plot:FindFirstChild('Structures') :: Folder):FindFirstChild('Models') :: Folder
	
	if SitOnThrone then
		local char = Player.Character or Player.CharacterAdded:Wait()
		local human = char:WaitForChild('Humanoid')
		
		courtRoom.ThroneSeat:Sit(human)
	end
	
	return courtRoom
end

-- load building
function PlotServiceServer:LoadBuildings(Player: Player)
	for pivot, buildingName in BLD_CONFIGS.PivotsToBuildings do
		local data = DAT_Server:get(Player, {'Buildings', pivot})
		
		if not data then
			continue
		end
		
		local buildingConfig = BLD_CONFIGS.Buildings[buildingName]
		local config = buildingConfig[data.Level]
		local nextConfig = buildingConfig[data.Level + 1]
		
		if not config then
			continue
		end
		
		local plot = PLT_CONTAINER[Player]
		local pivotModel = plot.Structures.Pivots:FindFirstChild(pivot) :: Model?
		
		if pivotModel then
			local model: Model
			
			if data.Upgrading then
				model = nextConfig.Constructing
			else
				model = config.Model
			end
			
			local building = model:Clone() :: Model
			building:PivotTo(pivotModel:GetPivot())
			building:SetAttribute('Pivot', pivot)
			building.Parent = plot.Structures.Models

			local primary = building.PrimaryPart
			local sound = primary and primary:FindFirstChildOfClass('Sound') :: Sound?

			if sound then
				sound:Play()
			end
			
			local objV = pivotModel:FindFirstChildOfClass('ObjectValue')
			
			if objV then
				objV.Value = building
			end
			
			if buildingName == 'Treasury' then
				local chest = building:FindFirstChild('Chest') :: Model?
				local textLabel = chest and chest:FindFirstChildWhichIsA('TextLabel', true)
				
				if textLabel then
					textLabel.Text = STR_UTILS.GetCondensedAmount(DAT_Server:get(Player, 'TreasuryGold'))
				end
			end
			
			local upgrade = building:FindFirstChild('Upgrade') :: Model?
			
			if upgrade then
				local amount = upgrade:FindFirstChild('Amount', true) :: TextLabel?
				
				if amount then
					amount.Text = nextConfig and STR_UTILS.GetCondensedAmount(nextConfig.Cost) or 'MAX'
				end
			end
		else
			warn(`[PlotServiceServer]: Couldn't find pivot model {pivot}`)
		end
	end
end

-- play decision outcome
function PlotServiceServer:PlayChoiceOutcome(Player: Player, Choice: CFG_TYPES.Choice, NPCs: {[number]: DAT_TYPES.NPCData}?)
	local decision = DAT_Server:get(Player, {'Decisions', 'Current', 'Name'})
	local config = DCS_CONFIGS.Decisions[decision]
	
	local choiceConfig = config.Choices[Choice]
	
	if not choiceConfig then
		warn(`[PlotServiceServer]: Couldn't find choice {Choice} in decision {decision}`)
		return
	end
	
	local outcomeConfigs = choiceConfig.Outcome
	
	if not outcomeConfigs then
		warn(`[PlotServiceServer]: Couldn't find outcome for choice {Choice} in decision {decision}`)
		return
	end
	
	local plot = PLT_CONTAINER[Player]
	
	for i, outcomeConfig in outcomeConfigs do
		local building = plot.Structures.Models:FindFirstChild(outcomeConfig.Building) :: Model?
		if not building then
			continue
		end
		
		if outcomeConfig.Music then
			
		end
		
		if outcomeConfig.Spawn then
			for spawnNo, spawnConfig in outcomeConfig.Spawn do
				local char: Model, animator: Animator
				local subject = spawnConfig.Subject
				
				if typeof(subject) == 'string' then
					char, animator = CHR_UTILS.Create(subject, spawnConfig.Gender, spawnConfig.WithoutHair)
				elseif typeof(subject) == 'number' then
					if NPCs then
						char = CHR_UTILS.ToNPC(NPCs[subject])
						animator = char:FindFirstChildWhichIsA('Animator', true) :: Animator
					end
				end
				
				local pivot = (building:FindFirstChild('Pivots') :: Folder):FindFirstChild(spawnConfig.Pivot) :: BasePart
				char:PivotTo(pivot.CFrame)
				char.Parent = plot.NPCs.Decision
				
				if spawnConfig.Animation then
					ANM_UTILS.PlayAnimation(animator, ANM_UTILS.GetAnimationFromPath(spawnConfig.Animation))
				end
				
				if spawnConfig.Prompt then
					local newPrompt = ACT_UTILS.AddPrompt(char:FindFirstChild('HumanoidRootPart') :: BasePart, spawnConfig.Prompt.ActionText)
					
					newPrompt:AddTag('DecisionPrompt')
					newPrompt:SetAttribute('Decision', decision)
					newPrompt:SetAttribute('Choice', Choice)
					newPrompt:SetAttribute('Player', Player.Name)
					newPrompt:SetAttribute('Outcome', i)
					newPrompt:SetAttribute('Spawn', i)
					
					if spawnConfig.Prompt.Gift then
						local gift = RPS.Assets.Models.Props.Gift:Clone()
						gift.Parent = plot.Temp
						gift:PivotTo(char:GetPivot() * CFrame.new(3.5, 0, 0))
						
						local objV = Instance.new('ObjectValue')
						objV.Name = 'Gift'
						objV.Value = gift
						objV.Parent = newPrompt
					end
				end
			end
		end
	end
end

-- dispense housing tax
function PlotServiceServer:DispenseHousingTax(Player: Player, HousingKey: string, DT: number)
	local data = DAT_Server:waitForData(Player)
	local housing = data:get({'Buildings', HousingKey})
	local config = BLD_CONFIGS.Buildings.Housing[housing.Level]

	if not housing or housing.Level == 0 then
		return
	end
	
	local timer = housing.Timer or config.Timer
	timer -= DT

	if timer <= 0 then
		local plot = PLT_CONTAINER[Player]
		local treasury = plot.Structures.Models:FindFirstChild('Treasury')
		local chest = treasury and treasury:FindFirstChild('Chest') :: Model?
		local textLabel = chest and chest:FindFirstChildWhichIsA('TextLabel', true)
		
		local amount = config.Population * config.Tax
		
		DAT_Server:update(Player, 'TreasuryGold', function(Old)
			local new = Old + amount
			
			if textLabel then
				textLabel.Text = STR_UTILS.GetCondensedAmount(new)
			end
			
			return new
		end)
		
		RPS.Remotes.PlotService.DispenseHousingTax:FireAllClients(Player, HousingKey, config.Tax)
		timer += config.Timer
	end

	data:update({'Buildings', HousingKey}, function(Old)
		Old.Timer = timer
		return Old
	end)
end

-- update construction timers
function PlotServiceServer:UpdateConstructionTimers(Player: Player, DT: number)
	local data = DAT_Server:waitForData(Player)
	local buildings = data:get('Buildings')
	
	for pivot, buildingData in buildings do
		if not buildingData.Upgrading then
			continue
		end
		
		buildingData.TimeRemaining -= DT
		
		if buildingData.TimeRemaining > 0 then
			continue
		end
		
		buildingData.Upgrading = false
		buildingData.Level += 1
		
		data:update({'Buildings', pivot}, function(Old)
			return buildingData
		end)
		
		local plot = PLT_CONTAINER[Player]
		local pivotModel = plot.Structures.Pivots:FindFirstChild(pivot) :: Model
		local objV = pivotModel:FindFirstChildWhichIsA('ObjectValue') :: ObjectValue
		local oldBuilding = objV.Value
		
		if oldBuilding then
			oldBuilding:Destroy()
		end
		
		local buildingName = BLD_CONFIGS.PivotsToBuildings[pivot]
		local buildingConfig = BLD_CONFIGS.Buildings[buildingName]
		local config = buildingConfig[buildingData.Level]
		local newBuilding = config.Model:Clone() :: Model
		newBuilding:PivotTo(pivotModel:GetPivot())
		newBuilding:SetAttribute('Pivot', pivot)
		newBuilding.Parent = plot.Structures.Models
		
		local primary = newBuilding.PrimaryPart
		local sound = primary and primary:FindFirstChildOfClass('Sound') :: Sound?
		
		if sound then
			sound:Play()
		end
		
		local upgrade = newBuilding:FindFirstChild('Upgrade') :: Model?
		local amount = upgrade and upgrade:FindFirstChild('Amount', true) :: TextLabel?
		
		local nextConfig = buildingConfig[buildingData.Level + 1]
		
		if amount then
			amount.Text = nextConfig and STR_UTILS.GetCondensedAmount(nextConfig.Cost) or 'MAX'
		end
		
		objV.Value = newBuilding
		
		if buildingName == 'Barracks' then
			local guards = data:get({'PersistentNPCs', 'Guards'}) :: {[number]: any}
			local now = DateTime.now().UnixTimestamp

			if #guards < config.Guards then
				for i = #guards + 1, config.Guards do
					local guard = {
						Level = 1,
						Created = now
					}

					guards[i] = guard
				end

				data:update({'PersistentNPCs', 'Guards'}, function()
					return guards
				end)
			end
			
			RPS.Remotes.NPCService.UpdateData:FireAllClients(Player, {Guards = DAT_Server:get(Player, {'PersistentNPCs', 'Guards'})})
		end
		
		RPS.Remotes.NPCService.UpdateData:FireAllClients(Player, {Buildings = DAT_Server:get(Player, 'Buildings')})
	end
end

return PlotServiceServer
