local Feedback = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local MPS = game:GetService('MarketplaceService')

local FSH_CONFIGS = require(RPS.Modules.Services.FishService.FishConfigs)

local plr = PLS.LocalPlayer :: Player
local mouse = plr:GetMouse()

local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local feedback = gui:WaitForChild('Feedback')

local tween: Tween
local initSize = feedback.Size

-- initialize feedback interface
function Feedback:Init()
	RPS.Remotes.FishService.Feedback.OnClientEvent:Connect(function(Completion)
		if MPS:UserOwnsGamePassAsync(plr.UserId, 1955911642) then
			Completion += 0.1
		end
		
		local least = -1
		local chosen: {Texts: {string}, Color: Color3, Sound: string}
		
		for threshold, data in FSH_CONFIGS.CompletionThresholds do
			if Completion >= threshold and least < threshold then
				chosen = data
				least = threshold
			end
		end
		
		if not chosen then
			return
		end
		
		local msg = chosen.Texts[math.random(1, #chosen.Texts)]
		feedback.Text = msg
		feedback.TextColor3 = chosen.Color
		feedback.Position = UDim2.fromOffset(mouse.X, mouse.Y)
		
		feedback.Size = initSize
		feedback.TextTransparency = 1
		
		if tween then
			tween:Destroy()
		end

		feedback.Visible = true
		
		tween = TWS:Create(feedback, TweenInfo.new(.35, Enum.EasingStyle.Bounce), {Size = UDim2.fromScale(initSize.X.Scale * 1.2, initSize.Y.Scale * 1.2), TextTransparency = 0})
		tween:Play()
		
		local sound = feedback:FindFirstChild(chosen.Sound) :: Sound?
		if sound then
			sound:Play()
		end
		
		tween.Completed:Wait()
		task.wait(1)
		
		feedback.Visible = false
	end)
end

return Feedback
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1162"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Mutations</string><string name="ScriptGuid">{3a01f7ab-50c3-4a67-b200-bd91a5c82aea}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Mutations = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local INT_UTILS = require(RPS.Modules.Services.InterfaceService.InterfaceUtils)

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui

local gui = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local currency = gui:WaitForChild('Currency')
local toggle = gui:WaitForChild('ToggleCurrency')

local tweens: {[Instance]: Tween} = {}
local closed = true

-- get shells number to string
local function getCurrencyString(Money: number)
	local split = tostring(math.floor(Money)):split('')
	local newText = ''
	
	for i = 1, #split do
		local char = split[i]
		
		if (#split - i) % 3 == 0 and i ~= #split then
			newText ..= char .. ' '
		else
			newText ..= char
		end
	end
	
	return newText
end

-- toggle currency
local function toggleCurrency(Toggle: boolean?)
	local new = not closed
	
	if Toggle ~= nil then
		new = Toggle
	end
	
	if new == closed then
		return
	end
	
	local oldTween = tweens[currency]
	if oldTween then
		oldTween:Destroy()
	end

	local props = not new and {Position = UDim2.new(1, -10,0.15, 10), AnchorPoint = Vector2.new(1, 0)} or {Position = UDim2.new(1, 10,0.15, 10), AnchorPoint = Vector2.new(0, 0)}

	local newTween = TWS:Create(currency, TweenInfo.new(.3, Enum.EasingStyle.Cubic), props :: {[string]: any})
	newTween:Play()

	tweens[currency] = newTween
	toggle.Icon.Rotation = closed and 0 or 180
	closed = new
end

-- update logs ui
local function updateCurrency(Mutation: string, NewMoney: number)
	local currencyFrame = currency.Inner:FindFirstChild(Mutation) :: typeof(currency.Inner.Coral)

	if not currencyFrame then
		return
	end
	
	local newText = getCurrencyString(NewMoney)
	
	if not currency.AdditionSound.IsPlaying then
		currency.AdditionSound:Play()
	end
	
	currencyFrame.Amount.Text = newText
end

-- tween currency
local function tweenCurrency(OldAmount: number, Currency: string, NewAmount: number)
	local frame = currency.Inner:FindFirstChild(Currency) :: typeof(currency.Inner.Coral)?
	
	if not frame then
		return
	end
	
	local numValue = frame.Amount.NumValue

	local oldTween = tweens[numValue]
	if oldTween then
		oldTween:Destroy()
	end


	if NewAmount < OldAmount then
		tweens[numValue] = TWS:Create(numValue, TweenInfo.new(.5, Enum.EasingStyle.Cubic), {Value = NewAmount})
		tweens[numValue]:Play()

		currency.CoinSound:Play()
	elseif NewAmount > OldAmount then
		local diff = NewAmount - OldAmount
		local addition = script.Addition
		local clone = addition:Clone()
		local additions = frame.Amount.Additions
		local children = additions:GetChildren()
		local sizeX = 1/(additions.Size.X.Scale)

		clone.Text = '+' .. getCurrencyString(diff)
		clone.Position = UDim2.fromScale(#children * sizeX, 0)
		clone.Size = UDim2.new(sizeX, 0, 1, 0)
		clone.Parent = additions

		currency.CoinSound:Play()

		task.delay(.5, function()
			local tween = TWS:Create(clone, TweenInfo.new(.5), {Position = UDim2.new(-sizeX,0,0,0), TextTransparency = 1})
			tween:Play()

			tween.Completed:Wait()
			clone:Destroy()

			local oldTween = tweens[numValue]
			if oldTween then
				oldTween:Destroy()
			end

			tweens[numValue] = TWS:Create(numValue, TweenInfo.new(.5, Enum.EasingStyle.Cubic), {Value = NewAmount})
			tweens[numValue]:Play()
		end)
		
		toggleCurrency(false)
		
		INT_UTILS.PopUpCurrency(Currency, diff)
	end
end

-- set initial currency amount
local function initCurrency(Amount: number, Frame: typeof(currency.Inner.Coral), Currency: string)
	if not Frame then
		return
	end
	
	Frame.Amount.NumValue.Value = Amount
	updateCurrency(Currency, Amount)

	Frame.Amount.NumValue.Changed:Connect(function()
		updateCurrency(Currency, Frame.Amount.NumValue.Value)
	end)
end

-- initialize shells interface
function Mutations:Init()
	local mutCurrencies = DAT_Client:get('MutationCurrencies')
	local stationCoins = DAT_Client:get('StationCoins')
	
	if typeof(mutCurrencies) == 'number' then
		mutCurrencies = {
			Coral = 0,
			Kelp = 0,
			Toxic = 0,
			Pearl = 0,
			Gold = 0
		}
	end
	
	initCurrency(stationCoins, currency.Inner.StationCoins :: any, 'StationCoins')
	for curr, amount in mutCurrencies do
		initCurrency(amount, currency.Inner:FindFirstChild(curr) :: typeof(currency.Inner.Coral), curr)
	end
	
	DAT_Client:getChangedSignal( 'MutationCurrencies'):Connect(function(NewCurrencies: {[string]: number}, OldCurrencies: {[string]: number})
		if typeof(NewCurrencies) == 'number' then
			return
		end
		
		for curr, amount in NewCurrencies do
			tweenCurrency(OldCurrencies[curr], curr, NewCurrencies[curr])
		end
	end)
	
	DAT_Client:getChangedSignal('StationCoins'):Connect(function(NewAmount, OldAmount)
		tweenCurrency(OldAmount, 'StationCoins', NewAmount)
	end)
	
	--[[currency.Inner.Buy.MouseEnter:Connect(function()
		if buyTxtrTween then
			buyTxtrTween:Destroy()
		end
		if buyBtnTween then
			buyBtnTween:Destroy()
		end
		
		buyTxtrTween = TWS:Create(currency.Inner.Buy.Texture, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {ImageColor3 = Color3.fromRGB(255,255,255)})
		buyBtnTween = TWS:Create(currency.Inner.Buy, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {Size = UDim2.fromScale(.7,.7)})
		
		buyTxtrTween:Play()
		buyBtnTween:Play()
	end)

	currency.Inner.Buy.MouseLeave:Connect(function()
		if buyTxtrTween then
			buyTxtrTween:Destroy()
		end
		if buyBtnTween then
			buyBtnTween:Destroy()
		end

		buyTxtrTween = TWS:Create(currency.Inner.Buy.Texture, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {ImageColor3 = Color3.fromRGB(190,190,190)})
		buyBtnTween = TWS:Create(currency.Inner.Buy, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {Size = UDim2.fromScale(.5,.5)})

		buyTxtrTween:Play()
		buyBtnTween:Play()
	end)]]

	toggle.MouseButton1Click:Connect(toggleCurrency :: any)
end

return Mutations
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="TextLabel" referent="RBX1163"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2><BinaryString name="AttributesSerialize"></BinaryString><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">0</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><float name="LineHeight">1</float><string name="LocalizationMatchIdentifier"></string><string name="LocalizationMatchedSourceText"></string><int name="MaxVisibleGraphemes">-1</int><string name="Name">Addition</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><string name="OpenTypeFeatures"></string><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><bool name="RichText">false</bool><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0</float><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><string name="SerializedOverrides"></string><token name="Sink">0</token><UDim2 name="Size"><XS>0.5</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><token name="