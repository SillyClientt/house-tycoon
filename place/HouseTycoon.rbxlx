end

return PlotServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1313"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">BuildService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1314"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">BuildServiceClient</string><string name="ScriptGuid">{386997dc-c50c-4c24-a400-900443419e11}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local BuildServiceClient = {}

local PLS = game:GetService('Players')
local WKS = game:GetService('Workspace')
local RPS = game:GetService('ReplicatedStorage')
local UIS = game:GetService('UserInputService')
local CAS = game:GetService('ContextActionService')
local RNS = game:GetService('RunService')

local BLD_CSignals = require(script.Parent.BuildClientSignals)
local BLD_UTILS = require(RPS.Modules.Utils.BuildUtils)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)

local plr = PLS.LocalPlayer
local mouse = plr:GetMouse()
local camera = WKS.CurrentCamera

local pivot: Vector3?
local drag: Vector3?
local wall: Part?

-- initialize build service client-side
function BuildServiceClient:Init()
	BLD_CSignals.BuildActivated:Connect(function()
		BuildServiceClient:StartTrackingWallBuild()
	end)
end

-- start tracking wall build
function BuildServiceClient:StartTrackingWallBuild()
	pivot = nil
	
	CAS:BindAction('Wall Build', function(Action: string, State: Enum.UserInputState, Input: InputObject)
		if State == Enum.UserInputState.Begin and Input.UserInputType == Enum.UserInputType.MouseButton1 then
			if wall then
				RNS:UnbindFromRenderStep('Wall Building')
			else
				wall = BLD_CONFIGS.Walls.Brick.Placeholder:Clone()
				wall.Anchored = true
				
				pivot = BLD_UTILS.BindToGrid(mouse.Hit.Position, 1)
				drag = pivot
				
				RNS:BindToRenderStep('Wall Building', Enum.RenderPriority.Input.Value + 1, function()
					drag = BLD_UTILS.BindToGrid(mouse.Hit.Position, 1)
					
					local pos = (drag + pivot :: Vector3)/2
					local lookAt = pos + (drag - pivot :: Vector3).Unit
					
					wall.CFrame = CFrame.new(pos, lookAt)
					wall.Size = Vector3.new(1, 9, (drag - pivot :: Vector3).Magnitude)
				end)
			end
		end
	end, false, Enum.UserInputType.MouseButton1)
end

function BuildServiceClient:Click()
	local start = camera.CFrame.Position
	local endPoint = mouse.Hit.Position
	
	local result = WKS:Raycast(start, (endPoint - start)*1.5)
	if result then
		print('fired')
		RPS.Remotes.BuildService.RegisterPoint:FireServer('Wall', result.Position)
	end
end

return BuildServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1315"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">BuildClientSignals</string><string name="ScriptGuid">{111e1cb7-3c12-49f7-b6b1-c085d997a387}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)

local BuildClientSignals = {
	BuildActivated = Signal() :: Signal.Signal<>
}

return BuildClientSignals
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1316"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">FurnitureService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1317"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">FurnitureServiceClient</string><string name="ScriptGuid">{7e782505-134a-4138-8fcb-37c5243ed297}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local FurnitureServiceClient = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')
local UIS = game:GetService('UserInputService')
local RNS = game:GetService('RunService')

local FUR_UTILS = require(RPS.Modules.Utils.FurnitureUtils)

local plr = PLS.LocalPlayer
local mouse = plr:GetMouse()

local templates = RPS:WaitForChild('Furniture')
local remotes = RPS.Remotes.FurnitureService

local preview: Model?
local selected: Model?
local position: Vector3?
local selection: Highlight?

-- clear selection
local function clearSelection()
	selected = nil

	if selection then
		selection:Destroy()
		selection = nil
	end
end

-- stop placing
function FurnitureServiceClient:StopPlacement()
	if preview then
		preview:Destroy()
		preview = nil
	end

	position = nil
end

-- update preview
function FurnitureServiceClient:UpdatePreview()
	local model = preview
	local camera = WKS.CurrentCamera

	position = nil

	if not model or not camera then
		return
	end

	local excluded: {Instance} = {model}

	if plr.Character then
		table.insert(excluded, plr.Character)
	end

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = excluded

	local ray = camera:ScreenPointToRay(mouse.X, mouse.Y)
	local result = WKS:Raycast(
		ray.Origin,
		ray.Direction * 1000,
		params
	)

	if result then
		position = result.Position
		FUR_UTILS.PlaceFurniture(model, result.Position, 0)
	end
end

-- start placing
function FurnitureServiceClient:StartPlacement()
	FurnitureServiceClient:StopPlacement()
	clearSelection()

	local template = templates:FindFirstChild('Chair')

	if not template or not template:IsA('Model') then
		warn('Put a Chair model inside ReplicatedStorage.Furniture')
		return
	end

	local model = template:Clone()

	for _, child in model:GetDescendants() do
		if child:IsA('BasePart') then
			child.Anchored = true
			child.CanCollide = false
			child.CanTouch = false
			child.CanQuery = false
			child.Transparency = math.max(child.Transparency, 0.5)
		end

		if child:IsA('Seat') or child:IsA('VehicleSeat') then
			child.Disabled = true
		end
	end

	preview = model
	model.Parent = WKS

	FurnitureServiceClient:UpdatePreview()
end

-- select furniture
function FurnitureServiceClient:SelectFurniture()
	clearSelection()

	local folder = WKS:FindFirstChild(`Furniture_{plr.UserId}`)
	local target: Instance? = mouse.Target

	if not folder then
		return
	end

	while target and target ~= WKS do
		if target:IsA('Model') and target.Parent == folder then
			selected = target

			local highlight = Instance.new('Highlight')
			highlight.FillTransparency = 1
			highlight.Adornee = target
			highlight.Parent = target

			selection = highlight
			return
		end

		target = target.Parent
	end
end

-- initialize furniture service client-side
function FurnitureServiceClient:Init()
	RNS.RenderStepped:Connect(function()
		if preview then
			FurnitureServiceClient:UpdatePreview()
		end
	end)

	UIS.InputBegan:Connect(function(Input, Processed)
		if Processed then
			return
		end

		if Input.KeyCode == Enum.KeyCode.B then
			FurnitureServiceClient:StartPlacement()

		elseif Input.KeyCode == Enum.KeyCode.Q then
			FurnitureServiceClient:StopPlacement()
			clearSelection()

		elseif Input.KeyCode == Enum.KeyCode.R then
			if selected then
				remotes.RotateFurniture:FireServer(selected.Name)
			end

		elseif Input.UserInputType == Enum.UserInputType.MouseButton1 then
			if preview then
				FurnitureServiceClient:UpdatePreview()

				if position then
					remotes.PlaceFurniture:FireServer('Chair', position)
					FurnitureServiceClient:StopPlacement()
				end
			else
				FurnitureServiceClient:SelectFurniture()
			end
		end
	end)

	plr.CharacterRemoving:Connect(function()
		FurnitureServiceClient:StopPlacement()
		clearSelection()
	end)
end

return FurnitureServiceClient]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="ModuleScript" referent="RBX1134"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Interface</string><string name="ScriptGuid">{cdf4e8a2-7c46-4dfb-808b-beec2b3bb1d2}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Interface = {}

-- initialize interface
function Interface:Init()
	for _, child in script:GetChildren() do
		if child:IsA('ModuleScript') then
			task.spawn(function()
				(require(child) :: {Init: (self: any) -> ()}):Init()
			end)
		end
	end
end

return Interface
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1135"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Shells</string><string name="ScriptGuid">{1463943b-6b94-4cff-ab0d-05d7ce7bd064}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Shells = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local INT_UTILS = require(RPS.Modules.Services.InterfaceService.InterfaceUtils)

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui

local gui = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local currency = gui:WaitForChild('Shells')

local buyTxtrTween: Tween
local buyBtnTween: Tween
local shellsNumTween: Tween

-- get shells number to string
local function getShellsString(Money: number)
	local split = tostring(math.floor(Money)):split('')
	local newText = ''
	
	for i = 1, #split do
		local char = split[i]
		
		if (#split - i) % 3 == 0 and i ~= #split then
			newText ..= char .. ' '
		else
			newText ..= char
		end
	end
	
	return newText
end

-- update logs ui
local function updateShells(NewMoney: number)
	local newText = getShellsString(NewMoney)
	
	if not currency.AdditionSound.IsPlaying then
		currency.AdditionSound:Play()
	end
	
	currency.Inner.Shells.Amount.Text = newText
end

-- initialize shells interface
function Shells:Init()
	local shells = DAT_Client:get('Shells')
	local shellsRush = DAT_Client:get('ShellsRush')
	
	local shellsFrame = currency.Inner.Shells

	shellsFrame.Amount.NumValue.Value = shells or 0
	currency.ShellsRush.Visible = shellsRush.Active
	updateShells(shells)
	
	DAT_Client:getChangedSignal('Shells'):Connect(function(NewMoney: number, OldMoney: number)
		if shellsNumTween then
			shellsNumTween:Destroy()
		end
		
		if NewMoney < OldMoney then
			shellsNumTween = TWS:Create(shellsFrame.Amount.NumValue, TweenInfo.new(.5, Enum.EasingStyle.Cubic), {Value = NewMoney})
			shellsNumTween:Play()
			
			currency.CoinSound:Play()
		elseif NewMoney > OldMoney then
			local diff = NewMoney - OldMoney
			local addition = script.Addition
			local clone = addition:Clone()
			local additions = shellsFrame.Amount.Additions
			local children = additions:GetChildren()
			local sizeY = 1/(additions.Size.Y.Scale)
			
			clone.Text = '+' .. getShellsString(diff)
			clone.Position = UDim2.new(0, 0, 0.06 + #children * sizeY, 0)
			clone.Size = UDim2.new(1, 0, sizeY, 0)
			clone.Parent = additions
			
			currency.CoinSound:Play()
			
			task.delay(.5, function()
				local tween = TWS:Create(clone, TweenInfo.new(.5), {Position = UDim2.new(0,0,0,0), TextTransparency = 1})
				tween:Play()
				
				tween.Completed:Wait()
				clone:Destroy()

				if shellsNumTween then
					shellsNumTween:Destroy()
				end

				shellsNumTween = TWS:Create(shellsFrame.Amount.NumValue, TweenInfo.new(.5, Enum.EasingStyle.Cubic), {Value = NewMoney})
				shellsNumTween:Play()
			end)
			
			INT_UTILS.PopUpCurrency('Shells', diff)
		end
	end)
	
	--[[currency.Inner.Buy.MouseEnter:Connect(function()
		if buyTxtrTween then
			buyTxtrTween:Destroy()
		end
		if buyBtnTween then
			buyBtnTween:Destroy()
		end
		
		buyTxtrTween = TWS:Create(currency.Inner.Buy.Texture, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {ImageColor3 = Color3.fromRGB(255,255,255)})
		buyBtnTween = TWS:Create(currency.Inner.Buy, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {Size = UDim2.fromScale(.7,.7)})
		
		buyTxtrTween:Play()
		buyBtnTween:Play()
	end)

	currency.Inner.Buy.MouseLeave:Connect(function()
		if buyTxtrTween then
			buyTxtrTween:Destroy()
		end
		if buyBtnTween then
			buyBtnTween:Destroy()
		end

		buyTxtrTween = TWS:Create(currency.Inner.Buy.Texture, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {ImageColor3 = Color3.fromRGB(190,190,190)})
		buyBtnTween = TWS:Create(currency.Inner.Buy, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {Size = UDim2.fromScale(.5,.5)})

		buyTxtrTween:Play()
		buyBtnTween:Play()
	end)]]
	
	currency.Inner.Shells.Amount.NumValue.Changed:Connect(updateShells)
	
	RPS.Remotes.RewardService.ActivatedShellRush.OnClientEvent:Connect(function()
		currency.ShellsRush.Visible = true
	end)
	RPS.Remotes.RewardService.StoppedShellRush.OnClientEvent:Connect(function()
		currency.ShellsRush.Visible = false
	end)
end

return Shells
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="TextLabel" referent="RBX1136"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2><BinaryString name="AttributesSerialize"></BinaryString><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">0</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><float name="LineHeight">1</float><string name="LocalizationMatchIdentifier"></string><string name="LocalizationMatchedSourceText"></string><int name="MaxVisibleGraphemes">-1</int><string name="Name">Addition</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><string name="OpenTypeFeatures"></string><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0.0599999987</YS><YO>0</YO></UDim2><bool name="RichText">false</bool><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0</float><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><string name="SerializedOverrides"></string><token name="Sink">0</token><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.0430000015</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">-1</int64><string name="Text">0</string><Color3 name="TextColor3"><R>1</R><G>1</G><B>1</B></Color3><token name="TextDirection">0</token><bool name="TextScaled">true</bool><float name="TextSize">14</float><Color3 name="TextStrokeColor3"><R>0</R><G>0</G><B>0</B></Color3><float name="TextStrokeTransparency">1</float><float name="TextTransparency">0</float><token name="TextTruncate">0</token><bool name="TextWrapped">true</bool><token name="TextXAlignment">0</token><token name="TextYAlignment">1</token><bool name="Visible">true</bool><int name="ZIndex">2</int></Properties><Item class="Frame" referent="RBX1138"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0</Y></Vector2><BinaryString name="AttributesSerialize"></BinaryString><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">0</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><string name="Name">Additions</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><UDim2 name="Position"><XS>0.5</XS><XO>0</XO><YS>0</YS><YO>0</YO></UDim2><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0</float><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><string name="SerializedOverrides"></string><token name="Sink">0</token><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>6</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">-1</int64><token name="Style">0</token><bool name="Visible">true</bool><int name="ZIndex">1</int></Properties></Item><Item class="NumberValue" referent="RBX1137"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="Name">NumValue</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64><double name="Value">0</double></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBX1139"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Inventory</string><string name="ScriptGuid">{5e71046f-00fe-43e9-951b-256d250a9826}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Inventory = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local UIS = game:GetService('UserInputService')

--local INV_CONFIGS = require(RPS.Modules.Services.InventoryService.InventoryConfigs)
local DAT_Client = require(RPS.Modules.Packages.DataService).client
local TOL_CONFIGS = require(RPS.Modules.Services.ToolService.ToolConfigs)
local IMG_CONFIGS = require(RPS.Modules.Services.ImageService.ImageConfigs)
local STR_CONFIGS = require(RPS.Modules.Services.StoreService.StoreConfigs)
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui

local gui = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local inventory = gui:WaitForChild('Inventory')
local backpackFrame = gui:WaitForChild('Backpack')

type SlotButton = typeof(inventory.Content.Items.Inner['1'])

local itemsTween: Tween
local closed = not inventory.Content.Items.Visible
local selectedSlot: SlotButton?
local equippedSlot: SlotButton?

local itemsAdded = 0

local slots: {[SlotButton]: Tool?} = {}

-- add item added ui display
local function addItem(Item: string, AmountAdded: number)
	local itemAdded = script.ItemAdded
	
	local children = inventory.Additions:GetChildren()
	local scaleY = inventory.Additions.Size.Y.Scale
	
	
	local clone = itemAdded:Clone()
	clone.Description.Text = `+{AmountAdded} {Item}` .. (AmountAdded > 1 and 's' or '')
	clone.Position = UDim2.fromScale(0, 1 - (itemsAdded * (1/scaleY)))
	clone.Parent = inventory.Additions

	inventory.ItemSound:Play()

	itemsAdded += 1
	local added = itemsAdded
	
	task.delay(3, function()
		local tween = TWS:Create(clone, TweenInfo.new(.5, Enum.EasingStyle.Cubic), {Position = UDim2.fromScale(0,1.05), GroupTransparency = 1})
		tween:Play()
		
		tween.Completed:Wait()
		clone:Destroy()
		
		if itemsAdded == added then
			itemsAdded = 0
		end
	end)
end

-- toggle item slot
local function toggleSlot(Slot: SlotButton, Toggle: boolean)
	local tool = slots[Slot]

	if tool then
		if Toggle then
			if equippedSlot then
				local equippedTool = slots[equippedSlot]

				if equippedTool then
					equippedTool.Parent = plr.Backpack
				end
				
				equippedSlot.Item.UIStroke.Enabled = false
				equippedSlot.Scrap.Visible = false
			end

			tool.Parent = plr.Character
			equippedSlot = Slot
			Slot.Item.UIStroke.Enabled = true
			
			Slot.Scrap.Visible = true
		else
			tool.Parent = plr.Backpack
			equippedSlot = nil
			Slot.Item.UIStroke.Enabled = false
			Slot.Scrap.Visible = false
		end
	end
end

-- select item slot
local function selectSlot(Slot: SlotButton?)
	if selectedSlot and Slot ~= selectedSlot then
		selectedSlot.Plus.TextTransparency = 0.8
		selectedSlot.Plus.Size = UDim2.fromScale(.8, .8)
	end
	
	if Slot then
		if Slot == selectedSlot then
			Slot.Plus.TextTransparency = 0.3
			Slot.Plus.Size = UDim2.fromScale(.8, .8)
			selectedSlot = nil
			
			backpackFrame.Visible = false
		else
			Slot.Plus.TextTransparency = 0
			Slot.Plus.Size = UDim2.fromScale(1.1, 1.1)
			selectedSlot = Slot
			
			if Slot.Plus.Visible then
				backpackFrame.Visible = true
			end
		end
		
		toggleSlot(Slot, equippedSlot ~= Slot)
	else
		selectedSlot = nil
	end
end

-- toggle items list
local function toggleItems()
	if itemsTween then
		itemsTween:Destroy()
	end

	if closed then
		closed = false
		inventory.Content.Items.Size = UDim2.fromScale(0, 0)
		inventory.Content.Items.Visible = true

		itemsTween = TWS:Create(inventory.Content.Items, TweenInfo.new(.3, Enum.EasingStyle.Cubic), {Size = UDim2.fromScale(.7,1)})

		if not inventory.InventoryOpen.IsPlaying then
			inventory.InventoryOpen:Play()
		end
	else
		closed = true
		itemsTween = TWS:Create(inventory.Content.Items, TweenInfo.new(.3, Enum.EasingStyle.Cubic), {Size = UDim2.fromScale(0,0)})

		itemsTween.Completed:Once(function()
			inventory.Content.Items.Visible = false
		end)

		selectSlot()
		
		if not inventory.InventoryClose.IsPlaying then
			inventory.InventoryClose:Play()
		end
	end

	itemsTween:Play()
end

-- add to slots
local function addToSlots(Tool: Tool)
	for _, tool in slots do
		if tool == Tool then
			return
		end
	end
	
	local empty: SlotButton? = selectedSlot and not slots[selectedSlot] and selectedSlot or nil
	
	if not empty then
		for i = 1,5 do
			local button = inventory.Content.Items.Inner:FindFirstChild(tostring(i)) :: SlotButton
			local tool = slots[button]

			if not tool and not empty then
				empty = button
				break
			end
		end
	end
	
	local char = plr.Character
	local backpack = plr.Backpack
	local config-- = INV_CONFIGS[Tool.Name]
	
	if not empty then
		return
	end
	
	slots[empty] = Tool
	empty.Item.Visible = true
	empty.Plus.Visible = false
	empty:SetAttribute('Item', Tool.Name)

	local existing = empty.Item:FindFirstChildOfClass('Tool')

	if existing then
		existing:Destroy()
	end
	
	local image = IMG_CONFIGS[Tool.Name] or TOL_CONFIGS.Gizmo[Tool.Name] and TOL_CONFIGS.Gizmo[Tool.Name].Image or  STR_CONFIGS.Skins[Tool.Name] and STR_CONFIGS.Skins[Tool.Name].Image
	
	if image then
		empty.Item.Icon.Image = image
		empty.Item.Icon.Visible = true
	else
		local clone = Tool:Clone()
		clone.Parent = empty.Item
		clone:PivotTo(Tool:GetAttribute('ViewCF') or CFrame.new(0,0,-2.5))
	end
	
	local ancConn: RBXScriptConnection
	local desConn: RBXScriptConnection
	local amountConn

	local inventoryData = DAT_Client:get('Inventory')
	local data = inventoryData[Tool.Name]

	if data and data.Amount > 1 then
		--empty.Item.Stack.Visible = true
		empty.Item.Stack.Text = 'x'..data.Amount
		
		amountConn = DAT_Client:getChangedSignal('Inventory'):Connect(function(NewInventoryData)
			local gadgetData = NewInventoryData[Tool.Name]
			
			if not gadgetData then
				if amountConn then
					amountConn:Disconnect()
				end
				
				return
			end
			
			if gadgetData.Amount <= 1 then
				empty.Item.Stack.Visible = false

				if amountConn then
					amountConn:Disconnect()
				end
			end
			
			empty.Item.Stack.Visible = 'x'..gadgetData.Amount
		end)
	end
	
	local function disconnect()
		ancConn:Disconnect()
		desConn:Disconnect()

		if amountConn then
			amountConn:Disconnect()
		end

		local filled: SlotButton?

		for slotB, tool in slots do
			if tool == Tool then
				filled = slotB
				break
			end
		end

		if filled then
			slots[filled] = nil
			filled:SetAttribute('Item', nil)

			filled.Item.Visible = false
			filled.Item.UIStroke.Enabled = false
			filled.Plus.Visible = true
			filled.Scrap.Visible = false
		end

		if selectedSlot and not slots[selectedSlot] then
			selectSlot()
		end
		
		if equippedSlot == filled then
			equippedSlot = nil
		end
	end

	ancConn = Tool.AncestryChanged:Connect(function(_, Parent)
		if Parent == plr.Character or Parent == plr:FindFirstChildOfClass('Backpack') then
			return
		end
		
		disconnect()
	end)

	desConn = Tool.Destroying:Once(disconnect)
end

-- initialize inventory interface
function Inventory:Init()
	local onboardingTutorial = DAT_Client:get('OnboardingTutorial')
	if onboardingTutorial.Finished or onboardingTutorial.Step >= 2 then
		inventory.Visible = true
	end

	DAT_Client:getChangedSignal('OnboardingTutorial'):Connect(function(NewData)
		if NewData.Finished or NewData.Step >= 2 then
			inventory.Visible = true
		end
	end)
	
	inventory.Content.Actions.Inner.Satchel.Activated:Connect(function()
		toggleItems()
	end)
	
	for _, child in inventory.Content.Actions.Inner:GetChildren() do
		if child:IsA('TextButton') then
			local button = child :: typeof(inventory.Content.Actions.Inner.Satchel)
			
			local sizeTween: Tween
			local txtrTween: Tween
			
			button.MouseEnter:Connect(function()
				if sizeTween then
					sizeTween:Destroy()
				end
				
				if txtrTween then
					txtrTween:Destroy()
				end
				
				sizeTween = TWS:Create(button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {Size = UDim2.fromScale(.9,.9)})
				txtrTween = TWS:Create(button.Texture, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {ImageColor3 = Color3.fromRGB(255,255,255)})
				
				sizeTween:Play()
				txtrTween:Play()
			end)

			button.MouseLeave:Connect(function()
				if sizeTween then
					sizeTween:Destroy()
				end

				if txtrTween then
					txtrTween:Destroy()
				end

				sizeTween = TWS:Create(button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {Size = UDim2.fromScale(.8,.8)})
				txtrTween = TWS:Create(button.Texture, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {ImageColor3 = Color3.fromRGB(180,180,180)})

				sizeTween:Play()
				txtrTween:Play()
			end)
		end
	end
	
	for _, slotB: Instance in inventory.Content.Items.Inner:GetChildren() do
		if slotB:IsA('ImageButton') then
			local button = slotB :: SlotButton
			
			button.Activated:Connect(function()
				selectSlot(button)
			end)
			
			button.MouseEnter:Connect(function()
				if selectedSlot ~= button then
					button.Plus.TextTransparency = 0.3
				end
			end)
			
			button.MouseLeave:Connect(function()
				if selectedSlot ~= button then
					button.Plus.TextTransparency = 0.8
				end
			end)
			
			button.Scrap.Activated:Connect(function()
				local tool = slots[button]
				
				if tool and TOL_CONFIGS.Gizmo[tool.Name] then
					RPS.Remotes.ToolService.RemoveGadget:FireServer(tool.Name)
				end
			end)
		end
	end
	
	plr.CharacterAdded:Connect(function()
		for _, slotB in inventory.Content.Items.Inner:GetChildren() do
			if slotB:IsA('ImageButton') then
				local button = slotB :: SlotButton
				
				slots[button] = nil
				button:SetAttribute('Item', nil)
				button.Item.Visible = false
			end
		end
		
		equippedSlot = nil
	end)
	
	local char = plr.Character or plr.CharacterAdded:Wait()
	
	plr.Backpack.ChildAdded:Connect(function(Child)
		if not Child:IsA('Tool') then
			return
		end
		
		addToSlots(Child)
	end)

	plr.CharacterAdded:Connect(function()
		local backpack = plr.Backpack
		backpack.ChildAdded:Connect(function(Child)
			if not Child:IsA('Tool') then
				return
			end

			addToSlots(Child)
		end)

		for _, child in backpack:GetChildren() do
			if not child:IsA('Tool') then
				continue
			end

			addToSlots(child)
		end
	end)
	
	for _, child in plr.Backpack:GetChildren() do
		if not child:IsA('Tool') then
			continue
		end
		
		addToSlots(child)
	end
	
	UIS.InputBegan:Connect(function(Input, Processed)
		if Processed then
			return
		end
		
		if Input.KeyCode == Enum.KeyCode.One then
			local slot = inventory.Content.Items.Inner['1'] :: ImageButton
			toggleSlot(slot :: SlotButton, equippedSlot ~= slot)
		elseif Input.KeyCode == Enum.KeyCode.Two then
			local slot = inventory.Content.Items.Inner['2'] :: ImageButton
			toggleSlot(slot :: SlotButton, equippedSlot ~= slot)
		elseif Input.KeyCode == Enum.KeyCode.Three then
			local slot = inventory.Content.Items.Inner['3'] :: ImageButton
			toggleSlot(slot :: SlotButton, equippedSlot ~= slot)
		elseif Input.KeyCode == Enum.KeyCode.Four then
			local slot = inventory.Content.Items.Inner['4'] :: ImageButton
			toggleSlot(slot :: SlotButton, equippedSlot ~= slot)
		elseif Input.KeyCode == Enum.KeyCode.Five then
			local slot = inventory.Content.Items.Inner['5'] :: ImageButton
			toggleSlot(slot :: SlotButton, equippedSlot ~= slot)
		end
	end)
	
	for _, itemSlot in backpackFrame.Items:GetChildren() do
		if not itemSlot:IsA('Frame') then
			continue
		end
		
		local button = itemSlot:FindFirstChild('Button') :: TextButton
		
		button.Activated:Connect(function()
			local item = itemSlot:GetAttribute('Item')
			
			local filled: SlotButton?
			local filledTool: Tool?
			for slotB, tool in slots do
				if tool and tool.Name == item then
					filled = slotB
					filledTool = tool
					break
				end
			end
			
			if filled == selectedSlot then
				return
			end
			
			if selectedSlot == nil then 
				return
			end
			
			local slotTool = slots[selectedSlot]
			
			if filled then
				if filled and filledTool then
					if filledTool.Name:match('Sponge') or filledTool.Name:match('Scraper') then
						return
					end
				end
				
				filled.Item.Visible = slotTool and true or false
				filled.Item.Icon.Visible = true
				filled.Plus.Visible = not slotTool
				filled:SetAttribute('Item', slotTool and slotTool.Name)

				selectedSlot.Item.Visible = true
				selectedSlot.Item.Icon.Visible = true
				selectedSlot.Plus.Visible = false
				selectedSlot:SetAttribute('Item', item)
				
				selectedSlot.Item.Icon.Image = TOL_CONFIGS.Gizmo[item].Image
				
				if slotTool then
					filled.Item.Icon.Image = TOL_CONFIGS.Gizmo[slotTool.Name].Image
				end
				
				slots[selectedSlot] = slots[filled]
				slots[filled] = slotTool
				
				return
			end

			if slotTool and TOL_CONFIGS.Gizmo[slotTool.Name] and slotTool.Name ~= item then			
				slots[selectedSlot] = nil
				selectedSlot.Item.Visible = false
				selectedSlot.Plus.Visible = true
				selectedSlot:SetAttribute('Item', nil)
				
				RPS.Remotes.ToolService.RemoveGadget:FireServer(slotTool.Name)
			end
			
			if item then
				RPS.Remotes.ToolService.MoveGadget:FireServer(item)
			end
		end)
	end
	
	backpackFrame:GetPropertyChangedSignal('Visible'):Connect(function()
		if not backpackFrame.Visible then
			selectSlot()
		end
	end)
end


return Inventory
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="CanvasGroup" referent="RBX1140"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0</X><Y>1</Y></Vector2><BinaryString name="AttributesSerialize"></BinaryString><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">0</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">0</int><bool name="ClipsDescendants">true</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><Color3 name="GroupColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="GroupTransparency">0</float><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><string name="Name">ItemAdded</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>1.04999995</YS><YO>0</YO></UDim2><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0</float><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><string name="SerializedOverrides"></string><token name="Sink">0</token><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>1</YS><YO>0</YO></UDim2><token name="SizeConstraint">0</token><int64 name="SourceAssetId">-1</int64><bool name="Visible">true</bool><int name="ZIndex">1</int></Properties><Item class="TextLabel" referent="RBX1141"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0.5</X><Y>0.5</Y></Vector2><BinaryS