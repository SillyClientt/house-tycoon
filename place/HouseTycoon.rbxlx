	Animations: {
		Idle: Animation,
		Run: Animation,
		Attack: Animation
	}
}

return nil
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item></Item><Item class="Folder" referent="RBX1405"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">Modules (server)</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Folder" referent="RBX1406"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">Services</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Folder" referent="RBX1407"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">PlayerService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1408"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">PlayerServiceServer</string><string name="ScriptGuid">{472ff010-cada-4869-b640-8a659260b4c9}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local PlayerServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local PPS = game:GetService('ProximityPromptService')
local RNS = game:GetService('RunService')
local WKS = game:GetService('Workspace')
local HTP = game:GetService('HttpService')
local ANS = game:GetService('AnalyticsService')

local DRS_UTILS = require(RPS.Modules.Utils.DressUtils)
local CLN_UTILS = require(RPS.Modules.Utils.CollisionUtils)
local DAT_Server = require(RPS.Modules.Packages.DataService).server

local now = DateTime.now().UnixTimestampMillis/1000

local testOwned = true

local playtimeStepNames = {
	[1] = 'Joined',
	[2] = 'Played 1 minute',
	[3] = 'Played 3 minutes',
	[4] = 'Played 5 minutes',
	[5] = 'Played 10 minutes',
	[6] = 'Played 15 minutes',
	[7] = 'Played 20 minutes',
	[8] = 'Played 30 minutes'
}

local testData = require(script.TestData)
local initialData = require(script.DefaultData)

local sessionIds: {[Player]: string} = {}
local stepReached: {[Player]: number} = {}
local stepThresholds = {
	[1] = 0,
	[2] = 60,
	[3] = 180,
	[4] = 300,
	[5] = 600,
	[6] = 900,
	[7] = 1200,
	[8] = 1800
}

-- initialize player service server-side
function PlayerServiceServer:Init()
	DAT_Server:init({
		template = WKS:GetAttribute('Testing') and RNS:IsStudio() and testData or initialData,
		
		profileStoreIndex = 'Public v0',
		resetData = RNS:IsStudio() and WKS:GetAttribute('ResetData') or nil,
		useMock = RNS:IsStudio() and WKS:GetAttribute('Testing') or nil
		--overridenUserId = 11244616138
	})

	PLS.PlayerAdded:Connect(function(Player)
		sessionIds[Player] = HTP:GenerateGUID(false)
		stepReached[Player] = 1
		
		ANS:LogFunnelStepEvent(Player, 'Playtime', sessionIds[Player], 1, playtimeStepNames[1])
		
		local data = DAT_Server:waitForData(Player)
		
		local char = Player.Character
		
		if char then
			if DAT_Server:get(Player, 'Onboarding') ~= 'Coronation' then
				DRS_UTILS.WearCrown(char, 'Normal')
			end
			
			CLN_UTILS.SetCollisionGroup(char, 'Player')
		end
		
		Player.CharacterAdded:Connect(function(Character)
			if DAT_Server:get(Player, 'Onboarding') ~= 'Coronation' then
				DRS_UTILS.WearCrown(Character, 'Normal')
			end
			
			CLN_UTILS.SetCollisionGroup(Character, 'Player')
		end)
	end)
	
	PLS.PlayerRemoving:Connect(function(Player)
		sessionIds[Player] = nil
		stepReached[Player] = nil
	end)
	
	--[[task.spawn(function()
		while true do
			local waited = task.wait(1)
			
			for _, plr in PLS:GetPlayers() do
				local data = DAT_Server:waitForData(plr)
				local newTime = data:get('TotalTimePlayed') + waited
				
				data:update('TotalTimePlayed', function(Old)
					return Old + waited
				end)
								
				local sessionId = sessionIds[plr]
				
				if not sessionId then
					continue
				end
				
				local reached = stepReached[plr]
				local newStep: number?
				
				for step, threshold in stepThresholds do
					if reached >= step then
						continue
					end
					
					if newTime >= threshold and step > reached then
						newStep = step
					end
				end
				
				if not newStep then
					continue
				end
				
				stepReached[plr] = newStep
				
				ANS:LogFunnelStepEvent(plr, 'Playtime', sessionId, newStep, playtimeStepNames[newStep])
			end
		end
	end)]]
end

return PlayerServiceServer
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1409"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">DefaultData</string><string name="ScriptGuid">{6f13fcdb-1799-486c-9709-d8db454513ca}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
