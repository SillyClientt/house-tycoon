local ChanceUtils = {}

local random = Random.new()

-- pick a key from the pool table
function ChanceUtils.PickKeyFromPool(Pool: {[any]: number}): any
	local weightedTable = {} :: {[any]: {Min: number, Max: number}}
	local totWeight = 0
	for key, weight in pairs(Pool) do
		weightedTable[key] = {
			Min = totWeight,
			Max = 0
		}
		
		totWeight += weight
		weightedTable[key].Max = totWeight
	end

	local rng = random:NextNumber(0, totWeight)
	local chosenKey: string
	for key, minMax in pairs(weightedTable) do
		if rng >= minMax.Min and rng < minMax.Max then
			chosenKey = key
			break
		end
	end

	return chosenKey
end

-- pick a key from the weighted pool table
function ChanceUtils.PickKeyFromPoolWithWeights(Pool: {[any]: {Weight: number, [string]: any}}): any
	local weightedTable = {} :: {[any]: {Min: number, Max: number}}
	local totWeight = 0
	for key, data in pairs(Pool) do
		weightedTable[key] = {
			Min = totWeight,
			Max = 0
		}
		
		totWeight += data.Weight
		weightedTable[key].Max = totWeight
	end

	local rng = random:NextNumber(0, totWeight)
	local chosenKey: string
	for key, minMax in pairs(weightedTable) do
		if rng >= minMax.Min and rng < minMax.Max then
			chosenKey = key
			break
		end
	end

	return chosenKey
end

return ChanceUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1375"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">StringUtils</string><string name="ScriptGuid">{b2c60aaf-e659-4c58-b7d4-0b815ee48855}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local StringUtils = {}

local condensedCutoffs: {[string]: number} = {
	K = 1e3,
	M = 1e6,
	B = 1e9,
	T = 1e12,
	Qa = 1e15,
	Qi = 1e18,
	Sx = 1e21,
	Sp = 1e24,
	Oc = 1e27,
	N = 1e30,
}

-- change amount to condensed amount using suffix and 1 decimal after
function StringUtils.GetCondensedAmount(Amount: number): string
	local suffix = ''
	local min = 1

	for key, cutoff in pairs(condensedCutoffs) do
		if Amount >= cutoff and min < cutoff then
			min = cutoff
			suffix = key
		end
	end

	local newAmount = Amount / min
	local newText = StringUtils.TruncateToThreeDigits(newAmount)..suffix

	return newText
end

-- turn to uncondensed
function StringUtils.GetUncondensedAmount(Amount: string): number
	local amount = tonumber(Amount)
	
	if not amount then
		local suffix = Amount:sub(-1)
		local multiple = condensedCutoffs[suffix]
		
		if not multiple then
			suffix = Amount:sub(-2, -1)
			multiple = condensedCutoffs[suffix]
			
			amount = tonumber(Amount:sub(1, -3)) :: number
			amount *= multiple
		else
			amount = tonumber(Amount:sub(1, -2)) :: number
			amount *= multiple
		end
	end
	
	return amount :: number
end

-- turn amount to 3 digits
function StringUtils.TruncateToThreeDigits(Amount: number): string
	local str = tostring(Amount)
	local digitCount = 0
	local endPosition = 0

	-- Loop through the string character by character
	for i = 1, #str do
		local char = string.sub(str, i, i)
		endPosition = i

		-- Check if the character is a digit
		if string.match(char, "%d") then
			digitCount = digitCount + 1
		end

		-- Stop once we have captured exactly 3 digits
		if digitCount == 3 then
			break
		end
	end

	-- Cut the string up to the 3rd digit and convert it back to a number
	return string.sub(str, 1, endPosition)
end

return StringUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1376"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">FurnitureUtils</string><string name="ScriptGuid">{4fafd4ae-8c55-4b5f-823a-9ed97f0fba87}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local FurnitureUtils = {}

function FurnitureUtils.GetPosition(
	Position: Vector3,
	Rotation: number
): CFrame
	return CFrame.new(Position)
		* CFrame.Angles(0, math.rad(Rotation), 0)
end

function FurnitureUtils.PlaceFurniture(
	Furniture: Model,
	Position: Vector3,
	Rotation: number
)
	Furniture:PivotTo(
		FurnitureUtils.GetPosition(Position, Rotation)
	)
end

return FurnitureUtils]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1377"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">BuildUtils</string><string name="ScriptGuid">{6bcd8ee7-f2cb-44e8-a9a4-cb450ef1b34b}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local BuildUtils = {}

-- bind position to grid
function BuildUtils.BindToGrid(pos: Vector3, gridSize: number): Vector3
	return Vector3.new(
		math.floor(pos.X / gridSize + 0.5) * gridSize,
		pos.Y,
		math.floor(pos.Z / gridSize + 0.5) * gridSize
	)
end

return BuildUtils
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1378"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">Packages</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1379"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">DataService</string><string name="ScriptGuid">{efd8e011-5c76-483f-8848-404db2edb022}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[local server = require(script.DataServiceServer)
