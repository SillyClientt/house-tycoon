local NPCServiceServer = {}

local RPS = game:GetService('ReplicatedStorage')
local PLS = game:GetService('Players')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildingConfigs)

local plr = PLS.LocalPlayer :: Player

-- initialize npc service server-side
function NPCServiceServer:Init()
	RPS.Remotes.NPCService.RequestData.OnServerEvent:Connect(function(Player, Target: Player)
		local data = NPCServiceServer:CompileData(Target)
		RPS.Remotes.NPCService.RequestData:FireClient(Player, Target, data)
	end)
end

-- compile data
function NPCServiceServer:CompileData(Player: Player)
	local data = DAT_Server:waitForData(Player)
	local guards = data:get({'PersistentNPCs', 'Guards'}) :: {[number]: any}
	local buildings = data:get('Buildings') :: {[string]: {Level: number}}
	local knights = data:get({'PersistentNPCs', 'Knights'}) :: {[string]: any}

	local barracksConfig = BLD_CONFIGS.Buildings.Barracks[buildings.Barracks.Level]
	local now = DateTime.now().UnixTimestamp

	if #guards < barracksConfig.Guards then
		for i = #guards + 1, barracksConfig.Guards do
			local guard = {
				Level = 1,
				Created = now
			}

			guards[i] = guard
		end

		data:update({'PersistentNPCs', 'Guards'}, function()
			return guards
		end)
	end

	return {
		Knights = knights,
		Guards = guards,
		Buildings = buildings
	}
end

return NPCServiceServer
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1428"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">BuildService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1429"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">BuildServiceServer</string><string name="ScriptGuid">{6d16bf10-adf4-45c3-82a4-daf298645bcd}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local BuildServiceService = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')

local registeredPoints: {[Player]: Vector3} = {}

function BuildServiceService:Init()
	PLS.PlayerRemoving:Connect(function(Player: Player)
		registeredPoints[Player] = nil
	end)
	
	RPS.Remotes.BuildService.RegisterPoint.OnServerEvent:Connect(function(Player, Type: string, Position: Vector3)
		print('received')
		BuildServiceService:RegisterPoint(Player, Type, Position)
	end)
end

-- register a building structure (wall, floor, roof)
function BuildServiceService:RegisterPoint(Player: Player, Type: string, Position: Vector3)
	local start = registeredPoints[Player]
	local endPoint: Vector3? = start and Position
	print(start, endPoint, Position, Type)

	if endPoint then
		local part = Instance.new('Part')
		part.Parent = workspace
		
		local distance = start + endPoint
		part.Position = (distance)/2
		part.Size = Vector3.new((start - endPoint).Magnitude, 10, (start - endPoint).Magnitude)
		
		part.Anchored = true
		
		print(part)
		registeredPoints[Player] = nil
	else
		registeredPoints[Player] = Position
	end
end

return BuildServiceService
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1430"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">FurnitureService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1431"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">FurnitureServiceServer</string><string name="ScriptGuid">{82085584-6a70-4380-a9cf-b7ab11d5ed81}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local FurnitureServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')
local HTP = game:GetService('HttpService')

local FUR_UTILS = require(RPS.Modules.Utils.FurnitureUtils)
local DAT_Server = require(RPS.Modules.Packages.DataService).server

local templates = RPS:WaitForChild('Furniture')
local remotes = RPS.Remotes.FurnitureService

local playerFolders: {[Player]: Folder} = {}
local ready: {[Player]: boolean} = {}
local lastRequest: {[Player]: number} = {}

-- check request
local function checkRequest(Player: Player): boolean
	if not ready[Player] then
		return false
	end

	local now = os.clock()

	if now - (lastRequest[Player] or 0) < 0.2 then
		return false
	end

	lastRequest[Player] = now
	return true
end

-- load furniture
function FurnitureServiceServer:LoadPlayer(Player: Player)
	if playerFolders[Player] then
		return
	end

	local folder = Instance.new('Folder')
	folder.Name = `Furniture_{Player.UserId}`
	folder.Parent = WKS

	playerFolders[Player] = folder

	local data = DAT_Server:waitForData(Player)

	if not data or Player.Parent ~= PLS then
		return
	end

	local furniture = data:get('Furniture') or {}

	for id, item in furniture do
		local template = templates:FindFirstChild(item.Name)

		if not template or not template:IsA('Model') then
			continue
		end

		local model = template:Clone()
		model.Name = id

		FUR_UTILS.PlaceFurniture(
			model,
			Vector3.new(item.X, item.Y, item.Z),
			item.Rotation
		)

		model.Parent = folder
	end

	ready[Player] = true
end

-- place furniture
function FurnitureServiceServer:PlaceFurniture(
	Player: Player,
	Name: any,
	Position: any
)
	if not checkRequest(Player) then
		return
	end

	if typeof(Name) ~= 'string' or typeof(Position) ~= 'Vector3' then
		return
	end

	-- check position numbers
	for _, number in {Position.X, Position.Y, Position.Z} do
		if number ~= number or math.abs(number) > 1000000 then
			return
		end
	end

	local folder = playerFolders[Player]
	local template = templates:FindFirstChild(Name)

	if not folder or not template or not template:IsA('Model') then
		return
	end

	if #folder:GetChildren() >= 100 then
		return
	end

	local model = template:Clone()
	local id = HTP:GenerateGUID(false)

	model.Name = id
	FUR_UTILS.PlaceFurniture(model, Position, 0)

	DAT_Server:update(Player, 'Furniture', function(Old)
		local furniture = table.clone(Old or {})

		furniture[id] = {
			Name = Name,
			X = Position.X,
			Y = Position.Y,
			Z = Position.Z,
			Rotation = 0,
		}

		return furniture
	end)

	model.Parent = folder
end

-- rotate furniture
function FurnitureServiceServer:RotateFurniture(Player: Player, Id: any)
	if not checkRequest(Player) or typeof(Id) ~= 'string' then
		return
	end

	local folder = playerFolders[Player]
	local model = folder and folder:FindFirstChild(Id)

	if not model or not model:IsA('Model') then
		return
	end

	local furniture = DAT_Server:get(Player, 'Furniture')
	local item = furniture and furniture[Id]

	if not item then
		return
	end

	local rotation = (item.Rotation + 90) % 360

	DAT_Server:update(Player, 'Furniture', function(Old)
		local updated = table.clone(Old)
		local newItem = table.clone(updated[Id])

		newItem.Rotation = rotation
		updated[Id] = newItem

		return updated
	end)

	FUR_UTILS.PlaceFurniture(
		model,
		Vector3.new(item.X, item.Y, item.Z),
		rotation
	)
end

-- initialize furniture service server-side
function FurnitureServiceServer:Init()
	remotes.PlaceFurniture.OnServerEvent:Connect(function(Player, Name, Position)
		FurnitureServiceServer:PlaceFurniture(Player, Name, Position)
	end)

	remotes.RotateFurniture.OnServerEvent:Connect(function(Player, Id)
		FurnitureServiceServer:RotateFurniture(Player, Id)
	end)

	PLS.PlayerAdded:Connect(function(Player)
		FurnitureServiceServer:LoadPlayer(Player)
	end)

	PLS.PlayerRemoving:Connect(function(Player)
		local folder = playerFolders[Player]

		if folder then
			folder:Destroy()
		end

		playerFolders[Player] = nil
		ready[Player] = nil
		lastRequest[Player] = nil
	end)

	for _, player in PLS:GetPlayers() do
		task.spawn(function()
			FurnitureServiceServer:LoadPlayer(player)
		end)
	end
end

