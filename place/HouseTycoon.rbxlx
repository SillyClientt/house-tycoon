		INT_UTILS.TweenGuiObject(openingGui.Presents, TweenInfo.new(.4, Enum.EasingStyle.Cubic), {GroupTransparency = 1})
	end)

	local cutscene5F = start.Cutscene5
	startCF = cutscene5F.Start.CFrame
	moveCF = cutscene5F.End.CFrame

	pivotCF = cutscene5F.Pivot.CFrame
	targetCF = cutscene5F.Target.CFrame

	timeForTween = (targetCF.Position - pivotCF.Position).Magnitude/camSpeed
	local cutscene5T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35, 25)

	human:MoveTo(targetCF.Position)
	
	cutscene5T.Completed:Wait()

	local cutscene6F = start.Cutscene6
	startCF = cutscene6F.Start.CFrame
	moveCF = cutscene6F.End.CFrame

	pivotCF = cutscene6F.Pivot.CFrame
	targetCF = cutscene6F.Target.CFrame

	timeForTween = (targetCF.Position - pivotCF.Position).Magnitude/camSpeed
	local cutscene6T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35, 25)

	human:MoveTo(targetCF.Position)
	
	cutscene6T.Completed:Wait()
	
	walkTrack:Stop(1)
	moving = false
	
	task.wait(1)
	
	--local tween = AUD_UTILS.TweenMusic(TweenInfo.new(5, Enum.EasingStyle.Linear), {Volume = 0})
	
	local crown = start.Crown
	
	CAM_UTILS.SetCameraToCFrame(start.Cutscene7.Start.CFrame, 30)
	
	local crownTrack = ANM_UTILS.PlayAnimation(priestAnimator, RPS.Assets.OpeningService.Crown)

	local root = (char:FindFirstChild('HumanoidRootPart') :: BasePart)
	root.Anchored = true
	
	crownTrack:GetMarkerReachedSignal('CrownGiven'):Once(function()
		local weld = crown.Weld
		weld.Part0 = char:FindFirstChild('Head') :: BasePart
		weld.C0 = CFrame.new(0, 0.7, 0)
		crown.Parent = char
		SDS.Murmur.Volume = 0
	end)
	
	crownTrack.Ended:Wait()
	
	root.Anchored = false

	local cutscene8F = start.Cutscene8
	startCF = cutscene8F.Start.CFrame
	moveCF = cutscene8F.End.CFrame

	priest:PivotTo(cutscene8F.PriestPivot.CFrame)
	ANM_UTILS.PlayAnimation(priestAnimator, RPS.Assets.OpeningService.Kneel)
	
	pivotCF = cutscene8F.Pivot.CFrame
	targetCF = cutscene8F.Target.CFrame

	timeForTween = (targetCF.Position - pivotCF.Position).Magnitude/camSpeed
	local cutscene8T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35, 35)

	human:MoveTo(targetCF.Position)

	walkTrack = ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.Walk)
	moving = true

	task.spawn(function()
		task.wait(.2)
		while moving do
			step:Play()
			step = step == step2 and step1 or step2
			task.wait(1.08)
		end
	end)
	
	cutscene8T.Completed:Wait()
	moving = false
	walkTrack:Stop(1)
	
	task.wait(1)
	
	char.Parent = script
	
	local cutscene9F = start.Cutscene9
	startCF = cutscene9F.Start.CFrame
	moveCF = cutscene9F.End.CFrame

	local cutscene9T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(3, Enum.EasingStyle.Linear), 35)

	cutscene9T.Completed:Wait()
	
	local throneSit = ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.ThroneSit)

	char.Parent = WKS.Temp
	root.Anchored = true

	char:PivotTo(start.ThroneSeat.CFrame)
	
	for _, char in start.NPCs.Audience:GetChildren() do
		local animator = char:FindFirstChildWhichIsA('Animator', true) :: Animator
		
		task.delay(math.random(1,30)/100, function()
			ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.Kneel, 1)
		end)
	end
	
	task.wait(2)

	--CAM_UTILS.SetCameraToCFrame(startCF, 35)
	
	local cutscene10F = start.Cutscene10
	startCF = cutscene10F.Start.CFrame
	moveCF = cutscene10F.End.CFrame
	
	timeForTween = (moveCF.Position - startCF.Position).Magnitude/16
	local cutscene10T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35, 15)

	cutscene10T.Completed:Wait()
	
	RNS:UnbindFromRenderStep('Kneel Once Passed')
	
	task.wait(1)
	
	local logoTween = INT_UTILS.TweenGuiObject(openingGui.Logo, TweenInfo.new(2, Enum.EasingStyle.Cubic), {ImageTransparency = 0})

	logoTween.Completed:Wait()
	
	task.wait(2)
	
	local cutscene11F = start.Cutscene11
	startCF = cutscene11F.Start.CFrame
	moveCF = cutscene11F.End.CFrame

	pivotCF = cutscene11F.Pivot.CFrame
	targetCF = cutscene11F.Target.CFrame
	
	local cutscene11T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(2, Enum.EasingStyle.Linear), 15, 35)

	local chicken = RPS.Assets.OpeningService.Chicken:Clone()
	chicken:PivotTo(pivotCF)
	
	INT_UTILS.TweenGuiObject(openingGui.Logo, TweenInfo.new(.5, Enum.EasingStyle.Cubic), {ImageTransparency = 1})
	
	local chickenHuman = chicken.Humanoid
	local chickenAnimator = chickenHuman.Animator
	chicken.Parent = WKS.Temp
	
	ANM_UTILS.PlayAnimation(chickenAnimator, RPS.Animations.Chicken.Walk)
	
	local musicTween = AUD_UTILS.TweenMusic(TweenInfo.new(.6), {Volume = 0})
	
	task.spawn(function()
		musicTween.Completed:Wait()

		local cluck = chicken.Head.Cluck
		cluck:Play()
	end)
	
	chickenHuman.WalkSpeed = (targetCF.Position - pivotCF.Position).Magnitude / 6
	chickenHuman:MoveTo(targetCF.Position)
	
	chickenHuman.MoveToFinished:Wait()
	
	local bSTween = INT_UTILS.TweenGuiObject(openingGui.Blackscreen, TweenInfo.new(1, Enum.EasingStyle.Linear), {BackgroundTransparency = 0})
	bSTween.Completed:Wait()
	
	-- remove everything
	start:Destroy()
	chicken:Destroy()
	char:Destroy()
	
	local plrChar = plr.Character or plr.CharacterAdded:Wait()
	plrChar:PivotTo(plot:GetPivot())

	RPS.Remotes.OnboardingService.FinishedScene:FireServer()
		
	task.wait(1)
	--CAM_UTILS.ResetCamera()
	
	bSTween = INT_UTILS.TweenGuiObject(openingGui.Blackscreen, TweenInfo.new(1, Enum.EasingStyle.Linear), {BackgroundTransparency = 1})
	bSTween.Completed:Wait()
end

return OpeningServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1277"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">OpeningServiceClient</string><string name="ScriptGuid">{33575fc6-5ab9-4160-870c-7c26e66d1a5e}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local OpeningServiceClient = {}

local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService("Workspace")
local PLS = game:GetService('Players')
local RNS = game:GetService('RunService')
local CTP = game:GetService('ContentProvider')
local SDS = game:GetService('SoundService')
local RPF = game:GetService('ReplicatedFirst')

local CAM_UTILS = require(RPS.Modules.Utils.CameraUtils)
local PRP_UTILS = require(RPS.Modules.Utils.PropUtils)
local LGT_UTILS = require(RPS.Modules.Utils.LightUtils)
local ANM_UTILS = require(RPS.Modules.Utils.AnimationUtils)
local AUD_UTILS = require(RPS.Modules.Utils.AudioUtils)
local DRS_UTILS = require(RPS.Modules.Utils.DressUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)
local DAT_Client = require(RPS.Modules.Packages.DataService).client

local plr = PLS.LocalPlayer :: Player
local openingGui = plr.PlayerGui:WaitForChild('Opening')
local mouse = plr:GetMouse()

local kneeling: {[Model]: AnimationTrack} = {}

local armsTemplate = RPS.Assets.OpeningService.Arms
local camSpeed = 8

local start = RPF.Start

-- initialize cutscene service client-side
function OpeningServiceClient:Init()
	if DAT_Client:get('Onboarding') ~= 'Coronation' then
		return
	end
	
	local plot: Model
	
	while not plot do
		task.wait()
		
		for _, plotModel in WKS.Plots:GetChildren() :: {Model} do
			if plotModel:GetAttribute('Player') == plr.Name then
				plot = plotModel
				break
			end
		end
	end

	start:PivotTo(plot:GetPivot())
	start.Parent = WKS.Temp
	
	local arms = armsTemplate:Clone()
	local startCF = start.Spawn.CFrame
	arms:PivotTo(startCF)
	arms.Parent = WKS.Temp
	
	RNS:BindToRenderStep('Arms Follow Mouse', Enum.RenderPriority.Input.Value + 1, function()
		arms:PivotTo(CFrame.new(startCF.Position, mouse.Hit.Position))
	end)
	
	CAM_UTILS.SetCameraToCFrame(startCF)
	
	local origChar = (plr.Character or plr.CharacterAdded:Wait())
	origChar.Archivable = true
	
	local priest = start.NPCs.Priest
	local priestAnimator = priest.Humanoid.Animator
	
	ANM_UTILS.PlayAnimation(priestAnimator, RPS.Assets.OpeningService.HoldCrown)
	
	task.wait(1)
	
	local open = start.Open.Attachment.Open
	open.Enabled = true
	
	open.Triggered:Wait()
	
	open.Enabled = false
	
	local armsAnimator = arms.Humanoid.Animator
	local track = armsAnimator:LoadAnimation(arms.OpenGate)
	
	track:Play()
	
	local doorTween: Tween
	
	track:GetMarkerReachedSignal('OpenGate'):Once(function()
		start.Gate.Pivot.Open:Play()
		doorTween = PRP_UTILS.OpenDoor(start.Gate, TweenInfo.new(3, Enum.EasingStyle.Linear))
		local tween = LGT_UTILS.TweenLighting({ExposureCompensation = -1}, TweenInfo.new(.7, Enum.EasingStyle.Linear))
		tween.Completed:Once(function()
			LGT_UTILS.TweenLighting({ExposureCompensation = 0}, TweenInfo.new(1, Enum.EasingStyle.Linear))
		end)
		
		CAM_UTILS.TweenFOV(40, TweenInfo.new(3, Enum.EasingStyle.Linear))
	end)
	
	task.wait(1.7)

	local char = origChar:Clone()
	char.Parent = script

	local step1 = RPS.Assets.OpeningService.Step1:Clone()
	step1.Parent = char:FindFirstChild('RightFoot') :: BasePart

	local step2 = RPS.Assets.OpeningService.Step2:Clone()
	step2.Parent = char:FindFirstChild('LeftFoot') :: BasePart

	local human = char:FindFirstChild('Humanoid') :: Humanoid
	human.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	local animator = human:FindFirstChildOfClass('Animator') :: Animator

	RNS:BindToRenderStep('Kneel Once Passed', Enum.RenderPriority.Input.Value + 1, function()
		for _, knight in start.NPCs.Knights:GetChildren() :: {Model} do
			local plrChar = plr.Character
			if not plrChar then
				continue
			end
			
			if knight:GetPivot().Z < plrChar:GetPivot().Z then
				continue
			end

			if kneeling[knight] then
				continue
			end

			local human = knight:FindFirstChildOfClass('Humanoid') :: Humanoid
			local animator = human:FindFirstChildOfClass('Animator') :: Animator

			kneeling[knight] = ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.Kneel, .4)
		end
	end)

--[[
	local clothing: {Accessory} = {RPS.Assets.OpeningService.Shirt, RPS.Assets.OpeningService.Pants, RPS.Assets.OpeningService.Cape}
	
	DRS_UTILS.DressUp(char, clothing)]]
	
	RNS:UnbindFromRenderStep('Arms Follow Mouse')
	arms:Destroy()
	
	doorTween.Completed:Wait()

	AUD_UTILS.PlayMusic(SDS.Cathedral)
	
	task.wait(.4)
	
	local pivotCF = start.Cutscene1.PivotChar.CFrame
	startCF = start.Cutscene1.Start.CFrame
	local targetCF = start.Cutscene1.Target.CFrame
	local moveCF = start.Cutscene1.End.CFrame
	
	local timeForTween = (targetCF.Position - pivotCF.Position).Magnitude/camSpeed
	local cutscene1T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35)
	
	char:PivotTo(pivotCF)
	char.Parent = WKS.Temp
	
	for _, wall in start.Border:GetChildren() :: {BasePart} do
		wall.CanCollide = false
	end

	human.WalkSpeed = camSpeed
	human:MoveTo(targetCF.Position)

	local walkTrack = ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.Walk)
	local moving = true
	local step: Sound = step1

	task.spawn(function()
		task.wait(.2)
		while moving do
			step:Play()
			step = step == step2 and step1 or step2
			task.wait(1.08)
		end
	end)
	
	cutscene1T.Completed:Wait()
	task.wait(.3)
	moving = false
	
	--[[local camTweening = true
	local bStep1 = RPS.Assets.OpeningService.Step1:Clone()
	local bStep2 = RPS.Assets.OpeningService.Step2:Clone()
	bStep1.Parent = SDS
	bStep2.Parent = SDS
	
	local step: Sound = bStep1

	task.spawn(function()
		while camTweening do
			step:Play()
			step = step == bStep2 and bStep1 or bStep2
			task.wait(1)
		end
	end)
	
	local moveCF = start.Move.CFrame
	local moveTween = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new((startCF.Position - moveCF.Position).Magnitude/camSpeed, Enum.EasingStyle.Linear), 40)
	
	moveTween.Completed:Wait()
	
	camTweening = false]]

	char.Parent = script
	walkTrack:Stop()
	
	for _, wall in start.Border:GetChildren() :: {BasePart} do
		wall.CanCollide = true
	end
	
	CAM_UTILS.ResetCamera(70)
	
	local plrChar = plr.Character or plr.CharacterAdded:Wait()
	pivotCF = start.Cutscene1.Pivot.CFrame
	plrChar:PivotTo(pivotCF)
	
	local crown = start.Crown
	local claim = crown.Handle.Attachment.Claim
	claim.Triggered:Wait()
	start.SemiGlow.Transparency = 1
	
	--local tween = AUD_UTILS.TweenMusic(TweenInfo.new(5, Enum.EasingStyle.Linear), {Volume = 0})
	
	plrChar:PivotTo(pivotCF * CFrame.new(45, 0, 0))
	CAM_UTILS.SetCameraToCFrame(start.Cutscene7.Start.CFrame, 30)
	pivotCF = start.Cutscene7.Pivot.CFrame

	local root = (char:FindFirstChild('HumanoidRootPart') :: BasePart)
	char.Parent = WKS.Temp
	char:PivotTo(pivotCF)
	root.Anchored = true
	
	local crownTrack = ANM_UTILS.PlayAnimation(priestAnimator, RPS.Assets.OpeningService.Crown)
	
	crownTrack:GetMarkerReachedSignal('CrownGiven'):Once(function()
		local weld = crown.Weld
		weld.Part0 = char:FindFirstChild('Head') :: BasePart
		weld.C0 = CFrame.new(0, 0.7, 0)
		crown.Parent = char
		SDS.Murmur.Volume = 0
	end)
	
	crownTrack.Ended:Wait()

	local cutscene8F = start.Cutscene8
	startCF = cutscene8F.Start.CFrame
	moveCF = cutscene8F.End.CFrame

	priest:PivotTo(cutscene8F.PriestPivot.CFrame)
	ANM_UTILS.PlayAnimation(priestAnimator, RPS.Assets.OpeningService.Kneel)
	
	pivotCF = cutscene8F.Pivot.CFrame
	targetCF = cutscene8F.Target.CFrame

	local timeForTween = (targetCF.Position - pivotCF.Position).Magnitude/camSpeed
	local cutscene8T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35, 35)

	root.Anchored = false
	human:MoveTo(targetCF.Position)

	walkTrack = ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.Walk)
	local moving = true

	task.spawn(function()
		task.wait(.2)
		while moving do
			step:Play()
			step = step == step2 and step1 or step2
			task.wait(1.08)
		end
	end)
	
	cutscene8T.Completed:Wait()
	moving = false
	walkTrack:Stop(1)
	
	task.wait(1)
	char.Parent = script
	
	local cutscene9F = start.Cutscene9
	startCF = cutscene9F.Start.CFrame
	moveCF = cutscene9F.End.CFrame

	local cutscene9T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(1.5, Enum.EasingStyle.Linear), 35)

	cutscene9T.Completed:Wait()
	
	local throneSit = ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.ThroneSit)
	root.Anchored = true

	char.Parent = WKS.Temp
	char:PivotTo(start.ThroneSeat.CFrame)
	
	for _, char in start.NPCs.Audience:GetChildren() do
		local animator = char:FindFirstChildWhichIsA('Animator', true) :: Animator
		
		task.delay(math.random(1,30)/100, function()
			ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.Kneel, 1)
		end)
	end
	
	task.wait(2)

	--CAM_UTILS.SetCameraToCFrame(startCF, 35)
	
	local cutscene10F = start.Cutscene10
	startCF = cutscene10F.Start.CFrame
	moveCF = cutscene10F.End.CFrame
	
	timeForTween = (moveCF.Position - startCF.Position).Magnitude/16
	local cutscene10T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35, 15)

	cutscene10T.Completed:Wait()
	
	RNS:UnbindFromRenderStep('Kneel Once Passed')
	
	task.wait(1)
	
	local logoTween = INT_UTILS.TweenGuiObject(openingGui.Logo, TweenInfo.new(.5, Enum.EasingStyle.Cubic), {ImageTransparency = 0})

	logoTween.Completed:Wait()
	
	task.wait(1.5)
	
	local cutscene11F = start.Cutscene11
	startCF = cutscene11F.Start.CFrame
	moveCF = cutscene11F.End.CFrame

	pivotCF = cutscene11F.Pivot.CFrame
	targetCF = cutscene11F.Target.CFrame
	
	local cutscene11T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(2, Enum.EasingStyle.Linear), 15, 35)

	local chicken = RPS.Assets.OpeningService.Chicken:Clone()
	chicken:PivotTo(pivotCF)
	
	INT_UTILS.TweenGuiObject(openingGui.Logo, TweenInfo.new(.5, Enum.EasingStyle.Cubic), {ImageTransparency = 1})
	
	local chickenHuman = chicken.Humanoid
	local chickenAnimator = chickenHuman.Animator
	chicken.Parent = WKS.Temp
	
	ANM_UTILS.PlayAnimation(chickenAnimator, RPS.Animations.Chicken.Walk)
	
	local musicTween = AUD_UTILS.TweenMusic(TweenInfo.new(.6), {Volume = 0})
	
	task.spawn(function()
		musicTween.Completed:Wait()

		local cluck = chicken.Head.Cluck
		cluck:Play()
	end)
	
	chickenHuman.WalkSpeed = (targetCF.Position - pivotCF.Position).Magnitude / 6
	chickenHuman:MoveTo(targetCF.Position)
	
	chickenHuman.MoveToFinished:Wait()
	
	local bSTween = INT_UTILS.TweenGuiObject(openingGui.Blackscreen, TweenInfo.new(1, Enum.EasingStyle.Linear), {BackgroundTransparency = 0})
	bSTween.Completed:Wait()
	
	-- remove everything
	start:Destroy()
	chicken:Destroy()
	char:Destroy()
	
	plrChar = plr.Character or plr.CharacterAdded:Wait()
	plrChar:PivotTo(plot:GetPivot())

	RPS.Remotes.OnboardingService.FinishedCoronation:FireServer()
		
	task.wait(1)
	--CAM_UTILS.ResetCamera()
	
	bSTween = INT_UTILS.TweenGuiObject(openingGui.Blackscreen, TweenInfo.new(1, Enum.EasingStyle.Linear), {BackgroundTransparency = 1})
	bSTween.Completed:Wait()
end

return OpeningServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1278"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">PromptsService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1279"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">PromptsServiceClient</string><string name="ScriptGuid">{1bba7082-9cd2-4939-a509-eeb409e1360c}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[local PromptsServiceClient = {}

local UserInputService = game:GetService("UserInputService")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local TextService = game:GetService("TextService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

local GamepadButtonImage = {
	[Enum.KeyCode.ButtonX] = "rbxasset://textures/ui/Controls/xboxX.png",
	[Enum.KeyCode.ButtonY] = "rbxasset://textures/ui/Controls/xboxY.png",
	[Enum.KeyCode.ButtonA] = "rbxasset://textures/ui/Controls/xboxA.png",
	[Enum.KeyCode.ButtonB] = "rbxasset://textures/ui/Controls/xboxB.png",
	[Enum.KeyCode.DPadLeft] = "rbxasset://textures/ui/Controls/dpadLeft.png",
	[Enum.KeyCode.DPadRight] = "rbxasset://textures/ui/Controls/dpadRight.png",
	[Enum.KeyCode.DPadUp] = "rbxasset://textures/ui/Controls/dpadUp.png",
	[Enum.KeyCode.DPadDown] = "rbxasset://textures/ui/Controls/dpadDown.png",
	[Enum.KeyCode.ButtonSelect] = "rbxasset://textures/ui/Controls/xboxView.png",
	[Enum.KeyCode.ButtonStart] = "rbxasset://textures/ui/Controls/xboxmenu.png",
	[Enum.KeyCode.ButtonL1] = "rbxasset://textures/ui/Controls/xboxLB.png",
	[Enum.KeyCode.ButtonR1] = "rbxasset://textures/ui/Controls/xboxRB.png",
	[Enum.KeyCode.ButtonL2] = "rbxasset://textures/ui/Controls/xboxLT.png",
	[Enum.KeyCode.ButtonR2] = "rbxasset://textures/ui/Controls/xboxRT.png",
	[Enum.KeyCode.ButtonL3] = "rbxasset://textures/ui/Controls/xboxLS.png",
	[Enum.KeyCode.ButtonR3] = "rbxasset://textures/ui/Controls/xboxRS.png",
	[Enum.KeyCode.Thumbstick1] = "rbxasset://textures/ui/Controls/xboxLSDirectional.png",
	[Enum.KeyCode.Thumbstick2] = "rbxasset://textures/ui/Controls/xboxRSDirectional.png",
}

local buttonBackFrameColor = Color3.new(.95,.95,.95)
local iconColor = Color3.fromRGB(245, 213, 45)

local GamepadButtonColor = {
	[Enum.KeyCode.ButtonX] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonY] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonA] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonB] = buttonBackFrameColor,
	[Enum.KeyCode.DPadLeft] = buttonBackFrameColor,
	[Enum.KeyCode.DPadRight] = buttonBackFrameColor,
	[Enum.KeyCode.DPadUp] = buttonBackFrameColor,
	[Enum.KeyCode.DPadDown] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonSelect] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonStart] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonL1] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonR1] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonL2] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonR2] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonL3] = buttonBackFrameColor,
	[Enum.KeyCode.ButtonR3] = buttonBackFrameColor,
	[Enum.KeyCode.Thumbstick1] = buttonBackFrameColor,
	[Enum.KeyCode.Thumbstick2] = buttonBackFrameColor,
}

local KeyboardButtonImage = {
	[Enum.KeyCode.Backspace] = "rbxasset://textures/ui/Controls/backspace.png",
	[Enum.KeyCode.Return] = "rbxasset://textures/ui/Controls/return.png",
	[Enum.KeyCode.LeftShift] = "rbxasset://textures/ui/Controls/shift.png",
	[Enum.KeyCode.RightShift] = "rbxasset://textures/ui/Controls/shift.png",
	[Enum.KeyCode.Tab] = "rbxasset://textures/ui/Controls/tab.png",
}

local KeyboardButtonIconMapping = {
	["'"] = "rbxasset://textures/ui/Controls/apostrophe.png",
	[","] = "rbxasset://textures/ui/Controls/comma.png",
	["`"] = "rbxasset://textures/ui/Controls/graveaccent.png",
	["."] = "rbxasset://textures/ui/Controls/period.png",
	[" "] = "rbxasset://textures/ui/Controls/spacebar.png",
}

local KeyboardButtonColor = {
	[Enum.KeyCode.E] = buttonBackFrameColor
}

local KeyCodeToTextMapping = {
	[Enum.KeyCode.LeftControl] = "Ctrl",
	[Enum.KeyCode.RightControl] = "Ctrl",
	[Enum.KeyCode.LeftAlt] = "Alt",
	[Enum.KeyCode.RightAlt] = "Alt",
	[Enum.KeyCode.F1] = "F1",
	[Enum.KeyCode.F2] = "F2",
	[Enum.KeyCode.F3] = "F3",
	[Enum.KeyCode.F4] = "F4",
	[Enum.KeyCode.F5] = "F5",
	[Enum.KeyCode.F6] = "F6",
	[Enum.KeyCode.F7] = "F7",
	[Enum.KeyCode.F8] = "F8",
	[Enum.KeyCode.F9] = "F9",
	[Enum.KeyCode.F10] = "F10",
	[Enum.KeyCode.F11] = "F11",
	[Enum.KeyCode.F12] = "F12",
}

local function getScreenGui()
	local screenGui = PlayerGui:FindFirstChild("ProximityPrompts")
	if screenGui == nil then
		screenGui = Instance.new("ScreenGui")
		screenGui.Name = "ProximityPrompts"
		screenGui.ResetOnSpawn = false
		screenGui.Parent = PlayerGui
	end
	return screenGui
end

local function createProgressBarGradient(parent, leftSide)
	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(0.5, 1)
	frame.Position = UDim2.fromScale(leftSide and 0 or 0.5, 0)
	frame.BackgroundTransparency = 1
	frame.ClipsDescendants = true
	frame.Parent = parent

	local image = Instance.new("ImageLabel")
	image.BackgroundTransparency = 1
	image.Size = UDim2.fromScale(2, 1)
	image.Position = UDim2.fromScale(leftSide and 0 or -1, 0)
	image.Image = "rbxasset://textures/ui/Controls/RadialFill.png"
	image.Parent = frame

	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0),
		NumberSequenceKeypoint.new(0.4999, 0),
		NumberSequenceKeypoint.new(0.5, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	gradient.Rotation = leftSide and 180 or 0
	gradient.Parent = image

	return gradient
end

local function createCircularProgressBar()
	local bar = Instance.new("Frame")
	bar.Name = "CircularProgressBar"
	bar.Size = UDim2.fromOffset(58, 58)
	bar.AnchorPoint = Vector2.new(0.5, 0.5)
	bar.Position = UDim2.fromScale(0.5, 0.5)
	bar.BackgroundTransparency = 1

	local gradient1 = createProgressBarGradient(bar, true)
	local gradient2 = createProgressBarGradient(bar, false)

	local progress = Instance.new("NumberValue")
	progress.Name = "Progress"
	progress.Parent = bar
	progress.Changed:Connect(function(value)
		local angle = math.clamp(value * 360, 0, 360)
		gradient1.Rotation = math.clamp(angle, 180, 360)
		gradient2.Rotation = math.clamp(angle, 0, 180)
	end)

	return bar
end

local function createPrompt(prompt, inputType, gui)
	local tweensForButtonHoldBegin = {}
	local tweensForButtonHoldEnd = {}
	local tweensForFadeOut = {}
	local tweensForFadeIn = {}
	local tweenInfoInFullDuration =
		TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
	local tweenInfoOutHalfSecond = TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tweenInfoFast = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	local tweenInfoQuick = TweenInfo.new(0.06, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)

	local promptUI = Instance.new("BillboardGui")
	promptUI.Name = "Prompt"
	promptUI.AlwaysOnTop = true

	local frame = Instance.new("Frame")
	frame.Size = UDim2.fromScale(0.5, 1)
	frame.AnchorPoint = Vector2.new(0.18,1)
	frame.Position = UDim2.fromScale(0.5, 1)
	frame.BackgroundTransparency = .6
	frame.BackgroundColor3 = Color3.new(0.07, 0.07, 0.07)
	frame.Parent = promptUI
	
	local aspectRatio = Instance.new("UIAspectRatioConstraint")
	aspectRatio.AspectRatio = 3
	aspectRatio.Parent = frame

	local roundedCorner = Instance.new("UICorner")
	roundedCorner.Parent = frame

	local inputFrame = Instance.new("Frame")
	inputFrame.Name = "InputFrame"
	inputFrame.Size = UDim2.fromScale(1.01, 1.01)
	inputFrame.BackgroundTransparency = 1
	inputFrame.SizeConstraint = Enum.SizeConstraint.RelativeYY
	inputFrame.Parent = frame


	local resizeableInputFrame = Instance.new("Frame")
	resizeableInputFrame.Size = UDim2.fromScale(1, 1)
	resizeableInputFrame.Position = UDim2.fromScale(0.5, 0.5)
	resizeableInputFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	resizeableInputFrame.BackgroundTransparency = 1
	resizeableInputFrame.Parent = inputFrame

	local inputFrameScaler = Instance.new("UIScale")
	inputFrameScaler.Parent = resizeableInputFrame

	local inputFrameScaleFactor = inputType == Enum.ProximityPromptInputType.Touch and 1.6 or 1.33
	table.insert(
		tweensForButtonHoldBegin,
		TweenService:Create(inputFrameScaler, tweenInfoFast, { Scale = inputFrameScaleFactor })
	)
	table.insert(tweensForButtonHoldEnd, TweenService:Create(inputFrameScaler, tweenInfoFast, { Scale = 1 }))

	local actionText = Instance.new("TextLabel")
	actionText.Name = "ActionText"
	actionText.Size = UDim2.fromScale(.5, 1)
	actionText.Font = Enum.Font.SourceSansBold
	actionText.TextSize = 32
	actionText.BackgroundTransparency = 1
	actionText.TextTransparency = 1
	actionText.TextColor3 = Color3.new(1, 1, 1)
	actionText.TextXAlignment = Enum.TextXAlignment.Left
	actionText.TextScaled = true
	actionText.TextWrapped = false
	actionText.Parent = frame

	local actionFontFace = actionText.FontFace
	actionFontFace.Weight = Enum.FontWeight.Bold
	actionText.FontFace = actionFontFace

	local actionSroke = Instance.new('UIStroke')
	actionSroke.Color = Color3.new(0.23, 0.23, 0.23)
	actionSroke.Parent = actionText

	table.insert(tweensForButtonHoldBegin, TweenService:Create(actionText, tweenInfoFast, { TextTransparency = 1 }))
	table.insert(tweensForButtonHoldEnd, TweenService:Create(actionText, tweenInfoFast, { TextTransparency = 0 }))
	table.insert(tweensForFadeOut, TweenService:Create(actionText, tweenInfoFast, { TextTransparency = 1 }))
	table.insert(tweensForFadeIn, TweenService:Create(actionText, tweenInfoFast, { TextTransparency = 0 }))

	table.insert(tweensForButtonHoldBegin, TweenService:Create(actionSroke, tweenInfoFast, { Transparency = 1 }))
	table.insert(tweensForButtonHoldEnd, TweenService:Create(actionSroke, tweenInfoFast, { Transparency = 0 }))
	table.insert(tweensForFadeOut, TweenService:Create(actionSroke, tweenInfoFast, { Transparency = 1 }))
	table.insert(tweensForFadeIn, TweenService:Create(actionSroke, tweenInfoFast, { Transparency = 0 }))
	
	table.insert(tweensForFadeOut, TweenService:Create(frame, tweenInfoFast, { BackgroundTransparency = 1 }))
	table.insert(tweensForFadeIn, TweenService:Create(frame, tweenInfoFast, { BackgroundTransparency = .6 }))

	local objectText = Instance.new("TextLabel")
	objectText.Name = "ObjectText"
	objectText.Size = UDim2.fromScale(1, 1)
	objectText.Font = Enum.Font.Highway
	objectText.TextSize = 14
	objectText.BackgroundTransparency = 1
	objectText.TextTransparency = 1
	objectText.TextColor3 = Color3.new(0.7, 0.7, 0.7)
	objectText.TextXAlignment = Enum.TextXAlignment.Left
	objectText.Parent = frame

	local objectFontFace = objectText.FontFace
	objectFontFace.Weight = Enum.FontWeight.Bold
	objectText.FontFace = objectFontFace
	
	local objectSroke = Instance.new('UIStroke')
	objectSroke.Parent = objectText
	
	table.insert(tweensForButtonHoldBegin, TweenService:Create(objectText, tweenInfoFast, { TextTransparency = 1 }))
	--table.insert(tweensForButtonHoldEnd, TweenService:Create(objectText, tweenInfoFast, { TextTransparency = 0 }))
	table.insert(tweensForFadeOut, TweenService:Create(objectText, tweenInfoFast, { TextTransparency = 1 }))
	--table.insert(tweensForFadeIn, TweenService:Create(objectText, tweenInfoFast, { TextTransparency = 0 }))

	table.insert(tweensForButtonHoldBegin, TweenService:Create(objectSroke, tweenInfoFast, { Transparency = 1 }))
	--table.insert(tweensForButtonHoldEnd, TweenService:Create(objectSroke, tweenInfoFast, { Transparency = 0 }))
	table.insert(tweensForFadeOut, TweenService:Create(objectSroke, tweenInfoFast, { Transparency = 1 }))
	--table.insert(tweensForFadeIn, TweenService:Create(objectSroke, tweenInfoFast, { Transparency = 0 }))
	
	table.insert(
		tweensForButtonHoldBegin,
		TweenService:Create(frame, tweenInfoFast, { Size = UDim2.fromScale(0.5, 1)})
	)
	table.insert(
		tweensForButtonHoldEnd,
		TweenService:Create(frame, tweenInfoFast, { Size = UDim2.fromScale(1, 1)})
	)
	table.insert(
		tweensForFadeOut,
		TweenService:Create(frame, tweenInfoFast, { Size = UDim2.fromScale(0.5, 1)})
	)
	table.insert(
		tweensForFadeIn,
		TweenService:Create(frame, tweenInfoFast, { Size = UDim2.fromScale(1, 1)})
	)

	local roundFrame = Instance.new("TextButton")
	roundFrame.Text = ''
	roundFrame.Name = "RoundFrame"
	
	roundFrame.BackgroundColor3 = buttonBackFrameColor
	roundFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	roundFrame.Position = UDim2.fromScale(0.5, 0.5)
	roundFrame.Size = UDim2.fromScale(1.01,1.01)
	roundFrame.BackgroundTransparency = 1
	roundFrame.Parent = resizeableInputFrame
	
	local roundedFrameCorner = Instance.new("UICorner")
	--roundedFrameCorner.CornerRadius = UDim.new(0.5, 0)
	roundedFrameCorner.Parent = roundFrame

	table.insert(tweensForFadeOut, TweenService:Create(roundFrame, tweenInfoQuick, { BackgroundTransparency = 1 }))
	table.insert(tweensForFadeIn, TweenService:Create(roundFrame, tweenInfoQuick, { BackgroundTransparency = 0 }))

	local buttonDown = false

	roundFrame.InputBegan:Connect(function(input)
		if
			(
				input.UserInputType == Enum.UserInputType.Touch
					or input.UserInputType == Enum.UserInputType.MouseButton1
			) and input.UserInputState ~= Enum.UserInputState.Change
		then
			prompt:InputHoldBegin()
			buttonDown = true
		end
	end)
	roundFrame.InputEnded:Connect(function(input)
		if
			input.UserInputType == Enum.UserInputType.Touch
			or input.UserInputType == Enum.UserInputType.MouseButton1
		then
			if buttonDown then
				buttonDown = false
				prompt:InputHoldEnd()
			end
		end
	end)

	promptUI.Active = true
	
	if inputType == Enum.ProximityPromptInputType.Gamepad then
		if GamepadButtonImage[prompt.GamepadKeyCode] then
			local icon = Instance.new("ImageLabel")
			icon.Name = "ButtonImage"
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Size = UDim2.fromOffset(24, 24)
			icon.Position = UDim2.fromScale(0.5, 0.5)
			icon.BackgroundTransparency = 1
			icon.ImageTransparency = 1
			icon.Image = GamepadButtonImage[prompt.GamepadKeyCode]
			icon.Parent = resizeableInputFrame
			table.insert(tweensForFadeOut, TweenService:Create(icon, tweenInfoQuick, { ImageTransparency = 1 }))
			table.insert(tweensForFadeIn, TweenService:Create(icon, tweenInfoQuick, { ImageTransparency = 0 }))
			
			roundFrame.BackgroundColor3 = GamepadButtonColor[prompt.GamepadKeyCode] or roundFrame.BackgroundColor3
		end
	elseif inputType == Enum.ProximityPromptInputType.Touch then
		local buttonImage = Instance.new("ImageLabel")
		buttonImage.Name = "ButtonImage"
		buttonImage.BackgroundTransparency = 1
		buttonImage.ImageTransparency = 1
		buttonImage.Size = UDim2.fromOffset(25, 31)
		buttonImage.AnchorPoint = Vector2.new(0.5, 0.5)
		buttonImage.Position = UDim2.fromScale(0.5, 0.5)
		buttonImage.Image = "rbxasset://textures/ui/Controls/TouchTapIcon.png"
		buttonImage.ImageColor3 = iconColor
		buttonImage.Parent = resizeableInputFrame
		
		table.insert(tweensForFadeOut, TweenService:Create(buttonImage, tweenInfoQuick, { ImageTransparency = 1 }))
		table.insert(tweensForFadeIn, TweenService:Create(buttonImage, tweenInfoQuick, { ImageTransparency = 0 }))
	else
		local buttonImage = Instance.new("ImageLabel")
		buttonImage.Name = "ButtonImage"
		buttonImage.BackgroundTransparency = 1
		buttonImage.ImageTransparency = 1
		buttonImage.Size = UDim2.fromOffset(28, 30)
		buttonImage.AnchorPoint = Vector2.new(0.5, 0.5)
		buttonImage.Position = UDim2.fromScale(0.5, 0.5)
		buttonImage.Image = "rbxasset://textures/ui/Controls/key_single.png"
		buttonImage.Parent = resizeableInputFrame
		table.insert(tweensForFadeOut, TweenService:Create(buttonImage, tweenInfoQuick, { ImageTransparency = 1 }))
		--table.insert(tweensForFadeIn, TweenService:Create(buttonImage, tweenInfoQuick, { ImageTransparency = 0 }))

		local buttonTextString = UserInputService:GetStringForKeyCode(prompt.KeyboardKeyCode)
		roundFrame.BackgroundColor3 = KeyboardButtonColor[prompt.KeyboardKeyCode] or roundFrame.BackgroundColor3

		local buttonTextImage = KeyboardButtonImage[prompt.KeyboardKeyCode]
		if buttonTextImage == nil then
			buttonTextImage = KeyboardButtonIconMapping[buttonTextString]
		end

		if buttonTextImage == nil then
			local keyCodeMappedText = KeyCodeToTextMapping[prompt.KeyboardKeyCode]
			if keyCodeMappedText then
				buttonTextString = keyCodeMappedText
			end
		end

		if buttonTextImage then
			local icon = Instance.new("ImageLabel")
			icon.Name = "ButtonImage"
			icon.AnchorPoint = Vector2.new(0.5, 0.5)
			icon.Size = UDim2.fromOffset(36, 36)
			icon.Position = UDim2.fromScale(0.5, 0.5)
			icon.BackgroundTransparency = 1
			icon.ImageTransparency = 1
			icon.Image = buttonTextImage
			icon.Parent = resizeableInputFrame
			table.insert(tweensForFadeOut, TweenService:Create(icon, tweenInfoQuick, { ImageTransparency = 1 }))
			table.insert(tweensForFadeIn, TweenService:Create(icon, tweenInfoQuick, { ImageTransparency = 0 }))
		elseif buttonTextString ~= nil and buttonTextString ~= "" then
			local buttonText = Instance.new("TextLabel")
			buttonText.Name = "ButtonText"
			buttonText.Position = UDim2.fromOffset(0, -1)
			buttonText.Size = UDim2.fromScale(1, 1)
			buttonText.TextScaled = true
			buttonText.Font = Enum.Font.SourceSansBold
			buttonText.TextSize = 14
			if string.len(buttonTextString) > 2 then
				buttonText.TextSize = 12
			end
			buttonText.BackgroundTransparency = 1
			buttonText.TextTransparency = 1
			buttonText.TextColor3 = iconColor
			buttonText.TextXAlignment = Enum.TextXAlignment.Center
			buttonText.Text = buttonTextString
			buttonText.Parent = resizeableInputFrame
			table.insert(tweensForFadeOut, TweenService:Create(buttonText, tweenInfoQuick, { TextTransparency = 1 }))
			table.insert(tweensForFadeIn, TweenService:Create(buttonText, tweenInfoQuick, { TextTransparency = 0 }))
		else
			error(
				"ProximityPrompt '"
					.. prompt.Name
					.. "' has an unsupported keycode for rendering UI: "
					.. tostring(prompt.KeyboardKeyCode)
			)
		end
	end

	if inputType == Enum.ProximityPromptInputType.Touch or prompt.ClickablePrompt then
		local button = Instance.new("TextButton")
		button.BackgroundTransparency = 1
		button.TextTransparency = 1
		button.Size = UDim2.fromScale(1, 1)
		button.Parent = promptUI

		local buttonDown = false

		button.InputBegan:Connect(function(input)
			if
				(
					input.UserInputType == Enum.UserInputType.Touch
						or input.UserInputType == Enum.UserInputType.MouseButton1
				) and input.UserInputState ~= Enum.UserInputState.Change
			then
				prompt:InputHoldBegin()
				buttonDown = true
			end
		end)
		button.InputEnded:Connect(function(input)
			if
				input.UserInputType == Enum.UserInputType.Touch
				or input.UserInputType == Enum.UserInputType.MouseButton1
			then
				if buttonDown then
					buttonDown = false
					prompt:InputHoldEnd()
				end
			end
		end)

		promptUI.Active = true
	end

	if prompt.HoldDuration > 0 then
		local circleBar = createCircularProgressBar()
		circleBar.Parent = resizeableInputFrame
		table.insert(
			tweensForButtonHoldBegin,
			TweenService:Create(circleBar.Progress, tweenInfoInFullDuration, { Value = 1 })
		)
		table.insert(
			tweensForButtonHoldEnd,
			TweenService:Create(circleBar.Progress, tweenInfoOutHalfSecond, { Value = 0 })
		)
	end

	local holdBeganConnection
	local holdEndedConnection
	local triggeredConnection
	local triggerEndedConnection

	if prompt.HoldDuration > 0 then
		holdBeganConnection = prompt.PromptButtonHoldBegan:Connect(function()
			for _, tween in ipairs(tweensForButtonHoldBegin) do
				tween:Play()
			end
		end)

		holdEndedConnection = prompt.PromptButtonHoldEnded:Connect(function()
			for _, tween in ipairs(tweensForButtonHoldEnd) do
				tween:Play()
			end
		end)
	end

	triggeredConnection = prompt.Triggered:Connect(function()
		for _, tween in ipairs(tweensForFadeOut) do
			tween:Play()
		end
	end)

	triggerEndedConnection = prompt.TriggerEnded:Connect(function()
		for _, tween in ipairs(tweensForFadeIn) do
			tween:Play()
		end
		
		actionText.TextScaled = true
	end)

	local function updateUIFromPrompt()
		-- todo: Use AutomaticSize instead of GetTextSize when that feature becomes available
		local actionTextSize =
			TextService:GetTextSize(prompt.ActionText, 24, Enum.Font.Highway, Vector2.new(1000, 1000))
		local objectTextSize =
			TextService:GetTextSize(prompt.ObjectText, 14, Enum.Font.Highway, Vector2.new(1000, 1000))
		local maxTextWidth = math.max(actionTextSize.X, objectTextSize.X)
		local promptHeight = 72
		local promptWidth = 72
		local textPaddingLeft = 72

		if
			(prompt.ActionText ~= nil and prompt.ActionText ~= "")
			or (prompt.ObjectText ~= nil and prompt.ObjectText ~= "")
		then
			promptWidth = maxTextWidth + textPaddingLeft + 24
		end

		local actionTextYOffset = 0
		if prompt.ObjectText ~= nil and prompt.ObjectText ~= "" then
			actionTextYOffset = 9
		end
		actionText.Position = UDim2.new(0.45, textPaddingLeft - promptWidth / 2, 0, actionTextYOffset)
		objectText.Position = UDim2.new(0.5, textPaddingLeft - promptWidth / 2, 0, -10)

		actionText.Text = prompt.ActionText
		objectText.Text = prompt.ObjectText
		actionText.AutoLocalize = prompt.AutoLocalize
		actionText.RootLocalizationTable = prompt.RootLocalizationTable

		objectText.AutoLocalize = prompt.AutoLocalize
		objectText.RootLocalizationTable = prompt.RootLocalizationTable

		promptUI.Size = UDim2.fromOffset(promptWidth, promptHeight)
		promptUI.SizeOffset =
			Vector2.new(prompt.UIOffset.X / promptUI.Size.Width.Offset, prompt.UIOffset.Y / promptUI.Size.Height.Offset)

		actionText.TextWrapped = false
		actionText.TextScaled = true
	end

	local changedConnection = prompt.Changed:Connect(updateUIFromPrompt)
	updateUIFromPrompt()

	promptUI.Adornee = prompt.Parent
	promptUI.Parent = gui

	for _, tween in ipairs(tweensForFadeIn) do
		tween:Play()
	end

	actionText.TextWrapped = false
	actionText.TextScaled = true

	local function cleanup()
		if holdBeganConnection then
			holdBeganConnection:Disconnect()
		end

		if holdEndedConnection then
			holdEndedConnection:Disconnect()
		end

		triggeredConnection:Disconnect()
		triggerEndedConnection:Disconnect()
		changedConnection:Disconnect()

		for _, tween in ipairs(tweensForFadeOut) do
			tween:Play()
		end

		task.wait(0.2)

		promptUI.Parent = nil
	end

	return cleanup
end

local function onLoad()
	ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style == Enum.ProximityPromptStyle.Default then
			return
		end

		local gui = getScreenGui()

		local cleanupFunction = createPrompt(prompt, inputType, gui)

		prompt.PromptHidden:Wait()

		cleanupFunction()
	end)
end

function PromptsServiceClient:Init()
	onLoad()
end

return PromptsServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1280"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">DecisionService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1281"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">DecisionServiceClient</string><string name="ScriptGuid">{64cf20b7-4c3e-43d9-8c48-ce923270114c}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local DecisionServiceClient = {}

type DialogueData = {[number]: {PlaintiffNo: number, Subject: Model, Object: Model, DialogueConfig: CFG_TYPES.DialogueConfig, Mumble: Sound}}
	
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService("Workspace")
local PLS = game:GetService('Players')
local RNS = game:GetService('RunService')
local CTP = game:GetService('ContentProvider')
local SDS = game:GetService('SoundService')
local RPF = game:GetService('ReplicatedFirst')
local PPS = game:GetService('ProximityPromptService')

local CAM_UTILS = require(RPS.Modules.Utils.CameraUtils)
local PRP_UTILS = require(RPS.Modules.Utils.PropUtils)
local LGT_UTILS = require(RPS.Modules.Utils.LightUtils)
local ANM_UTILS = require(RPS.Modules.Utils.AnimationUtils)
local AUD_UTILS = require(RPS.Modules.Utils.AudioUtils)
local CHR_UTILS = require(RPS.Modules.Utils.CharacterUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)
local DCS_CONFIGS = require(RPS.Modules.Configs.DecisionConfigs)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local DAT_Client = require(RPS.Modules.Packages.DataService).client
local DCS_CSignals = require(script.Parent.DecisionClientSignals)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local plr = PLS.LocalPlayer :: Player

local plot: Model
local court: Model
local seat: Seat

local rightGuard: Animator
local leftGuard: Animator

local playingDecision = false
local state = 'Inactive'
local plaintiffs: {[number]: Model} = {}
local plaintiffsData: {[number]: DAT_TYPES.NPCData} = {}

-- initialize cutscene service client-side
function DecisionServiceClient:Init()
	DCS_CSignals.DecisionMade:Connect(function(Choice)
		DecisionServiceClient:PlayChoiceCutscenes(Choice :: CFG_TYPES.Choice)
		RPS.Remotes.DecisionService.ChoiceMade:FireServer(Choice, plaintiffsData)
		table.clear(plaintiffsData)
	end)
	
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		if not Prompt:HasTag('DecisionPrompt') then
			return
		end
		
		if Prompt:GetAttribute('Player') ~= plr.Name then
			return
		end
		
		local config = DCS_CONFIGS.Decisions[Prompt:GetAttribute('Decision')]
		if not config then
			return
		end
		
		local choiceConfig = config.Choices[Prompt:GetAttribute('Choice')]
		if not choiceConfig then
			return
		end
		
		local outcomeConfig = choiceConfig.Outcome and choiceConfig.Outcome[Prompt:GetAttribute('Outcome')]
		if not outcomeConfig then
			return
		end
		
		local spawnConfig = outcomeConfig.Spawn and outcomeConfig.Spawn[Prompt:GetAttribute('Spawn')]
		if not spawnConfig then
			return
		end
		
		if not spawnConfig.Prompt then
			return
		end
		
		Prompt.Enabled = false
		
		local root = (Prompt.Parent :: Attachment).Parent :: BasePart
		local focusCF = root.CFrame * CFrame.new(0, 5.5, -10) * CFrame.Angles(0, math.rad(180), 0)
		--CAM_UTILS.SetCameraToCFrame(focusCF, 50)
		--CAM_UTILS.TweenFOV(45, TweenInfo.new(2, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut, -1, true))
		
		local char = root.Parent :: Model
		local mumble = AUD_UTILS.AddMumble(char, char:GetAttribute('Gender'))
		
		for _, dialogue in spawnConfig.Prompt.Dialogue do
			local subject: Model
			if typeof(dialogue.Subject) == 'string' then
				subject = CHR_UTILS.Create(dialogue.Subject, dialogue.Gender, dialogue.WithoutHair)
			elseif typeof(dialogue.Subject) == 'Instance' and dialogue.Subject:IsA('Model') then
				subject = dialogue.Subject:Clone()
			end
			
			subject = subject or char:Clone()
			
			INT_UTILS.PlayDialogue(char, subject or char:Clone(), mumble, dialogue.Animation, dialogue.CFrame)
			task.wait(2.25)
		end

		if spawnConfig.Prompt.Gift then
			local giftModel = (Prompt:FindFirstChild('Gift') :: ObjectValue).Value :: Model
			local top = giftModel:FindFirstChild('Top') :: Model
			local pivotCF = top:GetPivot()
			local offsetCF = giftModel:GetPivot() * CFrame.new(0,4,-7)
			focusCF = CFrame.lookAt(offsetCF.Position, pivotCF.Position)
			
			CAM_UTILS.SetCameraToCFrame(focusCF, 45)
			--CAM_UTILS.TweenFOV(35, TweenInfo.new(2, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut, -1, true))
			
			PRP_UTILS.OpenGiftBox(giftModel)
		end

		RPS.Remotes.DecisionService.OutcomePlayed:FireServer()
		
		INT_UTILS.HideDialogueInstances(TweenInfo.new(1, Enum.EasingStyle.Cubic))
		
		CAM_UTILS.ResetCamera(70)
	end)
	
	task.spawn(function()
		while not plot do
			task.wait()

			for _, plotModel in WKS.Plots:GetChildren() :: {Model} do
				if plotModel:GetAttribute('Player') == plr.Name then
					plot = plotModel
					break
				end
			end
		end

		while not court do
			task.wait()

			local structures = plot:FindFirstChild('Structures') :: Folder?
			if structures then
				local models = structures:FindFirstChild('Models') :: Folder?
				if models then
					court = models:FindFirstChild('Court') :: Model
				end
			end
		end
		
		while not seat do
			task.wait()
			
			seat = court:FindFirstChild('ThroneSeat') :: Seat
		end
		
		DecisionServiceClient:PlayDecision()
		
		seat:GetPropertyChangedSignal('Occupant'):Connect(function()
			DecisionServiceClient:PlayDecision()
		end)
		
		DAT_Client:getChangedSignal({'Decisions', 'Current', 'Name'}):Connect(function()
			DecisionServiceClient:PlayDecision()
		end)
		
		while not rightGuard or not leftGuard do
			task.wait()
			
			local guards = court:FindFirstChild('Guards') :: Folder
			local rGuard = guards:FindFirstChild('RightGuard')
			local lGuard = guards:FindFirstChild('LeftGuard')

			if rGuard then
				rightGuard = rGuard:FindFirstChildWhichIsA('Animator', true) :: Animator
			end
			
			if lGuard then
				leftGuard = lGuard:FindFirstChildWhichIsA('Animator', true) :: Animator
			end
		end
		
		ANM_UTILS.PlayAnimation(leftGuard, RPS.Animations.Weapons.LeftSpearHold)
		ANM_UTILS.PlayAnimation(rightGuard, RPS.Animations.Weapons.RightSpearHold)
	end)
end

-- play decision cutscenes
function DecisionServiceClient:PlayChoiceCutscenes(Choice: CFG_TYPES.Choice)
	local decision = DAT_Client:get({'Decisions', 'Current', 'Name'})
	local config = DCS_CONFIGS.Decisions[decision]

	local cutscenes = config.Choices[Choice :: CFG_TYPES.Choice].Cutscene
	local npcs: {Model} = {}

	if cutscenes then
		for _, cutscene in cutscenes do
			local dur = INT_UTILS.PlayBlackScreen(1.5)
			task.wait(dur)
			
			local startTime = os.clock()
			
			if cutscene.Music then
				AUD_UTILS.PlayMusic(cutscene.Music)
			end
			
			if cutscene.WipePreviousCutscene then
				for _, npc in npcs do
					npc:Destroy()
				end
			end

			local folder = (court:FindFirstChild('Cutscenes') :: Folder):FindFirstChild(cutscene.Folder) :: Folder

			local start = folder:FindFirstChild('Start') :: BasePart
			local move = folder:FindFirstChild('End') :: BasePart?
			local pivot = folder:FindFirstChild('Pivot') :: BasePart?
			local target = folder:FindFirstChild('Target') :: BasePart?
			local pivotsF = folder:FindFirstChild('Pivots') :: Folder?

			local tween: Tween?

			if move then
				tween = CAM_UTILS.PlayCutscene(start.CFrame, move.CFrame, cutscene.Info, cutscene.FOV and cutscene.FOV.Start, cutscene.FOV and cutscene.FOV.End)
			else
				CAM_UTILS.SetCameraToCFrame(start.CFrame, cutscene.FOV and cutscene.FOV.Start)
			end

			if cutscene.Wipe then
				for _, num in cutscene.Wipe do
					if plaintiffs[num] then
						plaintiffs[num]:Destroy()
					end
				end
			end

			if cutscene.Spawn then
				for _, spawnConfig in cutscene.Spawn do
					for i = 1, spawnConfig.Amount do
						local char: Model, animator: Animator
						if typeof(spawnConfig.Subject) == 'number' then
							char = plaintiffs[spawnConfig.Subject]
							animator = char:FindFirstChildWhichIsA('Animator', true) :: Animator
						else
							char, animator = CHR_UTILS.Create(spawnConfig.Subject, nil, spawnConfig.WithoutHair)
						end

						if spawnConfig.Animation then
							ANM_UTILS.PlayAnimation(animator, ANM_UTILS.GetAnimationFromPath(spawnConfig.Animation))
						end

						if pivotsF and spawnConfig.Pivot then
							char:PivotTo((pivotsF:FindFirstChild(spawnConfig.Pivot) :: BasePart).CFrame)
						elseif pivot then
							if spawnConfig.Offset == 'Consistent' then
								char:PivotTo(pivot.CFrame)
							elseif spawnConfig.Offset == 'Random' then
								char:PivotTo(pivot.CFrame * CFrame.new(math.random(-3,3), 0, math.random(-3,3)))
							end
						end

						char.Parent = WKS.Temp

						if target then
							local human = char:FindFirstChildOfClass('Humanoid') :: Humanoid
							human:MoveTo(target.Position)
							human.WalkSpeed = spawnConfig.WalkSpeed or human.WalkSpeed

							--if not table.find(plaintiffs, char) then
								human.MoveToFinished:Once(function()
									char:Destroy()
								end)
							--end
						end

						if not table.find(plaintiffs, char) and not table.find(npcs, char) then
							table.insert(npcs, char)
						end

						task.wait(spawnConfig.Interval)
					end
				end
			end

			if tween and tween.PlaybackState ~= Enum.PlaybackState.Completed then
				tween.Completed:Wait()
			else
				task.wait(cutscene.Info.Time - (os.clock() - startTime))
			end
		end
	end

	task.wait(1)

	local dur = INT_UTILS.PlayBlackScreen(1.5)
	task.wait(dur)
	CAM_UTILS.ResetCamera(70)

	for _, npc in npcs do
		npc:Destroy()
	end
	
	for _, plaintiff in plaintiffs do
		plaintiff:Destroy()
	end
	
	table.clear(plaintiffs)
	
	AUD_UTILS.PlayMusic(SDS.Ambience.Court)
end

-- play current decision
function DecisionServiceClient:PlayDecision()
	local char = plr.Character
	local human = char and char:FindFirstChild('Humanoid') :: Humanoid

	if seat.Occupant ~= human then
		return
	end
	
	local decision = DAT_Client:get({'Decisions', 'Current', 'Name'})
	
	if not decision or playingDecision then
		return
	end
	
	playingDecision = true
	
	local cutscenes = court:FindFirstChild('Cutscenes') :: typeof(RPS.Assets.Models.Courts.Court.Cutscenes)
	
	local start: BasePart
	
	while not start do
		task.wait()
		
		start = cutscenes.Waiting:FindFirstChild('Start')
	end
	
	
	CAM_UTILS.SetCameraToCFrame(start.CFrame)
	CAM_UTILS.ResetCamera(70)
	--CAM_UTILS.SetCameraToCFrame(start.CFrame, 60)
	--CAM_UTILS.TweenFOV(50, TweenInfo.new(8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true))
	AUD_UTILS.PlayMusic(SDS.Ambience.Court)
	
	state = 'Waiting'
	
	task.spawn(function()
		while state == 'Waiting' do
			task.wait(math.random(200,500)/100)
			
			local duration = INT_UTILS.Blink()
			task.wait(duration)
			
			if state == 'Active' then
				local dialogues = DecisionServiceClient:AddPlaintiffs()
				
				task.delay(4, function()
					DecisionServiceClient:PlayDialogue(dialogues)
				end)
				
				break
			end
		end
	end)
	
	task.wait(3)
	
	if state == 'Waiting' then
		state = 'Active'
	end
end

-- play dialogue
function DecisionServiceClient:PlayDialogue(Dialogues: DialogueData)
	if state ~= 'Active' then
		return
	end
	
	local decision = DAT_Client:get({'Decisions', 'Current', 'Name'})
	local config = DCS_CONFIGS.Decisions[decision]

	local folder: Folder = ((court:FindFirstChild('Cutscenes') :: Folder):FindFirstChild('Plaintiff') :: Folder):FindFirstChild(tostring(#config.Plaintiffs)) :: Folder
	
	local current: BasePart
	
	for _, dialogue in Dialogues do
		local focus = folder:FindFirstChild('Plaintiff'..dialogue.PlaintiffNo) :: BasePart
		
		local human = dialogue.Subject:FindFirstChildOfClass('Humanoid') :: Humanoid
		local focusCF = focus.CFrame * CFrame.new(0, -2 + human.HipHeight, 0)
		
		local focusTween: Tween?
		
		if current ~= focus then
			local cam = CAM_UTILS.GetCamera()
			focusTween = CAM_UTILS.PlayCutscene(cam.CFrame, focusCF, TweenInfo.new(1, Enum.EasingStyle.Cubic), nil, 70)

			task.spawn(function()
				(focusTween :: Tween).Completed:Wait()
				CAM_UTILS.PlayCutscene(focusCF, focusCF * CFrame.new(0,1.5,0), TweenInfo.new(3, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), 70, 60)
			end)
		end
		
		current = focus
		
		local att, gui = INT_UTILS.PlayDialogue(dialogue.Subject, dialogue.Object, dialogue.Mumble, dialogue.DialogueConfig.Animation, dialogue.DialogueConfig.CFrame)
		
		plaintiffs[dialogue.PlaintiffNo] = dialogue.Subject
		
		task.wait(2.25)
	end
	
	INT_UTILS.HideDialogueInstances(TweenInfo.new(1, Enum.EasingStyle.Cubic))
	
	local subject: Model
	
	for _, dialogue in Dialogues do
		if dialogue.PlaintiffNo == config.DecisionPlaintiff then
			subject = dialogue.Subject
		end
	end
	
	local human = subject:FindFirstChildOfClass('Humanoid') :: Humanoid
	
	local focus = folder:FindFirstChild('Plaintiff'..config.DecisionPlaintiff) :: BasePart
	local focusCF = focus.CFrame --* CFrame.new(0, -2 + human.HipHeight, 0)
	
	local cam = CAM_UTILS.GetCamera()
	local camTween = CAM_UTILS.PlayCutscene(cam.CFrame, focusCF, TweenInfo.new(1, Enum.EasingStyle.Sine), nil, 70)
	
	camTween.Completed:Wait()
	
	INT_UTILS.PlayDecision(subject:FindFirstChild('HumanoidRootPart') :: BasePart, config, plaintiffs)
end

-- add plaintiffs
function DecisionServiceClient:AddPlaintiffs(): DialogueData
	local decision = DAT_Client:get({'Decisions', 'Current', 'Name'})
	
	local config = DCS_CONFIGS.Decisions[decision]
	
	local num = #config.Plaintiffs
	local pivotsF = ((court:FindFirstChild('Pivots') :: Folder):FindFirstChild('Plaintiffs') :: Folder)
	local numF = pivotsF:FindFirstChild(tostring(num)) :: Folder
	
	local dialogues: DialogueData = {}
	local mumbles: {[number]: Sound} = {}

	for i = 1, num do
		local plaintiffData = config.Plaintiffs[i]
		
		local cat = plaintiffData.Category
		local char: Model, animator: Animator
		local mumble: Sound
		
		if typeof(cat) == 'Instance' and cat:IsA('Model') then
			char = cat:Clone()
			animator = char:FindFirstChildWhichIsA('Animator', true) :: Animator
		else
			char, animator = CHR_UTILS.Create(cat, plaintiffData.Gender, plaintiffData.WithoutHair)
		end

		local configMumble = plaintiffData.Mumble

		if configMumble then
			mumble = configMumble:Clone()
			mumble.Parent = char:FindFirstChild('Head') or char:FindFirstChildWhichIsA('BasePart') :: BasePart
		end

		mumble = mumble or AUD_UTILS.AddMumble(char, char.Name)

		local pivot = numF:FindFirstChild('Plaintiff'..i) :: BasePart

		char:PivotTo(pivot.CFrame)
		char.Parent = WKS.Temp
		
		task.delay(1, function()
			local kneelAnim = ANM_UTILS.PlayAnimation(animator, RPS.Animations.Character.Kneel, .6)
			task.wait(1.6)
			kneelAnim:Stop(.6)

			local path = plaintiffData.Animation
			local track: AnimationTrack?

			if path then
				track = ANM_UTILS.PlayAnimation(animator, ANM_UTILS.GetAnimationFromPath(path), .6)
			end
		end)
		
		plaintiffs[i] = char
		plaintiffsData[i] = CHR_UTILS.ToData(char)
		mumbles[i] = mumble
	end
	
	for i = 1, num do
		local plaintiffData = config.Plaintiffs[i]
		
		if plaintiffData.Dialogue then
			for _, config in plaintiffData.Dialogue do
				local object = config.Subject
				local clone: Model
				
				if typeof(object) == 'Instance' and object:IsA('Model') then
					clone = object:Clone()
				elseif typeof(object) == 'string' then
					clone = CHR_UTILS.Create(object, nil, config.WithoutHair)
				elseif typeof(object) == 'number' then
					clone = plaintiffs[object]:Clone()
				end
				
				dialogues[config.Order] = {
					PlaintiffNo = i,
					Subject = plaintiffs[i],
					Object = clone,
					DialogueConfig = config,
					Mumble = mumbles[i]
				}
			end
		end
	end
	
	return dialogues
end

return DecisionServiceClient
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1282"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">DecisionClientSignals</string><string name="ScriptGuid">{bc98e9f7-3f2d-475e-8d5a-bf9f4bfacdb3}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)

local DecisionClientSignals = {
	DecisionMade = Signal() :: Signal.Signal<string>
}

return DecisionClientSignals
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1283"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">InterfaceService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1284"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">InterfaceServiceClient</string><string name="ScriptGuid">{bb6697e8-8491-4c1e-89c0-6bc5fc0b5acf}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Interface = {}

-- initialize interface
function Interface:Init()
	for _, child in script:GetChildren() do
		if child:IsA('ModuleScript') then
			task.spawn(function()
				(require(child) :: {Init: (self: any) -> ()}):Init()
			end)
		end
	end
end

return Interface
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1285"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Gold</string><string name="ScriptGuid">{00f281fd-c399-4945-91f0-ceb390e5af24}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Gold = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local SDS = game:GetService('SoundService')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui

local gui = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local currency = gui:WaitForChild('Gold')

local tween: Tween
local increase: TextLabel?

local sum = 0
local lastUpdate = 0

-- add change to sum
local function addToSum(Amount: number, Total: number)
	lastUpdate = os.clock()
	sum += Amount
	
	local label = increase or currency.Amount.Increase:Clone()
	label.Text = '+'..INT_UTILS.GetSpacedAmount(sum)
	label.Parent = currency.Amount
	label.Visible = true
	increase = label
	
	task.delay(1, function()
		if os.clock() - lastUpdate < 1 then
			return
		end
		
		local gold = currency.Amount.NumValue.Value
		
		if tween then
			tween:Destroy()
		end
		
		local timer = sum > 1000 and 1 or sum > 100 and 0.6 or 0.3

		local increaseTween = INT_UTILS.TweenGuiObject(label, TweenInfo.new(timer, Enum.EasingStyle.Linear), {TextTransparency = 1, Position = UDim2.fromScale(0,.5)})
		
		tween = TWS:Create(currency.Amount.NumValue, TweenInfo.new(timer, Enum.EasingStyle.Linear), {Value = Total})
		tween:Play()
		
		increaseTween.Completed:Once(function()
			label:Destroy()
		end)
		
		increase = nil
		sum = 0
	end)
	
end

-- initialize gold interface
function Gold:Init()
	local gold = DAT_Client:get('Gold')

	currency.Amount.NumValue.Value = gold or 0
	currency.Amount.Text = INT_UTILS.GetSpacedAmount(gold)

	currency.Amount.NumValue.Changed:Connect(function(NewAmount)
		currency.Amount.Text = INT_UTILS.GetSpacedAmount(NewAmount)
	end)

	RPS.Remotes.EconomyService.Rewarded.OnClientEvent:Connect(function(Currency: string, Amount: number, NewAmount: number, Tag: string?)
		if Currency ~= 'Gold' then
			return
		end
		
		if Tag == 'Kill' then
			addToSum(Amount, NewAmount)
		elseif Tag == 'Tax' then
			addToSum(Amount, NewAmount)
		end
	end)
	RPS.Remotes.EconomyService.Deducted.OnClientEvent:Connect(function(Currency: string, Amount: number, NewAmount: number, Tag: string?)
		if Currency ~= 'Gold' then
			return
		end
		
		if Tag == 'Purchase' then
			SDS.UI.Kaching:Play()
		else
			SDS.UI.Loss:Play()
		end
		
		currency.Amount.NumValue.Value = NewAmount
	end)
end

return Gold
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties><Item class="TextLabel" referent="RBX1286"><Properties><bool name="Active">false</bool><Vector2 name="AnchorPoint"><X>0</X><Y>0</Y></Vector2><BinaryString name="AttributesSerialize"></BinaryString><bool name="AutoLocalize">true</bool><token name="AutomaticSize">0</token><Color3 name="BackgroundColor3"><R>1</R><G>1</G><B>1</B></Color3><float name="BackgroundTransparency">1</float><Color3 name="BorderColor3"><R>0</R><G>0</G><B>0</B></Color3><token name="BorderMode">0</token><int name="BorderSizePixel">0</int><bool name="ClipsDescendants">false</bool><bool name="DefinesCapabilities">false</bool><bool name="Draggable">false</bool><Font name="FontFace"><Family><url>rbxasset://fonts/families/SourceSansPro.json</url></Family><Weight>700</Weight><Style>Normal</Style></Font><bool name="Interactable">true</bool><int name="LayoutOrder">0</int><float name="LineHeight">1</float><string name="LocalizationMatchIdentifier"></string><string name="LocalizationMatchedSourceText"></string><int name="MaxVisibleGraphemes">-1</int><string name="Name">Addition</string><Ref name="NextSelectionDown">null</Ref><Ref name="NextSelectionLeft">null</Ref><Ref name="NextSelectionRight">null</Ref><Ref name="NextSelectionUp">null</Ref><string name="OpenTypeFeatures"></string><UDim2 name="Position"><XS>0</XS><XO>0</XO><YS>0.0599999987</YS><YO>0</YO></UDim2><bool name="RichText">false</bool><Ref name="RootLocalizationTable">null</Ref><float name="Rotation">0</float><bool name="Selectable">false</bool><token name="SelectionBehaviorDown">0</token><token name="SelectionBehaviorLeft">0</token><token name="SelectionBehaviorRight">0</token><token name="SelectionBehaviorUp">0</token><bool name="SelectionGroup">false</bool><Ref name="SelectionImageObject">null</Ref><int name="SelectionOrder">0</int><string name="SerializedOverrides"></string><token name="Sink">0</token><UDim2 name="Size"><XS>1</XS><XO>0</XO><YS>0.0430000015</YS><YO>0</YO><