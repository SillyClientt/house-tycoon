				end
				
				task.wait()
			end

			tap.Visible = false

			if highlight then
				highlight:Destroy()
			end

			TUT_UTILS.DirectArrowsAt()
			
			shellsConn:Disconnect()
			
			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(13)
		end]]

		local claimedOrders = DAT_Client:get('OrdersCompleted')

		local function teleToOrderBoard()
			local char = plr.Character

			if not char then
				return
			end

			local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?

			if not station then
				return
			end

			local ordersBoard = station:FindFirstChild('OrdersBoard') :: Model

			char:PivotTo((ordersBoard):GetPivot() * CFrame.new(0, 0, -7) * CFrame.Angles(0, math.rad(180), 0))
		end
		
		local function waitUntilOrdersComplete(Amount: number)
			for i = DAT_Client:get('OrdersCompleted'), Amount do
				objective.Tracker.Amount.Text = RWD_UTILS.ToString(math.min(math.floor(DAT_Client:get('OrdersCompleted')), Amount))..'/'..Amount
				
				local complete: string?

				while not complete do
					for orderName, order in DAT_Client:get('Orders') do
						if order.Reached >= order.Target then
							complete = orderName
						end
					end

					task.wait()
				end

				local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?

				local highlight: Highlight?

				if station then
					local ordersBoard = station:FindFirstChild('OrdersBoard') :: Model
					local basicBoard = ordersBoard:FindFirstChild(complete..'OrderPart', true) :: Part?
					local att = basicBoard and basicBoard:FindFirstChildWhichIsA('Attachment', true) :: Attachment

					if basicBoard then
						highlight = TUT_UTILS.Highlight(basicBoard.Parent :: Model, Color3.new(0.95, 1, 0.25))
					end

					if att then
						TUT_UTILS.DirectArrowsAt(att)
					end
				end

				if not gui.Order.Visible then
					gui.Order:GetPropertyChangedSignal('Visible'):Wait()
				end

				local basicFrame = gui.Order.Orders:FindFirstChild(complete) :: typeof(gui.Order.Orders.Basic)

				if not basicFrame.Visible then
					basicFrame:GetPropertyChangedSignal('Visible'):Wait()
				end

				local focus, tap = TUT_UTILS.FocusFrameOnGuiObject(basicFrame.Complete)

				while DAT_Client:get('OrdersCompleted') < i do
					task.wait()
				end

				focus.Visible = false
				tap.Visible = false

				if highlight then
					highlight:Destroy()
				end

				TUT_UTILS.DirectArrowsAt()
			end
		end
		
		if claimedOrders < 3 then
			updateObjective({
				Description = "Complete 3 orders!",
				Title = 'Complete',
				Color = Color3.new(0.982528, 0.946792, 0.442084),
				RunFunc = teleToOrderBoard
			})

			toggleObjective(false)
			
			waitUntilOrdersComplete(3)

			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(13)
		end
		
		local purchasedDecor = DAT_Client:get('DecorationsPurchased')
		
		if #purchasedDecor < 1 then
			updateObjective({
				Description = "Buy a decoration!",
			})
			
			toggleObjective(false)

			local focus, tap: ImageLabel?

			if gui.Order.Visible then
				focus, tap = TUT_UTILS.FocusFrameOnGuiObject(gui.Order.Close)
				gui.Order:GetPropertyChangedSignal('Visible'):Wait()
				tap.Visible = false
			end
			
			local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?
			
			if station then
				local decorF = station:FindFirstChild('Decorations') :: Folder
				local bedF = decorF:FindFirstChild('Bed') :: Folder
				local bedPivot = bedF:FindFirstChildOfClass('Part') :: BasePart
				local att = bedPivot:FindFirstChildOfClass('Attachment') :: Attachment
				
				TUT_UTILS.DirectArrowsAt(att)
			end
			
			if not gui.Decorate.Visible then
				gui.Decorate:GetPropertyChangedSignal('Visible'):Wait()
			end
			
			local selected: TextButton?
			local cost = 1000000
			
			for _, child in gui.Decorate.Scroller:GetChildren() do
				if not child:IsA('TextButton') or child.Name == 'Empty' then
					continue
				end
				
				local config = STT_CONFIGS.Decorations[child.Name]
					
				if cost > config.Cost then
					cost = config.Cost
					selected = child
				end
			end
			
			if selected then
				focus, tap = TUT_UTILS.FocusFrameOnGuiObject(selected)
				selected.Activated:Wait()
				
				local buy = selected:FindFirstChild('Buy', true) :: TextButton
				focus, tap = TUT_UTILS.FocusFrameOnGuiObject(buy)
				buy.Activated:Wait()
			end
			
			while #DAT_Client:get('DecorationsPurchased') < 1 do
				task.wait()
			end
			
			if tap then
				tap.Visible = false
			end
			
			TUT_UTILS.DirectArrowsAt()
		end
		
		claimedOrders = DAT_Client:get('OrdersCompleted')

		if claimedOrders < 5 then
			updateObjective({
				Description = "Complete 5 orders!",
				Title = 'Complete',
				Color = Color3.new(0.982528, 0.946792, 0.442084),
				RunFunc = teleToOrderBoard
			})

			toggleObjective(false)

			waitUntilOrdersComplete(5)

			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(15)
		end
		

		local treatsUsed = DAT_Client:get('TreatsUsed')

		if treatsUsed < 1 then
			updateObjective({
				Description = "Buy a treat!",
				RunFunc = function()
					local char = plr.Character

					if not char then
						return
					end

					local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?

					if not station then
						return
					end

					char:PivotTo((station:FindFirstChild('Gizmo') :: Model):GetPivot() * CFrame.new(0, 0, -7) * CFrame.Angles(0, math.rad(180), 0))
				end
			})

			toggleObjective(false)

			local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?

			local highlight: Highlight?

			if station then
				local gizmo = station:FindFirstChild('Gizmo') :: Model?
				local att = gizmo and gizmo:FindFirstChildWhichIsA('Attachment', true)

				if gizmo then
					highlight = TUT_UTILS.Highlight(gizmo, Color3.new(0.95, 0.5, 0.25))
				end

				if att then
					TUT_UTILS.DirectArrowsAt(att)
				end
			end

			if gui.Gizmo.Store.Position.X.Scale > 1 then
				gui.Gizmo.Store:GetPropertyChangedSignal('Position'):Wait()

				local isTweening, tween = INT_UTILS.IsTweening(gui.Gizmo.Store)
				if isTweening and tween then
					tween.Completed:Wait()
				end
			end

			local scroller = gui.Gizmo.Store.Scroller
			local selected = scroller:FindFirstChild('Uncommon Treat') :: ImageLabel

			local focus, tap
			
			local dirtPopper = scroller:FindFirstChild('Dirt Popper') :: ImageLabel
			
			scroller.CanvasPosition = Vector2.new(0, selected.AbsolutePosition.Y - dirtPopper.AbsolutePosition.Y)
			
			focus, tap = TUT_UTILS.FocusFrameOnGuiObject(selected:FindFirstChild('Buy') :: TextButton)
			
			local purchased = false

			local statsConn; statsConn = DAT_Client:getChangedSignal('GadgetStats'):Connect(function(New)
				for gadget, data in New do
					if gadget:match('Treat') then
						if data.Bought > 0 then
							purchased = true
						end
					end
				end
			end)
			
			while not purchased do
				task.wait()
			end
			
			statsConn:Disconnect()

			if focus and tap then
				focus.Visible = false
				tap.Visible = false
			end

			if highlight then
				highlight:Destroy()
			end

			TUT_UTILS.DirectArrowsAt()
			
			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(16)
			
			updateObjective({
				Description = "Use the treat!"
			})
			
			while DAT_Client:get('TreatsUsed') < 1 do
				task.wait()
			end
			
			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(17)
		end

		local dayClaimed = DAT_Client:get('Daily').DayReached

		if dayClaimed == 0 then
			updateObjective({
				Description = "Claim today's daily reward!",
				RunFunc = function()
					gui.Daily.Visible = true
				end
			})

			toggleObjective(true)

			if not gui.Daily.Visible then
				local focus, tap = TUT_UTILS.FocusFrameOnGuiObject(gui.Sidebar.Daily)
				gui.Daily:GetPropertyChangedSignal('Visible'):Wait()
				tap.Visible = false
			end

			local focus, tap = TUT_UTILS.FocusFrameOnGuiObject(gui.Daily.Claim)

			while DAT_Client:get('Daily').DayReached == 0 do
				task.wait()
			end

			tap.Visible = false

			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(18)
		end
		
		updateObjective({
			Description = 'Like the game and join the group for 3000 SHELLS! Keep cleaning!',
			RunFunc = function()
				gui.LikeGame.Visible = true
			end
		})	
		
		toggleObjective(true)

		if not plr:IsInGroupAsync(348279) then
			gui.LikeGame.Visible = true

			local focus, tap = TUT_UTILS.FocusFrameOnGuiObject(gui.LikeGame.Objective.Like)

			while gui.LikeGame.Visible do
				task.wait()
			end

			tap.Visible = false

			while not plr:IsInGroupAsync(348279) do
				task.wait(1)
			end
			
			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(19)
		end
		
		--[[TWS:Create(objectiveFrame, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			GroupTransparency = 1
		}):Play()]]
	end)
end

return Objective
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1251"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">FreeRush</string><string name="ScriptGuid">{91d06b5c-cb3a-4fea-b6dc-2647ab84c96d}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local FreeRush = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')

local FSH_CONFIGS = require(RPS.Modules.Services.FishService.FishConfigs)
local RWD_UTILS = require(RPS.Modules.Services.RewardService.RewardUtils)
local DAT_Client = require(RPS.Modules.Packages.DataService).client

local plr = PLS.LocalPlayer :: Player
local mouse = plr:GetMouse()

local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local freeRush = gui:WaitForChild('FreeRush')
local timer = freeRush:WaitForChild('Timer'):WaitForChild('Amount')

local initSize = freeRush.Size

local tweens: {[Instance]: Tween} = {}

-- rotate button on hover
local function addButtonEffect(Button: TextButton)
	local colors = {
		Hover = Button:GetAttribute('Hover'),
		Neutral = Button:GetAttribute('Neutral')
	}

	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = -3,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1),
			BackgroundColor3 = colors.Hover
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = size,
			BackgroundColor3 = colors.Neutral
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- show free rush frane
local function show()
	freeRush.Size = UDim2.new()
	freeRush.Visible = true

	local tween = TWS:Create(freeRush, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {Size = initSize})
	tween:Play()
end

-- initialize free rush interface
function FreeRush:Init()
	local onboardingTutorial = DAT_Client:get('OnboardingTutorial')
	if onboardingTutorial.Finished then
		show()
	end

	DAT_Client:getChangedSignal('OnboardingTutorial'):Connect(function(NewData)
		if NewData.Finished then
			show()
		end
	end)
	
	addButtonEffect(freeRush)
	
	if DAT_Client:get('ClaimedFreeShellRush') then
		freeRush.Size = UDim2.fromScale(0,0)
		freeRush.Visible = false
	end
	
	RPS.Remotes.RewardService.UpdateFreeRushTimer.OnClientEvent:Connect(function(Timer)
		timer.Text = 'PLAY FOR '..RWD_UTILS.ToTimer2(Timer)
		
		if Timer <= 0 then
			local tween = TWS:Create(freeRush, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {Size = UDim2.fromScale(0,0)})
			tween:Play()
			
			freeRush.Interactable = false
			
			tween.Completed:Wait()
			freeRush.Visible = false
		end
	end)
end

return FreeRush
