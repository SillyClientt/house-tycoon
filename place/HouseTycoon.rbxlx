local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)

local AnalyticsServerSignals = {
	FlushEconomy = Signal() :: Signal.Signal<Player, string>,
	LogEconomy = Signal() :: Signal.Signal<Player, string,  Enum.AnalyticsEconomyFlowType, string, number, {[string]: number | string}?>,
	LogJourney = Signal() :: Signal.Signal<Player, string>
}

return AnalyticsServerSignals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW100"><Properties><string name="Name">AnalyticsServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local AnalyticsServiceServer = {}

local ANS = game:GetService('AnalyticsService')
local RPS = game:GetService('ReplicatedStorage')
local PLS = game:GetService('Players')

local ATC_SSignals = require(script.Parent.AnalyticsServerSignals)
local DAT_Server = require(RPS.Modules.Packages.DataService).server

local FLUSH_INTERVAL = 30

type PendingLog = {
	CustomData: {[string]: string | number}?,
	FlowType: Enum.AnalyticsEconomyFlowType,
	Amount: number,
	TransactionType: string
}

local pendingEconomyLogs: {[Player]: {[string]: PendingLog?}} = {}
local nodesCompleted: {[Player]: {[string]: boolean}} = {}

-- initialize analytics service server-side
function AnalyticsServiceServer:Init()
	ATC_SSignals.LogEconomy:Connect(function(Player, Economy, FlowType, TransactionType, Amount, CustomData)
		AnalyticsServiceServer:AddToPending(Player, Economy, FlowType, TransactionType, Amount, CustomData)
	end)

	ATC_SSignals.FlushEconomy:Connect(function(Player, Economy)
		AnalyticsServiceServer:Flush(Player, Economy)
	end)

	ATC_SSignals.LogJourney:Connect(function(Player, Node)
		AnalyticsServiceServer:LogJourney(Player, Node)
	end)

	PLS.PlayerAdded:Connect(function(Player)
		nodesCompleted[Player] = {}
	end)

	for _, player in PLS:GetPlayers() do
		nodesCompleted[player] = {}
	end

	PLS.PlayerRemoving:Connect(function(Player)
		AnalyticsServiceServer:FlushAll(Player)

		pendingEconomyLogs[Player] = nil
		nodesCompleted[Player] = nil
	end)

	-- send batched economy logs every so often
	task.spawn(function()
		while true do
			task.wait(FLUSH_INTERVAL)

			for _, player in PLS:GetPlayers() do
				AnalyticsServiceServer:FlushAll(player)
			end
		end
	end)
end

-- add to player pending economy log (same-type logs are added together)
function AnalyticsServiceServer:AddToPending(Player: Player, Economy: string, FlowType: Enum.AnalyticsEconomyFlowType, TransactionType: string, Amount: number, CustomData: {[string]: number | string}?)
	local plrLogs = pendingEconomyLogs[Player]

	if not plrLogs then
		plrLogs = {}
		pendingEconomyLogs[Player] = plrLogs
	end

	assert(plrLogs)

	local oldLog = plrLogs[Economy]

	if oldLog and (oldLog.FlowType ~= FlowType or oldLog.TransactionType ~= TransactionType or CustomData ~= nil) then
		AnalyticsServiceServer:Flush(Player, Economy)
		oldLog = nil
	end

	if oldLog then
		oldLog.Amount += Amount
	else
		plrLogs[Economy] = {
			FlowType = FlowType,
			TransactionType = TransactionType,
			Amount = Amount,
			CustomData = CustomData
		}
	end
end

-- flush player economy log
function AnalyticsServiceServer:Flush(Player: Player, Economy: string)
	local plrLogs = pendingEconomyLogs[Player]
	local pendingLog = plrLogs and plrLogs[Economy]

	if not plrLogs or not pendingLog then
		return
	end

	plrLogs[Economy] = nil

	if not DAT_Server:hasProfile(Player) then
		return
	end

	local endingBalance = DAT_Server:get(Player, 'Cash')

	pcall(function()
		ANS:LogEconomyEvent(Player, pendingLog.FlowType, Economy, pendingLog.Amount, endingBalance, pendingLog.TransactionType, nil, pendingLog.CustomData)
	end)
end

-- flush every pending economy log for a player
function AnalyticsServiceServer:FlushAll(Player: Player)
	local plrLogs = pendingEconomyLogs[Player]

	if not plrLogs then
		return
	end

	for economy in plrLogs do
		AnalyticsServiceServer:Flush(Player, economy)
	end
end

-- log a one-time milestone for a player session (e.g. 'SoldHouse')
function AnalyticsServiceServer:LogJourney(Player: Player, Node: string)
	local completed = nodesCompleted[Player]

	if not completed or completed[Node] then
		return
	end

	completed[Node] = true

	pcall(function()
		ANS:LogCustomEvent(Player, Node)
	end)
end

return AnalyticsServiceServer
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW104"><Properties><string name="Name">BuildService</string></Properties><Item class="ModuleScript" referent="NEW102"><Properties><string name="Name">BuildHistory</string><ProtectedString name="Source"><![CDATA[--!strict
-- remembers each player's last build actions so they can be undone (Ctrl+Z)
local BuildHistory = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')

local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)

export type Change = {
	Kind: string, -- 'Wall' | 'Floor' | 'Furniture'
	Level: number, -- unused for furniture (the item data has its own Level)
	Key: string, -- edge key, cell key or furniture id
	Before: any, -- data before the action (nil = nothing was there)
	After: any,
}

export type Action = {
	Changes: {Change},
	Spent: number, -- cash the action cost (negative when it paid the player back)
}

local stacks: {[Player]: {Action}} = {}

PLS.PlayerRemoving:Connect(function(Player)
	stacks[Player] = nil
end)

-- save an action
function BuildHistory.Record(Player: Player, Changes: {Change}, Spent: number)
	if #Changes == 0 then
		return
	end

	local stack = stacks[Player] or {}
	stacks[Player] = stack

	table.insert(stack, {Changes = Changes, Spent = Spent})

	while #stack > BLD_CONFIGS.UndoSteps do
		table.remove(stack, 1)
	end
end

-- take the last action off the stack
function BuildHistory.Pop(Player: Player): Action?
	local stack = stacks[Player]

	return stack and table.remove(stack)
end

-- put an action back (used when an undo can't happen)
function BuildHistory.Push(Player: Player, Action: Action)
	local stack = stacks[Player] or {}
	stacks[Player] = stack

	table.insert(stack, Action)
end

-- forget everything (used when the land is swapped, e.g. a house was sold)
function BuildHistory.Clear(Player: Player)
	stacks[Player] = nil
end

return BuildHistory
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW103"><Properties><string name="Name">BuildServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local BuildServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local SSG = game:GetService('ServerStorage')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local BLD_UTILS = require(RPS.Modules.Utils.BuildUtils)
local FUR_UTILS = require(RPS.Modules.Utils.FurnitureUtils)
local HSE_UTILS = require(RPS.Modules.Utils.HouseUtils)
local LND_UTILS = require(RPS.Modules.Utils.LandUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local HSE_Server = require(SSG.Modules.Services.HouseService.HouseServiceServer)
local ECN_Server = require(SSG.Modules.Services.EconomyService.EconomyServiceServer)
local ATC_SSignals = require(SSG.Modules.Services.AnalyticsService.AnalyticsServerSignals)

local BLD_HISTORY = require(script.Parent.BuildHistory)

local remotes = RPS.Remotes.BuildService

local REQUEST_COOLDOWN = 0.1
local MAX_WALLS_PER_LEVEL = 2500
local RED = Color3.fromRGB(235, 80, 80)

local lastRequest: {[Player]: number} = {}

-- send a message to the player
local function notify(Player: Player, Text: string)
	RPS.Remotes.InterfaceService.Notify:FireClient(Player, Text, RED)
end

-- check request (rate limit + land loaded)
local function checkRequest(Player: Player): boolean
	local now = os.clock()

	if now - (lastRequest[Player] or 0) < REQUEST_COOLDOWN then
		return false
	end

	lastRequest[Player] = now

	return HSE_Server:IsReady(Player)
end

-- check a value is a whole number
local function isInteger(Value: any): boolean
	return typeof(Value) == 'number' and Value == Value and Value % 1 == 0 and math.abs(Value) < 10000
end

-- check a floor number is unlocked
local function isLevelUnlocked(Player: Player, Level: any): boolean
	return isInteger(Level) and Level >= 1 and Level <= DAT_Server:get(Player, 'Levels')
end

-- count the keys in a table
local function count(Dictionary: {[string]: any}): number
	local total = 0

	for _ in Dictionary do
		total += 1
	end

	return total
end

-- data path of a wall or floor
local function piecePath(Kind: 'Wall' | 'Floor', Level: number, Key: string): {string}
	return {'Land', 'Levels', GRD_UTILS.LevelKey(Level), if Kind == 'Wall' then 'Walls' else 'Floors', Key}
end

-- write a wall / floor / furniture value and redraw it
local function applyChange(Player: Player, Change: BLD_HISTORY.Change, Value: any)
	if Change.Kind == 'Furniture' then
		DAT_Server:set(Player, {'Land', 'Furniture', Change.Key}, if Value then table.clone(Value) else nil)
		HSE_Server:RenderFurniture(Player, Change.Key)
	elseif Change.Kind == 'Wall' then
		DAT_Server:set(Player, piecePath('Wall', Change.Level, Change.Key), if Value then table.clone(Value) else nil)
		HSE_Server:RenderWall(Player, Change.Level, Change.Key)
	else
		DAT_Server:set(Player, piecePath('Floor', Change.Level, Change.Key), Value)
		HSE_Server:RenderFloor(Player, Change.Level, Change.Key)
	end
end

-- pay for a list of changes, apply them and remember them for undo
local function commit(Player: Player, Changes: {BLD_HISTORY.Change}, Cost: number, Refund: number, Tag: string): boolean
	if #Changes == 0 then
		return false
	end

	if not ECN_Server:TryDeduct(Player, Cost, Tag) then
		return false
	end

	if Refund > 0 then
		ECN_Server:Reward(Player, {Cash = Refund}, 'Refund')
	end

	for _, change in Changes do
		applyChange(Player, change, change.After)
	end

	BLD_HISTORY.Record(Player, Changes, Cost - Refund)

	return true
end

-- check a wall line can be built on (owned, not locked, supported upstairs)
local function checkEdge(Player: Player, Land: DAT_TYPES.LandData, Parcels: {[string]: boolean}, Level: number, Edge: string): string?
	if not LND_UTILS.IsEdgeOwned(Parcels, Edge) then
		return 'Buy this land first'
	end

	if HSE_Server:IsEdgeLocked(Player, Edge) then
		return 'locked'
	end

	-- walls upstairs need a floor next to them (here or below)
	if Level > 1 then
		local levelData = HSE_UTILS.GetLevel(Land, Level)
		local belowData = HSE_UTILS.GetLevel(Land, Level - 1)
		local a, b = GRD_UTILS.EdgeCells(Edge)

		if not (levelData.Floors[a] or levelData.Floors[b] or belowData.Floors[a] or belowData.Floors[b]) then
			return 'Walls upstairs need a floor next to them'
		end
	end

	return nil
end

-- tell the player why a check failed
local function reject(Player: Player, Reason: string)
	if Reason == 'locked' then
		HSE_Server:NotifyLocked(Player)
	else
		notify(Player, Reason)
	end
end

-- initialize build service server-side
function BuildServiceServer:Init()
	remotes.PlaceWalls.OnServerEvent:Connect(function(Player, Level, Kind, Style, AX, AZ, BX, BZ)
		BuildServiceServer:PlaceWalls(Player, Level, Kind, Style, AX, AZ, BX, BZ)
	end)

	remotes.PlaceFloors.OnServerEvent:Connect(function(Player, Level, Style, AX, AZ, BX, BZ)
		BuildServiceServer:PlaceFloors(Player, Level, Style, AX, AZ, BX, BZ)
	end)

	remotes.PlaceRoom.OnServerEvent:Connect(function(Player, Level, WallStyle, FloorStyle, AX, AZ, BX, BZ)
		BuildServiceServer:PlaceRoom(Player, Level, WallStyle, FloorStyle, AX, AZ, BX, BZ)
	end)

	remotes.RemovePiece.OnServerEvent:Connect(function(Player, Level, Piece, Key)
		BuildServiceServer:RemovePiece(Player, Level, Piece, Key)
	end)

	remotes.Undo.OnServerEvent:Connect(function(Player)
		BuildServiceServer:Undo(Player)
	end)

	PLS.PlayerRemoving:Connect(function(Player)
		lastRequest[Player] = nil
	end)
end

-- place a straight line of walls, windows or doors between two grid points
-- (also used to turn one wall into a door/window, or to repaint it)
function BuildServiceServer:PlaceWalls(Player: Player, Level: any, Kind: any, Style: any, AX: any, AZ: any, BX: any, BZ: any)
	if typeof(Kind) ~= 'string' or typeof(Style) ~= 'string' then
		return
	end

	if not isInteger(AX) or not isInteger(AZ) or not isInteger(BX) or not isInteger(BZ) then
		return
	end

	if not BLD_CONFIGS.WallKinds[Kind] or not BLD_CONFIGS.WallStyles[Style] then
		return
	end

	if not checkRequest(Player) or not isLevelUnlocked(Player, Level) then
		return
	end

	local edges = GRD_UTILS.EdgesBetween(AX, AZ, BX, BZ)

	if #edges == 0 or #edges > BLD_CONFIGS.MaxDragCells then
		return
	end

	local land = HSE_Server:GetLand(Player)
	local parcels = DAT_Server:get(Player, 'Parcels')
	local levelData = HSE_UTILS.GetLevel(land, Level)
	local newWall: DAT_TYPES.WallData = {Kind = Kind :: any, Style = Style}

	local changes: {BLD_HISTORY.Change} = {}
	local cost, refund = 0, 0

	for _, edge in edges do
		local problem = checkEdge(Player, land, parcels, Level, edge)

		if problem then
			reject(Player, problem)
			return
		end

		local old = levelData.Walls[edge]

		if old and old.Kind == newWall.Kind and old.Style == newWall.Style then
			continue
		end

		table.insert(changes, {Kind = 'Wall', Level = Level, Key = edge, Before = old and table.clone(old), After = newWall})
		cost += BLD_UTILS.GetWallCost(newWall)

		if old then
			refund += math.floor(BLD_UTILS.GetWallCost(old) * BLD_CONFIGS.RefundRate)
		end
	end

	if count(levelData.Walls) + #changes > MAX_WALLS_PER_LEVEL then
		notify(Player, 'Wall limit reached')
		return
	end

	if commit(Player, changes, cost, refund, 'BuildWall') then
		ATC_SSignals.LogJourney:Fire(Player, 'PlacedWall')
	end
end

-- work out the floor changes for a set of cells (nil + reason when not allowed)
local function planFloors(Player: Player, Land: DAT_TYPES.LandData, Level: number, Style: string, Cells: {string}): ({BLD_HISTORY.Change}?, number, number, string?)
	local parcels = DAT_Server:get(Player, 'Parcels')
	local levelData = HSE_UTILS.GetLevel(Land, Level)
	local belowData = HSE_UTILS.GetLevel(Land, Level - 1)
	local stairwells = FUR_UTILS.GetStairwells(Land)
	local styleConfig = BLD_CONFIGS.FloorStyles[Style]

	local changes: {BLD_HISTORY.Change} = {}
	local cost, refund = 0, 0

	for _, cell in Cells do
		if not LND_UTILS.IsCellOwned(parcels, cell) then
			return nil, 0, 0, 'Buy this land first'
		end

		if HSE_Server:IsColumnLocked(Player, cell) then
			return nil, 0, 0, 'locked'
		end

		-- stair openings stay open
		if stairwells[GRD_UTILS.LevelCell(Level, cell)] then
			continue
		end

		if Level > 1 and not belowData.Floors[cell] then
			return nil, 0, 0, 'Upstairs floors need a floor below them'
		end

		local old = levelData.Floors[cell]

		if old == Style then
			continue
		end

		table.insert(changes, {Kind = 'Floor', Level = Level, Key = cell, Before = old, After = Style})
		cost += styleConfig.Cost

		local oldConfig = old and BLD_CONFIGS.FloorStyles[old]

		if oldConfig then
			refund += math.floor(oldConfig.Cost * BLD_CONFIGS.RefundRate)
		end
	end

	return changes, cost, refund, nil
end

-- fill a rectangle of cells with floor (also used to repaint one tile)
function BuildServiceServer:PlaceFloors(Player: Player, Level: any, Style: any, AX: any, AZ: any, BX: any, BZ: any)
	if typeof(Style) ~= 'string' or not BLD_CONFIGS.FloorStyles[Style] then
		return
	end

	if not isInteger(AX) or not isInteger(AZ) or not isInteger(BX) or not isInteger(BZ) then
		return
	end

	local maxCells = BLD_CONFIGS.MaxDragCells

	if math.abs(AX - BX) >= maxCells or math.abs(AZ - BZ) >= maxCells then
		return
	end

	if not checkRequest(Player) or not isLevelUnlocked(Player, Level) then
		return
	end

	local land = HSE_Server:GetLand(Player)
	local changes, cost, refund, problem = planFloors(Player, land, Level, Style, GRD_UTILS.CellsBetween(AX, AZ, BX, BZ))

	if problem or not changes then
		reject(Player, problem or 'Can\'t build there')
		return
	end

	if commit(Player, changes, cost, refund, 'BuildFloor') then
		ATC_SSignals.LogJourney:Fire(Player, 'PlacedFloor')
	end
end

-- build a whole room: walls around the rectangle, floor inside and a door at the front
function BuildServiceServer:PlaceRoom(Player: Player, Level: any, WallStyle: any, FloorStyle: any, AX: any, AZ: any, BX: any, BZ: any)
	if typeof(WallStyle) ~= 'string' or not BLD_CONFIGS.WallStyles[WallStyle] then
		return
	end

	if typeof(FloorStyle) ~= 'string' or not BLD_CONFIGS.FloorStyles[FloorStyle] then
		return
	end

	if not isInteger(AX) or not isInteger(AZ) or not isInteger(BX) or not isInteger(BZ) then
		return
	end

	local minX, maxX = math.min(AX, BX), math.max(AX, BX)
	local minZ, maxZ = math.min(AZ, BZ), math.max(AZ, BZ)
	local maxCells = BLD_CONFIGS.MaxDragCells

	if maxX - minX >= maxCells or maxZ - minZ >= maxCells then
		return
	end

	if maxX == minX and maxZ == minZ then
		notify(Player, 'Drag out a room at least 2 tiles big')
		return
	end

	if not checkRequest(Player) or not isLevelUnlocked(Player, Level) then
		return
	end

	local land = HSE_Server:GetLand(Player)
	local parcels = DAT_Server:get(Player, 'Parcels')
	local levelData = HSE_UTILS.GetLevel(land, Level)

	-- floor first (also checks the land and upstairs support)
	local changes, cost, refund, problem = planFloors(Player, land, Level, FloorStyle, GRD_UTILS.CellsBetween(minX, minZ, maxX, maxZ))

	if problem or not changes then
		reject(Player, problem or 'Can\'t build there')
		return
	end

	assert(changes)

	-- walls all the way round (existing walls, doors and windows are kept)
	local perimeter: {string} = {}

	for x = minX, maxX do
		table.insert(perimeter, GRD_UTILS.EdgeKey('X', x, minZ))
		table.insert(perimeter, GRD_UTILS.EdgeKey('X', x, maxZ + 1))
	end

	for z = minZ, maxZ do
		table.insert(perimeter, GRD_UTILS.EdgeKey('Z', minX, z))
		table.insert(perimeter, GRD_UTILS.EdgeKey('Z', maxX + 1, z))
	end

	local hasDoor = false

	for _, edge in perimeter do
		local old = levelData.Walls[edge]

		if old and old.Kind == 'Door' then
			hasDoor = true
		end
	end

	-- the door goes in the middle of the side facing the road (+Z)
	local doorEdge = if hasDoor then nil else GRD_UTILS.EdgeKey('X', math.floor((minX + maxX) / 2), maxZ + 1)

	for _, edge in perimeter do
		local old = levelData.Walls[edge]
		local wantDoor = edge == doorEdge

		if old and not wantDoor then
			continue
		end

		local edgeProblem = checkEdge(Player, land, parcels, Level, edge)

		if edgeProblem and edgeProblem ~= 'Walls upstairs need a floor next to them' then
			reject(Player, edgeProblem)
			return
		end

		local newWall: DAT_TYPES.WallData = {Kind = if wantDoor then 'Door' else 'Wall', Style = if old then old.Style else WallStyle}

		table.insert(changes, {Kind = 'Wall', Level = Level, Key = edge, Before = old and table.clone(old), After = newWall})
		cost += BLD_UTILS.GetWallCost(newWall)

		if old then
			refund += math.floor(BLD_UTILS.GetWallCost(old) * BLD_CONFIGS.RefundRate)
		end
	end

	if commit(Player, changes, cost, refund, 'BuildRoom') then
		ATC_SSignals.LogJourney:Fire(Player, 'PlacedRoom')
	end
end

-- check nothing rests on a floor tile (floor above, furniture on it)
local function getFloorBlocker(Land: DAT_TYPES.LandData, Level: number, Key: string): string?
	if HSE_UTILS.GetLevel(Land, Level + 1).Floors[Key] then
		return 'Remove the floor above first'
	end

	for _, item in Land.Furniture do
		if item.Level == Level then
			for _, cell in FUR_UTILS.GetCoveredCells(item.Name, item.X, item.Z, item.Rotation) do
				if cell == Key then
					return 'Move the furniture off this tile first'
				end
			end
		end
	end

	return nil
end

-- remove one wall or floor piece and refund part of its cost
function BuildServiceServer:RemovePiece(Player: Player, Level: any, Piece: any, Key: any)
	if typeof(Key) ~= 'string' or (Piece ~= 'Wall' and Piece ~= 'Floor') then
		return
	end

	if not checkRequest(Player) or not isLevelUnlocked(Player, Level) then
		return
	end

	local land = HSE_Server:GetLand(Player)
	local levelData = HSE_UTILS.GetLevel(land, Level)

	if Piece == 'Wall' then
		local wall = levelData.Walls[Key]

		if not wall then
			return
		end

		if HSE_Server:IsEdgeLocked(Player, Key) then
			HSE_Server:NotifyLocked(Player)
			return
		end

		local refund = math.floor(BLD_UTILS.GetWallCost(wall) * BLD_CONFIGS.RefundRate)

		commit(Player, {{Kind = 'Wall', Level = Level, Key = Key, Before = table.clone(wall), After = nil}}, 0, refund, 'Remove')
	else
		local style = levelData.Floors[Key]
		local config = style and BLD_CONFIGS.FloorStyles[style]

		if not config then
			return
		end

		if HSE_Server:IsColumnLocked(Player, Key) then
			HSE_Server:NotifyLocked(Player)
			return
		end

		local blocker = getFloorBlocker(land, Level, Key)

		if blocker then
			notify(Player, blocker)
			return
		end

		local refund = math.floor(config.Cost * BLD_CONFIGS.RefundRate)

		commit(Player, {{Kind = 'Floor', Level = Level, Key = Key, Before = style, After = nil}}, 0, refund, 'Remove')

		-- dirt can't float in the air
		for id, dirt in land.Dirt do
			if dirt.Level == Level and dirt.Cell == Key then
				DAT_Server:set(Player, {'Land', 'Dirt', id}, nil)
				HSE_Server:RenderDirt(Player, id)
			end
		end
	end
end

-- check a change touches nothing that is locked (on the market or rented)
local function isChangeLocked(Player: Player, Change: BLD_HISTORY.Change): boolean
	if Change.Kind == 'Wall' then
		return HSE_Server:IsEdgeLocked(Player, Change.Key)
	elseif Change.Kind == 'Floor' then
		return HSE_Server:IsColumnLocked(Player, Change.Key)
	end

	for _, item in {Change.Before, Change.After} do
		if item then
			for _, cell in FUR_UTILS.GetCoveredCells(item.Name, item.X, item.Z, item.Rotation) do
				if HSE_Server:IsColumnLocked(Player, cell) then
					return true
				end
			end
		end
	end

	return false
end

-- undo the last build action (cash goes back exactly as it was)
function BuildServiceServer:Undo(Player: Player)
	if not checkRequest(Player) then
		return
	end

	local action = BLD_HISTORY.Pop(Player)

	if not action then
		notify(Player, 'Nothing to undo')
		return
	end

	assert(action)

	for _, change in action.Changes do
		if isChangeLocked(Player, change) then
			HSE_Server:NotifyLocked(Player)
			return
		end
	end

	-- give back what it cost, or take back what it refunded
	if action.Spent < 0 then
		if not ECN_Server:TryDeduct(Player, -action.Spent, 'Undo') then
			BLD_HISTORY.Push(Player, action)
			return
		end
	elseif action.Spent > 0 then
		ECN_Server:Reward(Player, {Cash = action.Spent}, 'Refund')
	end

	for index = #action.Changes, 1, -1 do
		local change = action.Changes[index]
		applyChange(Player, change, change.Before)
	end
end

-- let other services add to the undo history (furniture)
function BuildServiceServer:Record(Player: Player, Changes: {BLD_HISTORY.Change}, Spent: number)
	BLD_HISTORY.Record(Player, Changes, Spent)
end

return BuildServiceServer
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW106"><Properties><string name="Name">CleaningService</string></Properties><Item class="ModuleScript" referent="NEW105"><Properties><string name="Name">CleaningServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local CleaningServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local SSG = game:GetService('ServerStorage')
local HTP = game:GetService('HttpService')
local PPS = game:GetService('ProximityPromptService')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local MKT_CONFIGS = require(RPS.Modules.Configs.MarketConfigs)
local MON_CONFIGS = require(RPS.Modules.Configs.MonetizationConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local HSE_UTILS = require(RPS.Modules.Utils.HouseUtils)
local MON_UTILS = require(RPS.Modules.Utils.MonetizationUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local HSE_Server = require(SSG.Modules.Services.HouseService.HouseServiceServer)
local ATC_SSignals = require(SSG.Modules.Services.AnalyticsService.AnalyticsServerSignals)

local DIRT_KINDS: {CFG_TYPES.DirtKind} = {'Dust', 'Stain', 'Trash'}

local random = Random.new()

-- seconds since each house last got dirty: [player][house id]
local timers: {[Player]: {[string]: number}} = {}
local autoCleanTimers: {[Player]: number} = {}

-- initialize cleaning service server-side
function CleaningServiceServer:Init()
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		CleaningServiceServer:OnPrompt(Prompt, Player)
	end)

	PLS.PlayerRemoving:Connect(function(Player)
		timers[Player] = nil
		autoCleanTimers[Player] = nil
	end)

	task.spawn(function()
		while true do
			local waited = task.wait(MKT_CONFIGS.DirtTick)

			for _, player in PLS:GetPlayers() do
				if HSE_Server:IsReady(player) then
					CleaningServiceServer:Tick(player, waited)
				end
			end
		end
	end)
end

-- dirt builds up in every house over time
function CleaningServiceServer:Tick(Player: Player, DT: number)
	local houses = HSE_Server:GetHouses(Player)
	local rentals = DAT_Server:get(Player, 'Rentals')
	local playerTimers = timers[Player] or {}
	local seen: {[string]: number} = {}

	timers[Player] = playerTimers

	for _, house in houses do
		local interval = if rentals[house.Id] then MKT_CONFIGS.DirtInterval.Rented else MKT_CONFIGS.DirtInterval.Other
		local elapsed = (playerTimers[house.Id] or 0) + DT

		if elapsed >= interval then
			elapsed = 0

			if house.DirtCount < HSE_UTILS.GetMaxDirt(house.CellCount) then
				CleaningServiceServer:SpawnDirt(Player, house)
			end
		end

		seen[house.Id] = elapsed
	end

	-- forget houses that no longer exist
	timers[Player] = seen

	-- Auto Cleaner gamepass
	if MON_UTILS.HasPass(Player, 'AutoCleaner') then
		local autoElapsed = (autoCleanTimers[Player] or 0) + DT

		if autoElapsed >= MON_CONFIGS.AutoCleanInterval then
			autoElapsed = 0

			local id = next(HSE_Server:GetLand(Player).Dirt)

			if id then
				CleaningServiceServer:CleanDirt(Player, id)
			end
		end

		autoCleanTimers[Player] = autoElapsed
	end
end

-- put a dirt spot on a random clean floor tile of a house
function CleaningServiceServer:SpawnDirt(Player: Player, House: DAT_TYPES.HouseInfo)
	local land = HSE_Server:GetLand(Player)
	local dirty: {[string]: boolean} = {}

	for _, dirt in land.Dirt do
		dirty[GRD_UTILS.LevelCell(dirt.Level, dirt.Cell)] = true
	end

	local options: {string} = {}

	for levelCell in House.Cells do
		local level, cell = GRD_UTILS.ParseLevelCell(levelCell)

		if not dirty[levelCell] and HSE_UTILS.GetLevel(land, level).Floors[cell] then
			table.insert(options, levelCell)
		end
	end

	if #options == 0 then
		return
	end

	local level, cell = GRD_UTILS.ParseLevelCell(options[random:NextInteger(1, #options)])
	local id = HTP:GenerateGUID(false)
	local dirt: DAT_TYPES.DirtData = {
		Level = level,
		Cell = cell,
		Kind = DIRT_KINDS[random:NextInteger(1, #DIRT_KINDS)],
	}

	DAT_Server:set(Player, {'Land', 'Dirt', id}, dirt)
	HSE_Server:RenderDirt(Player, id)
end

-- remove a dirt spot
function CleaningServiceServer:CleanDirt(Player: Player, Id: string)
	if not HSE_Server:GetLand(Player).Dirt[Id] then
		return
	end

	DAT_Server:set(Player, {'Land', 'Dirt', Id}, nil)
	HSE_Server:RenderDirt(Player, Id)

	DAT_Server:update(Player, {'Stats', 'DirtCleaned'}, function(Old)
		return Old + 1
	end)

	ATC_SSignals.LogJourney:Fire(Player, 'CleanedDirt')
end

-- a player held the Clean prompt on a dirt spot
function CleaningServiceServer:OnPrompt(Prompt: ProximityPrompt, Player: Player)
	if Prompt.Name ~= 'CleanPrompt' then
		return
	end

	local spot = Prompt.Parent
	local landFolder = HSE_Server:GetLandFolder(Player)

	-- only the owner can clean their own houses
	if not spot or not landFolder or not spot:IsDescendantOf(landFolder) then
		return
	end

	CleaningServiceServer:CleanDirt(Player, spot.Name)
end

return CleaningServiceServer
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW109"><Properties><string name="Name">EconomyService</string></Properties><Item class="ModuleScript" referent="NEW107"><Properties><string name="Name">EconomyServerSignals</string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local Signal = require(RPS.Modules.Packages.Signal)

local EconomyServerSignals = {
	Reward = Signal() :: Signal.Signal<Player, CFG_TYPES.RewardConfig, string?>,
	Deduct = Signal() :: Signal.Signal<Player, CFG_TYPES.DeductionConfig, string?>,
}

return EconomyServerSignals
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW108"><Properties><string name="Name">EconomyServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local EconomyServiceServer = {}

local RPS = game:GetService('ReplicatedStorage')
local SSG = game:GetService('ServerStorage')

local ECN_SSignals = require(script.Parent.EconomyServerSignals)
local DAT_Server = require(RPS.Modules.Packages.DataService).server
local ATC_SSignals = require(SSG.Modules.Services.AnalyticsService.AnalyticsServerSignals)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)

-- initialize economy service server-side
function EconomyServiceServer:Init()
	ECN_SSignals.Reward:Connect(function(Player, Reward, Tag)
		EconomyServiceServer:Reward(Player, Reward, Tag)
	end)

	ECN_SSignals.Deduct:Connect(function(Player, Deduction, Tag)
		EconomyServiceServer:Deduct(Player, Deduction, Tag)
	end)
end

-- get a player's cash
function EconomyServiceServer:GetCash(Player: Player): number
	return DAT_Server:get(Player, 'Cash') or 0
end

-- reward using reward config
function EconomyServiceServer:Reward(Player: Player, RewardConfig: CFG_TYPES.RewardConfig, Tag: string?)
	local transaction = RewardConfig.Transaction or Enum.AnalyticsEconomyTransactionType.Gameplay
	local amount: number = RewardConfig.Cash or 0

	if amount <= 0 then
		return
	end

	local new = DAT_Server:update(Player, 'Cash', function(Old)
		return Old + amount
	end)

	ATC_SSignals.LogEconomy:Fire(Player, 'Cash', Enum.AnalyticsEconomyFlowType.Source, transaction.Name, amount)
	RPS.Remotes.EconomyService.Rewarded:FireClient(Player, 'Cash', amount, new, Tag)
end

-- deduct using deduction config (does not check the player can afford it)
function EconomyServiceServer:Deduct(Player: Player, DeductionConfig: CFG_TYPES.DeductionConfig, Tag: string?)
	local transaction = DeductionConfig.Transaction or Enum.AnalyticsEconomyTransactionType.Shop
	local amount: number = DeductionConfig.Cash or 0

	if amount <= 0 then
		return
	end

	local new = DAT_Server:update(Player, 'Cash', function(Old)
		return Old - amount
	end)

	ATC_SSignals.LogEconomy:Fire(Player, 'Cash', Enum.AnalyticsEconomyFlowType.Sink, transaction.Name, amount)
	RPS.Remotes.EconomyService.Deducted:FireClient(Player, 'Cash', amount, new, Tag)
end

-- deduct only if the player can afford it, returns whether it went through
function EconomyServiceServer:TryDeduct(Player: Player, Amount: number, Tag: string?): boolean
	if Amount <= 0 then
		return true
	end

	if EconomyServiceServer:GetCash(Player) < Amount then
		RPS.Remotes.InterfaceService.Notify:FireClient(Player, 'Not enough cash!', Color3.fromRGB(235, 80, 80))
		return false
	end

	EconomyServiceServer:Deduct(Player, {Cash = Amount}, Tag)

	return true
end

return EconomyServiceServer
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW111"><Properties><string name="Name">FurnitureService</string></Properties><Item class="ModuleScript" referent="NEW110"><Properties><string name="Name">FurnitureServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local FurnitureServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local SSG = game:GetService('ServerStorage')
local HTP = game:GetService('HttpService')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local FUR_CONFIGS = require(RPS.Modules.Configs.FurnitureConfigs)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local FUR_UTILS = require(RPS.Modules.Utils.FurnitureUtils)
local MON_UTILS = require(RPS.Modules.Utils.MonetizationUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local HSE_Server = require(SSG.Modules.Services.HouseService.HouseServiceServer)
local ECN_Server = require(SSG.Modules.Services.EconomyService.EconomyServiceServer)
local ATC_SSignals = require(SSG.Modules.Services.AnalyticsService.AnalyticsServerSignals)
local BLD_HISTORY = require(SSG.Modules.Services.BuildService.BuildHistory)

local remotes = RPS.Remotes.FurnitureService

local REQUEST_COOLDOWN = 0.15
local MAX_FURNITURE = 400
local RED = Color3.fromRGB(235, 80, 80)

local lastRequest: {[Player]: number} = {}

-- check request (rate limit + land loaded)
local function checkRequest(Player: Player): boolean
	local now = os.clock()

	if now - (lastRequest[Player] or 0) < REQUEST_COOLDOWN then
		return false
	end

	lastRequest[Player] = now

	return HSE_Server:IsReady(Player)
end

-- check a value is a usable plot-local position
local function isPosition(Value: any): boolean
	return typeof(Value) == 'number' and Value == Value and math.abs(Value) < 1000
end

-- check a value is a whole floor number
local function isLevel(Value: any): boolean
	return typeof(Value) == 'number' and Value == Value and Value % 1 == 0 and Value >= 1 and Value <= 10
end

-- round to 2 decimals so saved data stays small
local function round(Value: number): number
	return math.floor(Value * 100 + 0.5) / 100
end

-- tell the player why an item can't go there
local function notifyBlocked(Player: Player, Reason: string?)
	RPS.Remotes.InterfaceService.Notify:FireClient(Player, Reason or "Can't place that there", RED)
end

-- check none of the tiles an item covers belong to a locked house
local function isAreaLocked(Player: Player, Name: string, X: number, Z: number, Rotation: number): boolean
	for _, cell in FUR_UTILS.GetCoveredCells(Name, X, Z, Rotation) do
		if HSE_Server:IsColumnLocked(Player, cell) then
			return true
		end
	end

	return false
end

-- check the player may use an item (premium unlocked / VIP pass)
function FurnitureServiceServer:HasAccess(Player: Player, Name: string): boolean
	local config = FUR_CONFIGS.Items[Name]

	if not config then
		return false
	end

	if config.Premium and not DAT_Server:get(Player, {'UnlockedItems', Name}) then
		return false
	end

	if config.Vip and not MON_UTILS.HasPass(Player, 'VipFurniture') then
		return false
	end

	return true
end

-- initialize furniture service server-side
function FurnitureServiceServer:Init()
	remotes.PlaceFurniture.OnServerEvent:Connect(function(Player, Name, Level, X, Z, Rotation)
		FurnitureServiceServer:PlaceFurniture(Player, Name, Level, X, Z, Rotation)
	end)

	remotes.MoveFurniture.OnServerEvent:Connect(function(Player, Id, Level, X, Z, Rotation)
		FurnitureServiceServer:MoveFurniture(Player, Id, Level, X, Z, Rotation)
	end)

	remotes.RotateFurniture.OnServerEvent:Connect(function(Player, Id)
		FurnitureServiceServer:RotateFurniture(Player, Id)
	end)

	remotes.RemoveFurniture.OnServerEvent:Connect(function(Player, Id)
		FurnitureServiceServer:RemoveFurniture(Player, Id)
	end)

	PLS.PlayerRemoving:Connect(function(Player)
		lastRequest[Player] = nil
	end)
end

-- buy and place a new item
function FurnitureServiceServer:PlaceFurniture(Player: Player, Name: any, Level: any, X: any, Z: any, Rotation: any)
	if typeof(Name) ~= 'string' or not isLevel(Level) or not isPosition(X) or not isPosition(Z) or typeof(Rotation) ~= 'number' then
		return
	end

	local config = FUR_CONFIGS.Items[Name]

	if not config or not checkRequest(Player) then
		return
	end

	if not FurnitureServiceServer:HasAccess(Player, Name) then
		notifyBlocked(Player, if config.Vip then 'Needs the VIP Furniture pass' else 'Unlock this item in the shop first')
		return
	end

	local land = HSE_Server:GetLand(Player)
	local total = 0

	for _ in land.Furniture do
		total += 1
	end

	if total >= MAX_FURNITURE then
		notifyBlocked(Player, 'Furniture limit reached')
		return
	end

	local x, z = round(X), round(Z)

	if isAreaLocked(Player, Name, x, z, Rotation) then
		HSE_Server:NotifyLocked(Player)
		return
	end

	local canPlace, reason = FUR_UTILS.CanPlace(land, HSE_Server:GetContext(Player), Name, Level, x, z, Rotation)

	if not canPlace then
		notifyBlocked(Player, reason)
		return
	end

	if not ECN_Server:TryDeduct(Player, config.Price, 'BuyFurniture') then
		return
	end

	local id = HTP:GenerateGUID(false)
	local item: DAT_TYPES.FurnitureData = {
		Name = Name,
		Level = Level,
		X = x,
		Z = z,
		Rotation = Rotation,
	}

	DAT_Server:set(Player, {'Land', 'Furniture', id}, item)
	HSE_Server:RenderFurniture(Player, id)

	BLD_HISTORY.Record(Player, {{Kind = 'Furniture', Level = Level, Key = id, Before = nil, After = table.clone(item)}}, config.Price)

	ATC_SSignals.LogJourney:Fire(Player, 'PlacedFurniture')
end

-- move (and optionally turn) an item the player already owns
function FurnitureServiceServer:MoveFurniture(Player: Player, Id: any, Level: any, X: any, Z: any, Rotation: any)
	if typeof(Id) ~= 'string' or not isLevel(Level) or not isPosition(X) or not isPosition(Z) or typeof(Rotation) ~= 'number' then
		return
	end

	if not checkRequest(Player) then
		return
	end

	local land = HSE_Server:GetLand(Player)
	local item = land.Furniture[Id]

	if not item then
		return
	end

	local x, z = round(X), round(Z)

	-- both the old and new spot must be editable
	if isAreaLocked(Player, item.Name, item.X, item.Z, item.Rotation) or isAreaLocked(Player, item.Name, x, z, Rotation) then
		HSE_Server:NotifyLocked(Player)
		return
	end

	local canPlace, reason = FUR_UTILS.CanPlace(land, HSE_Server:GetContext(Player), item.Name, Level, x, z, Rotation, Id)

	if not canPlace then
		notifyBlocked(Player, reason)
		return
	end

	local moved = table.clone(item)
	moved.Level = Level
	moved.X = x
	moved.Z = z
	moved.Rotation = Rotation

	DAT_Server:set(Player, {'Land', 'Furniture', Id}, moved)
	HSE_Server:RenderFurniture(Player, Id)

	BLD_HISTORY.Record(Player, {{Kind = 'Furniture', Level = Level, Key = Id, Before = table.clone(item), After = table.clone(moved)}}, 0)
end

-- turn an item 90 degrees
function FurnitureServiceServer:RotateFurniture(Player: Player, Id: any)
	if typeof(Id) ~= 'string' or not HSE_Server:IsReady(Player) then
		return
	end

	local item = HSE_Server:GetLand(Player).Furniture[Id]

	if not item then
		return
	end

	FurnitureServiceServer:MoveFurniture(Player, Id, item.Level, item.X, item.Z, (item.Rotation + 90) % 360)
end

-- remove an item and refund part of its price
function FurnitureServiceServer:RemoveFurniture(Player: Player, Id: any)
	if typeof(Id) ~= 'string' or not checkRequest(Player) then
		return
	end

	local item = HSE_Server:GetLand(Player).Furniture[Id]

	if not item then
		return
	end

	if isAreaLocked(Player, item.Name, item.X, item.Z, item.Rotation) then
		HSE_Server:NotifyLocked(Player)
		return
	end

	DAT_Server:set(Player, {'Land', 'Furniture', Id}, nil)
	HSE_Server:RenderFurniture(Player, Id)

	local config = FUR_CONFIGS.Items[item.Name]
	local refund = if config then math.floor(config.Price * BLD_CONFIGS.RefundRate) else 0

	if refund > 0 then
		ECN_Server:Reward(Player, {Cash = refund}, 'Refund')
	end

	BLD_HISTORY.Record(Player, {{Kind = 'Furniture', Level = item.Level, Key = Id, Before = table.clone(item), After = nil}}, -refund)
end

return FurnitureServiceServer
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW113"><Properties><string name="Name">HouseService</string></Properties><Item class="ModuleScript" referent="NEW112"><Properties><string name="Name">HouseServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local HouseServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local SSG = game:GetService('ServerStorage')
local WKS = game:GetService('Workspace')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local BLD_UTILS = require(RPS.Modules.Utils.BuildUtils)
local FUR_UTILS = require(RPS.Modules.Utils.FurnitureUtils)
local HSE_UTILS = require(RPS.Modules.Utils.HouseUtils)
local LND_UTILS = require(RPS.Modules.Utils.LandUtils)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local PLT_CONTAINER = require(SSG.Modules.Services.PlotService.PlotContainer)

local PIECE_FOLDERS = {'Walls', 'Posts', 'Floors', 'Furniture', 'Dirt'}
local RED = Color3.fromRGB(235, 80, 80)

local housesFolder: Folder
local landFolders: {[Player]: Folder} = {}
local lockedColumns: {[Player]: {[string]: boolean}} = {}

-- initialize house service server-side
function HouseServiceServer:Init()
	housesFolder = Instance.new('Folder')
	housesFolder.Name = 'Houses'
	housesFolder.Parent = WKS

	PLS.PlayerRemoving:Connect(function(Player)
		local folder = landFolders[Player]

		if folder then
			folder:Destroy()
		end

		landFolders[Player] = nil
		lockedColumns[Player] = nil
	end)
end

-- get the grid corner of a player's land
function HouseServiceServer:GetOrigin(Player: Player): Vector3?
	local land = PLT_CONTAINER[Player]

	return land and GRD_UTILS.GetOrigin(land)
end

-- get the player's land data
function HouseServiceServer:GetLand(Player: Player): DAT_TYPES.LandData
	return DAT_Server:get(Player, 'Land')
end

-- what the player may build on
function HouseServiceServer:GetContext(Player: Player): FUR_UTILS.PlaceContext
	return {
		Parcels = DAT_Server:get(Player, 'Parcels'),
		Levels = DAT_Server:get(Player, 'Levels'),
	}
end

-- every house on the player's land, and a map of level cell -> house id
function HouseServiceServer:GetHouses(Player: Player): ({DAT_TYPES.HouseInfo}, {[string]: string})
	return HSE_UTILS.GetHouses(HouseServiceServer:GetLand(Player))
end

-- find one house by id
function HouseServiceServer:FindHouse(Player: Player, Id: string): (DAT_TYPES.HouseInfo?, {[string]: string})
	local houses, cellHouse = HouseServiceServer:GetHouses(Player)

	for _, house in houses do
		if house.Id == Id then
			return house, cellHouse
		end
	end

	return nil, cellHouse
end

-- the folder a level's pieces of one kind live in
local function getFolder(Player: Player, Level: number, Kind: string): Folder?
	local land = landFolders[Player]
	local level = land and land:FindFirstChild(`L{Level}`)
	local folder = level and level:FindFirstChild(Kind)

	return if folder and folder:IsA('Folder') then folder else nil
end

-- get the player's land folder (used to check a prompt belongs to them)
function HouseServiceServer:GetLandFolder(Player: Player): Folder?
	return landFolders[Player]
end

-- lock / unlock tile columns (houses on the market or rented can't be edited)
function HouseServiceServer:SetLockedColumns(Player: Player, Columns: {[string]: boolean})
	lockedColumns[Player] = Columns
end

-- check a tile column is locked
function HouseServiceServer:IsColumnLocked(Player: Player, Cell: string): boolean
	local columns = lockedColumns[Player]

	return columns ~= nil and columns[Cell] == true
end

-- check a wall line is locked (either side locked)
function HouseServiceServer:IsEdgeLocked(Player: Player, Edge: string): boolean
	local a, b = GRD_UTILS.EdgeCells(Edge)

	return HouseServiceServer:IsColumnLocked(Player, a) or HouseServiceServer:IsColumnLocked(Player, b)
end

-- tell the player why they can't edit
function HouseServiceServer:NotifyLocked(Player: Player)
	RPS.Remotes.InterfaceService.Notify:FireClient(Player, 'That house is on the market or rented - you can\'t change it', RED)
end

-- check the land is loaded
function HouseServiceServer:IsReady(Player: Player): boolean
	return landFolders[Player] ~= nil
end

-- load a player's land onto their plot
function HouseServiceServer:LoadLand(Player: Player)
	if landFolders[Player] then
		return
	end

	DAT_Server:waitForData(Player)

	if Player.Parent ~= PLS or not PLT_CONTAINER[Player] then
		return
	end

	local folder = Instance.new('Folder')
	folder.Name = `Land_{Player.UserId}`
	folder:SetAttribute('Owner', Player.UserId)

	for level = 1, LND_CONFIGS.MaxLevels do
		local levelFolder = Instance.new('Folder')
		levelFolder.Name = `L{level}`

		for _, name in PIECE_FOLDERS do
			local child = Instance.new('Folder')
			child.Name = name
			child.Parent = levelFolder
		end

		levelFolder.Parent = folder
	end

	local parcels = Instance.new('Folder')
	parcels.Name = 'Parcels'
	parcels.Parent = folder

	folder.Parent = housesFolder
	landFolders[Player] = folder

	HouseServiceServer:RenderParcels(Player)
	HouseServiceServer:RenderAll(Player)
end

-- show locked parcels with their price
function HouseServiceServer:RenderParcels(Player: Player)
	local origin = HouseServiceServer:GetOrigin(Player)
	local folder = landFolders[Player]
	local parcelFolder = folder and folder:FindFirstChild('Parcels')

	if not origin or not parcelFolder then
		return
	end

	parcelFolder:ClearAllChildren()

	local parcels = DAT_Server:get(Player, 'Parcels')
	local price = LND_UTILS.GetNextPrice(parcels)
	local studs = LND_CONFIGS.ParcelCells * BLD_CONFIGS.CellSize

	for px = 0, LND_CONFIGS.ParcelGrid - 1 do
		for pz = 0, LND_CONFIGS.ParcelGrid - 1 do
			local key = GRD_UTILS.CellKey(px, pz)

			if parcels[key] then
				continue
			end

			local part = Instance.new('Part')
			part.Name = key
			part.Anchored = true
			part.CanCollide = false
			part.CanQuery = false
			part.CanTouch = false
			part.CastShadow = false
			part.Material = Enum.Material.SmoothPlastic
			part.Color = Color3.fromRGB(40, 40, 46)
			part.Transparency = 0.6
			part.Size = Vector3.new(studs - 0.4, 0.1, studs - 0.4)
			part.CFrame = CFrame.new(origin + Vector3.new((px + 0.5) * studs, 0.06, (pz + 0.5) * studs))
			part:SetAttribute('Parcel', key)

			-- price sign on parcels that can be bought now
			if price and LND_UTILS.CanBuyParcel(parcels, key) then
				local sign = Instance.new('BillboardGui')
				sign.Size = UDim2.fromScale(10, 2.5)
				sign.StudsOffsetWorldSpace = Vector3.new(0, 5, 0)
				sign.MaxDistance = 200
				sign.Parent = part

				local label = Instance.new('TextLabel')
				label.Size = UDim2.fromScale(1, 1)
				label.BackgroundTransparency = 1
				label.Font = Enum.Font.FredokaOne
				label.TextScaled = true
				label.TextColor3 = Color3.fromRGB(120, 230, 140)
				label.TextStrokeTransparency = 0.3
				label.Text = `For Sale: {STR_UTILS.FormatCash(price)}`
				label.Parent = sign
			end

			part.Parent = parcelFolder
		end
	end
end

-- destroy everything rendered for a player's land
function HouseServiceServer:ClearRender(Player: Player)
	for level = 1, LND_CONFIGS.MaxLevels do
		for _, name in PIECE_FOLDERS do
			local folder = getFolder(Player, level, name)

			if folder then
				folder:ClearAllChildren()
			end
		end
	end
end

-- render the whole land from data
function HouseServiceServer:RenderAll(Player: Player)
	HouseServiceServer:ClearRender(Player)

	local land = HouseServiceServer:GetLand(Player)

	for level = 1, LND_CONFIGS.MaxLevels do
		local levelData = HSE_UTILS.GetLevel(land, level)

		for key in levelData.Walls do
			HouseServiceServer:RenderWall(Player, level, key)
		end

		for key in levelData.Floors do
			HouseServiceServer:RenderFloor(Player, level, key)
		end
	end

	for id in land.Furniture do
		HouseServiceServer:RenderFurniture(Player, id)
	end

	for id in land.Dirt do
		HouseServiceServer:RenderDirt(Player, id)
	end
end

-- render (or remove) one wall piece and fix the posts at its ends
function HouseServiceServer:RenderWall(Player: Player, Level: number, Key: string)
	local origin = HouseServiceServer:GetOrigin(Player)
	local folder = getFolder(Player, Level, 'Walls')

	if not origin or not folder then
		return
	end

	local old = folder:FindFirstChild(Key)

	if old then
		old:Destroy()
	end

	local wall = HSE_UTILS.GetLevel(HouseServiceServer:GetLand(Player), Level).Walls[Key]

	if wall then
		BLD_UTILS.CreateWall(origin, Level, Key, wall).Parent = folder
	end

	local ax, az, bx, bz = GRD_UTILS.EdgePoints(Key)

	HouseServiceServer:RenderPost(Player, Level, ax, az)
	HouseServiceServer:RenderPost(Player, Level, bx, bz)
end

-- render the corner post at a grid point if any wall touches it
function HouseServiceServer:RenderPost(Player: Player, Level: number, X: number, Z: number)
	local origin = HouseServiceServer:GetOrigin(Player)
	local folder = getFolder(Player, Level, 'Posts')

	if not origin or not folder then
		return
	end

	local name = `P_{X}_{Z}`
	local old = folder:FindFirstChild(name)

	if old then
		old:Destroy()
	end

	local walls = HSE_UTILS.GetLevel(HouseServiceServer:GetLand(Player), Level).Walls

	for _, key in GRD_UTILS.EdgesAtPoint(X, Z) do
		local wall = walls[key]

		if wall then
			BLD_UTILS.CreatePost(origin, Level, X, Z, wall.Style).Parent = folder
			return
		end
	end
end

-- render (or remove) one floor tile
function HouseServiceServer:RenderFloor(Player: Player, Level: number, Key: string)
	local origin = HouseServiceServer:GetOrigin(Player)
	local folder = getFolder(Player, Level, 'Floors')

	if not origin or not folder then
		return
	end

	local old = folder:FindFirstChild(Key)

	if old then
		old:Destroy()
	end

	local style = HSE_UTILS.GetLevel(HouseServiceServer:GetLand(Player), Level).Floors[Key]

	if style then
		BLD_UTILS.CreateFloor(origin, Level, Key, style).Parent = folder
	end
end

-- find a rendered furniture model on any floor
local function findFurniture(Player: Player, Id: string): Instance?
	for level = 1, LND_CONFIGS.MaxLevels do
		local folder = getFolder(Player, level, 'Furniture')
		local model = folder and folder:FindFirstChild(Id)

		if model then
			return model
		end
	end

	return nil
end

-- render (or remove) one furniture item
function HouseServiceServer:RenderFurniture(Player: Player, Id: string)
	local origin = HouseServiceServer:GetOrigin(Player)

	if not origin then
		return
	end

	local old = findFurniture(Player, Id)
	local item = HouseServiceServer:GetLand(Player).Furniture[Id]
	local folder = item and getFolder(Player, item.Level, 'Furniture')

	-- same item on the same floor just moved: keep the model
	if old and item and folder and old.Parent == folder and old:IsA('Model') and old:GetAttribute('Item') == item.Name then
		FUR_UTILS.PlaceFurniture(old, FUR_UTILS.GetWorldPosition(origin, item), item.Rotation)
		return
	end

	if old then
		old:Destroy()
	end

	if not item or not folder then
		return
	end

	local model = FUR_UTILS.CreateModel(item.Name)

	if not model then
		warn(`[HouseServiceServer]: Couldn't create furniture {item.Name}`)
		return
	end

	model.Name = Id
	model:SetAttribute('Item', item.Name)
	model:SetAttribute('Level', item.Level)

	FUR_UTILS.PlaceFurniture(model, FUR_UTILS.GetWorldPosition(origin, item), item.Rotation)

	model.Parent = folder
end

-- render (or remove) one dirt spot
function HouseServiceServer:RenderDirt(Player: Player, Id: string)
	local origin = HouseServiceServer:GetOrigin(Player)

	if not origin then
		return
	end

	for level = 1, LND_CONFIGS.MaxLevels do
		local folder = getFolder(Player, level, 'Dirt')
		local old = folder and folder:FindFirstChild(Id)

		if old then
			old:Destroy()
		end
	end

	local dirt = HouseServiceServer:GetLand(Player).Dirt[Id]
	local folder = dirt and getFolder(Player, dirt.Level, 'Dirt')

	if dirt and folder then
		BLD_UTILS.CreateDirt(origin, dirt, Id).Parent = folder
	end
end

-- swap the whole land (used when a house is sold)
function HouseServiceServer:SetLand(Player: Player, Land: DAT_TYPES.LandData)
	DAT_Server:set(Player, 'Land', Land)
	HouseServiceServer:RenderAll(Player)
end

return HouseServiceServer
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW117"><Properties><string name="Name">MapService</string></Properties><Item class="ModuleScript" referent="NEW114"><Properties><string name="Name">DayCycle</string><ProtectedString name="Source"><![CDATA[--!strict
-- Moves the sun, blends the lighting between the day and night looks,
-- and turns the street lamps / shop windows on at night.
local DayCycle = {}

local RPS = game:GetService('ReplicatedStorage')
local LGT = game:GetService('Lighting')
local TWS = game:GetService('TweenService')

local MAP_CONFIGS = require(RPS.Modules.Configs.MapConfigs)

local UPDATE_RATE = 1 -- seconds between lighting updates (smooth enough, cheap to replicate)

local nightLights: {Light} = {}
local glowParts: {BasePart} = {}
local isNight: boolean? = nil

-- 0 at night, 1 in full daylight, smooth at dawn and dusk
local function getDaylight(Clock: number): number
	local dawn = MAP_CONFIGS.DayCycle.NightEnd
	local dusk = MAP_CONFIGS.DayCycle.NightStart

	if Clock < dawn - 1 or Clock > dusk + 1 then
		return 0
	elseif Clock < dawn + 1 then
		return (Clock - (dawn - 1)) / 2
	elseif Clock > dusk - 1 then
		return 1 - (Clock - (dusk - 1)) / 2
	end

	return 1
end

-- find a Lighting effect, or make it when the place doesn't have one
local function getEffect(ClassName: string, Name: string): Instance
	local effect = LGT:FindFirstChild(Name) or LGT:FindFirstChildOfClass(ClassName)

	if effect then
		return effect
	end

	local newEffect = Instance.new(ClassName)
	newEffect.Name = Name
	newEffect.Parent = LGT

	return newEffect
end

-- switch every registered light on or off
local function setNight(Night: boolean)
	if isNight == Night then
		return
	end

	isNight = Night

	for _, light in nightLights do
		light.Enabled = Night
	end

	for _, part in glowParts do
		part.Material = if Night then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
end

-- blend the day and night looks
local function applyLook(Daylight: number)
	local day = MAP_CONFIGS.DayLook
	local night = MAP_CONFIGS.NightLook

	local tint = getEffect('ColorCorrectionEffect', 'MapTint') :: ColorCorrectionEffect
	local atmosphere = getEffect('Atmosphere', 'Atmosphere') :: Atmosphere

	local goals = {
		Ambient = night.Ambient:Lerp(day.Ambient, Daylight),
		OutdoorAmbient = night.OutdoorAmbient:Lerp(day.OutdoorAmbient, Daylight),
		Brightness = night.Brightness + (day.Brightness - night.Brightness) * Daylight,
	}

	local info = TweenInfo.new(UPDATE_RATE, Enum.EasingStyle.Linear)

	TWS:Create(LGT, info, goals):Play()
	TWS:Create(tint, info, {
		TintColor = night.ColorTint:Lerp(day.ColorTint, Daylight),
		Saturation = night.Saturation + (day.Saturation - night.Saturation) * Daylight,
	}):Play()
	TWS:Create(atmosphere, info, {
		Color = night.AtmosphereColor:Lerp(day.AtmosphereColor, Daylight),
		Decay = night.AtmosphereDecay:Lerp(day.AtmosphereDecay, Daylight),
	}):Play()
end

-- lights that come on at night (Glow parts turn neon at night)
function DayCycle:AddNightLight(Light: Light, Glow: BasePart?)
	table.insert(nightLights, Light)

	if Glow then
		table.insert(glowParts, Glow)
	end

	if isNight ~= nil then
		Light.Enabled = isNight

		if Glow then
			Glow.Material = if isNight then Enum.Material.Neon else Enum.Material.SmoothPlastic
		end
	end
end

-- start the clock
function DayCycle:Start()
	local config = MAP_CONFIGS.DayCycle

	LGT.ClockTime = config.StartTime

	local hoursPerSecond = 24 / (config.MinutesPerDay * 60)

	task.spawn(function()
		while true do
			if config.Enabled then
				LGT.ClockTime = (LGT.ClockTime + hoursPerSecond * UPDATE_RATE) % 24
			end

			local clock = LGT.ClockTime

			applyLook(getDaylight(clock))
			setNight(clock >= config.NightStart or clock < config.NightEnd)

			task.wait(UPDATE_RATE)
		end
	end)
end

return DayCycle
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW115"><Properties><string name="Name">MapServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
-- Builds the suburb around the lands (Workspace.Map): sidewalks, road lines, fences,
-- street lamps, trees, a park and a town square. Then starts the day/night cycle.
-- Tweak the look in MapConfigs; the pieces themselves are in SceneryBuilder.
local MapServiceServer = {}

local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')
local SSG = game:GetService('ServerStorage')

local MAP_CONFIGS = require(RPS.Modules.Configs.MapConfigs)
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local PLT_Server = require(SSG.Modules.Services.PlotService.PlotServiceServer)

local SCENERY = require(script.Parent.SceneryBuilder)
local DAY_CYCLE = require(script.Parent.DayCycle)

local colors = MAP_CONFIGS.Colors

-- same seed every time, so the trees are always in the same spots
local random = Random.new(2026)

type Rect = {MinX: number, MaxX: number, MinZ: number, MaxZ: number}

local function isInside(Rect: Rect, X: number, Z: number): boolean
	return X > Rect.MinX and X < Rect.MaxX and Z > Rect.MinZ and Z < Rect.MaxZ
end

-- a flat slab whose top is at Top
local function slab(Parent: Instance, Name: string, CenterX: number, CenterZ: number, SizeX: number, SizeZ: number, Top: number, Color: Color3, Material: Enum.Material)
	SCENERY.Part(Parent, Vector3.new(SizeX, 1, SizeZ), CFrame.new(CenterX, Top - 0.5, CenterZ), Color,
		{Name = Name, Material = Material, Collide = true})
end

-- a square ring of slabs around a center (Inner = half the size of the hole)
local function ring(Parent: Instance, Name: string, Center: Vector3, Inner: number, Width: number, Top: number, Color: Color3, Material: Enum.Material)
	local outer = Inner + Width
	local middle = Inner + Width / 2

	slab(Parent, Name, Center.X, Center.Z - middle, outer * 2, Width, Top, Color, Material)
	slab(Parent, Name, Center.X, Center.Z + middle, outer * 2, Width, Top, Color, Material)
	slab(Parent, Name, Center.X - middle, Center.Z, Width, Inner * 2, Top, Color, Material)
	slab(Parent, Name, Center.X + middle, Center.Z, Width, Inner * 2, Top, Color, Material)
end

-- dashed yellow line from A to B, along X or Z
local function dashes(Parent: Instance, A: Vector3, B: Vector3)
	local length = (B - A).Magnitude
	local direction = (B - A).Unit
	local step = MAP_CONFIGS.DashLength + MAP_CONFIGS.DashGap
	local count = math.floor((length + MAP_CONFIGS.DashGap) / step)
	local start = (length - (count * step - MAP_CONFIGS.DashGap)) / 2

	for index = 0, count - 1 do
		local middle = A + direction * (start + index * step + MAP_CONFIGS.DashLength / 2)

		SCENERY.Part(Parent, Vector3.new(0.8, 0.05, MAP_CONFIGS.DashLength), CFrame.lookAt(middle, middle + direction),
			colors.RoadLine, {Name = 'RoadLine'})
	end
end

-- make (or empty) Workspace.Map
local function getMapFolder(): Folder
	local folder = WKS:FindFirstChild('Map')

	if folder and folder:IsA('Folder') then
		folder:ClearAllChildren()
		return folder
	end

	local newFolder = Instance.new('Folder')
	newFolder.Name = 'Map'
	newFolder.Parent = WKS

	return newFolder
end

-- initialize map service server-side (after PlotService has built the lands)
function MapServiceServer:Init()
	MapServiceServer:BuildSuburb()
	DAY_CYCLE:Start()
end

-- build all the scenery around the lands
function MapServiceServer:BuildSuburb()
	local plot = WKS:FindFirstChild('Plot')
	local ground = plot and plot:FindFirstChild('Ground')

	if not ground or not ground:IsA('BasePart') then
		warn('[MapServiceServer]: Workspace.Plot.Ground is missing, the suburb was not built')
		return
	end

	local folder = getMapFolder()
	local lands = PLT_Server:GetLands()

	local road = LND_CONFIGS.Neighborhood.RoadWidth
	local groundTop = ground.Position.Y + ground.Size.Y / 2
	local walkTop = groundTop + MAP_CONFIGS.CurbHeight

	local streets: Rect = {
		MinX = ground.Position.X - ground.Size.X / 2,
		MaxX = ground.Position.X + ground.Size.X / 2,
		MinZ = ground.Position.Z - ground.Size.Z / 2,
		MaxZ = ground.Position.Z + ground.Size.Z / 2,
	}

	if MAP_CONFIGS.RecolorBaseplate then
		local baseplate = WKS:FindFirstChild('Baseplate')

		if baseplate and baseplate:IsA('BasePart') then
			baseplate.Color = colors.Grass
			baseplate.Material = Enum.Material.Grass

			for _, child in baseplate:GetChildren() do
				if child:IsA('Texture') or child:IsA('Decal') then
					child:Destroy()
				end
			end
		end
	end

	-- grass under everything, a bit lower than the roads
	local park = MAP_CONFIGS.ParkWidth

	slab(folder, 'Park', ground.Position.X, ground.Position.Z, ground.Size.X + park * 2, ground.Size.Z + park * 2,
		groundTop - 0.05, colors.Grass, Enum.Material.Grass)

	local streetFolder = Instance.new('Folder')
	streetFolder.Name = 'Streets'
	streetFolder.Parent = folder

	for _, land in lands do
		MapServiceServer:DressLand(streetFolder, land, walkTop)
	end

	MapServiceServer:PaintRoads(streetFolder, lands, road, groundTop)
	MapServiceServer:BuildTownSquare(folder, streets, groundTop)
	MapServiceServer:PlantPark(folder, streets, groundTop)
end

-- sidewalk, curb, fence, lamps, trees and mailbox around one land
function MapServiceServer:DressLand(Parent: Instance, Land: BasePart, WalkTop: number)
	local model = Instance.new('Model')
	model.Name = `{Land.Name}Street`
	model.Parent = Parent

	local size = GRD_UTILS.LandStuds
	local half = size / 2
	local center = Land.Position
	local walk = MAP_CONFIGS.SidewalkWidth

	ring(model, 'Sidewalk', center, half, walk - 1, WalkTop, colors.Sidewalk, Enum.Material.Concrete)
	ring(model, 'Curb', center, half + walk - 1, 1, WalkTop + 0.1, colors.Curb, Enum.Material.Concrete)

	-- fence down both sides and across the back, a little outside the land so walls on the edge don't touch it
	local fenceOut = half + 1.4
	local back = center.Z - fenceOut
	local front = center.Z + half

	SCENERY.Fence(model, Vector3.new(center.X - fenceOut, WalkTop, front), Vector3.new(center.X - fenceOut, WalkTop, back))
	SCENERY.Fence(model, Vector3.new(center.X - fenceOut, WalkTop, back), Vector3.new(center.X + fenceOut, WalkTop, back))
	SCENERY.Fence(model, Vector3.new(center.X + fenceOut, WalkTop, back), Vector3.new(center.X + fenceOut, WalkTop, front))

	-- lamps along the front and back, leaning over the road
	local spacing = MAP_CONFIGS.LampSpacing
	local lampOut = half + walk - 1.8
	local x = center.X - half + spacing / 2

	while x < center.X + half do
		for _, side in {1, -1} do
			local at = Vector3.new(x, WalkTop, center.Z + lampOut * side)
			local light, bulb = SCENERY.Lamp(model, at, Vector3.new(0, 0, side))

			DAY_CYCLE:AddNightLight(light, bulb)
		end

		x += spacing
	end

	-- a row of trees down each side
	local trees = MAP_CONFIGS.TreesPerVerge
	local treeOut = half + walk / 2 + 0.4

	for index = 1, trees do
		local z = center.Z - half + size * (index - 0.5) / trees

		for _, side in {1, -1} do
			SCENERY.Tree(model, Vector3.new(center.X + treeOut * side, WalkTop, z), 0.75, random)
		end
	end

	-- mailbox by the starting parcel, where the owner spawns
	local parcelStuds = size / LND_CONFIGS.ParcelGrid
	local startX = GRD_UTILS.ParseCellKey(LND_CONFIGS.StartParcel)
	local origin = GRD_UTILS.GetOrigin(Land)

	SCENERY.Mailbox(model, Vector3.new(origin.X + (startX + 0.5) * parcelStuds - 8, WalkTop, center.Z + half + 2),
		Vector3.new(0, 0, 1))
end

-- dashed centre lines down every road, stopping at crossings
function MapServiceServer:PaintRoads(Parent: Instance, Lands: {BasePart}, Road: number, GroundTop: number)
	local half = GRD_UTILS.LandStuds / 2
	local columns: {number} = {}
	local rows: {number} = {}

	for _, land in Lands do
		if not table.find(columns, land.Position.X) then
			table.insert(columns, land.Position.X)
		end

		if not table.find(rows, land.Position.Z) then
			table.insert(rows, land.Position.Z)
		end
	end

	table.sort(columns)
	table.sort(rows)

	if #columns == 0 then
		return
	end

	-- centre of each road: one before every land and one after the last
	local function roadLines(Centers: {number}): {number}
		local lines = {Centers[1] - half - Road / 2}

		for _, centerValue in Centers do
			table.insert(lines, centerValue + half + Road / 2)
		end

		return lines
	end

	local xRoads = roadLines(columns)
	local zRoads = roadLines(rows)
	local y = GroundTop + 0.03

	for _, z in zRoads do
		for index = 1, #xRoads - 1 do
			dashes(Parent, Vector3.new(xRoads[index] + Road / 2, y, z), Vector3.new(xRoads[index + 1] - Road / 2, y, z))
		end
	end

	for _, x in xRoads do
		for index = 1, #zRoads - 1 do
			dashes(Parent, Vector3.new(x, y, zRoads[index] + Road / 2), Vector3.new(x, y, zRoads[index + 1] - Road / 2))
		end
	end
end

-- paved square with a fountain and shops, across the road from the front row
function MapServiceServer:BuildTownSquare(Parent: Instance, Streets: Rect, GroundTop: number)
	local config = MAP_CONFIGS.TownSquare

	local model = Instance.new('Model')
	model.Name = 'TownSquare'
	model.Parent = Parent

	local top = GroundTop + 0.2
	local centerX = (Streets.MinX + Streets.MaxX) / 2
	local centerZ = Streets.MaxZ + 4 + config.Depth / 2

	slab(model, 'Paving', centerX, centerZ, config.Width, config.Depth, top, config.PavingColor, Enum.Material.Pavement)

	-- fountain with benches around it
	local fountainAt = Vector3.new(centerX, top, centerZ - 14)
	SCENERY.Fountain(model, fountainAt)

	for _, angle in {45, 135, 225, 315} do
		local direction = Vector3.new(math.cos(math.rad(angle)), 0, math.sin(math.rad(angle)))
		local at = fountainAt + direction * 22

		SCENERY.Bench(model, at, -direction)
	end

	-- shops along the back, facing the neighbourhood
	local shops = config.Shops
	local gap = config.Width / #shops

	for index, shop in shops do
		local at = Vector3.new(centerX - config.Width / 2 + gap * (index - 0.5), top, centerZ + config.Depth / 2 - 17)

		for _, light in SCENERY.Shop(model, at, Vector3.new(0, 0, -1), shop.Name, shop.Color) do
			DAY_CYCLE:AddNightLight(light)
		end
	end

	-- lamps on the corners
	for _, corner in {{-1, -1}, {1, -1}} do
		local at = Vector3.new(centerX + corner[1] * (config.Width / 2 - 4), top, centerZ + corner[2] * (config.Depth / 2 - 4))
		local light, bulb = SCENERY.Lamp(model, at, Vector3.new(0, 0, -1))

		DAY_CYCLE:AddNightLight(light, bulb)
	end

	-- flower beds in front of the shops
	for index = 1, 6 do
		local x = centerX - config.Width / 2 + config.Width * (index - 0.5) / 6
		SCENERY.Flowers(model, Vector3.new(x, top, centerZ + config.Depth / 2 - 36), random)
	end
end

-- trees, bushes and flowers in the grass around the neighbourhood
function MapServiceServer:PlantPark(Parent: Instance, Streets: Rect, GroundTop: number)
	local folder = Instance.new('Folder')
	folder.Name = 'Park'
	folder.Parent = Parent

	local park = MAP_CONFIGS.ParkWidth
	local config = MAP_CONFIGS.TownSquare
	local centerX = (Streets.MinX + Streets.MaxX) / 2

	-- keep the road edge and the town square clear
	local keepOut: {Rect} = {
		{MinX = Streets.MinX - 10, MaxX = Streets.MaxX + 10, MinZ = Streets.MinZ - 10, MaxZ = Streets.MaxZ + 10},
		{
			MinX = centerX - config.Width / 2 - 8,
			MaxX = centerX + config.Width / 2 + 8,
			MinZ = Streets.MaxZ,
			MaxZ = Streets.MaxZ + config.Depth + 14,
		},
	}

	local function findSpot(): Vector3?
		for _ = 1, 30 do
			local x = random:NextNumber(Streets.MinX - park + 6, Streets.MaxX + park - 6)
			local z = random:NextNumber(Streets.MinZ - park + 6, Streets.MaxZ + park - 6)
			local blocked = false

			for _, rect in keepOut do
				if isInside(rect, x, z) then
					blocked = true
					break
				end
			end

			if not blocked then
				return Vector3.new(x, GroundTop, z)
			end
		end

		return nil
	end

	for _ = 1, MAP_CONFIGS.ParkTrees do
		local spot = findSpot()

		if spot then
			SCENERY.Tree(folder, spot, random:NextNumber(0.9, 1.5), random)
		end
	end

	for _ = 1, math.floor(MAP_CONFIGS.ParkTrees * 0.6) do
		local spot = findSpot()

		if spot then
			SCENERY.Bush(folder, spot, random:NextNumber(3, 5), random)
		end
	end

	for _ = 1, math.floor(MAP_CONFIGS.ParkTrees * 0.4) do
		local spot = findSpot()

		if spot then
			SCENERY.Flowers(folder, spot, random)
		end
	end
end

return MapServiceServer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW116"><Properties><string name="Name">SceneryBuilder</string><ProtectedString name="Source"><![CDATA[--!strict
-- Small helpers that build one piece of scenery each (trees, lamps, fences, shops...).
-- Every piece is made of plain parts, so it's easy to restyle here or swap for a model.
local SceneryBuilder = {}

local RPS = game:GetService('ReplicatedStorage')

local MAP_CONFIGS = require(RPS.Modules.Configs.MapConfigs)

local colors = MAP_CONFIGS.Colors

export type PartOptions = {
	Name: string?,
	Shape: Enum.PartType?,
	Material: Enum.Material?,
	Collide: boolean?,
	Transparency: number?,
}

-- anchored decoration part (no touch/query so it never gets in the way of building or clicking)
function SceneryBuilder.Part(Parent: Instance, Size: Vector3, At: CFrame, Color: Color3, Options: PartOptions?): Part
	local options: PartOptions = Options or {}

	local part = Instance.new('Part')
	part.Name = options.Name or 'Part'
	part.Anchored = true
	part.Shape = options.Shape or Enum.PartType.Block
	part.Size = Size
	part.CFrame = At
	part.Color = Color
	part.Material = options.Material or Enum.Material.SmoothPlastic
	part.Transparency = options.Transparency or 0
	part.CanCollide = options.Collide == true
	part.CanTouch = false
	part.CanQuery = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = Parent

	return part
end

-- a round cartoon tree (Scale 1 is about 16 studs tall)
function SceneryBuilder.Tree(Parent: Instance, Ground: Vector3, Scale: number, Rng: Random): Model
	local model = Instance.new('Model')
	model.Name = 'Tree'

	local trunkHeight = 7 * Scale
	local leaves = colors.Leaves[Rng:NextInteger(1, #colors.Leaves)]

	SceneryBuilder.Part(model, Vector3.new(trunkHeight, 1.6 * Scale, 1.6 * Scale),
		CFrame.new(Ground + Vector3.new(0, trunkHeight / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		colors.Trunk, {Name = 'Trunk', Shape = Enum.PartType.Cylinder, Material = Enum.Material.Wood, Collide = true})

	-- a big ball on top with two smaller ones on the sides
	local top = Ground + Vector3.new(0, trunkHeight + 3 * Scale, 0)
	SceneryBuilder.Part(model, Vector3.one * 10 * Scale, CFrame.new(top), leaves,
		{Name = 'Leaves', Shape = Enum.PartType.Ball, Material = Enum.Material.Grass})

	for _ = 1, 2 do
		local angle = Rng:NextNumber(0, math.pi * 2)
		local offset = Vector3.new(math.cos(angle), Rng:NextNumber(-1.5, 0.5), math.sin(angle)) * 3.5 * Scale
		SceneryBuilder.Part(model, Vector3.one * 7 * Scale, CFrame.new(top + offset), leaves,
			{Name = 'Leaves', Shape = Enum.PartType.Ball, Material = Enum.Material.Grass})
	end

	model.Parent = Parent
	return model
end

-- a low round bush
function SceneryBuilder.Bush(Parent: Instance, Ground: Vector3, Size: number, Rng: Random)
	local leaves = colors.Leaves[Rng:NextInteger(1, #colors.Leaves)]

	SceneryBuilder.Part(Parent, Vector3.new(Size * 1.3, Size, Size * 1.3), CFrame.new(Ground + Vector3.new(0, Size * 0.3, 0)),
		leaves, {Name = 'Bush', Shape = Enum.PartType.Ball, Material = Enum.Material.Grass})
end

-- a patch of little flowers
function SceneryBuilder.Flowers(Parent: Instance, Ground: Vector3, Rng: Random)
	local color = colors.Flowers[Rng:NextInteger(1, #colors.Flowers)]

	for _ = 1, 6 do
		local offset = Vector3.new(Rng:NextNumber(-3, 3), 0.5, Rng:NextNumber(-3, 3))
		SceneryBuilder.Part(Parent, Vector3.one * 0.9, CFrame.new(Ground + offset), color,
			{Name = 'Flower', Shape = Enum.PartType.Ball})
	end
end

-- a street lamp facing Facing (the light is returned so the day cycle can switch it)
function SceneryBuilder.Lamp(Parent: Instance, Ground: Vector3, Facing: Vector3): (PointLight, BasePart)
	local model = Instance.new('Model')
	model.Name = 'StreetLamp'

	local height = MAP_CONFIGS.LampHeight
	local base = CFrame.lookAt(Ground, Ground + Facing)

	SceneryBuilder.Part(model, Vector3.new(1.4, 1, 1.4), base * CFrame.new(0, 0.5, 0), colors.LampPost,
		{Name = 'Foot', Material = Enum.Material.Metal, Collide = true})
	SceneryBuilder.Part(model, Vector3.new(height, 0.6, 0.6),
		base * CFrame.new(0, height / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), colors.LampPost,
		{Name = 'Pole', Shape = Enum.PartType.Cylinder, Material = Enum.Material.Metal, Collide = true})

	-- arm reaching out over the street
	SceneryBuilder.Part(model, Vector3.new(0.4, 0.4, 3.5), base * CFrame.new(0, height - 0.2, -1.6), colors.LampPost,
		{Name = 'Arm', Material = Enum.Material.Metal})
	SceneryBuilder.Part(model, Vector3.new(2, 0.6, 2), base * CFrame.new(0, height - 0.3, -3.2), colors.LampPost,
		{Name = 'Shade', Material = Enum.Material.Metal})

	local bulb = SceneryBuilder.Part(model, Vector3.new(1.4, 0.4, 1.4), base * CFrame.new(0, height - 0.8, -3.2),
		colors.LampGlow, {Name = 'Bulb'})

	local light = Instance.new('PointLight')
	light.Range = MAP_CONFIGS.LampRange
	light.Brightness = MAP_CONFIGS.LampBrightness
	light.Color = colors.LampGlow
	light.Shadows = false
	light.Enabled = false
	light.Parent = bulb

	model.Parent = Parent
	return light, bulb
end

-- white picket fence from A to B (ground points)
function SceneryBuilder.Fence(Parent: Instance, A: Vector3, B: Vector3)
	local model = Instance.new('Model')
	model.Name = 'Fence'

	local length = (B - A).Magnitude
	local direction = (B - A).Unit
	local along = CFrame.lookAt(A, B)
	local height = MAP_CONFIGS.FenceHeight

	-- two rails
	for _, y in {height * 0.35, height * 0.75} do
		SceneryBuilder.Part(model, Vector3.new(0.3, 0.5, length), along * CFrame.new(0, y, -length / 2), colors.Fence,
			{Name = 'Rail', Collide = true})
	end

	-- pickets, each with a little point on top
	local count = math.floor(length / MAP_CONFIGS.PicketSpacing)

	for index = 0, count do
		local point = A + direction * math.min(index * MAP_CONFIGS.PicketSpacing, length)
		local at = CFrame.lookAt(point, point + direction)

		SceneryBuilder.Part(model, Vector3.new(0.5, height, 0.9), at * CFrame.new(0, height / 2, 0), colors.Fence,
			{Name = 'Picket'})
		SceneryBuilder.Part(model, Vector3.new(0.5, 0.64, 0.64),
			at * CFrame.new(0, height, 0) * CFrame.Angles(math.rad(45), 0, 0), colors.Fence, {Name = 'Tip'})
	end

	model.Parent = Parent
end

-- a mailbox on a post
function SceneryBuilder.Mailbox(Parent: Instance, Ground: Vector3, Facing: Vector3)
	local model = Instance.new('Model')
	model.Name = 'Mailbox'

	local base = CFrame.lookAt(Ground, Ground + Facing)

	SceneryBuilder.Part(model, Vector3.new(0.5, 3.5, 0.5), base * CFrame.new(0, 1.75, 0), colors.Trunk,
		{Material = Enum.Material.Wood, Collide = true})
	SceneryBuilder.Part(model, Vector3.new(1.4, 1.4, 2.4), base * CFrame.new(0, 4, 0), colors.Mailbox, {Collide = true})
	SceneryBuilder.Part(model, Vector3.new(0.15, 1, 0.3), base * CFrame.new(0.78, 4.6, 0.6), Color3.fromRGB(230, 60, 60))

	model.Parent = Parent
end

-- a park bench facing Facing
function SceneryBuilder.Bench(Parent: Instance, Ground: Vector3, Facing: Vector3)
	local model = Instance.new('Model')
	model.Name = 'Bench'

	local base = CFrame.lookAt(Ground, Ground + Facing)
	local wood = Color3.fromRGB(176, 120, 72)

	SceneryBuilder.Part(model, Vector3.new(6, 0.4, 2), base * CFrame.new(0, 1.8, 0), wood,
		{Material = Enum.Material.Wood, Collide = true})
	SceneryBuilder.Part(model, Vector3.new(6, 1.6, 0.3), base * CFrame.new(0, 3, 1), wood, {Material = Enum.Material.Wood})

	for _, x in {-2.6, 2.6} do
		SceneryBuilder.Part(model, Vector3.new(0.4, 1.8, 2), base * CFrame.new(x, 0.9, 0), colors.LampPost,
			{Material = Enum.Material.Metal})
	end

	model.Parent = Parent
end

-- a round fountain
function SceneryBuilder.Fountain(Parent: Instance, Ground: Vector3)
	local model = Instance.new('Model')
	model.Name = 'Fountain'

	local stone = Color3.fromRGB(196, 190, 180)
	local flat = CFrame.new(Ground) * CFrame.Angles(0, 0, math.rad(90))

	SceneryBuilder.Part(model, Vector3.new(2.4, 26, 26), flat * CFrame.new(1.2, 0, 0), stone,
		{Shape = Enum.PartType.Cylinder, Material = Enum.Material.Slate, Collide = true})
	SceneryBuilder.Part(model, Vector3.new(0.4, 23, 23), flat * CFrame.new(2.3, 0, 0), Color3.fromRGB(80, 170, 230),
		{Shape = Enum.PartType.Cylinder, Material = Enum.Material.Glass, Transparency = 0.25})
	SceneryBuilder.Part(model, Vector3.new(8, 3, 3), flat * CFrame.new(4, 0, 0), stone,
		{Shape = Enum.PartType.Cylinder, Material = Enum.Material.Slate, Collide = true})
	SceneryBuilder.Part(model, Vector3.new(1.2, 10, 10), flat * CFrame.new(7.5, 0, 0), stone,
		{Shape = Enum.PartType.Cylinder, Material = Enum.Material.Slate})
	SceneryBuilder.Part(model, Vector3.new(0.3, 8.6, 8.6), flat * CFrame.new(8.1, 0, 0), Color3.fromRGB(80, 170, 230),
		{Shape = Enum.PartType.Cylinder, Material = Enum.Material.Glass, Transparency = 0.25})

	-- water spray
	local nozzle = SceneryBuilder.Part(model, Vector3.one, CFrame.new(Ground + Vector3.new(0, 9, 0)), stone,
		{Transparency = 1})

	local attachment = Instance.new('Attachment')
	attachment.Parent = nozzle

	local spray = Instance.new('ParticleEmitter')
	spray.Color = ColorSequence.new(Color3.fromRGB(200, 235, 255))
	spray.LightEmission = 0.3
	spray.Size = NumberSequence.new(0.6, 0.2)
	spray.Transparency = NumberSequence.new(0.2, 1)
	spray.Lifetime = NumberRange.new(1, 1.4)
	spray.Rate = 60
	spray.Speed = NumberRange.new(12, 15)
	spray.SpreadAngle = Vector2.new(14, 14)
	spray.Acceleration = Vector3.new(0, -30, 0)
	spray.EmissionDirection = Enum.NormalId.Top
	spray.Parent = attachment

	model.Parent = Parent
end

-- a little shop with a sign, door and windows, its front facing Facing
function SceneryBuilder.Shop(Parent: Instance, Ground: Vector3, Facing: Vector3, Name: string, Color: Color3): {Light}
	local model = Instance.new('Model')
	model.Name = Name

	local base = CFrame.lookAt(Ground, Ground + Facing)
	local width, height, depth = 44, 20, 30
	local trim = Color3.fromRGB(250, 246, 236)
	local glass = Color3.fromRGB(150, 200, 230)
	local lights: {Light} = {}

	-- body and flat roof with a lip
	SceneryBuilder.Part(model, Vector3.new(width, height, depth), base * CFrame.new(0, height / 2, 0), Color,
		{Name = 'Body', Material = Enum.Material.Brick, Collide = true})
	SceneryBuilder.Part(model, Vector3.new(width + 2, 1.5, depth + 2), base * CFrame.new(0, height + 0.75, 0), trim,
		{Name = 'Roof', Collide = true})

	-- striped awning over the door
	for index = 0, 5 do
		local stripe = if index % 2 == 0 then trim else Color

		SceneryBuilder.Part(model, Vector3.new(width / 6, 0.4, 5),
			base * CFrame.new(-width / 2 + width / 12 + index * width / 6, 11, -depth / 2 - 2.3) * CFrame.Angles(math.rad(-18), 0, 0),
			stripe, {Name = 'Awning'})
	end

	-- door and two shop windows
	SceneryBuilder.Part(model, Vector3.new(7, 10, 0.4), base * CFrame.new(0, 5, -depth / 2 - 0.1), Color3.fromRGB(90, 62, 44),
		{Name = 'Door', Material = Enum.Material.Wood})

	for _, x in {-13, 13} do
		local window = SceneryBuilder.Part(model, Vector3.new(12, 7, 0.4), base * CFrame.new(x, 6.5, -depth / 2 - 0.1), glass,
			{Name = 'Window', Material = Enum.Material.Glass, Transparency = 0.1})

		-- the windows glow at night
		local light = Instance.new('SurfaceLight')
		light.Face = Enum.NormalId.Front
		light.Range = 14
		light.Brightness = 1.5
		light.Color = colors.LampGlow
		light.Enabled = false
		light.Parent = window

		table.insert(lights, light)
	end

	-- name sign
	local sign = SceneryBuilder.Part(model, Vector3.new(26, 4.5, 0.6), base * CFrame.new(0, 15.5, -depth / 2 - 0.3), trim,
		{Name = 'Sign'})

	local surface = Instance.new('SurfaceGui')
	surface.Face = Enum.NormalId.Front
	surface.PixelsPerStud = 30
	surface.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	surface.Parent = sign

	local label = Instance.new('TextLabel')
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color
	label.Text = Name
	label.Parent = surface

	local padding = Instance.new('UIPadding')
	padding.PaddingTop = UDim.new(0.12, 0)
	padding.PaddingBottom = UDim.new(0.12, 0)
	padding.Parent = label

	model.Parent = Parent
	return lights
end

return SceneryBuilder
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW119"><Properties><string name="Name">MarketService</string></Properties><Item class="ModuleScript" referent="NEW118"><Properties><string name="Name">MarketServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local MarketServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local SSG = game:GetService('ServerStorage')
local HTP = game:GetService('HttpService')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local MKT_CONFIGS = require(RPS.Modules.Configs.MarketConfigs)
local MON_CONFIGS = require(RPS.Modules.Configs.MonetizationConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local HSE_UTILS = require(RPS.Modules.Utils.HouseUtils)
local MON_UTILS = require(RPS.Modules.Utils.MonetizationUtils)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)
local HSE_Server = require(SSG.Modules.Services.HouseService.HouseServiceServer)
local BLD_HISTORY = require(SSG.Modules.Services.BuildService.BuildHistory)
local ECN_Server = require(SSG.Modules.Services.EconomyService.EconomyServiceServer)
local ATC_SSignals = require(SSG.Modules.Services.AnalyticsService.AnalyticsServerSignals)

local remotes = RPS.Remotes.MarketService

local GOOD = Color3.fromRGB(90, 210, 120)
local BAD = Color3.fromRGB(235, 80, 80)

type Listing = {
	HouseId: string,
	Mode: CFG_TYPES.ListingMode,
	Value: number,
	Offers: {DAT_TYPES.OfferData},
	NextOffer: number,
	Cells: {string},
}

local random = Random.new()
local listings: {[Player]: {[string]: Listing}} = {}
local lastRequest: {[Player]: number} = {}

-- check request (rate limit + land loaded)
local function checkRequest(Player: Player): boolean
	local now = os.clock()

	if now - (lastRequest[Player] or 0) < 0.25 or not HSE_Server:IsReady(Player) then
		return false
	end

	lastRequest[Player] = now
	return true
end

-- send a message to the player
local function notify(Player: Player, Text: string, Color: Color3)
	RPS.Remotes.InterfaceService.Notify:FireClient(Player, Text, Color)
end

-- random number between a min and max
local function between(Range: {Min: number, Max: number}): number
	return random:NextNumber(Range.Min, Range.Max)
end

-- random NPC name
local function randomName(): string
	local first = MKT_CONFIGS.FirstNames[random:NextInteger(1, #MKT_CONFIGS.FirstNames)]
	local last = MKT_CONFIGS.LastNames[random:NextInteger(1, #MKT_CONFIGS.LastNames)]

	return `{first} {last}`
end

-- seconds until the next offer (Quick Sale halves it)
local function offerDelay(Player: Player, Range: {Min: number, Max: number}): number
	local delay = between(Range)

	if MON_UTILS.HasPass(Player, 'QuickSale') then
		delay *= MON_CONFIGS.QuickSaleDelayMultiplier
	end

	return delay
end

-- the player's listings (created on demand)
local function getListings(Player: Player): {[string]: Listing}
	local playerListings = listings[Player]

	if not playerListings then
		playerListings = {}
		listings[Player] = playerListings
	end

	assert(playerListings)
	return playerListings
end

-- rentals from data
local function getRentals(Player: Player): {[string]: DAT_TYPES.RentalData}
	return DAT_Server:get(Player, 'Rentals')
end

-- lock every house that is listed or rented
function MarketServiceServer:UpdateLocks(Player: Player)
	local cells: {string} = {}

	for _, listing in getListings(Player) do
		table.move(listing.Cells, 1, #listing.Cells, #cells + 1, cells)
	end

	for _, rental in getRentals(Player) do
		table.move(rental.Cells, 1, #rental.Cells, #cells + 1, cells)
	end

	HSE_Server:SetLockedColumns(Player, HSE_UTILS.GetColumns(cells))
end

-- initialize market service server-side
function MarketServiceServer:Init()
	remotes.ListHouse.OnServerEvent:Connect(function(Player, HouseId, Mode)
		MarketServiceServer:ListHouse(Player, HouseId, Mode)
	end)

	remotes.Unlist.OnServerEvent:Connect(function(Player, HouseId)
		if typeof(HouseId) == 'string' and checkRequest(Player) then
			MarketServiceServer:Unlist(Player, HouseId)
		end
	end)

	remotes.AcceptOffer.OnServerEvent:Connect(function(Player, HouseId, OfferId)
		MarketServiceServer:AcceptOffer(Player, HouseId, OfferId)
	end)

	remotes.DeclineOffer.OnServerEvent:Connect(function(Player, HouseId, OfferId)
		MarketServiceServer:DeclineOffer(Player, HouseId, OfferId)
	end)

	remotes.CollectRent.OnServerEvent:Connect(function(Player)
		MarketServiceServer:CollectRent(Player)
	end)

	remotes.Evict.OnServerEvent:Connect(function(Player, HouseId)
		MarketServiceServer:Evict(Player, HouseId)
	end)

	PLS.PlayerAdded:Connect(function(Player)
		MarketServiceServer:LoadPlayer(Player)
	end)

	for _, player in PLS:GetPlayers() do
		task.spawn(function()
			MarketServiceServer:LoadPlayer(player)
		end)
	end

	PLS.PlayerRemoving:Connect(function(Player)
		listings[Player] = nil
		lastRequest[Player] = nil
	end)

	-- save the time the player left, for offline rent
	DAT_Server:addPlayerRemovingCallback(function(_Player, Data)
		Data.LastOnline = os.time()
	end)

	-- offers
	task.spawn(function()
		while true do
			task.wait(1)

			for player in listings do
				MarketServiceServer:UpdateOffers(player)
			end
		end
	end)

	-- rent
	task.spawn(function()
		while true do
			local waited = task.wait(MKT_CONFIGS.RentTickInterval)

			for _, player in PLS:GetPlayers() do
				if DAT_Server:hasProfile(player) then
					MarketServiceServer:AddRent(player, waited)
					DAT_Server:set(player, 'LastOnline', os.time(), true)
				end
			end
		end
	end)
end

-- lock rented houses and pay rent earned while offline
function MarketServiceServer:LoadPlayer(Player: Player)
	DAT_Server:waitForData(Player)

	if Player.Parent ~= PLS then
		return
	end

	MarketServiceServer:UpdateLocks(Player)

	local lastOnline = DAT_Server:get(Player, 'LastOnline')
	local now = os.time()

	DAT_Server:set(Player, 'LastOnline', now, true)

	if lastOnline <= 0 then
		return
	end

	local offline = math.clamp(now - lastOnline, 0, MKT_CONFIGS.OfflineRentHours * 3600)
	local earned = MarketServiceServer:AddRent(Player, offline)

	if earned >= 1 then
		task.delay(3, function()
			notify(Player, `Your tenants paid {STR_UTILS.FormatCash(earned)} while you were away!`, GOOD)
		end)
	end
end

-- rent a tenant pays per minute right now (cleanliness + 2x Rent pass)
function MarketServiceServer:GetCurrentRent(Player: Player, Rental: DAT_TYPES.RentalData): number
	local land = HSE_Server:GetLand(Player)
	local cells: {[string]: boolean} = {}
	local dirt = 0

	for _, cell in Rental.Cells do
		cells[cell] = true
	end

	for _, spot in land.Dirt do
		if cells[GRD_UTILS.LevelCell(spot.Level, spot.Cell)] then
			dirt += 1
		end
	end

	local rent = Rental.Rent * HSE_UTILS.GetCleanFactor(dirt)

	if MON_UTILS.HasPass(Player, 'DoubleRent') then
		rent *= MON_CONFIGS.DoubleRentMultiplier
	end

	return rent
end

-- add rent to every rental for the time passed, returns the total added
function MarketServiceServer:AddRent(Player: Player, Seconds: number): number
	local total = 0

	for id, rental in getRentals(Player) do
		local earned = MarketServiceServer:GetCurrentRent(Player, rental) * Seconds / 60

		total += earned
		DAT_Server:set(Player, {'Rentals', id, 'Pending'}, rental.Pending + earned)
	end

	return math.floor(total)
end

-- every house the player has on the market (key = house id)
function MarketServiceServer:GetListings(Player: Player): {[string]: any}
	return getListings(Player)
end

-- send every listing to the player
function MarketServiceServer:SendListings(Player: Player)
	local now = os.clock()
	local data: {[string]: DAT_TYPES.ListingData} = {}

	for houseId, listing in getListings(Player) do
		-- the client gets seconds left instead of server clock times
		local offers: {DAT_TYPES.OfferData} = {}

		for _, offer in listing.Offers do
			table.insert(offers, {
				Id = offer.Id,
				Name = offer.Name,
				Amount = offer.Amount,
				Expires = math.max(0, offer.Expires - now),
			})
		end

		data[houseId] = {
			HouseId = houseId,
			Mode = listing.Mode,
			Value = listing.Value,
			Offers = offers,
		}
	end

	remotes.ListingsUpdated:FireClient(Player, data)
end

-- put a house on the market for sale or rent
function MarketServiceServer:ListHouse(Player: Player, HouseId: any, Mode: any)
	if typeof(HouseId) ~= 'string' or (Mode ~= 'Sale' and Mode ~= 'Rent') or not checkRequest(Player) then
		return
	end

	if getListings(Player)[HouseId] or getRentals(Player)[HouseId] then
		return
	end

	local house = HSE_Server:FindHouse(Player, HouseId)

	if not house then
		notify(Player, 'That house changed - open the Houses panel again', BAD)
		return
	end

	if not house.Livable then
		local missing = {}

		for _, roomType in house.Missing do
			table.insert(missing, MKT_CONFIGS.RoomTypes[roomType].DisplayName)
		end

		notify(Player, `This house needs: {table.concat(missing, ', ')}`, BAD)
		return
	end

	getListings(Player)[HouseId] = {
		HouseId = HouseId,
		Mode = Mode :: CFG_TYPES.ListingMode,
		Value = house.Value,
		Offers = {},
		NextOffer = os.clock() + offerDelay(Player, MKT_CONFIGS.FirstOfferDelay),
		Cells = HSE_UTILS.GetCellList(house),
	}

	MarketServiceServer:UpdateLocks(Player)
	MarketServiceServer:SendListings(Player)

	ATC_SSignals.LogJourney:Fire(Player, 'ListedHouse')

	local text = if Mode == 'Sale' then 'House listed! Buyers will make offers soon.' else 'House up for rent! Tenants will apply soon.'
	notify(Player, text, GOOD)
end

-- take a house off the market
function MarketServiceServer:Unlist(Player: Player, HouseId: string)
	local playerListings = getListings(Player)

	if not playerListings[HouseId] then
		return
	end

	playerListings[HouseId] = nil

	MarketServiceServer:UpdateLocks(Player)
	MarketServiceServer:SendListings(Player)
end

-- remove expired offers and add new ones
function MarketServiceServer:UpdateOffers(Player: Player)
	local now = os.clock()
	local changed = false

	for _, listing in getListings(Player) do
		for index = #listing.Offers, 1, -1 do
			if listing.Offers[index].Expires <= now then
				table.remove(listing.Offers, index)
				changed = true
			end
		end

		if now < listing.NextOffer or #listing.Offers >= MKT_CONFIGS.MaxOffers then
			continue
		end

		local amount = if listing.Mode == 'Sale'
			then listing.Value * between(MKT_CONFIGS.SaleOfferRange)
			else HSE_UTILS.GetBaseRent(listing.Value) * between(MKT_CONFIGS.RentOfferRange)

		if MON_UTILS.HasPass(Player, 'QuickSale') then
			amount *= MON_CONFIGS.QuickSaleOfferBonus
		end

		table.insert(listing.Offers, {
			Id = HTP:GenerateGUID(false),
			Name = randomName(),
			Amount = math.max(1, math.floor(amount)),
			Expires = now + MKT_CONFIGS.OfferLifetime,
		})

		listing.NextOffer = now + offerDelay(Player, MKT_CONFIGS.OfferDelay)
		changed = true
	end

	if changed then
		MarketServiceServer:SendListings(Player)
	end
end

-- find an offer in a listing
local function findOffer(Listing: Listing, Id: string): (DAT_TYPES.OfferData?, number?)
	for index, offer in Listing.Offers do
		if offer.Id == Id then
			return offer, index
		end
	end

	return nil, nil
end

-- sell: remove the house's pieces from the land
function MarketServiceServer:RemoveHouse(Player: Player, HouseId: string): boolean
	local house, cellHouse = HSE_Server:FindHouse(Player, HouseId)

	if not house then
		return false
	end

	local land = HSE_UTILS.CloneLand(HSE_Server:GetLand(Player))
	local pieces = HSE_UTILS.GetHousePieces(land, house, cellHouse)

	for _, wall in pieces.Walls do
		land.Levels[GRD_UTILS.LevelKey(wall.Level)].Walls[wall.Key] = nil
	end

	for _, floor in pieces.Floors do
		land.Levels[GRD_UTILS.LevelKey(floor.Level)].Floors[floor.Key] = nil
	end

	for _, id in pieces.Furniture do
		land.Furniture[id] = nil
	end

	for _, id in pieces.Dirt do
		land.Dirt[id] = nil
	end

	HSE_Server:SetLand(Player, land)

	-- undo can't bring back (or refund) a house that was sold
	BLD_HISTORY.Clear(Player)

	return true
end

-- accept a buyer's or tenant's offer
function MarketServiceServer:AcceptOffer(Player: Player, HouseId: any, OfferId: any)
	if typeof(HouseId) ~= 'string' or typeof(OfferId) ~= 'string' or not checkRequest(Player) then
		return
	end

	local listing = getListings(Player)[HouseId]
	local offer = listing and findOffer(listing, OfferId)

	if not listing or not offer then
		return
	end

	if offer.Expires <= os.clock() then
		notify(Player, 'That offer expired', BAD)
		return
	end

	local amount: number = offer.Amount

	getListings(Player)[HouseId] = nil

	if listing.Mode == 'Sale' then
		if not MarketServiceServer:RemoveHouse(Player, HouseId) then
			notify(Player, 'That house changed, the sale was cancelled', BAD)
			MarketServiceServer:UpdateLocks(Player)
			MarketServiceServer:SendListings(Player)
			return
		end

		ECN_Server:Reward(Player, {Cash = amount}, 'HouseSale')

		DAT_Server:update(Player, {'Stats', 'HousesSold'}, function(Old)
			return Old + 1
		end)

		DAT_Server:update(Player, {'Stats', 'TotalEarned'}, function(Old)
			return Old + amount
		end)

		ATC_SSignals.LogJourney:Fire(Player, 'SoldHouse')
		notify(Player, `Sold to {offer.Name} for {STR_UTILS.FormatCash(amount)}! The land is free again.`, GOOD)
	else
		local rental: DAT_TYPES.RentalData = {
			Tenant = offer.Name,
			Rent = amount,
			Value = listing.Value,
			Pending = 0,
			Started = os.time(),
			Cells = listing.Cells,
		}

		DAT_Server:set(Player, {'Rentals', HouseId}, rental)

		DAT_Server:update(Player, {'Stats', 'HousesRented'}, function(Old)
			return Old + 1
		end)

		ATC_SSignals.LogJourney:Fire(Player, 'RentedHouse')
		notify(Player, `{offer.Name} moved in for {STR_UTILS.FormatCash(amount)}/min. Keep the house clean to keep the rent up!`, GOOD)
	end

	MarketServiceServer:UpdateLocks(Player)
	MarketServiceServer:SendListings(Player)
end

-- turn down an offer
function MarketServiceServer:DeclineOffer(Player: Player, HouseId: any, OfferId: any)
	if typeof(HouseId) ~= 'string' or typeof(OfferId) ~= 'string' or not checkRequest(Player) then
		return
	end

	local listing = getListings(Player)[HouseId]

	if not listing then
		return
	end

	local _, index = findOffer(listing, OfferId)

	if index then
		table.remove(listing.Offers, index)
		MarketServiceServer:SendListings(Player)
	end
end

-- collect all rent waiting in every rental
function MarketServiceServer:CollectRent(Player: Player)
	if not checkRequest(Player) then
		return
	end

	local total = 0

	for id, rental in getRentals(Player) do
		local whole = math.floor(rental.Pending)

		if whole > 0 then
			total += whole
			DAT_Server:set(Player, {'Rentals', id, 'Pending'}, rental.Pending - whole)
		end
	end

	if total <= 0 then
		notify(Player, 'No rent to collect yet', BAD)
		return
	end

	ECN_Server:Reward(Player, {Cash = total}, 'Rent')

	DAT_Server:update(Player, {'Stats', 'TotalEarned'}, function(Old)
		return Old + total
	end)

	ATC_SSignals.LogJourney:Fire(Player, 'CollectedRent')
end

-- end a lease (the house can be edited, sold or rented again)
function MarketServiceServer:Evict(Player: Player, HouseId: any)
	if typeof(HouseId) ~= 'string' or not checkRequest(Player) then
		return
	end

	local rental = getRentals(Player)[HouseId]

	if not rental then
		return
	end

	-- pay out what the tenant still owes first
	local owed = math.floor(rental.Pending)

	if owed > 0 then
		ECN_Server:Reward(Player, {Cash = owed}, 'Rent')
	end

	DAT_Server:set(Player, {'Rentals', HouseId}, nil)
	MarketServiceServer:UpdateLocks(Player)

	notify(Player, `{rental.Tenant} moved out. You can edit the house again.`, GOOD)
end

return MarketServiceServer
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW121"><Properties><string name="Name">MonetizationService</string></Properties><Item class="ModuleScript" referent="NEW120"><Properties><string name="Name">MonetizationServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local MonetizationServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local SSG = game:GetService('ServerStorage')
local MPS = game:GetService('MarketplaceService')
local RNS = game:GetService('RunService')
local WKS = game:GetService('Workspace')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local MON_CONFIGS = require(RPS.Modules.Configs.MonetizationConfigs)
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local FUR_CONFIGS = require(RPS.Modules.Configs.FurnitureConfigs)
local LND_UTILS = require(RPS.Modules.Utils.LandUtils)
local MON_UTILS = require(RPS.Modules.Utils.MonetizationUtils)
local ECN_Server = require(SSG.Modules.Services.EconomyService.EconomyServiceServer)
local PLT_Server = require(SSG.Modules.Services.PlotService.PlotServiceServer)
local ATC_SSignals = require(SSG.Modules.Services.AnalyticsService.AnalyticsServerSignals)

local remotes = RPS.Remotes.MonetizationService

local GOOD = Color3.fromRGB(90, 210, 120)

-- product id -> what it gives (filled in Init from the configs)
type ProductHandler = (Player: Player) -> ()

local productHandlers: {[number]: ProductHandler} = {}
local pendingParcels: {[Player]: string} = {}

-- send a message to the player
local function notify(Player: Player, Text: string)
	RPS.Remotes.InterfaceService.Notify:FireClient(Player, Text, GOOD)
end

-- give a parcel bought with Robux (the one the player picked, or the first free one)
local function grantParcel(Player: Player)
	local parcels = DAT_Server:get(Player, 'Parcels')
	local picked = pendingParcels[Player]
	local key = if picked and LND_UTILS.CanBuyParcel(parcels, picked) then picked else LND_UTILS.GetFirstBuyable(parcels)

	pendingParcels[Player] = nil

	if key then
		PLT_Server:UnlockParcel(Player, key)
	else
		-- every parcel was already owned: pay the cash price of the last one instead
		local prices = LND_CONFIGS.ParcelPrices
		ECN_Server:Reward(Player, {Cash = prices[#prices], Transaction = Enum.AnalyticsEconomyTransactionType.IAP}, 'Purchase')
	end
end

-- initialize monetization service server-side
function MonetizationServiceServer:Init()
	-- cash packs
	for _, pack in MON_CONFIGS.CashPacks do
		if pack.Id ~= 0 then
			productHandlers[pack.Id] = function(Player)
				ECN_Server:Reward(Player, {Cash = pack.Cash, Transaction = Enum.AnalyticsEconomyTransactionType.IAP}, 'Purchase')
			end
		end
	end

	-- land parcels
	for _, tier in LND_CONFIGS.ParcelTiers do
		if tier.ProductId ~= 0 then
			productHandlers[tier.ProductId] = grantParcel
		end
	end

	-- premium furniture
	for name, config in FUR_CONFIGS.Items do
		local premium = config.Premium

		if premium and premium.ProductId ~= 0 then
			productHandlers[premium.ProductId] = function(Player)
				DAT_Server:set(Player, {'UnlockedItems', name}, true)
				notify(Player, `{config.DisplayName} unlocked! Find it in the build menu.`)
			end
		end
	end

	MPS.ProcessReceipt = function(ReceiptInfo)
		return MonetizationServiceServer:ProcessReceipt(ReceiptInfo)
	end

	MPS.PromptGamePassPurchaseFinished:Connect(function(Player, PassId, Purchased)
		if not Purchased then
			return
		end

		for name, pass in MON_CONFIGS.Gamepasses do
			if pass.Id == PassId then
				Player:SetAttribute(MON_UTILS.PassAttribute(name), true)
				notify(Player, `{pass.DisplayName} is active!`)
			end
		end
	end)

	remotes.SetPendingParcel.OnServerEvent:Connect(function(Player, Key)
		if typeof(Key) == 'string' and LND_UTILS.IsParcelInside(Key) then
			pendingParcels[Player] = Key
		end
	end)

	PLS.PlayerAdded:Connect(function(Player)
		MonetizationServiceServer:LoadPasses(Player)
	end)

	for _, player in PLS:GetPlayers() do
		task.spawn(function()
			MonetizationServiceServer:LoadPasses(player)
		end)
	end

	PLS.PlayerRemoving:Connect(function(Player)
		pendingParcels[Player] = nil
	end)
end

-- check which gamepasses a player owns (all of them while testing in Studio)
function MonetizationServiceServer:LoadPasses(Player: Player)
	local testing = RNS:IsStudio() and WKS:GetAttribute('Testing') == true

	for name, pass in MON_CONFIGS.Gamepasses do
		local owned = testing

		if not owned and pass.Id ~= 0 then
			local success, result = pcall(function()
				return MPS:UserOwnsGamePassAsync(Player.UserId, pass.Id)
			end)

			owned = success and result == true
		end

		if owned then
			Player:SetAttribute(MON_UTILS.PassAttribute(name), true)
		end
	end
end

-- grant a developer product (safe to run twice for the same purchase)
function MonetizationServiceServer:ProcessReceipt(ReceiptInfo: {[string]: any}): Enum.ProductPurchaseDecision
	local player = PLS:GetPlayerByUserId(ReceiptInfo.PlayerId)
	local handler = productHandlers[ReceiptInfo.ProductId]

	if not player or not handler or not DAT_Server:hasProfile(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local purchaseId = tostring(ReceiptInfo.PurchaseId)
	local purchases: {string} = DAT_Server:get(player, 'Purchases')

	if table.find(purchases, purchaseId) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	local success, err = pcall(handler, player)

	if not success then
		warn(`[MonetizationServiceServer]: Failed to grant {ReceiptInfo.ProductId}: {err}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	-- remember the purchase so it is never granted twice
	DAT_Server:update(player, 'Purchases', function(Old)
		local list = table.clone(Old)
		table.insert(list, purchaseId)

		while #list > MON_CONFIGS.PurchaseHistory do
			table.remove(list, 1)
		end

		return list
	end)

	ATC_SSignals.LogJourney:Fire(player, 'BoughtProduct')

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

return MonetizationServiceServer
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW125"><Properties><string name="Name">PlayerService</string></Properties><Item class="ModuleScript" referent="NEW124"><Properties><string name="Name">PlayerServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local PlayerServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local RNS = game:GetService('RunService')
local WKS = game:GetService('Workspace')

local DAT_Server = require(RPS.Modules.Packages.DataService).server

local testData = require(script.TestData)
local initialData = require(script.DefaultData)

-- initialize player service server-side
function PlayerServiceServer:Init()
	local testing = RNS:IsStudio() and WKS:GetAttribute('Testing') == true

	DAT_Server:init({
		template = if testing then testData else initialData,

		profileStoreIndex = 'Housing v2',
		resetData = RNS:IsStudio() and WKS:GetAttribute('ResetData') == true or nil,
		useMock = testing or nil,
	})

	PLS.PlayerAdded:Connect(function(Player)
		PlayerServiceServer:LoadPlayer(Player)
	end)

	for _, player in PLS:GetPlayers() do
		task.spawn(function()
			PlayerServiceServer:LoadPlayer(player)
		end)
	end
end

-- create leaderstats and keep them in sync with data
function PlayerServiceServer:LoadPlayer(Player: Player)
	DAT_Server:waitForData(Player)

	if Player.Parent ~= PLS then
		return
	end

	local leaderstats = Instance.new('Folder')
	leaderstats.Name = 'leaderstats'

	local cash = Instance.new('IntValue')
	cash.Name = 'Cash'
	cash.Value = DAT_Server:get(Player, 'Cash')
	cash.Parent = leaderstats

	local sold = Instance.new('IntValue')
	sold.Name = 'Sold'
	sold.Value = DAT_Server:get(Player, {'Stats', 'HousesSold'})
	sold.Parent = leaderstats

	leaderstats.Parent = Player

	DAT_Server:getChangedSignal(Player, 'Cash'):Connect(function(Value)
		cash.Value = Value
	end)

	DAT_Server:getChangedSignal(Player, {'Stats', 'HousesSold'}):Connect(function(Value)
		sold.Value = Value
	end)
end

return PlayerServiceServer
]]></ProtectedString></Properties><Item class="ModuleScript" referent="NEW122"><Properties><string name="Name">DefaultData</string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local HSE_UTILS = require(RPS.Modules.Utils.HouseUtils)
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local data: DAT_TYPES.PlayerData = {
	Cash = 5000,
	Parcels = {
		[LND_CONFIGS.StartParcel] = true,
	},
	Levels = 1,

	Land = HSE_UTILS.NewLand(),
	Rentals = {},
	UnlockedItems = {},
	Purchases = {},

	Stats = {
		HousesSold = 0,
		HousesRented = 0,
		TotalEarned = 0,
		DirtCleaned = 0,
	},

	LastOnline = 0,
}

return data
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW123"><Properties><string name="Name">TestData</string><ProtectedString name="Source"><![CDATA[--!strict
-- used in Studio when Workspace has the attribute Testing = true
local DEFAULT_DATA = require(script.Parent.DefaultData)

local data = table.clone(DEFAULT_DATA)
data.Cash = 1000000
data.Levels = 3

return data
]]></ProtectedString></Properties></Item></Item></Item><Item class="Folder" referent="NEW128"><Properties><string name="Name">PlotService</string></Properties><Item class="ModuleScript" referent="NEW126"><Properties><string name="Name">PlotContainer</string><ProtectedString name="Source"><![CDATA[--!strict
-- which plot (base part in Workspace.Plot) each player owns
local PlotContainer: {[Player]: BasePart} = {}

return PlotContainer
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="NEW127"><Properties><string name="Name">PlotServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
local PlotServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService('Workspace')
local SSG = game:GetService('ServerStorage')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local LND_CONFIGS = require(RPS.Modules.Configs.LandConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local LND_UTILS = require(RPS.Modules.Utils.LandUtils)
local STR_UTILS = require(RPS.Modules.Utils.StringUtils)
local HSE_Server = require(SSG.Modules.Services.HouseService.HouseServiceServer)
local ECN_Server = require(SSG.Modules.Services.EconomyService.EconomyServiceServer)
local ATC_SSignals = require(SSG.Modules.Services.AnalyticsService.AnalyticsServerSignals)

local PLT_CONTAINER = require(script.Parent.PlotContainer)

local remotes = RPS.Remotes.PlotService

local GOOD = Color3.fromRGB(90, 210, 120)
local BAD = Color3.fromRGB(235, 80, 80)

local lands: {BasePart} = {}
local signs: {[Player]: BillboardGui} = {}
local lastRequest: {[Player]: number} = {}

-- send a message to the player
local function notify(Player: Player, Text: string, Color: Color3)
	RPS.Remotes.InterfaceService.Notify:FireClient(Player, Text, Color)
end

-- rate limit + data loaded
local function checkRequest(Player: Player): boolean
	local now = os.clock()

	if now - (lastRequest[Player] or 0) < 0.4 or not DAT_Server:hasProfile(Player) then
		return false
	end

	lastRequest[Player] = now
	return true
end

-- initialize plot service server-side
function PlotServiceServer:Init()
	PlotServiceServer:BuildNeighborhood()

	PLS.PlayerAdded:Connect(function(Player)
		PlotServiceServer:AssignPlot(Player)
	end)

	for _, player in PLS:GetPlayers() do
		task.spawn(function()
			PlotServiceServer:AssignPlot(player)
		end)
	end

	PLS.PlayerRemoving:Connect(function(Player)
		local land = PLT_CONTAINER[Player]

		if land then
			land:SetAttribute('Owner', nil)
		end

		local sign = signs[Player]

		if sign then
			sign:Destroy()
		end

		PLT_CONTAINER[Player] = nil
		signs[Player] = nil
		lastRequest[Player] = nil
	end)

	remotes.BuyParcel.OnServerEvent:Connect(function(Player, Key)
		PlotServiceServer:BuyParcel(Player, Key)
	end)

	remotes.UnlockLevel.OnServerEvent:Connect(function(Player)
		PlotServiceServer:UnlockLevel(Player)
	end)
end

-- build the ground, roads and one land per player slot (Workspace.Plot)
function PlotServiceServer:BuildNeighborhood()
	local config = LND_CONFIGS.Neighborhood
	local landSize = GRD_UTILS.LandStuds
	local road = config.RoadWidth

	local width = config.Columns * landSize + (config.Columns + 1) * road
	local depth = config.Rows * landSize + (config.Rows + 1) * road

	local folder = WKS:FindFirstChild('Plot')

	if not folder then
		folder = Instance.new('Folder')
		folder.Name = 'Plot'
		folder.Parent = WKS
	end

	assert(folder)

	-- old plot parts are replaced by generated lands
	folder:ClearAllChildren()

	local ground = Instance.new('Part')
	ground.Name = 'Ground'
	ground.Anchored = true
	ground.Material = Enum.Material.Asphalt
	ground.Color = config.RoadColor
	ground.Size = Vector3.new(width, 1, depth)
	ground.CFrame = CFrame.new(config.Center - Vector3.new(0, 0.5, 0))
	ground.TopSurface = Enum.SurfaceType.Smooth
	ground.Parent = folder

	local index = 0

	for row = 0, config.Rows - 1 do
		for column = 0, config.Columns - 1 do
			index += 1

			local x = config.Center.X - width / 2 + road + landSize / 2 + column * (landSize + road)
			local z = config.Center.Z - depth / 2 + road + landSize / 2 + row * (landSize + road)

			local land = Instance.new('Part')
			land.Name = `Land{index}`
			land.Anchored = true
			land.Material = Enum.Material.Grass
			land.Color = config.GrassColor
			land.Size = Vector3.new(landSize, 1, landSize)
			land.CFrame = CFrame.new(x, config.Center.Y + 0.2 - 0.5, z)
			land.TopSurface = Enum.SurfaceType.Smooth
			land.Parent = folder

			table.insert(lands, land)
		end
	end
end

-- every land part, in the order they are handed out
function PlotServiceServer:GetLands(): {BasePart}
	return lands
end

-- give a player a free land and load it
function PlotServiceServer:AssignPlot(Player: Player)
	if PLT_CONTAINER[Player] then
		return
	end

	local designated: BasePart?

	for _, land in lands do
		if land:GetAttribute('Owner') == nil then
			designated = land
			break
		end
	end

	if not designated then
		Player:Kick('No land available! Try another server.')
		return
	end

	assert(designated)

	designated:SetAttribute('Owner', Player.UserId)
	PLT_CONTAINER[Player] = designated
	Player:SetAttribute('Plot', designated.Name)

	PlotServiceServer:CreateSign(Player, designated)

	Player.CharacterAdded:Connect(function(Character)
		PlotServiceServer:SpawnAtPlot(Player, Character)
	end)

	if Player.Character then
		PlotServiceServer:SpawnAtPlot(Player, Player.Character)
	end

	HSE_Server:LoadLand(Player)
end

-- move a character to the road in front of their land, next to their first parcel
function PlotServiceServer:SpawnAtPlot(Player: Player, Character: Model)
	local land = PLT_CONTAINER[Player]

	if not land then
		return
	end

	task.defer(function()
		if not Character.Parent then
			return
		end

		local origin = GRD_UTILS.GetOrigin(land)
		local px = GRD_UTILS.ParseCellKey(LND_CONFIGS.StartParcel)
		local parcelStuds = GRD_UTILS.LandStuds / LND_CONFIGS.ParcelGrid
		local front = origin + Vector3.new((px + 0.5) * parcelStuds, 4, GRD_UTILS.LandStuds + 8)

		Character:PivotTo(CFrame.lookAt(front, front - Vector3.new(0, 0, 1)))
	end)
end

-- show the owner's name at the front of the land
function PlotServiceServer:CreateSign(Player: Player, Land: BasePart)
	local attachment = Instance.new('Attachment')
	attachment.Name = 'SignAttachment'
	attachment.Position = Vector3.new(0, 12, Land.Size.Z / 2)
	attachment.Parent = Land

	local sign = Instance.new('BillboardGui')
	sign.Name = 'OwnerSign'
	sign.Size = UDim2.fromScale(16, 4)
	sign.MaxDistance = 300
	sign.Adornee = attachment
	sign.Parent = attachment

	local label = Instance.new('TextLabel')
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.TextScaled = true
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.4
	label.Text = `{Player.DisplayName}'s Estate`
	label.Parent = sign

	signs[Player] = sign

	sign.Destroying:Connect(function()
		attachment:Destroy()
	end)
end

-- give a parcel (after paying cash or Robux)
function PlotServiceServer:UnlockParcel(Player: Player, Key: string)
	DAT_Server:set(Player, {'Parcels', Key}, true)
	HSE_Server:RenderParcels(Player)

	ATC_SSignals.LogJourney:Fire(Player, 'BoughtParcel')
	notify(Player, 'New land unlocked!', GOOD)
end

-- buy a parcel with cash
function PlotServiceServer:BuyParcel(Player: Player, Key: any)
	if typeof(Key) ~= 'string' or not checkRequest(Player) then
		return
	end

	local parcels = DAT_Server:get(Player, 'Parcels')

	if not LND_UTILS.CanBuyParcel(parcels, Key) then
		notify(Player, 'You can only buy land next to land you own', BAD)
		return
	end

	local price = LND_UTILS.GetNextPrice(parcels)

	if not price or not ECN_Server:TryDeduct(Player, price, 'BuyParcel') then
		return
	end

	PlotServiceServer:UnlockParcel(Player, Key)
end

-- unlock the next floor
function PlotServiceServer:UnlockLevel(Player: Player)
	if not checkRequest(Player) then
		return
	end

	local nextLevel = DAT_Server:get(Player, 'Levels') + 1
	local config = LND_CONFIGS.Levels[nextLevel]

	if not config then
		notify(Player, 'All floors are unlocked', BAD)
		return
	end

	if not ECN_Server:TryDeduct(Player, config.Cost, 'UnlockFloor') then
		return
	end

	DAT_Server:set(Player, 'Levels', nextLevel)

	ATC_SSignals.LogJourney:Fire(Player, `UnlockedLevel{nextLevel}`)
	notify(Player, `{config.DisplayName} unlocked for {STR_UTILS.FormatCash(config.Cost)}! Place stairs to reach it.`, GOOD)
end

return PlotServiceServer
]]></ProtectedString></Properties></Item></Item><Item class="Folder" referent="NEW130"><Properties><string name="Name">TenantService</string></Properties><Item class="ModuleScript" referent="NEW129"><Properties><string name="Name">TenantServiceServer</string><ProtectedString name="Source"><![CDATA[--!strict
-- NPC tenants living in rented houses, and viewers walking through listed houses
local TenantServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local SSG = game:GetService('ServerStorage')
local PFS = game:GetService('PathfindingService')

local DAT_Server = require(RPS.Modules.Packages.DataService).server
local TNT_CONFIGS = require(RPS.Modules.Configs.TenantConfigs)
local MKT_CONFIGS = require(RPS.Modules.Configs.MarketConfigs)
local FUR_CONFIGS = require(RPS.Modules.Configs.FurnitureConfigs)
local BLD_CONFIGS = require(RPS.Modules.Configs.BuildConfigs)
local GRD_UTILS = require(RPS.Modules.Utils.GridUtils)
local FUR_UTILS = require(RPS.Modules.Utils.FurnitureUtils)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)
local HSE_Server = require(SSG.Modules.Services.HouseService.HouseServiceServer)
local MKT_Server = require(SSG.Modules.Services.MarketService.MarketServiceServer)

local SYNC_INTERVAL = 3
local MOVE_TIMEOUT = 4

type Npc = {
	Model: Model,
	Humanoid: Humanoid,
	Root: BasePart,
	Bubble: TextLabel,
	Tracks: {[string]: AnimationTrack},
	Alive: boolean,
}

type Group = {
	Npcs: {Npc},
	HouseId: string,
	Viewer: boolean,
}

-- a piece of furniture a tenant can use, worked out from land data
type Spot = {
	Use: TNT_CONFIGS.UseConfig,
	Position: Vector3, -- bottom centre of the item
	Facing: CFrame, -- the item's rotation
	Approach: Vector3, -- where to stand in front of it
}

local random = Random.new()

local groups: {[Player]: {[string]: Group}} = {}
local houseInfo: {[Player]: {[string]: DAT_TYPES.HouseInfo}} = {}

-- random entry from a list
local function pick<T>(List: {T}): T
	return List[random:NextInteger(1, #List)]
end

-- random number of seconds in a range
local function between(Range: {Min: number, Max: number}): number
	return random:NextNumber(Range.Min, Range.Max)
end

-- show text over an NPC's head for a few seconds (nil hides it)
local function say(Npc: Npc, Text: string?, Duration: number?)
	Npc.Bubble.Text = Text or ''
	Npc.Bubble.Visible = Text ~= nil

	if Text and Duration then
		task.delay(Duration, function()
			if Npc.Alive and Npc.Bubble.Text == Text then
				Npc.Bubble.Visible = false
			end
		end)
	end
end

-- the folder NPCs on a land live in
local function getPeopleFolder(Player: Player): Folder?
	local land = HSE_Server:GetLandFolder(Player)

	if not land then
		return nil
	end

	local folder = land:FindFirstChild('People')

	if not folder then
		local newFolder = Instance.new('Folder')
		newFolder.Name = 'People'
		newFolder.Parent = land
		folder = newFolder
	end

	return folder :: Folder
end

-- make an NPC with random colours, a name tag and a speech bubble
local function createNpc(Name: string, Parent: Instance, At: Vector3): Npc?
	local description = Instance.new('HumanoidDescription')
	local skin = pick(TNT_CONFIGS.SkinColors)

	description.HeadColor = skin
	description.LeftArmColor = skin
	description.RightArmColor = skin
	description.TorsoColor = pick(TNT_CONFIGS.ShirtColors)
	description.LeftLegColor = pick(TNT_CONFIGS.PantsColors)
	description.RightLegColor = description.LeftLegColor

	local success, model = pcall(function()
		return PLS:CreateHumanoidModelFromDescription(description, Enum.HumanoidRigType.R15)
	end)

	if not success or not model then
		warn(`[TenantServiceServer]: Couldn't make NPC: {model}`)
		return nil
	end

	local humanoid = model:FindFirstChildOfClass('Humanoid')
	local root = model:FindFirstChild('HumanoidRootPart')
	local head = model:FindFirstChild('Head')

	if not humanoid or not root or not root:IsA('BasePart') or not head then
		model:Destroy()
		return nil
	end

	local rootPart = root :: BasePart

	model.Name = Name
	humanoid.DisplayName = Name
	humanoid.NameDisplayDistance = 60
	humanoid.WalkSpeed = 10
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer

	-- the default Animate script only runs for players, so animate on the server
	local animate = model:FindFirstChild('Animate')

	if animate then
		animate:Destroy()
	end

	local animator = humanoid:FindFirstChildOfClass('Animator')

	if not animator then
		local newAnimator = Instance.new('Animator')
		newAnimator.Parent = humanoid
		animator = newAnimator
	end

	assert(animator)

	local tracks: {[string]: AnimationTrack} = {}

	for name, id in TNT_CONFIGS.Animations do
		local animation = Instance.new('Animation')
		animation.AnimationId = id

		local track = animator:LoadAnimation(animation)
		track.Looped = true
		tracks[name] = track
	end

	humanoid.Running:Connect(function(Speed)
		if rootPart.Anchored then
			return
		end

		if Speed > 0.5 then
			if not tracks.Walk.IsPlaying then
				tracks.Idle:Stop(0.2)
				tracks.Walk:Play(0.2)
			end
		elseif not tracks.Idle.IsPlaying then
			tracks.Walk:Stop(0.2)
			tracks.Idle:Play(0.2)
		end
	end)

	-- speech bubble
	local billboard = Instance.new('BillboardGui')
	billboard.Name = 'Bubble'
	billboard.Size = UDim2.fromOffset(240, 34)
	billboard.StudsOffset = Vector3.new(0, 3.6, 0)
	billboard.MaxDistance = 90
	billboard.Parent = head

	-- the bubble grows sideways to fit its text, so short lines stay small
	local bubble = Instance.new('TextLabel')
	bubble.AnchorPoint = Vector2.new(0.5, 1)
	bubble.Position = UDim2.fromScale(0.5, 1)
	bubble.Size = UDim2.fromOffset(0, 28)
	bubble.AutomaticSize = Enum.AutomaticSize.X
	bubble.BackgroundColor3 = Color3.new(1, 1, 1)
	bubble.TextColor3 = Color3.fromRGB(34, 38, 66)
	bubble.Font = Enum.Font.FredokaOne
	bubble.TextSize = 17
	bubble.Visible = false
	bubble.Parent = billboard

	local corner = Instance.new('UICorner')
	corner.CornerRadius = UDim.new(1, 0)
	corner.Parent = bubble

	local stroke = Instance.new('UIStroke')
	stroke.Thickness = 2
	stroke.Color = Color3.fromRGB(34, 38, 66)
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = bubble

	local padding = Instance.new('UIPadding')
	padding.PaddingLeft = UDim.new(0, 8)
	padding.PaddingRight = UDim.new(0, 8)
	padding.Parent = bubble

	model:PivotTo(CFrame.new(At + Vector3.new(0, 3, 0)))
	model.Parent = Parent

	pcall(function()
		rootPart:SetNetworkOwner(nil)
	end)

	tracks.Idle:Play()

	return {
		Model = model,
		Humanoid = humanoid,
		Root = rootPart,
		Bubble = bubble,
		Tracks = tracks,
		Alive = true,
	}
end

-- walk an NPC to a point using pathfinding (gives up quietly if stuck)
local function walkTo(Npc: Npc, Target: Vector3)
	if not Npc.Alive then
		return
	end

	local path = PFS:CreatePath({
		AgentRadius = 1.4,
		AgentHeight = 5,
		AgentCanJump = false,
		WaypointSpacing = 4,
	})

	local computed = pcall(function()
		path:ComputeAsync(Npc.Root.Position, Target)
	end)

	local waypoints = if computed and path.Status == Enum.PathStatus.Success then path:GetWaypoints() else {}

	if #waypoints == 0 then
		return
	end

	for _, waypoint in waypoints do
		if not Npc.Alive then
			return
		end

		local reached = false
		local connection = Npc.Humanoid.MoveToFinished:Once(function()
			reached = true
		end)

		Npc.Humanoid:MoveTo(waypoint.Position)

		local started = os.clock()

		while not reached and Npc.Alive and os.clock() - started < MOVE_TIMEOUT do
			task.wait(0.1)
		end

		connection:Disconnect()
	end
end

-- furniture in a house that tenants can use
local function getSpots(Player: Player, House: DAT_TYPES.HouseInfo): {Spot}
	local origin = HSE_Server:GetOrigin(Player)
	local spots: {Spot} = {}

	if not origin then
		return spots
	end

	for _, item in HSE_Server:GetLand(Player).Furniture do
		local use = TNT_CONFIGS.Uses[item.Name]
		local config = FUR_CONFIGS.Items[item.Name]
		local cell = GRD_UTILS.LevelCell(item.Level, GRD_UTILS.LocalToCell(item.X, item.Z))

		if not use or not config or not House.Cells[cell] then
			continue
		end

		local position = FUR_UTILS.GetWorldPosition(origin, item)
		local facing = CFrame.Angles(0, math.rad(item.Rotation), 0)
		local front = facing:VectorToWorldSpace(Vector3.new(0, 0, -1))

		table.insert(spots, {
			Use = use,
			Position = position,
			Facing = facing,
			Approach = position + front * (config.Footprint.Y / 2 + 1.8),
		})
	end

	return spots
end

-- centre of a random tile in a house (world position on its floor)
local function randomTile(Player: Player, House: DAT_TYPES.HouseInfo, GroundOnly: boolean?): Vector3?
	local origin = HSE_Server:GetOrigin(Player)
	local cells: {string} = {}

	for levelCell in House.Cells do
		local level = GRD_UTILS.ParseLevelCell(levelCell)

		if not GroundOnly or level == 1 then
			table.insert(cells, levelCell)
		end
	end

	if not origin or #cells == 0 then
		return nil
	end

	local level, cell = GRD_UTILS.ParseLevelCell(pick(cells))
	local x, z = GRD_UTILS.ParseCellKey(cell)

	return GRD_UTILS.CellToWorld(origin, x, z, level) + Vector3.new(0, BLD_CONFIGS.FloorThickness, 0)
end

-- sit / lie / stand at a piece of furniture for a while
local function useSpot(Npc: Npc, Spot: Spot)
	walkTo(Npc, Spot.Approach)

	if not Npc.Alive then
		return
	end

	local use = Spot.Use
	local height = use.Height or 0

	say(Npc, use.Icon)

	if use.Pose == 'Stand' then
		local look = Vector3.new(Spot.Position.X, Npc.Root.Position.Y, Spot.Position.Z)

		if (look - Npc.Root.Position).Magnitude > 0.1 then
			Npc.Root.CFrame = CFrame.lookAt(Npc.Root.Position, look)
		end
	else
		Npc.Root.Anchored = true
		Npc.Tracks.Walk:Stop()

		if use.Pose == 'Sit' then
			-- sit facing the front of the item
			Npc.Root.CFrame = CFrame.new(Spot.Position + Vector3.new(0, height + 1.1, 0)) * Spot.Facing
			Npc.Tracks.Idle:Stop()
			Npc.Tracks.Sit:Play(0.2)
		else
			-- lie on the back, head towards the headboard (+Z of the bed)
			Npc.Root.CFrame = CFrame.new(Spot.Position + Vector3.new(0, height, 0)) * Spot.Facing * CFrame.Angles(math.rad(90), 0, 0)
		end
	end

	task.wait(between(use.Time))

	if not Npc.Alive then
		return
	end

	say(Npc, nil)

	if Npc.Root.Anchored then
		Npc.Tracks.Sit:Stop(0.2)
		Npc.Root.CFrame = CFrame.new(Spot.Approach + Vector3.new(0, 3, 0))
		Npc.Root.Anchored = false
		Npc.Tracks.Idle:Play(0.2)
	end
end

-- how a house feels to the people in it
local function getMood(Player: Player, HouseId: string, Viewer: boolean): string?
	local house = houseInfo[Player] and houseInfo[Player][HouseId]

	if not house then
		return nil
	end

	if house.DirtCount > 0 then
		return pick(if Viewer then TNT_CONFIGS.Moods.ViewerBad else TNT_CONFIGS.Moods.Dirty)
	elseif house.LitFraction < TNT_CONFIGS.DarkLitFraction then
		return pick(if Viewer then TNT_CONFIGS.Moods.ViewerBad else TNT_CONFIGS.Moods.Dark)
	end

	return pick(if Viewer then TNT_CONFIGS.Moods.ViewerGood else TNT_CONFIGS.Moods.Happy)
end

-- a tenant's day: use furniture, wander, say how they feel
local function tenantLife(Player: Player, Npc: Npc, HouseId: string)
	local nextMood = os.clock() + between(TNT_CONFIGS.MoodInterval)

	while Npc.Alive do
		local house = houseInfo[Player] and houseInfo[Player][HouseId]

		if not house then
			task.wait(2)
			continue
		end

		local spots = getSpots(Player, house)

		if #spots > 0 and random:NextNumber() < 0.75 then
			useSpot(Npc, pick(spots))
		else
			local tile = randomTile(Player, house)

			if tile then
				walkTo(Npc, tile)
			end

			task.wait(between({Min = 2, Max = 5}))
		end

		if Npc.Alive and os.clock() >= nextMood then
			nextMood = os.clock() + between(TNT_CONFIGS.MoodInterval)
			say(Npc, getMood(Player, HouseId, false), 4)
			task.wait(4)
		end
	end
end

-- a viewer walks in from the road, looks around, walks out, and comes back again
local function viewerLife(Player: Player, Npc: Npc, HouseId: string, Entrance: Vector3)
	while Npc.Alive do
		for _ = 1, TNT_CONFIGS.ViewerStops do
			local house = houseInfo[Player] and houseInfo[Player][HouseId]
			local tile = house and randomTile(Player, house, true)

			if not Npc.Alive or not tile then
				break
			end

			walkTo(Npc, tile)
			say(Npc, getMood(Player, HouseId, true), 3)
			task.wait(between(TNT_CONFIGS.ViewerLookTime))
		end

		walkTo(Npc, Entrance)
		task.wait(between({Min = 4, Max = 8}))
	end
end

-- remove a group of NPCs
local function despawn(Group: Group)
	for _, npc in Group.Npcs do
		npc.Alive = false
		npc.Model:Destroy()
	end

	Group.Npcs = {}
end

-- how many tenants a house gets (one per bed, bunk beds count twice)
local function getTenantCount(Player: Player, House: DAT_TYPES.HouseInfo): number
	local beds = 0

	for _, item in HSE_Server:GetLand(Player).Furniture do
		local use = TNT_CONFIGS.Uses[item.Name]
		local cell = GRD_UTILS.LevelCell(item.Level, GRD_UTILS.LocalToCell(item.X, item.Z))

		if use and use.Pose == 'Sleep' and House.Cells[cell] then
			beds += if TNT_CONFIGS.BunkBeds[item.Name] then 2 else 1
		end
	end

	return math.clamp(beds, 1, TNT_CONFIGS.MaxPerHouse)
end

-- spawn the tenants (or viewers) for one house
local function spawnGroup(Player: Player, House: DAT_TYPES.HouseInfo, Viewer: boolean, Budget: number): Group?
	local folder = getPeopleFolder(Player)
	local origin = HSE_Server:GetOrigin(Player)

	if not folder or not origin or Budget <= 0 then
		return nil
	end

	local group: Group = {Npcs = {}, HouseId = House.Id, Viewer = Viewer}
	local rental: DAT_TYPES.RentalData? = DAT_Server:get(Player, {'Rentals', House.Id})

	-- viewers start on the road in front of the house
	local entrance = origin + Vector3.new(House.CenterX, BLD_CONFIGS.FloorThickness, GRD_UTILS.LandStuds + 10)

	local count = if Viewer then TNT_CONFIGS.ViewersPerHouse else getTenantCount(Player, House)
	local lastName = pick(MKT_CONFIGS.LastNames)

	for index = 1, math.min(count, Budget) do
		local name = if rental and index == 1 then rental.Tenant else `{pick(MKT_CONFIGS.FirstNames)} {lastName}`

		if Viewer then
			name = `{pick(MKT_CONFIGS.FirstNames)} (viewing)`
		end

		local start = if Viewer then entrance else randomTile(Player, House, true)

		if not start then
			continue
		end

		local npc = createNpc(name, folder, start)

		if npc then
			table.insert(group.Npcs, npc)

			task.spawn(function()
				if Viewer then
					viewerLife(Player, npc, House.Id, entrance)
				else
					tenantLife(Player, npc, House.Id)
				end
			end)
		end
	end

	return group
end

-- make the NPCs match what is rented / listed right now
function TenantServiceServer:Sync(Player: Player)
	local houses = HSE_Server:GetHouses(Player)
	local byId: {[string]: DAT_TYPES.HouseInfo} = {}

	for _, house in houses do
		byId[house.Id] = house
	end

	houseInfo[Player] = byId

	local wanted: {[string]: boolean} = {}

	for houseId in DAT_Server:get(Player, 'Rentals') do
		wanted[`R:{houseId}`] = true
	end

	for houseId in MKT_Server:GetListings(Player) do
		wanted[`V:{houseId}`] = true
	end

	local playerGroups = groups[Player] or {}
	groups[Player] = playerGroups

	local total = 0

	for key, group in playerGroups do
		if not wanted[key] or not byId[group.HouseId] then
			despawn(group)
			playerGroups[key] = nil
		else
			total += #group.Npcs
		end
	end

	for key in wanted do
		if playerGroups[key] then
			continue
		end

		local houseId = string.sub(key, 3)
		local house = byId[houseId]

		if house then
			local group = spawnGroup(Player, house, string.sub(key, 1, 1) == 'V', TNT_CONFIGS.MaxPerPlayer - total)

			if group then
				playerGroups[key] = group
				total += #group.Npcs
			end
		end
	end
end

-- initialize tenant service server-side
function TenantServiceServer:Init()
	PLS.PlayerRemoving:Connect(function(Player)
		for _, group in groups[Player] or {} do
			despawn(group)
		end

		groups[Player] = nil
		houseInfo[Player] = nil
	end)

	task.spawn(function()
		while true do
			task.wait(SYNC_INTERVAL)

			for _, player in PLS:GetPlayers() do
				if HSE_Server:IsReady(player) and DAT_Server:hasProfile(player) then
					local success, err = pcall(function()
						TenantServiceServer:Sync(player)
					end)

					if not success then
						warn(`[TenantServiceServer]: {err}`)
					end
				end
			end
		end
	end)
end

return TenantServiceServer
]]></ProtectedString></Properties></Item></Item></Item></Item><Item class="Folder" referent="ARCHIVE"><Properties><string name="Name">Archive</string></Properties><Item class="Folder" referent="RBX1132"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">Modules</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Folder" referent="RBX1133"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">Services</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="Folder" referent="RBX1275"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">OpeningService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1276"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">OpeningServiceClient (archive)</string><string name="ScriptGuid">{b58e02a2-aaf7-4d41-9e85-56bda11ae299}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local OpeningServiceClient = {}

local RPS = game:GetService('ReplicatedStorage')
local WKS = game:GetService("Workspace")
local PLS = game:GetService('Players')
local RNS = game:GetService('RunService')
local CTP = game:GetService('ContentProvider')
local SDS = game:GetService('SoundService')
local RPF = game:GetService('ReplicatedFirst')

local CAM_UTILS = require(RPS.Modules.Utils.CameraUtils)
local PRP_UTILS = require(RPS.Modules.Utils.PropUtils)
local LGT_UTILS = require(RPS.Modules.Utils.LightUtils)
local ANM_UTILS = require(RPS.Modules.Utils.AnimationUtils)
local AUD_UTILS = require(RPS.Modules.Utils.AudioUtils)
local DRS_UTILS = require(RPS.Modules.Utils.DressUtils)
local INT_UTILS = require(RPS.Modules.Utils.InterfaceUtils)
local DAT_Client = require(RPS.Modules.Packages.DataService).client

local plr = PLS.LocalPlayer :: Player
local openingGui = plr.PlayerGui:WaitForChild('Opening')
local mouse = plr:GetMouse()

local kneeling: {[Model]: AnimationTrack} = {}

local armsTemplate = RPS.Assets.OpeningService.Arms
local camSpeed = 8

local start = RPF.Start

-- initialize cutscene service client-side
function OpeningServiceClient:Init()
	if DAT_Client:get('Onboarding') ~= 'Coronation' then
		return
	end
	
	local plot: Model
	
	while not plot do
		task.wait()
		
		for _, plotModel in WKS.Plots:GetChildren() :: {Model} do
			if plotModel:GetAttribute('Player') == plr.Name then
				plot = plotModel
				break
			end
		end
	end

	start:PivotTo(plot:GetPivot())
	start.Parent = WKS.Temp
	
	local arms = armsTemplate:Clone()
	local startCF = start.Spawn.CFrame
	arms:PivotTo(startCF)
	arms.Parent = WKS.Temp
	
	RNS:BindToRenderStep('Arms Follow Mouse', Enum.RenderPriority.Input.Value + 1, function()
		arms:PivotTo(CFrame.new(startCF.Position, mouse.Hit.Position))
	end)
	
	CAM_UTILS.SetCameraToCFrame(startCF)
	
	local origChar = (plr.Character or plr.CharacterAdded:Wait())
	origChar.Archivable = true
	
	local priest = start.NPCs.Priest
	local priestAnimator = priest.Humanoid.Animator
	
	ANM_UTILS.PlayAnimation(priestAnimator, RPS.Assets.OpeningService.HoldCrown)
	
	task.wait(3)
	
	local open = start.Open.Attachment.Open
	open.Enabled = true
	
	open.Triggered:Wait()
	
	open.Enabled = false
	
	local armsAnimator = arms.Humanoid.Animator
	local track = armsAnimator:LoadAnimation(arms.OpenGate)
	
	track:Play()
	
	local doorTween: Tween
	
	track:GetMarkerReachedSignal('OpenGate'):Once(function()
		start.Gate.Pivot.Open:Play()
		doorTween = PRP_UTILS.OpenDoor(start.Gate, TweenInfo.new(3, Enum.EasingStyle.Linear))
		local tween = LGT_UTILS.TweenLighting({ExposureCompensation = -1}, TweenInfo.new(.7, Enum.EasingStyle.Linear))
		tween.Completed:Once(function()
			LGT_UTILS.TweenLighting({ExposureCompensation = 0}, TweenInfo.new(1, Enum.EasingStyle.Linear))
		end)
		
		CAM_UTILS.TweenFOV(40, TweenInfo.new(3, Enum.EasingStyle.Linear))
	end)
	
	task.wait(1.7)

	local char = origChar:Clone()
	char.Parent = script

	local step1 = RPS.Assets.OpeningService.Step1:Clone()
	step1.Parent = char:FindFirstChild('RightFoot') :: BasePart

	local step2 = RPS.Assets.OpeningService.Step2:Clone()
	step2.Parent = char:FindFirstChild('LeftFoot') :: BasePart

	local human = char:FindFirstChild('Humanoid') :: Humanoid
	local animator = human:FindFirstChildOfClass('Animator') :: Animator

	RNS:BindToRenderStep('Kneel Once Passed', Enum.RenderPriority.Input.Value + 1, function()
		for _, knight in start.NPCs.Knights:GetChildren() :: {Model} do
			if knight:GetPivot().Z < char:GetPivot().Z then
				continue
			end

			if kneeling[knight] then
				continue
			end

			local human = knight:FindFirstChildOfClass('Humanoid') :: Humanoid
			local animator = human:FindFirstChildOfClass('Animator') :: Animator

			kneeling[knight] = ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.Kneel, .65)
		end
	end)

	local clothing: {Accessory} = {RPS.Assets.OpeningService.Shirt, RPS.Assets.OpeningService.Pants, RPS.Assets.OpeningService.Cape}
	
	local walkTrack = ANM_UTILS.PlayAnimation(animator, RPS.Assets.OpeningService.Walk)

	DRS_UTILS.DressUp(char, clothing)
	
	RNS:UnbindFromRenderStep('Arms Follow Mouse')
	arms:Destroy()
	
	doorTween.Completed:Wait()

	AUD_UTILS.PlayMusic(SDS.Cathedral)

	local camTweening = true
	local bStep1 = RPS.Assets.OpeningService.Step1:Clone()
	local bStep2 = RPS.Assets.OpeningService.Step2:Clone()
	bStep1.Parent = SDS
	bStep2.Parent = SDS
	
	local step: Sound = bStep1

	task.spawn(function()
		while camTweening do
			step:Play()
			step = step == bStep2 and bStep1 or bStep2
			task.wait(1)
		end
	end)
	
	local moveCF = start.Move.CFrame
	local moveTween = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new((startCF.Position - moveCF.Position).Magnitude/camSpeed, Enum.EasingStyle.Linear), 40)
	
	moveTween.Completed:Wait()
	
	camTweening = false
	
	local cutscene1F = start.Cutscene1
	startCF = cutscene1F.Start.CFrame
	moveCF = cutscene1F.End.CFrame

	char.Parent = WKS.Temp
	char:PivotTo(cutscene1F.Pivot:GetPivot())

	human.WalkSpeed = camSpeed
	human:MoveTo(cutscene1F.Target.CFrame.Position)

	local moving = true
	local step: Sound = step1

	task.spawn(function()
		while moving do
			step:Play()
			step = step == step2 and step1 or step2
			task.wait(1.065)
		end
	end)
	
	local timeForTween = (startCF.Position - moveCF.Position).Magnitude/camSpeed
	local cutscene1T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35)
	
	cutscene1T.Completed:Wait()
	
	local cutscene2F = start.Cutscene2
	startCF = cutscene2F.Start.CFrame
	moveCF = cutscene2F.End.CFrame

	local pivotCF = cutscene2F.Pivot.CFrame
	local targetCF = cutscene2F.Target.CFrame

	timeForTween = (targetCF.Position - pivotCF.Position).Magnitude/camSpeed
	local cutscene2T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 25,35)

	human:MoveTo(targetCF.Position)
	
	cutscene2T.Completed:Wait()

	local cutscene3F = start.Cutscene3
	startCF = cutscene3F.Start.CFrame
	moveCF = cutscene3F.End.CFrame

	pivotCF = cutscene3F.Pivot.CFrame
	targetCF = cutscene3F.Target.CFrame

	timeForTween = (targetCF.Position - pivotCF.Position).Magnitude/camSpeed
	local cutscene3T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35, 25)

	human:MoveTo(targetCF.Position)
	
	cutscene3T.Completed:Wait()

	local cutscene4F = start.Cutscene4
	startCF = cutscene4F.Start.CFrame
	moveCF = cutscene4F.End.CFrame

	pivotCF = cutscene4F.Pivot.CFrame
	targetCF = cutscene4F.Target.CFrame

	timeForTween = (targetCF.Position - pivotCF.Position).Magnitude/camSpeed
	local cutscene4T = CAM_UTILS.PlayCutscene(startCF, moveCF, TweenInfo.new(timeForTween, Enum.EasingStyle.Linear), 35, 25)

