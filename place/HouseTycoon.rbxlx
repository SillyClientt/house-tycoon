tring name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)
local DAT_TYPES = require(RPS.Modules.Types.DataTypes)

local InvasionClientSignals = {
	Aftermath = Signal() :: Signal.Signal<Player, string, {DAT_TYPES.ActiveTrooperData}>
}

return InvasionClientSignals
