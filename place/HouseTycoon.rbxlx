local Backpack = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local WKS = game:GetService('Workspace')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local TOL_CONFIGS = require(RPS.Modules.Services.ToolService.ToolConfigs)

local plr = PLS.LocalPlayer :: Player
local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local backpack = gui:WaitForChild('Backpack')
local closeB = backpack:WaitForChild('Close')

local tweens: {[Instance]: Tween} = {}

--[[
-- rotate button on hover
local function addButtonEffect(Button: TextButton)
	local colors = {
		Hover = Button:GetAttribute('Hover'),
		Neutral = Button:GetAttribute('Neutral')
	}

	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1),
			BackgroundColor3 = colors.Hover
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = size,
			BackgroundColor3 = colors.Neutral
		})
		tweens[Button] = tween
		tween:Play()
	end)
end
]]

-- update bakpack items
local function updateBackpack()
	local inventoryData = DAT_Client:get('Inventory')
	
	local gadgets: {[number]: {Name: string, Data: any, Config: any}} = {}
	local i = 1
	
	for name, data in inventoryData do
		local config = TOL_CONFIGS.Gizmo[name]
		
		if not config then
			continue
		end
		
		gadgets[i] = {
			Name = name,
			Data = data,
			Config = config
		}
		i += 1
	end
	
	local reached = #gadgets
	
	for index = 1, TOL_CONFIGS.InventorySpace do
		local data = gadgets[index]
		local slot = backpack.Items:FindFirstChild(tostring(index)) :: typeof(backpack.Items['1'])
		
		if data then
			local name = gadgets[index].Name
			local gadget = gadgets[index].Data
			local config = gadgets[index].Config
			
			slot.Icon.Image = config.Image
			slot.Icon.Visible = true
			
			slot.Amount.Amount.Text = gadget.Amount > 1 and 'x'..gadget.Amount or ''
			slot.Amount.Visible = gadget.Amount > 1
			
			slot.UIStroke.Enabled = gadget.Equipped
			
			slot:SetAttribute('Item', name)
		else
			slot.Icon.Visible = false
			slot.UIStroke.Enabled = false
			slot.Amount.Visible = false
			slot:SetAttribute('Item', nil)
		end
	end
end

-- initialize backpack ui
function Backpack:Init()
	closeB.MouseEnter:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end

		local tween = TWS:Create(closeB, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 15,
			Size = UDim2.fromScale(.175,.175)
		})
		tweens[closeB] = tween
		tween:Play()
	end)
	closeB.MouseLeave:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end

		local tween = TWS:Create(closeB, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = UDim2.fromScale(.15,.15)
		})
		tweens[closeB] = tween
		tween:Play()
	end)

	closeB.MouseButton1Click:Connect(function()
		backpack.Visible = false
	end)
	
	updateBackpack()
	
	DAT_Client:getChangedSignal('Inventory'):Connect(function()
		updateBackpack()
	end)
end

return Backpack
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1261"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Notification</string><string name="ScriptGuid">{77bf1d8f-16fd-4702-a5de-09a6ab1614b8}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Notification = {}

local RPS = game:GetService('ReplicatedStorage')
local PLS = game:GetService('Players')
local TWS = game:GetService("TweenService")

local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui
local gui = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local notification = gui:WaitForChild('Notification')

local tween: Tween
local lastNotif = 0

-- show a notification with the input text
local function notify(Text: string)
	notification.Text = Text
	
	if tween then
		tween:Destroy()
	end
	
	tween = TWS:Create(notification, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
		TextTransparency = 0
	})
	tween:Play()
	
	task.delay(2.5, function()
		if os.clock() - lastNotif < 2.5 then
			return
		end
		
		tween = TWS:Create(notification, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			TextTransparency = 1
		})
		tween:Play()
	end)
	
	notification.NotificationSound:Play()
	lastNotif = os.clock()
end

-- initialize notification ui
function Notification:Init()
	RPS.Remotes.TutorialService.Notify.OnClientEvent:Connect(notify)
	INT_CSignals.Notify:Connect(notify)
end

return Notification
