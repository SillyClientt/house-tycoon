 name="AttributesSerialize"></BinaryString><ColorSequence name="Color">0 0.721568644 0.725490212 0.733333349 0 0.883333325 0.933333337 0.933333337 0.933333337 0 0.931666672 0.988392174 0.989117622 0.989117622 0 1 0.909803927 0.917647064 0.917647064 0 </ColorSequence><bool name="DefinesCapabilities">false</bool><bool name="Enabled">true</bool><string name="Name">UIGradient</string><Vector2 name="Offset"><X>0</X><Y>0</Y></Vector2><float name="Rotation">-90</float><float name="Scale">1</float><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64><token name="TileMode">0</token><NumberSequence name="Transparency">0 0 0 1 0 0 </NumberSequence><token name="Type">0</token></Properties></Item><Item class="UIStroke" referent="RBX1175"><Properties><token name="ApplyStrokeMode">1</token><BinaryString name="AttributesSerialize"></BinaryString><UDim name="BorderOffset"><S>0</S><O>0</O></UDim><token name="BorderStrokePosition">0</token><Color3 name="Color"><R>0.411764741</R><G>0.788235366</G><B>1</B></Color3><bool name="DefinesCapabilities">false</bool><bool name="Enabled">true</bool><token name="LineJoinMode">0</token><string name="Name">UIStroke</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64><token name="StrokeSizingMode">0</token><float name="Thickness">2</float><float name="Transparency">0</float><int name="ZIndex">1</int></Properties></Item></Item></Item><Item class="ModuleScript" referent="RBX1248"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Home</string><string name="ScriptGuid">{834c21f2-25b7-4153-8381-959964075c0c}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Home = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local MPS = game:GetService('MarketplaceService')
local SCS = game:GetService('SocialService')
local STG = game:GetService('StarterGui')
local SDS = game:GetService('SoundService')
local WKS = game:GetService('Workspace')

local SST_CONFIGS = require(RPS.Modules.Services.StationService.StationConfigs)
local RWD_UTILS = require(RPS.Modules.Services.RewardService.RewardUtils)
local DAT_Client = require(RPS.Modules.Packages.DataService).client
local TIT_CONFIGS = require(RPS.Modules.Services.TitleService.TitleConfigs)

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui
local hud = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local sidebar = hud:WaitForChild('Sidebar')
local homeB = sidebar:WaitForChild('Home')
local newUpgrade = homeB:WaitForChild('NewUpgrade')
local home = hud:WaitForChild('Home')
local homeSidebar = home:WaitForChild('Sidebar')
local main = home:WaitForChild('Main')
local statistics = home:WaitForChild('Stats')
local closeB = home:WaitForChild('Close')
local stationFrame = main:WaitForChild('Station')
local upgradeView = stationFrame:WaitForChild('UpgradePreview')
local levelView = stationFrame:WaitForChild('LevelPreview')
local upgradeB = upgradeView:WaitForChild('Upgrade')
local playersScroller = main:WaitForChild('Players'):WaitForChild('Scroller')
local playerTemplate = playersScroller:WaitForChild('PlayerList')
local friendTemplate = playersScroller:WaitForChild('FriendList')
local titlesMain = main:WaitForChild('Titles')
local titlesScroller = titlesMain:WaitForChild('TitlesList'):WaitForChild('Scroller')
local titlePreview = titlesMain:WaitForChild('TitlePreview')
local titleEquipped = titlesMain:WaitForChild('TitleEquipped')
local titleTemplate = titlesScroller:WaitForChild('Title')
local settingsFrame = main:WaitForChild('Settings'):WaitForChild('Main')

local tweens: {[Instance]: Tween} = {}
local frames: {[Player]: Frame} = {}
local guis: {BillboardGui} = {}
local descConn: RBXScriptConnection?

local settingsBools = {
	Music = true,
	Feedback = true,
	Dialogue = true,
	Labels = false,
	HUD = true
}

local selectedCat = homeSidebar:WaitForChild('Station')
local lastUpgrade = 0

local selectedTitle: typeof(titleTemplate)

-- play new upgrade available
local function checkNewUpgrade()
	local level = DAT_Client:get('StationLevel')
	local coins = DAT_Client:get('StationCoins')
	local shells = DAT_Client:get('Shells')
	local xp = DAT_Client:get('StationXP')
	local config = SST_CONFIGS.Upgrades[level + 1]
	if not config then
		return
	end

	if config.ShellsCost > shells or config.StationCoinsCost > coins or config.XPRequired > xp then
		return
	end
	
	if homeB:GetAttribute('Notification') then
		return
	end

	homeB:SetAttribute('Notification', true)

	local frame = homeB.NewUpgrade.Frame
	local oldTween = tweens[frame]

	if oldTween then
		oldTween:Destroy()
	end

	homeB.NewUpgrade.Visible = true

	frame.Position = UDim2.fromScale(1,0)

	tweens[frame] = TWS:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Cubic, Enum.EasingDirection.InOut), {
		Position = UDim2.fromScale(1,1)
	})
	tweens[frame]:Play()

	home.NewUpgrade:Play()
	lastUpgrade = tick()

	task.spawn(function()
		task.wait(1.5)

		if tick() - lastUpgrade >= 1.45 then
			tweens[frame] = TWS:Create(frame, TweenInfo.new(0.15, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
				Position = UDim2.fromScale(0,1)
			})
			tweens[frame]:Play()

			tweens[frame].Completed:Wait()
			if frame.Position == UDim2.fromScale(0,1) then
				homeB.NewUpgrade.Visible = false
			end
		end
	end)
end

-- rotate button on hover
local function addButtonEffect(Button: TextButton)
	local colors = {
		Hover = Button:GetAttribute('Hover'),
		Neutral = Button:GetAttribute('Neutral')
	}
	
	local size = Button.Size

	Button.MouseEnter:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 5,
			Size = UDim2.fromScale(size.X.Scale * 1.1,size.Y.Scale * 1.1),
			BackgroundColor3 = colors.Hover
		})
		tweens[Button] = tween
		tween:Play()
	end)
	Button.MouseLeave:Connect(function()
		if tweens[Button] then
			tweens[Button]:Destroy()
		end

		local tween = TWS:Create(Button, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = size,
			BackgroundColor3 = colors.Neutral
		})
		tweens[Button] = tween
		tween:Play()
	end)
end

-- update station page
local function updateStationPage()
	local level = DAT_Client:get('StationLevel')
	local xp = DAT_Client:get('StationXP')
	local floorXP = math.floor(xp)
	local config = SST_CONFIGS.Upgrades[level]
	local nextConfig = SST_CONFIGS.Upgrades[level + 1]
	
	upgradeView.CoinsAmount.Text = nextConfig and tostring(nextConfig.StationCoinsCost) or 'MAX'
	upgradeView.ShellsAmount.Text = nextConfig and tostring(nextConfig.ShellsCost) or 'MAX'
	upgradeView.NextBoost.Text = nextConfig and nextConfig.UpgradePreview or 'MAX'
	upgradeView.Level.Text = 'Level '..(nextConfig and tostring(level + 1) or 'MAX')
	
	levelView.XP.Text = nextConfig and tostring(floorXP)..' / '..tostring(nextConfig.XPRequired)..' XP' or tostring(nextConfig.XPRequired)..' / '..tostring(nextConfig.XPRequired)..' XP'
	levelView.Level.Text = 'LEVEL '..tostring(level)
	levelView.XpBar.Xp.Size = UDim2.fromScale(nextConfig and (math.min(xp, nextConfig.XPRequired)/nextConfig.XPRequired) or 1, 0.9)
	
	levelView.StationStats.CleaningSpeed.Amount.Text = tostring('+'..SST_CONFIGS.Upgrades[level].CleaningBoost * 100)..'%'
	levelView.StationStats.ShellsEarned.Amount.Text = tostring('+'..SST_CONFIGS.Upgrades[level].ShellsBoost * 100)..'%'
end

-- update player count
local function updatePlayerCount()
	local count = 0
	for _ in PLS:GetPlayers() do
		count += 1
	end
	
	playersScroller.Players.Text = `Players in the server ({count}/{PLS.MaxPlayers})`
end

-- add player to list
local function addPlayer(Player: Player)
	if plr == Player then
		return
	end
	
	local frame
	local userId = Player.UserId
	
	if plr:IsFriendsWithAsync(userId) then
		frame = friendTemplate:Clone()
	else
		frame = playerTemplate:Clone()
		addButtonEffect(frame.Add)
		
		frame.Add.MouseButton1Click:Connect(function()
			STG:SetCore("PromptSendFriendRequest", Player)
		end)
	end
	
	local title = RPS.Remotes.StationService.GetTitle:InvokeServer(Player)
	local titleConfig = TIT_CONFIGS.Titles[title]
	
	frame.Icon.Image = PLS:GetUserThumbnailAsync(userId, Enum.ThumbnailType.AvatarBust, Enum.ThumbnailSize.Size60x60)
	frame.PlayerName.Text = Player.Name
	frame.PlayerTitle.Text = titleConfig and titleConfig.DisplayName
	frame.StationLvl.Text = 'Lvl '.. RPS.Remotes.StationService.GetStationLevel:InvokeServer(Player)
	
	local plot = RPS.Remotes.StationService.GetPlot:InvokeServer(Player) :: Model
	
	addButtonEffect(frame.Visit)
	frame.Visit.MouseButton1Click:Connect(function()
		local char = plr.Character
		if char and plot and plot:FindFirstChild('SpawnLocation') then
			char:PivotTo((plot:FindFirstChild('SpawnLocation') :: SpawnLocation).CFrame)
		end
	end)
	
	frames[Player] = frame
	frame.Visible = true
	frame.Parent = playersScroller
	
	updatePlayerCount()
end

-- remove player from list
local function removePlayer(Player: Player)
	local frame = frames[Player]
	
	if frame then
		frame:Destroy()
	end
	
	updatePlayerCount()
end

-- update player title
local function updatePlayerTitle(Player: Player, Title: string)
	local frame = frames[Player]
	
	if frame then
		(frame:FindFirstChild('PlayerTitle') :: TextLabel).Text = Title
	end
end

-- update station level
local function updateStationLevel(Player: Player, Level: number)
	local frame = frames[Player]

	if frame then
		(frame:FindFirstChild('StationLvl') :: TextLabel).Text = 'Lvl '..Level
	end
end

local function updateFill(TitleFrame: typeof(titleTemplate), Config: {
		Requirement: {
			Amount: number,
			Path: string,
			AllKeys: boolean
		}?,
		
		Custom: boolean?
	})

	local maxAmount = 0
	local amount = 0

	if Config.Custom then
		local skins = DAT_Client:get('Skins')

		if TitleFrame.Name == 'SetCollector' then
			local setComplete = true
			
			maxAmount = 4

			for skin, set in skins do
				if skin == 'Daily' or skin == 'Normal' then
 					continue
				end

				local unlockedAmount = 0
				
				setComplete = true
				for tool, unlocked in set do
					unlockedAmount += unlocked and 1 or 0
					amount = math.max(amount, unlockedAmount)

					if not unlocked then
						setComplete = false
						break
					end
				end

				if setComplete then
					break
				end
			end
		elseif TitleFrame.Name == 'SpectrumMaster' then
			for skin, set in skins do
				if skin == 'Daily' or skin == 'Normal' then
					continue
				end

				for tool, unlocked in set do
					amount += unlocked and 1 or 0
					maxAmount += 1
				end
			end
		end
	else
		if not Config.Requirement then
			amount = 1
			maxAmount = 1
		else
			local data = DAT_Client:get(Config.Requirement.Path)

			if Config.Requirement.AllKeys then
				for key, value in data do
					amount += value
					maxAmount += Config.Requirement.Amount
				end
			else
				amount = data
				maxAmount = Config.Requirement.Amount
			end
		end
	end
	
	amount = math.min(amount, maxAmount)
	
	TitleFrame.Progress.Fill.Size = UDim2.fromScale(amount / maxAmount, 1)
	TitleFrame.FillFraction.Text = `{amount}/{maxAmount}`
	
	TitleFrame.Equip.Visible = amount == maxAmount
end

-- update all fills
local function updateFills()
	for _, child in titlesScroller:GetChildren() do
		if not child:IsA('TextButton') then
			continue
		end
		
		local config = TIT_CONFIGS.Titles[child.Name]
		
		if not config then
			continue
		end
		
		updateFill(child :: typeof(selectedTitle), config :: any)
	end
end

-- update equipped title
local function updateEquippedTitle()
	local equipped = DAT_Client:get('SelectedTitle')
	local config = TIT_CONFIGS.Titles[equipped]
	
	if not config then
		titleEquipped.Visible = false
		return
	end
	
	local renameFrame = titleEquipped.Frame.TitleRename
	
	renameFrame.TextLabel.Text = config.DisplayName
	renameFrame.UIGradient.Color = config.Gradient
	renameFrame.UIStroke.Color = config.Gradient.Keypoints[1].Value

	titleEquipped.Visible = true
end

-- update selected title
local function updateTitlePreview(Config: {DisplayName: string, Description: string, Gradient: ColorSequence, Requirement: {Path: string | {string}, Amount: number, AllKeys: boolean?}?, Custom: boolean?, Order: number, Bonus: {Type: string, Amount: number}?})
	titlePreview.HowToObtain.Text = Config.Description

	local renameFrame = titlePreview.TitleRename

	renameFrame.TextLabel.Text = Config.DisplayName
	renameFrame.UIGradient.Color = Config.Gradient
	renameFrame.UIStroke.Color = Config.Gradient.Keypoints[1].Value

	titlePreview.BonusEffect.Text = Config.Bonus and Config.Bonus.Type or 'No Bonus'
	titlePreview.Percent.Text = Config.Bonus and `+{Config.Bonus.Amount * 100}%` or '+0%'
end

-- initialize title buttons
local function initTitles()
	local selected = DAT_Client:get('SelectedTitle')
	
	titleTemplate.Visible = false
	
	for title, config in TIT_CONFIGS.Titles do
		local titleFrame = titleTemplate:Clone()
		titleFrame.Name = title
		
		titleFrame.TitleRename.TextLabel.Text = config.DisplayName
		titleFrame.TitleRename.UIGradient.Color = config.Gradient
		titleFrame.TitleRename.UIStroke.Color = config.Gradient.Keypoints[1].Value
		titleFrame.HowToObtain.Text = config.Description
		titleFrame.TitleName.Text = config.DisplayName
		titleFrame.BonusEffect.Text = config.Bonus and config.Bonus.Type or 'No Bonus'
		titleFrame.Percent.Text = config.Bonus and `+{config.Bonus.Amount * 100}%` or '+0%'
		
		updateFill(titleFrame, config :: any)
		
		titleFrame.LayoutOrder = config.Order
		titleFrame.Parent = titlesScroller
		titleFrame.Visible = true
		
		titleFrame.MouseButton1Click:Connect(function()
			updateTitlePreview(config)
		end)
		
		titleFrame.Equip.MouseButton1Click:Connect(function()
			RPS.Remotes.TitleService.SetTitle:FireServer(title)
		end)
		
		addButtonEffect(titleFrame.Equip)
		
		if title == selected then
			updateTitlePreview(config)
		end
	end
end

-- tween toggle to boolean
local function tweenToggleTo(Toggle: Frame, To: boolean)
	if tweens[Toggle] then
		tweens[Toggle]:Destroy()
	end
	
	local pos = To and UDim2.fromScale(1, .5) or UDim2.fromScale(0, .5)
	local anchor = To and Vector2.new(1, .5) or Vector2.new(0, .5)

	local tween = TWS:Create(Toggle, TweenInfo.new(0.15, Enum.EasingStyle.Cubic), {
		Position = pos,
		AnchorPoint = anchor
	})
	tween:Play()
	
	tweens[Toggle] = tween
end

-- toggle labels
local function toggleLabels(Toggle: boolean)
	tweenToggleTo(settingsFrame.Labels.Toggle.Icon, settingsBools.Labels)

	if descConn then
		descConn:Disconnect()
	end

	for _, gui in guis do
		gui.Enabled = true
	end

	table.clear(guis)

	if not settingsBools.Labels then
		for _, desc in WKS:GetDescendants() do
			if desc:IsA('BillboardGui') then
				if desc:HasTag('DialogueGui') or desc:HasTag('HintGui') then
					continue
				end
				
				if desc.Enabled then
					table.insert(guis, desc)
					desc.Enabled = false
				end
			end
		end

		descConn = WKS.DescendantAdded:Connect(function(Descendant)
			if Descendant:IsA('BillboardGui') then
				if Descendant:HasTag('DialogueGui') or Descendant:HasTag('HintGui') then
					return
				end
				
				if Descendant.Enabled then
					table.insert(guis, Descendant)
					Descendant.Enabled = false
				end
			end
		end)
	end

end

-- initialize settings frame
local function initSettings()
	settingsFrame.Music.Toggle.MouseButton1Click:Connect(function()
		settingsBools.Music = not settingsBools.Music
		tweenToggleTo(settingsFrame.Music.Toggle.Icon, settingsBools.Music)
		SDS.Master.Music.Volume = settingsBools.Music and 1 or 0
	end)
	settingsFrame.Feedback.Toggle.MouseButton1Click:Connect(function()
		settingsBools.Feedback = not settingsBools.Feedback
		tweenToggleTo(settingsFrame.Feedback.Toggle.Icon, settingsBools.Feedback)
		SDS.Master.Feedback.Volume = settingsBools.Feedback and 1 or 0
	end)
	settingsFrame.Dialogue.Toggle.MouseButton1Click:Connect(function()
		settingsBools.Dialogue = not settingsBools.Dialogue
		tweenToggleTo(settingsFrame.Dialogue.Toggle.Icon, settingsBools.Dialogue)
		SDS.Master.Dialogue.Volume = settingsBools.Dialogue and 1 or 0
	end)
	settingsFrame.Labels.Toggle.MouseButton1Click:Connect(function()
		settingsBools.Labels = not settingsBools.Labels
		toggleLabels(settingsBools.Labels)
	end)
end

-- initialize home interface
function Home:Init()
	local onboardingTutorial = DAT_Client:get('OnboardingTutorial')
	if not onboardingTutorial.Finished then
		settingsBools.Labels = false
		toggleLabels(settingsBools.Labels)
	end

	DAT_Client:getChangedSignal('OnboardingTutorial'):Connect(function(NewData)
		if NewData.Finished then
			settingsBools.Labels = true
			toggleLabels(settingsBools.Labels)
		end
	end)
	
	initTitles()
	initSettings()
	
	playerTemplate.Visible = false
	friendTemplate.Visible = false
	
	updateEquippedTitle()
	updateStationPage()
	updatePlayerCount()
		
	DAT_Client:getChangedSignal('SelectedTitle'):Connect(function(NewTitle)
		local config = TIT_CONFIGS.Titles[NewTitle]
		
		updateEquippedTitle()
		
		if config then
			updateTitlePreview(config)
		end
	end)
		
	statistics:WaitForChild('ShellsEarned').Text = RWD_UTILS.ToString(DAT_Client:get('TotalShellsEarned'))
	statistics.TimePlayed.Text = RWD_UTILS.ToTimer(DAT_Client:get('TotalTimePlayed'))
	statistics.FishCleaned.Text = DAT_Client:get('TotalFishCleaned')

	DAT_Client:getChangedSignal('TotalShellsEarned'):Connect(function(Shells)
		statistics.ShellsEarned.Text = RWD_UTILS.ToString(Shells)
	end)
	DAT_Client:getChangedSignal('TotalFishCleaned'):Connect(function(FishNo)
		statistics.FishCleaned.Text = FishNo
		updateFills()
	end)
	
	RPS.Remotes.StationService.UpdateTotalTimePlayed.OnClientEvent:Connect(function(Time)
		statistics.TimePlayed.Text = RWD_UTILS.ToTimer(Time)
	end)
		
	DAT_Client:getChangedSignal('Shells'):Connect(checkNewUpgrade)
	DAT_Client:getChangedSignal('StationCoins'):Connect(checkNewUpgrade)
	
	DAT_Client:getChangedSignal('StationLevel'):Connect(function()
		homeB:SetAttribute('Notification', nil)
		updateStationPage()
		
		updateFills()
	end)
	DAT_Client:getChangedSignal('StationXP'):Connect(updateStationPage)
	DAT_Client:getChangedSignal('Skins'):Connect(updateFills)
	
	for _, config in TIT_CONFIGS.Titles do
		if config.Requirement then
			DAT_Client:getChangedSignal(config.Requirement.Path):Connect(updateFills)
		end
	end
	
	for _, player in PLS:GetPlayers() do
		addPlayer(player)
	end
	
	PLS.PlayerAdded:Connect(addPlayer)
	PLS.PlayerRemoving:Connect(removePlayer)
	
	RPS.Remotes.StationService.UpdateTitle.OnClientEvent:Connect(updatePlayerTitle)
	RPS.Remotes.StationService.UpdateStationLevel.OnClientEvent:Connect(updateStationLevel)
	
	for _, sidebarButton in homeSidebar:GetChildren() do
		if not sidebarButton:IsA('TextButton') then
			continue
		end
		
		sidebarButton.MouseEnter:Connect(function()
			if tweens[sidebarButton] then
				tweens[sidebarButton]:Destroy()
			end
			
			local tween = TWS:Create(sidebarButton, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = Color3.fromRGB(124, 198, 255)
			})
			tweens[sidebarButton] = tween
			tween:Play()
		end)
		sidebarButton.MouseLeave:Connect(function()
			if selectedCat == sidebarButton then
				return
			end
			
			if tweens[sidebarButton] then
				tweens[sidebarButton]:Destroy()
			end

			local tween = TWS:Create(sidebarButton, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
				BackgroundColor3 = Color3.fromRGB(17, 47, 91)
			})
			tweens[sidebarButton] = tween
			tween:Play()
		end)
		
		sidebarButton.MouseButton1Click:Connect(function()
			if sidebarButton == selectedCat then
				return
			end
			
			if tweens[sidebarButton] then
				tweens[sidebarButton]:Destroy()
			end
			
			sidebarButton.BackgroundColor3 = Color3.fromRGB(124, 198, 255);
			
			selectedCat.BackgroundColor3 = Color3.fromRGB(17, 47, 91)
			selectedCat = sidebarButton :: typeof(selectedCat)
			
			for _, child in main:GetChildren() do
				if not child:IsA('Frame') then
					continue
				end
				
				child.Visible = child.Name == sidebarButton.Name
			end
		end)
	end
		
	closeB.MouseEnter:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end
		
		local tween = TWS:Create(closeB, TweenInfo.new(.15, Enum.EasingStyle.Cubic), {
			Rotation = 15,
			Size = UDim2.fromScale(.175,.175)
		})
		tweens[closeB] = tween
		tween:Play()
	end)
	closeB.MouseLeave:Connect(function()
		if tweens[closeB] then
			tweens[closeB]:Destroy()
		end

		local tween = TWS:Create(closeB, TweenInfo.new(.1, Enum.EasingStyle.Cubic), {
			Rotation = 0,
			Size = UDim2.fromScale(.15,.15)
		})
		tweens[closeB] = tween
		tween:Play()
	end)
	
	closeB.MouseButton1Click:Connect(function()
		home.Visible = false
	end)
	
	addButtonEffect(upgradeB)
	
	upgradeB.MouseButton1Click:Connect(function()
		RPS.Remotes.StationService.UpgradeStation:FireServer()
	end)
end

return Home
