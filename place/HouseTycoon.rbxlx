	},
	Wood = {
		DisplayName = 'Wood',
		Order = 2,
		Cost = 45,
		Value = 33,
		Color = Color3.fromRGB(161, 116, 76),
		Material = Enum.Material.WoodPlanks,
	},
	Painted = {
		DisplayName = 'Painted',
		Order = 3,
		Cost = 45,
		Value = 34,
		Color = Color3.fromRGB(150, 190, 210),
		Material = Enum.Material.SmoothPlastic,
	},
	Brick = {
		DisplayName = 'Brick',
		Order = 4,
		Cost = 60,
		Value = 45,
		Color = Color3.fromRGB(158, 84, 64),
		Material = Enum.Material.Brick,
	},
	Stone = {
		DisplayName = 'Stone',
		Order = 5,
		Cost = 90,
		Value = 69,
		Color = Color3.fromRGB(150, 150, 145),
		Material = Enum.Material.Cobblestone,
	},
}

BuildConfigs.WallStyles = wallStyles

local floorStyles: {[string]: CFG_TYPES.FloorStyleConfig} = {
	Wood = {
		DisplayName = 'Wood',
		Order = 1,
		Cost = 45,
		Value = 39,
		Color = Color3.fromRGB(176, 128, 84),
		Material = Enum.Material.WoodPlanks,
	},
	Carpet = {
		DisplayName = 'Carpet',
