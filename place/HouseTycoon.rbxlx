local Boosts = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')

local plr = PLS.LocalPlayer :: Player
local plrGui = plr.PlayerGui
local gui = (plrGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local boostsFrame = gui:WaitForChild('Boosts')

-- initialize boosts interface
function Boosts:Init()
	task.spawn(function()
		while true do
			task.wait(5)
			
			local activeBoosts = RPS.Remotes.FishService.GetBoosts:InvokeServer()
			
			for _, child in boostsFrame:GetChildren() do
				if not child:IsA('ImageButton') then
					continue
				end
				
				child.Visible = table.find(activeBoosts, child.Name) ~= nil
			end
		end
	end)
end

return Boosts
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1250"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">Objective</string><string name="ScriptGuid">{d6058c9b-905d-4965-8acd-46306737b580}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local Objective = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local TWS = game:GetService('TweenService')
local WKS = game:GetService('Workspace')

local DAT_Client = require(RPS.Modules.Packages.DataService).client
local RWD_UTILS = require(RPS.Modules.Services.RewardService.RewardUtils)
local STT_CONFIGS = require(RPS.Modules.Services.StationService.StationConfigs)
local TUT_UTILS = require(RPS.Modules.Services.TutorialService.TutorialUtils)
local INT_UTILS = require(RPS.Modules.Services.InterfaceService.InterfaceUtils)
local INT_CSignals = require(RPS.Modules.Services.InterfaceService.InterfaceClientSignals)
local TOL_CONFIGS = require(RPS.Modules.Services.ToolService.ToolConfigs)
local INT_UTILS = require(RPS.Modules.Services.InterfaceService.InterfaceUtils)
local FSH_CONFIGS = require(RPS.Modules.Services.FishService.FishConfigs)

local plr = PLS.LocalPlayer :: Player
local mouse = plr:GetMouse()

local gui = (plr.PlayerGui:WaitForChild('HUD', 100) :: typeof(game:GetService('StarterGui').HUD))
local objectiveFrame = gui:WaitForChild('Objective')
local close = objectiveFrame:WaitForChild('Close')
local objective = objectiveFrame:WaitForChild('Objective')
local tutorialSkip = gui:WaitForChild('TutorialSkip')

local tween: Tween
local toggle = false

local conn: RBXScriptConnection?

local showing: string?
local queue: {string} = {}

-- wait for dirt to be added
local function waitForDirt(): BasePart
	local dirt: BasePart

	for _, child in WKS.Dirt:GetChildren() :: {BasePart} do
		if child:GetAttribute('Player') == plr.Name and not child:GetAttribute('Whale') then
			dirt = child
			break
		end
	end

	if not dirt then
		local conn: RBXScriptConnection; conn = WKS.Dirt.ChildAdded:Connect(function(Child)
			if Child:IsA('BasePart') and Child:GetAttribute('Player') == plr.Name and not Child:GetAttribute('Whale') then
				dirt = Child
				conn:Disconnect()
			end	
		end)

		while not dirt do
			task.wait()
		end
	end
	
	return dirt
end

-- wait for obstacle
local function waitForObstacle(Obstacle: string): Model
	local obstacle: Model

	for _, child in WKS.Obstacles:GetChildren() :: {Model} do
		if child.Name:match(Obstacle) and not child:GetAttribute('Whale') and child:GetAttribute('Player') == plr.Name then
			obstacle = child
			break
		end
	end

	if not obstacle then
		local conn: RBXScriptConnection; conn = WKS.Obstacles.ChildAdded:Connect(function(Child)
			if Child.Name:match(Obstacle) and Child:IsA('Model') and not Child:GetAttribute('Whale') and Child:GetAttribute('Player') == plr.Name then
				obstacle = Child
				conn:Disconnect()
			end	
		end)

		while not obstacle do
			task.wait()
		end
	end

	return obstacle
end

-- wait for fish
local function waitForFish(): Model
	local fish: Model

	for _, child in WKS.Temp:GetChildren() :: {Model} do
		print(child)
		if child:GetAttribute('Player') ~= plr.Name or child:GetAttribute('Whale') then
			continue
		end
		
		fish = child
		break
	end

	if not fish then
		local conn: RBXScriptConnection; conn = WKS.Temp.ChildAdded:Connect(function(Child)
			if not FSH_CONFIGS.Fish[Child.Name] or Child:GetAttribute('Player') ~= plr.Name or Child:GetAttribute('Whale') then
				return
			end	
			
			fish = Child :: Model
			conn:Disconnect()
		end)

		while not fish do
			task.wait()
		end
	end
	
	print(fish)

	return fish
end

-- show player to equip gadget
local function showHowToUse(Gadget: string): Model? | BasePart?
	if Gadget:match('Battery') then
		return nil
	end
	
	showing = Gadget
	
	if gui.Gizmo.Store.Position.X.Scale < 1 then
		local focus, tap = TUT_UTILS.FocusFrameOnGuiObject(gui.Gizmo.Store.Close)
		gui.Gizmo.Store:GetPropertyChangedSignal('Position'):Wait()
		
		tap.Visible = false
	end
	
	local char = plr.Character or plr.CharacterAdded:Wait()
	local tool = char:FindFirstChild(Gadget) :: Tool? or plr.Backpack:FindFirstChild(Gadget) :: Tool

	local slotB: ImageButton
	local free: ImageButton

	for _, slotButton in gui.Inventory.Content.Items.Inner:GetChildren() do
		if not slotButton:IsA('ImageButton') then
			continue
		end

		if not slotButton:GetAttribute('Item') then
			free = slotButton
		end
		
		if slotButton:GetAttribute('Item') ~= Gadget then
			continue
		end

		slotB = slotButton
		break
	end

	local highlight: BasePart? | Model?

	if Gadget == 'Dirt Popper' then
		highlight = waitForDirt()
	elseif Gadget == 'Starfish Snacker' then
		highlight = waitForObstacle('Starfish')
	elseif Gadget == 'Barnacle Cracker' then
		highlight = waitForObstacle('Barnacle')
	elseif Gadget:match('Bubble') or Gadget:match('Kit') then
		highlight = waitForFish()
	end

	local focus: Frame?, tap: ImageLabel?
	
	if not slotB then
		local itemB: TextButton?

		for _, itemFrame in gui.Backpack.Items:GetChildren() do
			if not itemFrame:IsA('Frame') or itemFrame:GetAttribute('Item') ~= Gadget then
				continue
			end

			itemB = itemFrame:FindFirstChildOfClass('TextButton')
			break
		end

		if not itemB then
			return nil
		end

		if not gui.Backpack.Visible then
			if not free then
				local toScrap = gui.Inventory.Content.Items.Inner['5']
				
				if not toScrap.Item.UIStroke.Enabled then
					focus, tap = TUT_UTILS.FocusFrameOnGuiObject(toScrap)
					toScrap.Activated:Wait()
				end
				
				focus, tap = TUT_UTILS.FocusFrameOnGuiObject(toScrap.Scrap)
				toScrap.Scrap.Activated:Wait()
				
				free = toScrap
			end
			
			focus, tap = TUT_UTILS.FocusFrameOnGuiObject(free)
			free.Activated:Wait()

			focus, tap = TUT_UTILS.FocusFrameOnGuiObject(itemB)
			itemB.Activated:Wait()

			focus, tap = TUT_UTILS.FocusFrameOnGuiObject(gui.Backpack.Close)
			gui.Backpack:GetPropertyChangedSignal('Visible'):Wait()
		end
		
		slotB = free
	end
	
	focus, tap = TUT_UTILS.FocusFrameOnGuiObject(slotB)
	TUT_UTILS.WaitForEquippedTool(Gadget)

	if not highlight or not highlight.Parent then
		if Gadget == 'Dirt Popper' then
			highlight = waitForDirt()
		elseif Gadget == 'Starfish Snacker' then
			highlight = waitForObstacle('Starfish')
		elseif Gadget == 'Barnacle Cracker' then
			highlight = waitForObstacle('Barnacle')
		elseif Gadget:match('Bubble') or Gadget:match('Kit') then
			highlight = waitForFish()
		end
	end
	
	local highlightInstance: Highlight?
	
	if highlight then
		if tap then
			tap.Visible = false
		end
		
		TUT_UTILS.HintClickOrTap(highlight)
		
		if highlight:FindFirstAncestor('Temp') then
			highlightInstance = TUT_UTILS.Highlight(highlight)
		else
			TUT_UTILS.HighlightObstacle(highlight)
		end
	else
		focus, tap = TUT_UTILS.FocusFrameOnGuiObject(gui.Screen)
	end
	
	local used = DAT_Client:get('GadgetsUsed')
	
	while DAT_Client:get('GadgetsUsed') == used do
		task.wait()
	end
	
	if highlightInstance then
		highlightInstance:Destroy()
	end
	
	if tap then
		tap.Visible = false
	end

	local index = table.find(queue, Gadget)

	if index then
		table.remove(queue, index)
	end
		
	if queue[1] then
		showHowToUse(queue[1])
		table.remove(queue, 1)
	end

	showing = nil
	
	return highlight
end

-- update objective text adn tracker
local function updateObjective(Data: {
		Description: string,
		Color: Color3?,
		RunFunc: (() -> ())?,
		Title: string?
	})
	
	objective.Description.Text = Data.Description
	objective.Skip.Visible = false
	
	if Data.Title then
		objective.Tracker.Visible = true
		objective.Tracker.Title.Text = Data.Title
		objective.Tracker.Title.TextColor3 = Data.Color or Color3.fromRGB(249, 183, 232)
	else
		objective.Tracker.Visible = false
	end
	
	if conn then
		conn:Disconnect()
	end
	
	if Data.RunFunc then
		objective.GoTo.Visible = true
		conn = objective.GoTo.MouseButton1Click:Connect(Data.RunFunc)
	else
		objective.GoTo.Visible = false
	end
end

-- move objective visibility
local function toggleObjective(Toggle: boolean?)
	if Toggle == nil then
		Toggle = not toggle
		toggle = Toggle
	else
		toggle = Toggle
	end
	
	local anchor = toggle and Vector2.new(1,0) or Vector2.new(0,0)
	
	if tween then
		tween:Destroy()
	end
	
	tween = TWS:Create(objective, TweenInfo.new(.15), {
		AnchorPoint = anchor
	})
	tween:Play()
	
	close.TextLabel.Text = toggle and '>' or '<'
end


-- initialize sidebar interface
function Objective:Init()
	objectiveFrame.Visible = false
	
	objectiveFrame.Close.MouseButton1Click:Connect(function()
		toggleObjective()
	end)
	
	objectiveFrame.Objective.Skip.MouseButton1Click:Connect(function()
		gui.TutorialSkip.Visible = true
	end)
	
	tutorialSkip.Yes.MouseButton1Click:Connect(function()
		RPS.Remotes.TutorialService.AdvanceToStep:FireServer(7)
		gui.TutorialSkip.Visible = false
	end)
	
	tutorialSkip.No.MouseButton1Click:Connect(function()
		tutorialSkip.Visible = false
	end)

	task.spawn(function()
		task.wait(3)

		while DAT_Client:get('OnboardingTutorial').Step < 5 and not DAT_Client:get('OnboardingTutorial').Finished do
			task.wait()
		end
		
		objectiveFrame.Visible = true
		toggleObjective(false)
		
		while not DAT_Client:get('OnboardingTutorial').Finished do
			task.wait()
		end

		objectiveFrame.Visible = true
		toggleObjective(true)

		local cleaned = DAT_Client:get('TotalFishCleaned')
		
		if cleaned < 3  then
			updateObjective({
				Description = "Clean 3 fish!",
				Title = 'Cleaned',
				Color = Color3.new(0.493919, 1, 0.97702)
			})
			
			toggleObjective(false)

			objective.Tracker.Amount.Text = RWD_UTILS.ToString(math.min(math.floor(cleaned), 3))..'/'..'3'

			local cleanedConn; cleanedConn = DAT_Client:getChangedSignal('TotalFishCleaned'):Connect(function(Cleaned)
				cleaned = Cleaned

				objective.Tracker.Amount.Text = RWD_UTILS.ToString(math.min(math.floor(cleaned), 3))..'/'..'3'
			end)

			while cleaned < 2 do
				task.wait()
			end
			
			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(8)
			
			while cleaned < 3 do
				task.wait()
			end
			
			cleanedConn:Disconnect()
			
			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(9)
		end

		local claimedOrders = DAT_Client:get('OrdersCompleted')

		if claimedOrders < 1 then
			updateObjective({
				Description = "Claim your order reward!",
				RunFunc = function()
					local char = plr.Character

					if not char then
						return
					end

					local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?

					if not station then
						return
					end

					local ordersBoard = station:FindFirstChild('OrdersBoard') :: Model
					local basicBoard = ordersBoard:FindFirstChild('BasicOrderPart', true) :: Part

					char:PivotTo((basicBoard):GetPivot() * CFrame.new(0, 0, -7) * CFrame.Angles(0, math.rad(180), 0))
				end
			})

			toggleObjective(false)

			local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?

			local highlight: Highlight?

			if station then
				local ordersBoard = station:FindFirstChild('OrdersBoard') :: Model
				local basicBoard = ordersBoard:FindFirstChild('BasicOrderPart', true) :: Part?
				local att = basicBoard and basicBoard:FindFirstChildWhichIsA('Attachment', true) :: Attachment

				if basicBoard then
					highlight = TUT_UTILS.Highlight(basicBoard.Parent :: Model, Color3.new(0.95, 1, 0.25))
				end

				if att then
					TUT_UTILS.DirectArrowsAt(att)
				end
			end
			
			if not gui.Order.Visible then
				gui.Order:GetPropertyChangedSignal('Visible'):Wait()
			end
			
			local basicFrame = gui.Order.Orders.Basic
			
			if not basicFrame.Visible then
				basicFrame:GetPropertyChangedSignal('Visible'):Wait()
			end

			local focus, tap = TUT_UTILS.FocusFrameOnGuiObject(basicFrame.Complete)

			while DAT_Client:get('OrdersCompleted') < 1 do
				task.wait()
			end
			
			focus.Visible = false
			tap.Visible = false

			if highlight then
				highlight:Destroy()
			end

			TUT_UTILS.DirectArrowsAt()

			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(10)
		end

		local function queueShow(Tool: string)
			if Tool:match('Battery') then
				return
			end

			if Tool:match('Treat')  then
				local found = false

				for _, gadget in queue do
					if gadget:match('Treat') then
						found = true
						break
					end
				end

				if DAT_Client:get('TreatsUsed') > 0 or found then
					return
				end
			end

			local gadgetStats = DAT_Client:get('GadgetStats')

			if gadgetStats[Tool] and gadgetStats[Tool].Used > 0 then
				return
			end

			if table.find(queue, Tool) then
				return
			end

			if showing then
				table.insert(queue, Tool)
				return
			end

			showHowToUse(Tool)
		end

		DAT_Client:getChangedSignal('Inventory'):Connect(function(Data)
			for gadget in Data do
				queueShow(gadget)
			end
		end)
		
		local boughtGadgets = DAT_Client:get('GadgetsPurchased')
		
		if boughtGadgets < 1 then
			updateObjective({
				Description = "Buy a gadget from Gizmo Gill!",
				RunFunc = function()
					local char = plr.Character
					
					if not char then
						return
					end
					
					local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?
					
					if not station then
						return
					end
					
					char:PivotTo((station:FindFirstChild('Gizmo') :: Model):GetPivot() * CFrame.new(0, 0, -7) * CFrame.Angles(0, math.rad(180), 0))
				end
			})

			toggleObjective(false)

			local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?

			local highlight: Highlight?

			if station then
				local gizmo = station:FindFirstChild('Gizmo') :: Model?
				local att = gizmo and gizmo:FindFirstChildWhichIsA('Attachment', true)
				
				if gizmo then
					highlight = TUT_UTILS.Highlight(gizmo, Color3.new(0.95, 0.5, 0.25))
				end
				
				if att then
					TUT_UTILS.DirectArrowsAt(att)
				end
			end
			
			if not gui.Gizmo.Visible then
				gui.Gizmo:GetPropertyChangedSignal('Visible'):Wait()
			elseif gui.Gizmo.Store.Position.X.Scale > 1 then
				gui.Gizmo.Store:GetPropertyChangedSignal('Position'):Wait()
				
				local isTweening, tween = INT_UTILS.IsTweening(gui.Gizmo.Store)
				if isTweening and tween then
					tween.Completed:Wait()
				end
			end
			
			local popper = gui.Gizmo.Store.Scroller:FindFirstChild('Dirt Popper') :: Frame?
			local focus: Frame?
			local tap: ImageLabel?
			if popper then
				local buy = popper:FindFirstChild('Buy') :: TextButton
				focus, tap = TUT_UTILS.FocusFrameOnGuiObject(buy)
			end
			
			while DAT_Client:get('GadgetsPurchased') < 1 do
				task.wait()
			end
			
			if focus and tap then
				focus.Visible = false
				tap.Visible = false
			end
			
			if highlight then
				highlight:Destroy()
			end
			
			TUT_UTILS.DirectArrowsAt()
			
			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(11)
		end

		local usedGadgets = DAT_Client:get('GadgetsUsed')

		if usedGadgets < 1 then
			updateObjective({
				Description = "Use a gadget!"
			})

			toggleObjective(false)

			local char = plr.Character
			
			while DAT_Client:get('GadgetsUsed') < 1 do
				task.wait()
			end

			RPS.Remotes.TutorialService.AdvanceOnboarding:FireServer(12)
		end

		--[[local spongeLevel = DAT_Client:get('ToolUpgrades').Sponge

		if spongeLevel == 0 then
			updateObjective({
				Description = "Upgrade your sponge to level 1 at Hank's!",
				Title = 'Shells',
				RunFunc = function()
					local char = plr.Character

					if char then
						local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?

						if not station then
							return
						end

						char:PivotTo((station:FindFirstChild('Hank') :: Model):GetPivot() * CFrame.new(0, 0, -10) * CFrame.Angles(0, math.rad(180), 0))
					end
				end
			})

			toggleObjective(true)

			objective.Tracker.Amount.Text = RWD_UTILS.ToString(math.min(math.floor(DAT_Client:get('Shells')), 1000))..'/'..'1K'

			local shellsConn; shellsConn = DAT_Client:getChangedSignal('Shells'):Connect(function(Shells)
				objective.Tracker.Amount.Text = RWD_UTILS.ToString(math.min(math.floor(Shells), 1000))..'/'..'1K'
			end)
			
			while DAT_Client:get('Shells') < 1000 do
				task.wait()
			end

			local station = RPS.Remotes.StationService.GetStation:InvokeServer() :: Model?

			local highlight: Highlight?

