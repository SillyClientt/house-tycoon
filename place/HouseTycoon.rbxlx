local AnalyticsServiceServer = {}

local ANS = game:GetService('AnalyticsService')
local RPS = game:GetService('ReplicatedStorage')
local PLS = game:GetService('Players')
local HTP = game:GetService('HttpService')
local PPS = game:GetService('ProximityPromptService')

local ATC_SSignals = require(script.Parent.AnalyticsServerSignals)
local DAT_Server = require(RPS.Modules.Packages.DataService).server

local journeyName = 'PlayerInteraction'

local pendingEconomyLogs: {[Player]: {
	[string]: {
		CustomData: {[string]: string | number}?,
		FlowType: Enum.AnalyticsEconomyFlowType,
		Amount: number,
		TransactionType: string
	}?
}} = {}

local sessionIds: {[Player]: string} = {}
local nodesCompleted: {[Player]: {[string]: boolean}} = {}
local fishCleaned: {[Player]: number} = {}

-- initialize analytics service server-side
function AnalyticsServiceServer:Init()
	ATC_SSignals.LogEconomy:Connect(function(Player, Economy, FlowType, TransactionType, Amount, CustomData)
		AnalyticsServiceServer:AddToPending(Player, Economy, FlowType, TransactionType, Amount, CustomData)
	end)
	
	ATC_SSignals.FlushEconomy:Connect(function(Player, Economy)
		AnalyticsServiceServer:Flush(Player, Economy)
	end)
	
	ATC_SSignals.LogJourney:Connect(function(Player, Node)
		AnalyticsServiceServer:LogJourney(Player, Node)
	end)
	
	PLS.PlayerAdded:Connect(function(Player)
		sessionIds[Player] = HTP:GenerateGUID(false)
		nodesCompleted[Player] = {}
		fishCleaned[Player] = 0
	end)
	
	PLS.PlayerRemoving:Connect(function(Player)
		pendingEconomyLogs[Player] = nil
		sessionIds[Player] = nil
		nodesCompleted[Player] = nil
		fishCleaned[Player] = nil
	end)
	
	PPS.PromptTriggered:Connect(function(Prompt, Player)
		local node: string?
		
		if Prompt:HasTag('ZapperPrompt') then
			node = 'ZappedFish'
		elseif Prompt:HasTag('ViewOrderPrompt') then
			node = 'ViewedAnOrder'
		elseif Prompt:HasTag('JoinGroupPrompt') then
			node = 'ViewedGroupPrompt'
		elseif Prompt:HasTag('HankPrompt') then
			node = 'TalkedToHank'
		elseif Prompt:HasTag('GizmoPrompt') then
			node = 'TalkedToGizmoGill'
		elseif Prompt:HasTag('VelvetPrompt') then
			node = 'TalkedToVelvet'
		elseif Prompt:HasTag('FishclopediaPrompt') then
			node = 'InteractedWithFishclopedia'
		end
		
		if not node then
			return
		end
		
		AnalyticsServiceServer:LogJourney(Player, node)
	end)
end

-- add to player pending economy log
function AnalyticsServiceServer:AddToPending(Player: Player, Economy: string, FlowType: Enum.AnalyticsEconomyFlowType, TransactionType: string, Amount: number, CustomData: {[string]: number | string}?)
	local plrLogs = pendingEconomyLogs[Player]
	
	if not plrLogs then
		pendingEconomyLogs[Player] = {
			[Economy] = {
				FlowType = FlowType,
				TransactionType = TransactionType,
				Amount = Amount,
				CustomData = CustomData
			}
		}
		
		return
	end

	local oldLog = plrLogs[Economy]
	
	if not oldLog then
		pendingEconomyLogs[Player][Economy] = {
			FlowType = FlowType,
			TransactionType = TransactionType,
			Amount = Amount,
			CustomData = CustomData
		}

		return
	end

	local changedCustom = false

	if oldLog.CustomData and CustomData then
		for key, value in oldLog.CustomData do
			if not CustomData[key] or CustomData[key] ~= value then
				changedCustom = true
				break
			end
		end
	elseif CustomData then
		changedCustom = true
	end
	
	if oldLog.FlowType ~= FlowType then
		AnalyticsServiceServer:Flush(Player, Economy)
	elseif oldLog.TransactionType ~= TransactionType then
		AnalyticsServiceServer:Flush(Player, Economy)
	elseif changedCustom then
		AnalyticsServiceServer:Flush(Player, Economy)
	end

	local flushed = pendingEconomyLogs[Player][Economy]
	
	if flushed then
		flushed.Amount += Amount
	else
		pendingEconomyLogs[Player][Economy] = {
			FlowType = FlowType,
			TransactionType = TransactionType,
			Amount = Amount,
			CustomData = CustomData
		}
	end
end

-- flush player economy log
function AnalyticsServiceServer:Flush(Player: Player, Economy: string)
	local plrLogs = pendingEconomyLogs[Player]
	local pendingLog = plrLogs and plrLogs[Economy]
	if not pendingLog then
		return
	end

	pendingEconomyLogs[Player][Economy] = nil
	
	local endingBalance = DAT_Server:get(Player, 'Shells')
	local mutation = pendingLog.CustomData and pendingLog.CustomData.Mutation
	
	if Economy == 'Station Coins' then
		endingBalance = DAT_Server:get(Player, 'StationCoins')
	elseif Economy == 'Mutation Currency' and typeof(mutation) == 'string' then
		endingBalance = DAT_Server:get(Player, {'MutationCurrencies', mutation})
	end
	
	ANS:LogEconomyEvent(Player, pendingLog.FlowType, Economy, pendingLog.Amount, endingBalance, pendingLog.TransactionType, nil, pendingLog.CustomData)
end

-- log player journey
function AnalyticsServiceServer:LogJourney(Player: Player, Node: string)
	local completed = nodesCompleted[Player]
	if not completed then
		return
	end
	
	if Node == 'CleanedFish' then
		local cleaned = fishCleaned[Player]

		if cleaned >= 10 then
			return
		end
		
		cleaned += 1
		
		Node = 'CleanedFish'..cleaned
		
		fishCleaned[Player] = cleaned
	end
	
	if completed[Node] then
		return
	end
	
	nodesCompleted[Player][Node] = true
	
	ANS:LogJourneyEvent(Player, journeyName, Node, sessionIds[Player])
end

return AnalyticsServiceServer
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1418"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">AnalyticsServerSignals</string><string name="ScriptGuid">{0a40462a-5f79-438e-b2cf-0265894af22d}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local RPS = game:GetService('ReplicatedStorage')

local Signal = require(RPS.Modules.Packages.Signal)

local AnalyticsServerSignals = {
	FlushEconomy = Signal() :: Signal.Signal<Player, string>,
	LogEconomy = Signal() :: Signal.Signal<Player, string,  Enum.AnalyticsEconomyFlowType, string, number, {[string]: number | string}?>,
	LogJourney = Signal() :: Signal.Signal<Player, string>
}

return AnalyticsServerSignals
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item></Item><Item class="Folder" referent="RBX1419"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><Color3 name="IconTint"><R>0</R><G>0</G><B>0</B></Color3><string name="Name">EconomyService</string><string name="SerializedOverrides"></string><int64 name="SourceAssetId">-1</int64></Properties><Item class="ModuleScript" referent="RBX1420"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">EconomyServiceServer</string><string name="ScriptGuid">{c7d545c4-efc7-4d0c-9e3a-a40eeed47288}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
local EconomyServiceServer = {}

local PLS = game:GetService('Players')
local RPS = game:GetService('ReplicatedStorage')
local PPS = game:GetService('ProximityPromptService')
local RNS = game:GetService('RunService')
local WKS = game:GetService('Workspace')
local HTP = game:GetService('HttpService')
local ANS = game:GetService('AnalyticsService')
local SSG = game:GetService('ServerStorage')

local ECN_SSignals = require(script.Parent.EconomyServerSignals)
local DAT_Server = require(RPS.Modules.Packages.DataService).server
local ANS_SSignals = require(SSG.Modules.Services.AnalyticsService.AnalyticsServerSignals)
local CFG_TYPES = require(RPS.Modules.Types.ConfigTypes)

-- initialize plot service server-side
function EconomyServiceServer:Init()
	ECN_SSignals.Reward:Connect(function(Player, Reward, Tag)
		EconomyServiceServer:Reward(Player, Reward, Tag)
	end)
	
	ECN_SSignals.Deduct:Connect(function(Player, Deduction, Tag)
		EconomyServiceServer:Deduct(Player, Deduction, Tag)
	end)
end

-- reward using reward config
function EconomyServiceServer:Reward(Player: Player, RewardConfig: CFG_TYPES.RewardConfig, Tag: string?)
	local transaction = RewardConfig.Transaction or Enum.AnalyticsEconomyTransactionType.Gameplay

	if RewardConfig.Gold then
		local new = DAT_Server:get(Player, 'Gold') + RewardConfig.Gold
		
		DAT_Server:update(Player, 'Gold', function(Old)
			return new
		end)

		ANS_SSignals.LogEconomy:Fire(Player, 'Gold', Enum.AnalyticsEconomyFlowType.Source, transaction.Name, RewardConfig.Gold)
		RPS.Remotes.EconomyService.Rewarded:FireClient(Player, 'Gold', RewardConfig.Gold, new, Tag)
	end

	if RewardConfig.Prestige then
		local new = DAT_Server:get(Player, 'Prestige') + RewardConfig.Prestige
		
		DAT_Server:update(Player, 'Prestige', function(Old)
			return new
		end)

		ANS_SSignals.LogEconomy:Fire(Player, 'Prestige', Enum.AnalyticsEconomyFlowType.Source, transaction.Name, RewardConfig.Prestige)
		RPS.Remotes.EconomyService.Rewarded:FireClient(Player, 'Prestige', RewardConfig.Prestige, new, Tag)
	end

	if RewardConfig.Reputation then
		local new = DAT_Server:get(Player, 'Reputation') + RewardConfig.Reputation
		
		DAT_Server:update(Player, 'Reputation', function(Old)
			return new
		end)

		ANS_SSignals.LogEconomy:Fire(Player, 'Reputation', Enum.AnalyticsEconomyFlowType.Source, transaction.Name, RewardConfig.Reputation)
		RPS.Remotes.EconomyService.Rewarded:FireClient(Player, 'Reputation', RewardConfig.Reputation, new, Tag)
	end
end

-- deduct using deduction config
function EconomyServiceServer:Deduct(Player: Player, DeductionConfig: CFG_TYPES.DeductionConfig, Tag: string?)
	local transaction = DeductionConfig.Transaction or Enum.AnalyticsEconomyTransactionType.Gameplay

	if DeductionConfig.Gold then
		local amount = DeductionConfig.Gold
		local new = DAT_Server:get(Player, 'Gold') - amount
		
		DAT_Server:update(Player, 'Gold', function(Old)
			return new
		end)

		ANS_SSignals.LogEconomy:Fire(Player, 'Gold', Enum.AnalyticsEconomyFlowType.Sink, transaction.Name, amount)
		RPS.Remotes.EconomyService.Deducted:FireClient(Player, 'Gold', amount, new, Tag)
	end

	if DeductionConfig.Prestige then
		local amount = DeductionConfig.Prestige
		local new = DAT_Server:get(Player, 'Prestige') + amount
		
		DAT_Server:update(Player, 'Prestige', function(Old)
			return new
		end)

		ANS_SSignals.LogEconomy:Fire(Player, 'Prestige', Enum.AnalyticsEconomyFlowType.Sink, transaction.Name, amount)
		RPS.Remotes.EconomyService.Deducted:FireClient(Player, 'Prestige', amount, new, Tag)
	end

	if DeductionConfig.Reputation then
		local amount = DeductionConfig.Reputation
		local new = DAT_Server:get(Player, 'Reputation') - amount
		
		DAT_Server:update(Player, 'Reputation', function(Old)
			return new
		end)

		ANS_SSignals.LogEconomy:Fire(Player, 'Reputation', Enum.AnalyticsEconomyFlowType.Sink, transaction.Name, amount)
		RPS.Remotes.EconomyService.Deducted:FireClient(Player, 'Reputation', amount, new, Tag)
	end
end


return EconomyServiceServer
]]></ProtectedString><int64 name="SourceAssetId">-1</int64></Properties></Item><Item class="ModuleScript" referent="RBX1421"><Properties><BinaryString name="AttributesSerialize"></BinaryString><bool name="DefinesCapabilities">false</bool><string name="LinkedSource"></string><string name="Name">EconomyServerSignals</string><string name="ScriptGuid">{03317e6f-93ec-4e0f-9dc8-466b9ee9e520}</string><string name="SerializedOverrides"></string><ProtectedString name="Source"><![CDATA[--!strict
