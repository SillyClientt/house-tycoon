					Subject = RPS.Assets.Models.Props.Crown,
					CFrame = CFrame.new(0, 0, -2)
				},
				{
					Order = 3,
					Subject = 1,
					CFrame = CFrame.new(0, -4.5, -2),
					Animation = {'Character', 'Scared'}
				},
			}
		},
		{ -- plaintiff 2
			Category = RPS.Assets.Models.Animals.Chicken,
			Animation = {'Chicken','Idle'},
			Mumble = SDS.Mumbles.Animals.Chicken,

			Dialogue = {
				{
					Order = 4,
					Subject = RPS.Assets.Models.Props.Hay,
					CFrame = CFrame.new(0, 0, -2),
				}
			}
		}
	},

	Requires = {
		NPCs = {
			Knight = {
				Common = 0,
				Uncommon = 0,
				Rare = 0,
				Epic = 0,
				Legendary = 0
			},
		},

		Buildings = {
			Farm = 0,
		},

		Choices = {
			Chicken = 'Pardon'
		},


	},

	Portrait = {
		Title = 'CHICKEN IN THE PALACE!',
		Image = IMG_CONFIGS.Backgrounds.Court,
		
		Subjects = {
			Victim = {
				Subject = 1,
				CFrame = CFrame.new(0, -2.5, 0) * CFrame.Angles(0,math.rad(60),0),
				Animation = {'Character', 'Angry'},
				Position = UDim2.fromScale(.3, .6),
				Size = UDim2.fromScale(.3, .6)
			},
			Aggressor = {
				Subject = 2,
				CFrame = CFrame.new(0, -1.5, 0) * CFrame.Angles(0,math.rad(-60),0),
				Animation = {'Chicken', 'Idle'},
				Position = UDim2.fromScale(.7, .6),
				Size = UDim2.fromScale(.3, .6)
